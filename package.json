{
  "name": "opencode-ralph-plugin",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./adapter": {
      "types": "./dist/opencode/adapter.d.ts",
      "import": "./dist/opencode/adapter.js"
    },
    "./store": {
      "types": "./dist/state/run-store.d.ts",
      "import": "./dist/state/run-store.js"
    },
    "./commands": {
      "types": "./dist/commands/router.d.ts",
      "import": "./dist/commands/router.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js"
    },
    "./review": {
      "types": "./dist/review/code-review.d.ts",
      "import": "./dist/review/code-review.js"
    },
    "./review/snapshot": {
      "types": "./dist/review/snapshot.d.ts",
      "import": "./dist/review/snapshot.js"
    },
    "./review/types": {
      "types": "./dist/review/types.d.ts",
      "import": "./dist/review/types.js"
    },
    "./review/functional": {
      "types": "./dist/review/functional-review.d.ts",
      "import": "./dist/review/functional-review.js"
    },
    "./review/functional-results": {
      "types": "./dist/review/functional-results.d.ts",
      "import": "./dist/review/functional-results.js"
    },
    "./review/coordinator": {
      "types": "./dist/review/coordinator.d.ts",
      "import": "./dist/review/coordinator.js"
    },
    "./review/repairs": {
      "types": "./dist/review/repairs.d.ts",
      "import": "./dist/review/repairs.js"
    },
    "./reporting/completion": {
      "types": "./dist/reporting/completion.d.ts",
      "import": "./dist/reporting/completion.js"
    },
    "./process": {
      "types": "./dist/process/ownership.d.ts",
      "import": "./dist/process/ownership.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/opencode-compatibility.md",
    "docs/troubleshooting.md",
    "docs/package-validation.md",
    "docs/live-opencode-trial.md",
    "docs/live-opencode-evidence.json",
    "skills",
    "server.js",
    "tui.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "build": "bun run scripts/clean-build.ts && tsc -p tsconfig.build.json && vite build && bun run scripts/copy-dashboard.ts",
    "test": "bun test --timeout 30000 tests/integration",
    "test:browser": "bun run scripts/browser-tests.ts",
    "test:smoke": "bun test tests/smoke",
    "build:dashboard": "vite build",
    "pack:local": "bun run build && bun pm pack",
    "test:package": "bun run scripts/package-smoke.ts",
    "test:e2e": "bun test tests/e2e",
    "test:status": "bun test --timeout 30000 tests/integration --test-name-pattern status"
  },
  "dependencies": {
    "@opencode/client": "2.0.29",
    "@opencode/plugin": "2.0.29",
    "@opencode/schema": "2.0.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@opencode/cli": "2.0.29",
    "@playwright/test": "1.56.1",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "trustedDependencies": [
    "@opencode/cli"
  ]
}
