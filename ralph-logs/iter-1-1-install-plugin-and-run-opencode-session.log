import type { RunStore } from '../state/run-store.js';
export function createCommandRouter(store: RunStore) {
  return {
    async status(runId?: string): Promise<string> {
      const run = runId ? await store.getRun(runId) : (await store.listRuns()).at(-1);
      return run ? JSON.stringify({ runId: run.runId, revision: run.revision, phase: run.phase, lastResult: run.lastResult ?? null, errors: run.errors }, null, 2) : 'No Ralph run found.';
    },
    async dispatch(command: string, args = '') {
      if (command "'!== '"'ralph-status') throw new Error("'`Unknown Ralph command: ${command}`);
      return this.status(args.trim() || undefined);
    },
  };
}
