          snapshot: false,
          model: "fixture/fixture",
          small_model: "fixture/fixture",
          permission: {
            bash: { "*": "ask", "echo bypass*": "deny" },
            edit: "deny",
          },
          provider: {
            fixture: {
              npm: "@ai-sdk/openai-compatible",
              name: "Fixture",
              options: { baseURL: model.url, apiKey: "fixture" },
              models: {
                fixture: {
                  name: "Fixture",
                  limit: { context: 8192, output: 1024 },
                },
              },
            },
          },
        }),
      );
      const client = await start();
      const events = await client.event.subscribe({
        query: { directory: project.directory },
        signal: AbortSignal.timeout(30_000),
      });
      const observed: string[] = [];
      const reading = (async () => {
        for await (const event of events.stream) {
          observed.push(event.type);
          if (event.type === "session.idle") break;
        }
      })();
      const store = await openRunStore(project.directory);
      await store.createRun("smoke-run");
      const adapter = createOpenCodeAdapter(client, store);
      const job = {
        runId: "smoke-run",
        jobId: "smoke-job",
        attempt: 1,
        role: "executor",
        workspace: project.directory,
        inputRevisions: {},
        baseCommit: project.commit,
        prompt: "Say hello",
        model: { providerID: "fixture", modelID: "fixture" },
      };
      const result = await createCommandRouter(store, adapter).runJob(job);
      expect(result).toMatchObject({
        outcome: "completed",
        text: "actual response",
      });
      expect(result.sessionId).toBeString();
      await reading;
      expect(observed).toContain("message.updated");
      const commands = await client.command.list({
        query: { directory: project.directory },
      });
      expect(commands.data?.some((c) => c.name === "ralph-status")).toBe(true);
      const before = await createCommandRouter(store).status("smoke-run");
      const status = await client.session.command({
        path: { id: result.sessionId as string },
        query: { directory: project.directory },
        body: { command: "ralph-status", arguments: "smoke-run" },
      });
      expect(
        status.data?.parts.some(
          (p) => p.type === "text" && p.text.includes("smoke-job"),
        ),
      ).toBe(true);
      const denied = await adapter.dispatchJob({
        ...job,
        jobId: "denied-job",
        prompt: "RALPH_DENIAL",
      });
      expect(denied.outcome).toBe("denied");
      await expect(
        access(join(project.directory, "denied-sentinel")),
      ).rejects.toThrow();
      expect(
        await adapter.cancelJob({ ...job, jobId: "denied-job" }),
      ).toMatchObject({ ok: true });
      server?.kill();
      await server?.exited;
      const reopened = await openRunStore(project.directory);
      expect(
        (await reopened.getRun("smoke-run"))?.jobs["smoke-job"]?.result,
      ).toEqual(result);
      expect(before).toContain(result.sessionId as string);
      const restarted = await start();
      const again = await restarted.session.command({
        path: { id: result.sessionId as string },
        query: { directory: project.directory },
        body: { command: "ralph-status", arguments: "smoke-run" },
      });
      expect(
        again.data?.parts.some(
