import { expect, test } from "bun:test";
import { access, mkdir, writeFile } from "node:fs/promises";
import { join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { createCommandRouter } from "../../src/commands/router.js";
import {
  createAdapterClient,
  createOpenCodeAdapter,
} from "../../src/opencode/adapter.js";
import { openRunStore } from "../../src/state/run-store.js";
import { createModelFixture } from "../helpers/model-fixture.js";
import { createTestProject } from "../helpers/project.js";

const smoke = process.env.OPENCODE_SMOKE === "1" ? test : test.skip;
smoke(
  "installed package: real OpenCode session, command, denied tool, events, restart",
  async () => {
    const project = await createTestProject();
    const model = createModelFixture();
    let server: Bun.Subprocess<"ignore", "pipe", "pipe"> | undefined;
    const root = resolve(import.meta.dir, "../..");
    const binary = join(
      root,
      "node_modules",
      "opencode-ai",
      "bin",
      "opencode.exe",
    );
    const run = async (args: string[], cwd: string) => {
      const proc = Bun.spawn(args, { cwd, stdout: "pipe", stderr: "pipe" });
      const [code, output, error] = await Promise.all([
        proc.exited,
        new Response(proc.stdout).text(),
        new Response(proc.stderr).text(),
      ]);
      if (code)
        throw new Error(
          `Fixture command failed (${code}): ${output}\n${error}`,
        );
      return output;
    };
    const env = {
      ...process.env,
      XDG_CONFIG_HOME: join(project.directory, "config"),
      XDG_DATA_HOME: join(project.directory, "data"),
      XDG_CACHE_HOME: join(project.directory, "cache"),
      OPENCODE_DISABLE_DEFAULT_PLUGINS: "1",
      OPENCODE_DISABLE_MODELS_FETCH: "1",
    };
    async function start() {
      const proc = Bun.spawn(
        [binary, "serve", "--hostname=127.0.0.1", "--port=0"],
        {
          cwd: project.directory,
          env,
          stdin: "ignore",
          stdout: "pipe",
          stderr: "pipe",
        },
      );
      server = proc;
      const reader = proc.stdout.getReader();
      let output = "";
      const timeout = setTimeout(() => proc.kill(), 30_000);
      while (true) {
        const chunk = await reader.read();
        if (chunk.done)
          throw new Error(
            `OpenCode startup failed: ${output}\n${await new Response(proc.stderr).text()}`,
          );
        output += new TextDecoder().decode(chunk.value);
        const match = output.match(
          /opencode server listening on (https?:\/\/\S+)/,
        );
        if (match?.[1]) {
          clearTimeout(timeout);
          reader.releaseLock();
          return createAdapterClient(match[1]);
        }
      }
    }
    try {
      await run([process.execPath, "run", "build"], root);
      await run(
        [
          process.execPath,
          "pm",
          "pack",
          "--destination",
          project.directory,
          "--quiet",
        ],
        root,
      );
      await writeFile(
        join(project.directory, "package.json"),
        JSON.stringify({
          private: true,
          type: "module",
          dependencies: {
            "opencode-ralph-plugin": `file:${join(project.directory, "opencode-ralph-plugin-0.1.0.tgz")}`,
          },
        }),
      );
      await run([process.execPath, "install"], project.directory);
      const plugin = pathToFileURL(
        join(
          project.directory,
          "node_modules/opencode-ralph-plugin/dist/plugin.js",
        ),
      ).href;
      await mkdir(env.XDG_CONFIG_HOME, { recursive: true });
      await writeFile(
        join(project.directory, "opencode.json"),
        JSON.stringify({
          plugin: [plugin],
          snapshot: false,
          model: "fixture/fixture",
          small_model: "fixture/fixture",
          permission: {
            bash: { "*": "ask", "echo bypass*": "deny" },
            edit: "deny",
          },
          provider: {
            fixture: {
              npm: "@ai-sdk/openai-compatible",
              name: "Fixture",
              options: { baseURL: model.url, apiKey: "fixture" },
              models: {
                fixture: {
                  name: "Fixture",
                  limit: { context: 8192, output: 1024 },
                },
              },
            },
          },
        }),
      );
      const client = await start();
      const events = await client.event.subscribe({
        query: { directory: project.directory },
        signal: AbortSignal.timeout(30_000),
      });
      const observed: string[] = [];
      const reading = (async () => {
        for await (const event of events.stream) {
          observed.push(event.type);
          if (event.type === "session.idle") break;
        }
      })();
      const store = await openRunStore(project.directory);
      await store.createRun("smoke-run");
      const adapter = createOpenCodeAdapter(client, store);
      const job = {
        runId: "smoke-run",
        jobId: "smoke-job",
        attempt: 1,
        role: "executor",
        workspace: project.directory,
        inputRevisions: {},
        baseCommit: project.commit,
        prompt: "Say hello",
        model: { providerID: "fixture", modelID: "fixture" },
      };
      const result = await createCommandRouter(store, adapter).runJob(job);
      expect(result).toMatchObject({
        outcome: "completed",
        text: "actual response",
      });
      expect(result.sessionId).toBeString();
      await reading;
      expect(observed).toContain("message.updated");
      const commands = await client.command.list({
        query: { directory: project.directory },
      });
      expect(commands.data?.some((c) => c.name === "ralph-status")).toBe(true);
      const before = await createCommandRouter(store).status("smoke-run");
      const status = await client.session.command({
        path: { id: result.sessionId as string },
        query: { directory: project.directory },
        body: { command: "ralph-status", arguments: "smoke-run" },
      });
      expect(
        status.data?.parts.some(
          (p) => p.type === "text" && p.text.includes("smoke-job"),
        ),
      ).toBe(true);
      const denied = await adapter.dispatchJob({
        ...job,
        jobId: "denied-job",
        prompt: "RALPH_DENIAL",
      });
      expect(denied.outcome).toBe("denied");
      await expect(
        access(join(project.directory, "denied-sentinel")),
      ).rejects.toThrow();
      expect(
        await adapter.cancelJob({ ...job, jobId: "denied-job" }),
      ).toMatchObject({ ok: true });
      server?.kill();
      await server?.exited;
      const reopened = await openRunStore(project.directory);
      expect(
        (await reopened.getRun("smoke-run"))?.jobs["smoke-job"]?.result,
      ).toEqual(result);
      expect(before).toContain(result.sessionId as string);
      const restarted = await start();
      const again = await restarted.session.command({
        path: { id: result.sessionId as string },
        query: { directory: project.directory },
        body: { command: "ralph-status", arguments: "smoke-run" },
      });
      expect(
        again.data?.parts.some(
          (p) => p.type === "text" && p.text.includes("denied-job"),
        ),
      ).toBe(true);
      expect(model.calls()).toBeGreaterThan(0);
      const restartAdapter = createOpenCodeAdapter(restarted, reopened);
      const heldJob = { ...job, jobId: "abort-job", prompt: "RALPH_HOLD" };
      const held = restartAdapter.dispatchJob(heldJob);
      const deadline = Date.now() + 15_000;
      while (!model.holding() && Date.now() < deadline) await Bun.sleep(20);
      expect(model.holding()).toBe(true);
      expect(await restartAdapter.cancelJob(heldJob)).toEqual({ ok: true });
      model.release();
      expect((await held).outcome).toBe("cancelled");
      expect(
        Object.values(
          (await reopened.getRun("smoke-run"))?.operations ?? {},
        ).some(
          (op) => op.kind === "session.abort" && op.status === "completed",
        ),
      ).toBe(true);
      expect(
        await restartAdapter.publishStatus(
          result.sessionId as string,
          project.directory,
          "Probe complete",
        ),
      ).toEqual({ ok: true });
      const history = await restarted.session.messages({
        path: { id: result.sessionId as string },
        query: { directory: project.directory },
      });
      expect(
        history.data?.some(
          (m) =>
            m.info.role === "user" &&
            m.parts.some((p) => p.type === "text" && p.text === "Say hello"),
        ),
      ).toBe(true);
      expect(
        await restartAdapter.requestUserInput({
          runId: "smoke-run",
          requestId: "q",
          revision: 1,
          sessionId: result.sessionId as string,
          workspace: project.directory,
          question: "approve?",
        }),
      ).toMatchObject({ ok: false, error: { code: "unsupported" } });
    } finally {
      server?.kill();
      await server?.exited;
      model.release();
      model.close();
      await project.cleanup();
    }
  },
  120_000,
);

