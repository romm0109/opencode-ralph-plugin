  recordBaseline(
    runId: string,
    revision: number,
    baseline: NonNullable<RunRecord["baseline"]>,
    skips: string[],
  ): Promise<boolean>;
  recordPlanning(
    runId: string,
    revision: number,
    planning: import("../planning/types.js").PlanningState,
  ): Promise<boolean>;
  recordControl(
    runId: string,
    control: RunControl,
    revision?: number,
  ): Promise<boolean>;
  recordReviewWorkflow(
    runId: string,
    revision: number,
    workflow: ReviewWorkflow,
  ): Promise<boolean>;
  recordExecution(
    runId: string,
    revision: number,
    execution: ExecutionEvidence,
  ): Promise<boolean>;
  recordReviewSnapshot(
    runId: string,
    revision: number,
    review: StoredReview,
  ): Promise<boolean>;
  recordReviewResult(
