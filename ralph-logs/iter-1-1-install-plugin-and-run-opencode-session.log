import { createOpencodeClient, type OpencodeClient, type Event } from '@opencode-ai/sdk';
import type { Failure, JobEnvelope, JobResult, UserInputRequest, UserInputResult } from '../core/types.js';
import type { RunStore } from '../state/run-store.js';
export interface OpenCodeAdapter {
  dispatchJob(job: JobEnvelope): Promise<JobResult>;
  cancelJob(job: JobEnvelope): Promise<{ ok: boolean; error?: Failure }>;
  requestUserInput(request: UserInputRequest): Promise<UserInputResult>;
  publishStatus(sessionId: string, workspace: string, text: string): Promise<{ ok: boolean; error?: Failure }>;
  receiveEvent(event: Event): Promise<void>;
}
export function createAdapterClient(baseUrl: string, fetch?: (input: Request) => Promise<Response>): OpencodeClient {
  return createOpencodeClient({ baseUrl, ...(fetch ? { fetch } : {}) });
}
function failure(cause: unknown, status?: number): Failure {
  const message = cause instanceof Error ? cause.message : JSON.stringify(cause) ?? 'Unknown SDK failure';
