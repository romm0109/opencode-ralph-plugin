    | "planning.changed"
    | "run.control"
    | "review.workflow"
    | "review.snapshot"
    | "review.result"
    | "execution.observed"
    | "run.created"
    | "job.intent"
    | "job.session"
    | "job.result"
    | "operation.intent"
    | "operation.result";
