    },
    async publishStatus(_sessionId, workspace, text) {
      try {
        const response = await client.tui.showToast({ query: { directory: workspace }, body: { title: 'Ralph status', message: text, variant: 'info' } });
        return response.data ? { ok: true } : { ok: false, error: failure(response.error, response.response.status) };
