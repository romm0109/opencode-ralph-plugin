import { Plugin } from "@opencode/plugin";
import type { Registration } from "@opencode/plugin/promise/registration";
import { z } from "zod";
import { handleControlCommand } from "./commands/control.js";
import { createCommandRouter } from "./commands/router.js";
import { startDashboard } from "./dashboard/server.js";
import {
  createOpenCodeAdapter,
  reviewToolAlias,
  reviewTools,
} from "./opencode/adapter.js";
import { ralphBridge } from "./opencode/bridge.js";
import { reconcileRun } from "./recovery/reconcile.js";
import { openRunStore } from "./state/run-store.js";

// Linked worktrees activate separate OpenCode locations in the same server.
// Recover shared state once; tearing down one location must not stop another.
const repositories = new Map<
  string,
  { instances: number; ready: Promise<void>; error?: unknown }
>();

export const RalphPlugin = Plugin.define({
  id: "ralph",
  async setup(ctx) {
    const directory = ctx.location.directory;
    const store = await openRunStore(directory);
    const existing = repositories.get(store.root);
    let activate: () => void = () => {};
    const repository = existing ?? {
      instances: 0,
      ready: new Promise<void>((resolve) => {
        activate = resolve;
      }),
    };
    repositories.set(store.root, repository);
    repository.instances++;
    const registrations: Registration[] = [];
    const observationAliases = new Set<string>();
    async function prepareReview(_workspace: string, allowed: string[]) {
      const catalog = await ctx.tool.list();
      const selected = catalog.filter(
        (tool) => allowed.includes(tool.id) && !observationAliases.has(tool.id),
      );
      if (!selected.length) return;
      registrations.push(
        await ctx.tool.transform((editor) => {
          for (const tool of selected)
            editor.add({
              name: reviewToolAlias(tool.id),
              description: tool.description,
              input: tool.input,
              ...(tool.output ? { output: tool.output } : {}),
              options: {
                codemode: false,
                permission: tool.options?.permission ?? tool.id,
              },
              execute: tool.execute,
            });
        }),
      );
      for (const tool of selected) observationAliases.add(tool.id);
      await ctx.tool.reload();
    }
    let statusEvents:
      | Awaited<ReturnType<typeof ctx.rpc.register<typeof ralphBridge>>>
      | undefined;
    const adapter = createOpenCodeAdapter(
      {
        session: ctx.session,
        assertCommandPermission: async (sessionId, command, hash) => {
          await ctx.permission.assert({
            sessionID: sessionId,
            action: "shell",
            resources: [
              JSON.stringify({
                executable: command.executable,
                args: command.args,
                cwd: command.cwd,
                shell: command.shell,
              }),
            ],
            metadata: { ralphCommandHash: hash, commandId: command.id },
          });
        },
        tools: async () => (await ctx.tool.list()).map((tool) => tool.id),
        prepareReview,
        notify: async (_workspace, text) => {
          await statusEvents?.events.emit("status", { text });
        },
      },
      store,
    );
    const recoveryNotifications: string[] = [];
    try {
      if (existing) {
        await repository.ready;
        if (repository.error) throw repository.error;
      } else
        for (const run of await store.listRuns()) {
          if (
            run.reviewWorkflow?.status === "terminal" &&
            Object.values(run.operations).every((op) => op.status !== "intent")
          )
            continue;
          recoveryNotifications.push(
            JSON.stringify(
              await reconcileRun({
                store,
                directory,
                runId: run.runId,
                adapter,
              }),
            ),
          );
        }
    } catch (cause) {
      repository.error = cause;
      if (--repository.instances === 0) repositories.delete(store.root);
      throw cause;
    } finally {
      activate();
    }
    let dashboard: Awaited<ReturnType<typeof startDashboard>>;
    try {
      dashboard = await startDashboard(store);
    } catch (cause) {
      if (--repository.instances === 0) repositories.delete(store.root);
      throw cause;
    }
    const router = createCommandRouter(
      store,
      adapter,
      dashboard.url,
      directory,
    );
    const eventsAbort = new AbortController();
    let disposed = false;
    let notification: ReturnType<typeof setImmediate> | undefined;
    async function reviewJob(sessionID: string) {
      for (const run of await store.listRuns()) {
        const entry = Object.values(run.jobs).find(
          (job) => job.envelope.sessionId === sessionID,
        );
        if (entry?.envelope.readOnly) return entry.envelope;
      }
    }
    async function dispose() {
      if (disposed) return;
      disposed = true;
      if (notification) clearImmediate(notification);
      eventsAbort.abort();
      const lastInstance = --repository.instances === 0;
      if (lastInstance) repositories.delete(store.root);
      try {
        if (lastInstance)
          for (const run of await store.listRuns()) {
            if (
              (run.control?.status === "stopped" ||
                run.reviewWorkflow?.status === "terminal") &&
              !Object.values(run.operations).some((op) => op.ownedProcess)
            )
              continue;
            await handleControlCommand(
              "ralph-stop",
              run.runId,
              store,
              adapter,
              {
                source: "shutdown",
              },
            );
            const current = await store.getRun(run.runId);
            await store.recordControl(run.runId, {
              status: "interrupted",
              source: "shutdown",
              facts: current?.control?.facts ?? [],
            });
          }
      } finally {
        await Promise.allSettled(
          registrations.map((registration) => registration.dispose()),
        );
        await dashboard.stop();
      }
    }
    try {
      statusEvents = await ctx.rpc.register(ralphBridge, {
        tools: async () => (await ctx.tool.list()).map((tool) => tool.id),
        prepareReview: async ({ tools }) => {
          await prepareReview(directory, tools);
          return { ok: true };
        },
        publishStatus: async ({ text }) => {
          await statusEvents?.events.emit("status", { text });
          return { ok: true };
        },
      });
      registrations.push(statusEvents);
      registrations.push(
        await ctx.command.transform((editor) => {
          for (const name of [
            "ralph-status",
            "ralph-commands",
            "ralph-orchestrator",
            "ralph-pause",
            "ralph-resume",
            "ralph-stop",
          ]) {
            editor.add({
              name,
              description:
                name === "ralph-status"
                  ? "Read durable Ralph run status"
                  : `${name.slice(6)} the durable Ralph run`,
              async execute(input) {
                const text = await router.dispatch(
                  name,
                  input.prompt.text.trim(),
                  { workspace: directory, sessionId: input.sessionID },
                );
                await adapter.publishStatus(input.sessionID, directory, text);
                await ctx.session.synthetic({
                  sessionID: input.sessionID,
                  text,
                  description: "Ralph command result",
                  resume: false,
                });
              },
            });
          }
        }),
      );
      registrations.push(
        await ctx.tool.transform((editor) => {
          editor.add({
            name: "ralph_status",
            description:
              "Read persisted Ralph phase, correlated job result, errors and dashboard URL.",
            input: z.object({ runId: z.string().optional() }),
            options: { codemode: false },
            async execute({ runId }) {
              return {
                content: await router.status(runId?.trim() || undefined),
              };
            },
          });
          editor.add({
            name: "ralph_control",
            description:
              "Pause, resume or stop a durable Ralph run. Use slash commands for explicit user intent.",
            input: z.object({
              action: z.enum(["pause", "resume", "stop"]),
              runId: z.string().optional(),
            }),
            options: { codemode: false },
            async execute({ action, runId }) {
              return {
                content: await router.dispatch(
                  `ralph-${action}`,
                  runId?.trim() ?? "",
                ),
              };
            },
          });
        }),
      );
      registrations.push(
        await ctx.session.hook("context", async (input) => {
          const job = await reviewJob(input.sessionID);
          const allowed = job
            ? new Set([...reviewTools(job)].map(reviewToolAlias))
            : undefined;
          for (const name of Object.keys(input.tools)) {
            if (allowed ? !allowed.has(name) : name.startsWith("ralph_review_"))
              delete input.tools[name];
          }
        }),
      );
      // Execution checks also cover tools reached through code mode or renamed
      // definitions. Never change a host denial into an allow.
      registrations.push(
        await ctx.tool.hook("execute.before", async (input) => {
          const job = await reviewJob(input.sessionID);
          if (
            job &&
            !new Set([...reviewTools(job)].map(reviewToolAlias)).has(input.tool)
          )
            throw new Error(
              `Permission denied: Ralph review cannot execute ${input.tool}`,
            );
        }),
      );
      const events = ctx.event.subscribe({ signal: eventsAbort.signal });
      void (async () => {
        try {
          for await (const event of events) {
            if (disposed) break;
            await adapter.receiveEvent(event);
          }
        } catch (cause) {
          if (!eventsAbort.signal.aborted)
            console.error("Ralph event subscription failed", cause);
        }
      })();
      // Host activation must finish before emitting notifications.
      notification = setImmediate(async () => {
        for (const text of recoveryNotifications) {
          if (disposed) break;
          await adapter.publishStatus("", directory, text);
        }
      });
      notification.unref();
      return dispose;
    } catch (cause) {
      await dispose();
      throw cause;
    }
  },
});
export default RalphPlugin;
import { reviewCompletedCode } from "../core/orchestrator.js";
import type { JobEnvelope, JobResult } from "../core/types.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { CodeReviewOptions } from "../review/code-review.js";
import {
  coordinateReviewRound,
  type ReviewCoordinatorOptions,
} from "../review/coordinator.js";
import {
  type FunctionalReviewOptions,
  runFunctionalReview,
} from "../review/functional-review.js";
import type { ReviewSnapshot } from "../review/types.js";
import type { RunStore } from "../state/run-store.js";
import { assertDispatchAllowed, handleControlCommand } from "./control.js";
import { orchestrateFeature } from "./orchestrator.js";
import {
  type ProjectSetupOptions,
  projectStatus,
  setupProject,
} from "./project-setup.js";
export function createCommandRouter(
  store: RunStore,
  adapter?: OpenCodeAdapter,
  dashboardUrl?: string,
  workspace?: string,
) {
  return {
    projectStatus,
    async setupProject(options: ProjectSetupOptions) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      return setupProject({ ...options, store, adapter });
    },
    async reviewFeature(
      options: Omit<ReviewCoordinatorOptions, "store" | "adapter">,
    ) {
      await assertDispatchAllowed(store, options.runId);
      return coordinateReviewRound({
        ...options,
        store,
        ...(adapter ? { adapter } : {}),
      });
    },
    async reviewFunctional(
      snapshot: ReviewSnapshot,
      options: Omit<FunctionalReviewOptions, "store" | "adapter">,
    ) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      await assertDispatchAllowed(store, snapshot.runId);
      return runFunctionalReview(snapshot, { ...options, store, adapter });
    },
    async reviewCode(
      snapshot: ReviewSnapshot,
      options: Omit<CodeReviewOptions, "store" | "adapter">,
    ) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      await assertDispatchAllowed(store, snapshot.runId);
      return reviewCompletedCode(snapshot, { ...options, store, adapter });
    },
    async runJob(job: JobEnvelope): Promise<JobResult> {
      if (!adapter)
        return {
          ...job,
          outcome: "failed",
          evidence: [],
          error: {
            code: "unsupported",
            message: "No OpenCode adapter supplied",
          },
        };
      await store.createRun(job.runId);
      await assertDispatchAllowed(store, job.runId);
      return adapter.dispatchJob(job);
    },
    async status(runId?: string): Promise<string> {
      const projectSetup = workspace
        ? await projectStatus(workspace)
        : undefined;
      const run = runId
        ? await store.getRun(runId)
        : (await store.listRuns()).at(-1);
      return run
        ? JSON.stringify(
            {
              ...(dashboardUrl ? { dashboardUrl } : {}),
              ...(projectSetup ? { projectSetup } : {}),
              runId: run.runId,
              revision: run.revision,
              phase: run.phase,
              control: run.control ?? null,
              lastResult: run.lastResult ?? null,
              ...(run.review ? { review: run.review } : {}),
              ...(run.reviewWorkflow
                ? { reviewWorkflow: run.reviewWorkflow }
                : {}),
              ...(run.planning ? { planning: run.planning } : {}),
              ...(run.baseline
                ? {
                    baseline: run.baseline,
                    validationSkips: run.validationSkips ?? [],
                  }
                : {}),
              errors: run.errors,
            },
            null,
            2,
          )
        : dashboardUrl
          ? JSON.stringify({
              dashboardUrl,
              ...(projectSetup ? { projectSetup } : {}),
              message: "No Ralph run found.",
            })
          : projectSetup
            ? JSON.stringify({ projectSetup, message: "No Ralph run found." })
            : "No Ralph run found.";
    },
    async dispatch(command: string, args = "", context?: ProjectSetupOptions) {
      if (command === "ralph-orchestrator") {
        if (!context)
          throw new Error(
            "Feature planning requires the main session and workspace",
          );
        if (!adapter) throw new Error("No OpenCode adapter supplied");
        return JSON.stringify(
          await orchestrateFeature({
            ...context,
            feature: args,
            store,
            adapter,
          }),
          null,
          2,
        );
      }
      if (command === "ralph-commands") {
        if (!context)
          throw new Error(
            "Project setup requires the main session and workspace",
          );
        return JSON.stringify(await this.setupProject(context), null, 2);
      }
      if (["ralph-pause", "ralph-resume", "ralph-stop"].includes(command)) {
        const runId = args.trim() || (await store.listRuns()).at(-1)?.runId;
        if (!runId) throw new Error("No Ralph run found");
        return handleControlCommand(
          command as "ralph-pause" | "ralph-resume" | "ralph-stop",
          runId,
          store,
          adapter,
        );
      }
      if (command !== "ralph-status")
        throw new Error(`Unknown Ralph command: ${command}`);
      return this.status(args.trim() || undefined);
    },
  };
}
import { randomUUID } from "node:crypto";
import {
  OpenCode,
  type OpenCodeClient,
  type SessionApi,
  type V2Event,
} from "@opencode/client";
import type {
  Failure,
  JobEnvelope,
  JobResult,
  UserInputRequest,
  UserInputResult,
} from "../core/types.js";
import type { RunStore } from "../state/run-store.js";
import { ralphBridge } from "./bridge.js";

export interface OpenCodeAdapter {
  getSessionModel?(sessionId: string): Promise<JobEnvelope["model"]>;
  /** Explicit host permission; no SDK denial may fall back to direct execution. */
  authorizeCommand?(request: {
    job: JobEnvelope;
    command: import("../config/commands.js").CommandSpec;
    hash: string;
  }): Promise<{ ok: boolean; error?: Failure }>;
  inspectSession?(
    job: JobEnvelope,
  ): Promise<"idle" | "busy" | "missing" | "unknown">;
  discoverTools?(workspace: string): Promise<string[]>;
  dispatchJob(job: JobEnvelope): Promise<JobResult>;
  cancelJob(job: JobEnvelope): Promise<{ ok: boolean; error?: Failure }>;
  requestUserInput(request: UserInputRequest): Promise<UserInputResult>;
  publishStatus(
    sessionId: string,
    workspace: string,
    text: string,
  ): Promise<{ ok: boolean; error?: Failure }>;
  receiveEvent(event: V2Event): Promise<void>;
}

export interface AdapterHost {
  assertCommandPermission?(
    sessionId: string,
    command: import("../config/commands.js").CommandSpec,
    hash: string,
  ): Promise<void>;
  session: Pick<
    SessionApi,
    "create" | "get" | "prompt" | "wait" | "context" | "interrupt"
  > &
    Partial<Pick<SessionApi, "active">>;
  tools(workspace: string): Promise<string[]>;
  prepareReview(workspace: string, tools: string[]): Promise<void>;
  notify(workspace: string, text: string): Promise<void>;
}

export function createAdapterClient(
  baseUrl: string,
  fetch?: (input: Request) => Promise<Response>,
  headers?: RequestInit["headers"],
): OpenCodeClient & AdapterHost {
  const client = OpenCode.make({
    baseUrl,
    ...(headers ? { headers } : {}),
    ...(fetch
      ? {
          fetch: ((input: RequestInfo | URL, init?: RequestInit) =>
            fetch(new Request(input, init))) as typeof globalThis.fetch,
        }
      : {}),
  });
  const bridge = client.rpc(ralphBridge);
  return Object.assign(client, {
    tools: (workspace: string) =>
      bridge.tools({}, { location: { directory: workspace } }),
    prepareReview: async (workspace: string, tools: string[]) => {
      await bridge.prepareReview(
        { tools },
        { location: { directory: workspace } },
      );
    },
    notify: async (workspace: string, text: string) => {
      await bridge.publishStatus(
        { text },
        { location: { directory: workspace } },
      );
    },
  });
}

function statusOf(cause: unknown): number | undefined {
  if (!cause || typeof cause !== "object") return undefined;
  const value = cause as { status?: number; cause?: unknown };
  return (
    value.status ?? (value.cause !== cause ? statusOf(value.cause) : undefined)
  );
}
function failure(cause: unknown): Failure {
  const message =
    cause instanceof Error
      ? cause.message
      : (JSON.stringify(cause) ?? "Unknown SDK failure");
  return {
    code:
      statusOf(cause) === 403 ||
      /permission.*(denied|rejected)|PermissionDenied|not allowed|declined/i.test(
        message,
      )
        ? "permission-denied"
        : "sdk-error",
    message,
    cause:
      cause instanceof Error
        ? { name: cause.name, message: cause.message, status: statusOf(cause) }
        : cause,
  };
}

// Only observation tools may execute in review sessions. Shell and delegation
// remain excluded even if supplied as observation tools.
export function reviewTools(job: JobEnvelope): Set<string> {
  return new Set([
    "read",
    "glob",
    "grep",
    "list",
    ...(job.role === "functional-review"
      ? (job.observationTools ?? []).filter(
          (name) =>
            ![
              "edit",
              "write",
              "patch",
              "apply_patch",
              "bash",
              "shell",
              "subagent",
              "opencode",
              "execute",
              "ralph_control",
            ].includes(name),
        )
      : []),
  ]);
}
export function reviewToolAlias(name: string) {
  return `ralph_review_${name}`;
}

export function createOpenCodeAdapter(
  client: AdapterHost,
  store: RunStore,
): OpenCodeAdapter {
  async function finish(job: JobEnvelope, error: Failure): Promise<JobResult> {
    const result: JobResult = {
      ...job,
      outcome: error.code === "permission-denied" ? "denied" : "failed",
      error,
      evidence: [],
    };
    await store.recordResult(result);
    const current = (await store.getRun(job.runId))?.jobs[job.jobId];
    return current?.envelope.attempt === job.attempt && current.result
      ? current.result
      : { ...job, outcome: "cancelled", evidence: [] };
  }
  async function abortSession(
    job: JobEnvelope,
  ): Promise<{ ok: boolean; error?: Failure }> {
    if (!job.sessionId) return { ok: true };
    // Keep the durable operation name so old journals remain readable.
    const operation = {
      operationId: randomUUID(),
      kind: "session.abort" as const,
      job,
      status: "intent" as const,
    };
    await store.recordOperation(operation);
    let error: Failure | undefined;
    try {
      await client.session.interrupt({ sessionID: job.sessionId });
    } catch (cause) {
      error = failure(cause);
    }
    await store.recordOperation({
      ...operation,
      status: error ? "failed" : "completed",
      ...(error ? { error } : {}),
    });
    return error ? { ok: false, error } : { ok: true };
  }
  return {
    async authorizeCommand({ job, command, hash }) {
      if (!job.sessionId || !client.assertCommandPermission)
        return {
          ok: false,
          error: {
            code: "unsupported",
            message: "Host command permission assertion is unavailable",
          },
        };
      try {
        await client.assertCommandPermission(job.sessionId, command, hash);
        return { ok: true };
      } catch (cause) {
        return { ok: false, error: failure(cause) };
      }
    },
    async inspectSession(job) {
      if (!job.sessionId) return "missing";
      try {
        const session = await client.session.get({ sessionID: job.sessionId });
        if (client.session.active) {
          const active = await client.session.active();
          return active[job.sessionId] ? "busy" : "idle";
        }
        return session.outcome ? "idle" : "unknown";
      } catch (cause) {
        return statusOf(cause) === 404 ? "missing" : "unknown";
      }
    },
    async getSessionModel(sessionId) {
      const session = await client.session.get({ sessionID: sessionId });
      return session.model
        ? { providerID: session.model.providerID, modelID: session.model.id }
        : undefined;
    },
    discoverTools: (workspace) => client.tools(workspace),
    async dispatchJob(job) {
      if (!(await store.recordIntent(job))) {
        const existing = (await store.getRun(job.runId))?.jobs[job.jobId];
        if (existing?.envelope.attempt === job.attempt && existing.result)
          return existing.result;
        return {
          ...job,
          outcome: "failed",
          error: {
            code: "sdk-error",
            message: "Duplicate or stale dispatch; no side effect performed",
          },
          evidence: [],
        };
      }
      let bound = job;
      try {
        if (job.readOnly)
          await client.prepareReview(job.workspace, [...reviewTools(job)]);
        const created = await client.session.create({
          location: { directory: job.workspace },
          title: `Ralph ${job.runId}/${job.jobId}/${job.attempt}`,
          ...(job.model
            ? {
                model: {
                  providerID: job.model.providerID,
                  id: job.model.modelID,
                },
              }
            : {}),
          metadata: {
            ralph: { runId: job.runId, jobId: job.jobId, attempt: job.attempt },
          },
        });
        bound = { ...job, sessionId: created.id };
        if (!(await store.attachSession(job, created.id))) {
          const abort = await abortSession(bound);
          return {
            ...bound,
            outcome: "cancelled",
            evidence: [],
            ...(abort.error ? { error: abort.error } : {}),
          };
        }
        const textInput = job.readOnly
          ? `${job.prompt}\nUse the observation tools prefixed ralph_review_ (for example ralph_review_read). Other tools are unavailable in this review session.`
          : job.prompt;
        const prompt = await client.session.prompt({
          sessionID: created.id,
          text: textInput,
        });
        if (prompt.sessionID !== created.id)
          return finish(bound, {
            code: "missing-output",
            message: "OpenCode returned an uncorrelated prompt receipt",
          });
        // v2 acknowledges the inbox item immediately. Waiting is a barrier, not
        // success evidence; inspect the completed turn behind the same receipt.
        await client.session.wait({ sessionID: created.id });
        const history = await client.session.context({ sessionID: created.id });
        const start = history.findIndex(
          (message) => message.id === prompt.id && message.type === "user",
        );
        if (start < 0)
          return finish(bound, {
            code: "missing-output",
            message: "No correlated delivered prompt in session context",
          });
        const turn = history.slice(start + 1);
        if (
          turn.some(
            (message) =>
              message.type === "user" || message.type === "synthetic",
          )
        )
          return finish(bound, {
            code: "missing-output",
            message: "Session received another input before result collection",
          });
        const assistants = turn.filter(
          (message) => message.type === "assistant",
        );
        const tools = assistants
          .flatMap((message) => message.content)
          .filter((part) => part.type === "tool");
        const denied = tools.find(
          (part) =>
            part.state.status === "error" &&
            failure(part.state.error).code === "permission-denied",
        );
        if (denied && denied.state.status === "error")
          return finish(bound, failure(denied.state.error));
        const failedTool = tools.find(
          (part) =>
            part.state.status === "error" ||
            part.name === "invalid" ||
            (part.state.status === "completed" &&
              (part.state.metadata?.error === true ||
                (Array.isArray(part.state.metadata?.toolCalls) &&
                  part.state.metadata.toolCalls.some(
                    (call) =>
                      call &&
                      typeof call === "object" &&
                      "status" in call &&
                      call.status === "error",
                  )))),
        );
        if (failedTool)
          return finish(bound, {
            code: "sdk-error",
            message:
              failedTool.state.status === "error"
                ? failedTool.state.error.message
                : "OpenCode reported an invalid or failed tool call",
            cause: failedTool,
          });
        const idle = [...turn]
          .reverse()
          .find((message) => message.type === "idle");
        if (idle?.type === "idle" && idle.outcome !== "succeeded")
          return finish(
            bound,
            idle.error
              ? failure(idle.error)
              : {
                  code:
                    idle.outcome === "interrupted" ? "cancelled" : "sdk-error",
                  message: `OpenCode session ${idle.outcome}`,
                },
          );
        const assistant = assistants.at(-1);
        if (assistant?.error) return finish(bound, failure(assistant.error));
        const text = assistant?.content
          .filter((part) => part.type === "text")
          .map((part) => part.text)
          .join("\n")
          .trim();
        if (
          !assistant?.time.completed ||
          !text ||
          assistant.finish !== "stop" ||
          idle?.type !== "idle" ||
          idle.outcome !== "succeeded"
        )
          return finish(bound, {
            code: "missing-output",
            message: "No completed correlated assistant text response",
          });
        const result: JobResult = {
          ...bound,
          outcome: "completed",
          text,
          evidence: [assistant.id],
        };
        await store.recordResult(result);
        const current = (await store.getRun(job.runId))?.jobs[job.jobId];
        return current?.envelope.attempt === job.attempt && current.result
          ? current.result
          : { ...bound, outcome: "cancelled", evidence: [] };
      } catch (cause) {
        return finish(bound, failure(cause));
      }
    },
    async cancelJob(job) {
      const entry = (await store.getRun(job.runId))?.jobs[job.jobId];
      if (!entry || entry.envelope.attempt !== job.attempt)
        return {
          ok: false,
          error: { code: "sdk-error", message: "Unknown or stale job" },
        };
      if (entry.status === "terminal") return { ok: true };
      await store.recordResult({
        ...entry.envelope,
        outcome: "cancelled",
        evidence: [],
        error: { code: "cancelled", message: "Cancellation requested" },
      });
      return abortSession(entry.envelope);
    },
    async requestUserInput(_request) {
      return {
        ok: false,
        error: {
          code: "unsupported",
          message:
            "Ralph has no verified human approval/provenance channel yet. No assistant or API-created message is accepted as approval.",
        },
      };
    },
    async publishStatus(_sessionId, workspace, text) {
      try {
        await client.notify(workspace, text);
        return { ok: true };
      } catch (cause) {
        return { ok: false, error: failure(cause) };
      }
    },
    async receiveEvent(event) {
      if (event.type !== "permission.replied" || event.data.reply !== "reject")
        return;
      for (const run of await store.listRuns()) {
        for (const entry of Object.values(run.jobs)) {
          if (
            entry.status !== "terminal" &&
            entry.envelope.sessionId === event.data.sessionID
          )
            await finish(entry.envelope, {
              code: "permission-denied",
              message: "OpenCode permission rejected",
              cause: event.data,
            });
        }
      }
    },
  };
}

