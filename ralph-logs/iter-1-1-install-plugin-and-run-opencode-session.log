    async dispatchJob(job) {
      if ("'!(await store.recordIntent(job))) {
        const existing = (await store.getRun(job.runId))?.jobs[job.jobId];
        if (existing?.envelope.attempt === job.attempt && existing.result) return existing.result;
        return { ...job, outcome: '"'failed', error: { code: 'sdk-error', message: 'Duplicate or stale dispatch; no side effect performed' }, evidence: [] };
      }
      let bound = job;
      try {
        const created = await client.session.create({ query: { directory: job.workspace }, body: { title: "'`Ralph ${job.runId}/${job.jobId}/${job.attempt}` } });
        if (!created.data) return finish(bound, failure(created.error, created.response.status));
        bound = { ...job, sessionId: created.data.id };
        if (!(await store.attachSession(job, created.data.id))) return { ...bound, outcome: '"'cancelled', evidence: [] };
        const response = await client.session.prompt({ path: { id: created.data.id }, query: { directory: job.workspace }, body: { parts: [{ type: 'text', text: job.prompt }], ...(job.model ? { model: job.model } : {}) } });
        if ("'!response.data) return finish(bound, failure(response.error, response.response.status));
        const { info, parts } = response.data;
        const denied = parts.find(part => part.type === '"'tool' && part.state.status === 'error' && /permission|rejected|not allowed/i.test(part.state.error));
        if (denied && denied.type === 'tool' && denied.state.status === 'error') return finish(bound, { code: 'permission-denied', message: denied.state.error, cause: denied });
        if (info.error) return finish(bound, failure(info.error));
        const text = parts.filter(part => part.type === 'text').map(part => part.text).join('\\n').trim();
        if (info.role "'!== '"'assistant' || info.sessionID "'!== bound.sessionId || !info.time.completed || !text) return finish(bound, { code: '"'missing-output', message: 'No completed correlated assistant text response' });
        const result: JobResult = { ...bound, outcome: 'completed', text, evidence: [info.id] };
