test('a denied operation persists as denied and has no process fallback', async () => {
  const project = await createTestProject();
  try {
    const store = await openRunStore(project.directory);
    await store.createRun('r');
    const fake = createFakeOpenCode(); fake.deny();
    const result = await createOpenCodeAdapter(fake.client, store).dispatchJob({ runId: 'r', jobId: 'j', attempt: 1, role: 'executor', workspace: project.directory, inputRevisions: {}, baseCommit: project.commit, prompt: 'execute a command' });
    expect(result.outcome).toBe('denied');
    expect(result.error?.code).toBe('permission-denied');
    expect(fake.requests.map(r => r.path)).toEqual(['/session']);
    expect((await openRunStore(project.directory)).getRun('r')).resolves.toMatchObject({ phase: 'failed', lastResult: { outcome: 'denied' } });
  } finally { await project.cleanup(); }
});

test('duplicate permission events and late success cannot transition twice', async () => {
  const project = await createTestProject();
  try {
    const store = await openRunStore(project.directory); await store.createRun('r');
    const fake = createFakeOpenCode(); fake.hold();
    const adapter = createOpenCodeAdapter(fake.client, store);
    const pending = adapter.dispatchJob({ runId: 'r', jobId: 'j', attempt: 1, role: 'executor', workspace: project.directory, inputRevisions: {}, baseCommit: project.commit, prompt: 'hello' });
    while (fake.requests.length < 2) await Bun.sleep(10);
    await adapter.receiveEvent({ type: 'session.idle', properties: { sessionID: 'session-1' } });
    expect((await store.getRun('r'))?.phase).toBe('running');
    const event = { type: 'permission.replied' as const, properties: { sessionID: 'session-1', permissionID: 'p', response: 'reject' } };
    await adapter.receiveEvent(event); await adapter.receiveEvent(event);
    const before = await store.getRun('r');
    fake.release();
    expect((await pending).outcome).toBe('denied');
    expect(await store.getRun('r')).toEqual(before);
    expect((await store.events('r')).filter(e => e.type === 'job.result')).toHaveLength(1);
  } finally { await project.cleanup(); }
});

test('missing output is failed and user questions disclose unsupported API', async () => {
  const project = await createTestProject();
  try {
    const store = await openRunStore(project.directory); await store.createRun('r');
    const fake = createFakeOpenCode(); fake.empty();
    const adapter = createOpenCodeAdapter(fake.client, store);
    const result = await adapter.dispatchJob({ runId: 'r', jobId: 'j', attempt: 1, role: 'executor', workspace: project.directory, inputRevisions: {}, baseCommit: project.commit, prompt: 'hello' });
    expect(result.error?.code).toBe('missing-output');
    expect(await adapter.requestUserInput({ runId: 'r', requestId: 'q', revision: 1, sessionId: 'session-1', workspace: project.directory, question: 'approve?' })).toMatchObject({ ok: false, error: { code: 'unsupported' } });
  } finally { await project.cleanup(); }
});

test('linked worktrees share a canonical store but separate repositories do not', async () => {
  const project = await createTestProject(); const other = await createTestProject();
  try {
    const linked = "'`${project.directory}-linked`;
    await git('"'git', ['-C', project.directory, 'worktree', 'add', '-b', 'linked', linked]);
    try {
      const primary = await openRunStore(project.directory); await primary.createRun('shared');
      const secondary = await openRunStore(linked);
      expect(secondary.root).toBe(primary.root);
      expect((await secondary.getRun('shared'))?.runId).toBe('shared');
      const independent = await openRunStore(other.directory);
      expect(independent.root).not.toBe(primary.root);
