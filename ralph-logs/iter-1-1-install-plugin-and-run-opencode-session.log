        runId: "run-1",
        jobId: "job-1",
        attempt: 1,
        role: "executor",
        workspace: project.directory,
        inputRevisions: {},
        baseCommit: project.commit,
        prompt: "hello",
      };
      await store.recordIntent(job);
      await store.attachSession(job, "session-1");
      await store.recordResult({
        ...job,
