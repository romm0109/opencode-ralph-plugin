      async () =>
        (await f.store.getRun(f.runId))?.issueAttempts?.E?.status ===
        "submitted",
    ).catch((cause) => diagnostic(f, cause));
    expect(
      f.jobs.filter((j) => j.role === "merger").map((j) => j.issueId),
    ).toEqual(["A"]);
    await until(async () =>
      JSON.parse(
        await f.router.status(f.runId),
      ).execution.integrationQueue.includes("E"),
    );
