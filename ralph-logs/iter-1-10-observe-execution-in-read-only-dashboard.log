export type CheckStatus =
  | "waiting"
  | "running"
  | "failed"
  | "skipped"
  | "passed";
/** Evidence supplied by execution; the dashboard never computes scheduler policy. */
export interface ExecutionEvidence {
  /** Execution must attest that the required validation set is complete. */
  verification?: "incomplete" | "failed" | "passed";
  issues: {
    id: string;
    title: string;
    dependencies: string[];
    status:
      | "pending"
      | "ready"
      | "running"
      | "integration_queued"
      | "integrated"
      | "blocked"
      | "failed";
    blockers: string[];
  }[];
  integrationQueue: string[];
  checks: {
    id: string;
    status: CheckStatus;
    reason?: string;
    attempt: number;
    candidateCommit: string;
    commandRevision: number;
  }[];
}
export interface JobEnvelope {
  runId: string;
  jobId: string;
  attempt: number;
  role: string;
  issueId?: string;
  sessionId?: string;
  workspace: string;
  inputRevisions: Record<string, number>;
  baseCommit: string;
  prompt: string;
  model?: { providerID: string; modelID: string };
}
export interface Failure {
  code:
    | "permission-denied"
    | "sdk-error"
    | "missing-output"
    | "unsupported"
    | "cancelled";
  message: string;
  cause?: unknown;
}
export interface JobResult extends JobEnvelope {
  outcome: "completed" | "failed" | "denied" | "cancelled";
  text?: string;
  evidence: string[];
  producedCommit?: string;
  error?: Failure;
}
export interface RunOperation {
  operationId: string;
  kind: "session.abort";
  job: JobEnvelope;
  status: "intent" | "completed" | "failed";
  error?: Failure;
}
export interface RunRecord {
  schemaVersion: 1;
  runId: string;
  repositoryId: string;
  revision: number;
  phase: "ready" | "running" | "completed" | "failed" | "cancelled";
  jobs: Record<
    string,
    {
      envelope: JobEnvelope;
      status: "intent" | "running" | "terminal";
      result?: JobResult;
    }
  >;
  execution?: ExecutionEvidence;
  lastResult?: JobResult;
  errors: Failure[];
  operations: Record<string, RunOperation>;
}
