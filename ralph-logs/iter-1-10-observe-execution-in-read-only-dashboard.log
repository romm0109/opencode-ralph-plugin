import type { DashboardEvent, LogPage, RunSnapshot } from "../projections.js";
export type RunSummary = Pick<RunSnapshot, "runId" | "phase" | "revision">;
export function createDashboardApi(token: string) {
  const headers = { Authorization: `Bearer ${token}` };
  async function get<T>(path: string, signal?: AbortSignal): Promise<T> {
    const response = await fetch(path, {
      headers,
      ...(signal ? { signal } : {}),
    });
    if (!response.ok)
      throw new Error(`Dashboard read failed (${response.status})`);
    return response.json() as Promise<T>;
  }
  return {
    runs: () => get<RunSummary[]>("/api/runs"),
    snapshot: (runId: string) =>
      get<RunSnapshot>(`/api/runs/${encodeURIComponent(runId)}`),
    log: (runId: string, logId: string, offset: number) =>
      get<LogPage>(
        `/api/runs/${encodeURIComponent(runId)}/logs/${encodeURIComponent(logId)}?offset=${offset}`,
      ),
    async subscribe(
      runId: string,
      after: number,
      signal: AbortSignal,
      receive: (snapshot: RunSnapshot) => void,
    ) {
      const response = await fetch(
        `/api/runs/${encodeURIComponent(runId)}/events?after=${after}`,
        { headers, signal },
      );
      if (!response.ok || !response.body)
        throw new Error(`Event stream failed (${response.status})`);
      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      let sequence = after;
      try {
        for (;;) {
          const { done, value } = await reader.read();
          if (done) throw new Error("Stream disconnected");
          buffer += decoder.decode(value, { stream: true });
          while (buffer.includes("\n\n")) {
            const boundary = buffer.indexOf("\n\n");
            const frame = buffer.slice(0, boundary);
            buffer = buffer.slice(boundary + 2);
            const lines = frame.split("\n");
            const kind = lines.find((l) => l.startsWith("event: "))?.slice(7);
            const data = lines
              .filter((l) => l.startsWith("data: "))
              .map((l) => l.slice(6))
              .join("\n");
            if (!data) continue;
            const parsed = JSON.parse(data) as RunSnapshot | DashboardEvent;
            const snapshot =
              kind === "snapshot"
                ? (parsed as RunSnapshot)
                : (parsed as DashboardEvent).snapshot;
            if (kind === "snapshot" || snapshot.sequence > sequence) {
              sequence = snapshot.sequence;
              receive(snapshot);
            }
          }
          if (buffer.length > 4 * 1024 * 1024)
            throw new Error("Event frame too large");
        }
      } finally {
        await reader.cancel().catch(() => {});
        reader.releaseLock();
      }
    },
  };
}
export type DashboardApi = ReturnType<typeof createDashboardApi>;
import { expect, test } from "@playwright/test";
import { createCommandRouter } from "../../src/commands/router.js";
import { startDashboard } from "../../src/dashboard/server.js";
import { createOpenCodeAdapter } from "../../src/opencode/adapter.js";
import { openRunStore } from "../../src/state/run-store.js";
import { createFakeOpenCode } from "../helpers/fake-opencode.js";
import { createTestProject } from "../helpers/project.js";

test("observes two live agents, blocked descendants, skipped validation and reconnect without workflow controls", async ({
  page,
  context,
}) => {
  const project = await createTestProject();
  const store = await openRunStore(project.directory);
  const dashboard = await startDashboard(store, { pollIntervalMs: 50 });
  const fake = createFakeOpenCode();
  fake.hold();
  const router = createCommandRouter(
    store,
    createOpenCodeAdapter(fake.client, store),
    dashboard.url,
  );
  const pending = ["B", "C"].map((id) =>
    router.runJob({
      runId: "diamond",
      jobId: id,
      issueId: id,
      attempt: 1,
      role: "executor",
      workspace: project.directory,
      inputRevisions: { graph: 1 },
      baseCommit: project.commit,
      prompt: "fixture",
    }),
  );
  try {
    await expect.poll(() => fake.requests.length).toBe(4);
    const execution = {
      issues: [
        {
          id: "A",
          title: "Root",
          dependencies: [],
          status: "integrated" as const,
          blockers: [],
        },
        {
          id: "B",
          title: "Left",
          dependencies: ["A"],
          status: "running" as const,
          blockers: [],
        },
        {
          id: "C",
          title: "Right",
          dependencies: ["A"],
          status: "running" as const,
          blockers: [],
        },
        {
          id: "D",
          title: "Join",
          dependencies: ["B", "C"],
          status: "blocked" as const,
          blockers: ["B", "C"],
        },
      ],
      integrationQueue: [],
      checks: [
        {
          id: "unit-tests",
          status: "skipped" as const,
          reason: "timeout",
          attempt: 1,
          candidateCommit: project.commit,
          commandRevision: 1,
        },
      ],
    };
    await store.recordExecution(
      "diamond",
      (await store.getRun("diamond"))?.revision ?? 0,
      execution,
    );
    const status = JSON.parse(await router.status("diamond"));
    await page.goto(status.dashboardUrl);
    // Fragment is removed after bootstrap; request URLs never contain the token.
    await expect(page).toHaveURL(`${new URL(dashboard.url).origin}/`);
    await expect(page.getByRole("status")).toContainText("connected");
    const graph = page.getByRole("region", { name: "Dependency graph" });
    await expect(graph.getByText("running", { exact: true })).toHaveCount(2);
    await expect(graph.getByText("Blocked by: B, C")).toBeVisible();
    await expect(page.getByText("skipped", { exact: true })).toBeVisible();
    await expect(page.getByText("incomplete", { exact: true })).toBeVisible();
    await expect(
      page.getByRole("button", {
        name: /approve|answer|pause|retry|stop|resume/i,
      }),
    ).toHaveCount(0);
    await context.setOffline(true);
    await expect(page.getByRole("status")).toContainText("reconnecting");
    fake.release();
    await Promise.all(pending);
    await store.recordExecution(
      "diamond",
      (await store.getRun("diamond"))?.revision ?? 0,
      {
        ...execution,
        integrationQueue: ["B", "C"],
        issues: execution.issues.map((i) =>
          i.id === "B" || i.id === "C"
            ? { ...i, status: "integration_queued" as const }
            : i,
        ),
      },
    );
    await context.setOffline(false);
    await expect(page.getByRole("status")).toContainText("connected");
    await expect(
      graph.getByText("integration queued", { exact: true }),
    ).toHaveCount(2);
    await expect(graph.getByText("Blocked by: B, C")).toBeVisible();
    await page.getByRole("button", { name: "View log B", exact: true }).click();
    await expect(page.getByRole("region", { name: "Logs" })).toContainText(
      "actual response",
    );
    await expect(page.getByText("skipped", { exact: true })).toBeVisible();
    await expect(
      page.getByRole("button", {
        name: /approve|answer|pause|retry|stop|resume/i,
      }),
    ).toHaveCount(0);
  } finally {
    fake.release();
    await Promise.allSettled(pending);
    await dashboard.stop();
    await project.cleanup();
  }
});

