    ).toContain("id: 2\nevent: snapshot");
    fallback.abort();
    expect(
      (await openRunStore(project.directory)).getRun("diamond"),
    ).resolves.toMatchObject({ execution });
  } finally {
    await dashboard.stop();
    await project.cleanup();
  }
});

