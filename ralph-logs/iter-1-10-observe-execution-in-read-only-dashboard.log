export function projectRunSnapshot(
  run: RunRecord,
  sequence = 0,
  secrets: readonly string[] = [],
): RunSnapshot {
  const execution = run.execution;
  const checks = execution?.checks ?? [];
  const safe = (s: string) =>
    sanitizeDisplay(s, secrets).slice(0, MAX_LOG_CHARS);
  const report = run.reviewWorkflow?.report;
  return {
    schemaVersion: 1,
    runId: run.runId,
    phase: run.phase,
    ...(run.control
      ? {
          control: {
            status: run.control.status,
            facts: (run.control.facts ?? []).map(safe),
          },
        }
      : {}),
    revision: run.revision,
    sequence,
    verification: report
      ? report.outcome === "verified"
        ? "passed"
        : report.outcome === "unresolved"
          ? "failed"
          : "incomplete"
      : !checks.length
        ? "unavailable"
        : execution?.verification === "failed" ||
            checks.some((c) => c.status === "failed")
          ? "failed"
          : execution?.verification === "passed" &&
              checks.every((c) => c.status === "passed")
            ? "passed"
            : "incomplete",
    completion: report
      ? {
          outcome: report.outcome,
          branch: safe(report.branch),
          commit: report.commit,
          repairCount: report.repairCount,
          completedIssues: report.completedIssues.map(safe),
          blockedIssues: report.blockedIssues.map(safe),
          repairedIssues: report.repairedIssues.map(safe),
          attempts: report.attempts.map((a) => ({
            issueId: safe(a.issueId),
            used: a.used,
          })),
          evidenceRefs: report.evidenceRefs.map(safe),
          skippedChecks: report.skippedChecks.map(
            (c) => `${safe(c.id)}: ${safe(c.reason ?? "missing validation")}`,
          ),
          unavailableReview: report.unavailableReview.map(safe),
          retainedResourceCount: report.retainedResources.length,
          cleanupFailures: report.cleanupFailures.map(safe),
        }
      : null,
    reviewRounds: (run.reviewWorkflow?.rounds ?? []).map((r) => ({
      round: r.snapshot.round,
      commit: r.snapshot.commit,
      code: r.code?.outcome ?? "waiting",
      functional: r.functional?.outcome ?? "waiting",
      findings: [
        ...(r.code?.findings ?? []),
        ...(r.functional?.findings ?? []),
      ].map((f) => ({
        id: safe(f.id),
        role: f.reviewerRole,
        criterion: safe(f.criterion),
        blocking: f.blocking,
        disposition: r.disputes.some(
          (d) =>
            d.finding.id === f.id &&
            d.finding.reviewerRole === f.reviewerRole &&
            d.disposition === "withdrawn",
        )
          ? "withdrawn"
          : f.disposition,
        evidence: f.evidence.map(safe),
      })),
      criteria:
        r.functional?.criteria.map((c) => ({
          id: safe(c.id),
          criterion: safe(c.criterion),
          status: c.status,
          evidenceRefs: c.evidenceRefs.map(safe),
          reason: safe(c.reason ?? ""),
        })) ?? [],
      infrastructureAttempts: r.functional?.attempts.length ?? 0,
      repairs: r.repairs.map((t) => ({
        id: t.id,
        status: t.status,
        attempts: t.attempts.length,
      })),
    })),
    executionAvailable: !!execution,
    issues:
      execution?.issues.map((i) => ({
        id: i.id,
        title: safe(i.title),
        dependencies: [...i.dependencies],
        status: i.status,
        blockers: [...i.blockers],
      })) ?? [],
    integrationQueue: [...(execution?.integrationQueue ?? [])],
    checks: checks.map((c) => ({
      id: c.id,
      status: c.status,
      attempt: c.attempt,
      candidateCommit: c.candidateCommit,
      commandRevision: c.commandRevision,
      ...(c.reason !== undefined ? { reason: safe(c.reason) } : {}),
    })),
    agents: Object.values(run.jobs).map(({ envelope: j, status, result }) => ({
      jobId: j.jobId,
      issueId: j.issueId ?? null,
      role: safe(j.role),
      attempt: j.attempt,
      sessionId: j.sessionId ?? null,
      baseCommit: j.baseCommit,
      inputRevisions: { ...j.inputRevisions },
      status: result?.outcome ?? (status === "intent" ? "waiting" : status),
      logId: result?.text !== undefined ? logId(j.jobId, j.attempt) : null,
      evidence: result?.evidence.map(safe) ?? [],
      error: result?.error
        ? { code: result.error.code, message: safe(result.error.message) }
        : null,
    })),
    errors: run.errors.map((e) => ({ code: e.code, message: safe(e.message) })),
  };
}
import { runIssue } from "../core/orchestrator.js";
import type { RunRecord } from "../core/types.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import type { AttemptOptions } from "./attempts.js";
import { integrationQueue } from "./integration-queue.js";
import { reconcileReadiness } from "./readiness.js";

export { reconcileReadiness } from "./readiness.js";

const active = new Map<string, Promise<RunRecord | undefined>>();
export function scheduleReadyIssues(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  options: AttemptOptions = {},
) {
  const key = `${store.repositoryId}:${runId}`;
  const existing = active.get(key);
  if (existing) return existing;
  const promise = schedule(store, adapter, runId, options).finally(() => {
    active.delete(key);
  });
  active.set(key, promise);
  return promise;
}
async function schedule(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  options: AttemptOptions,
) {
  const initial = await store.getRun(runId);
  const concurrency = initial?.planning?.settings.concurrency ?? 2;
  if (!Number.isInteger(concurrency) || concurrency <= 0)
    throw new Error("Executor concurrency must be a positive integer");
  if (
    !initial?.baseline ||
    !["passed", "passed_with_omissions"].includes(initial.baseline.status) ||
    initial.planning?.phase !== "execution_approved"
  )
    throw new Error("Validated baseline and approved graph required");
  const epoch = initial.control?.epoch ?? 0;
  const queue = integrationQueue(store, runId);
  const workers = new Map<string, Promise<void>>();
  let fatal: unknown;
  let projection: Promise<unknown> = Promise.resolve();
  const publish = () => {
    const update = projection.then(async () => {
      for (;;) {
        const run = await store.getRun(runId);
        if (
          !run ||
          run.planning?.phase !== "execution_approved" ||
          (run.control && run.control.status !== "active") ||
          (run.control?.epoch ?? 0) !== epoch ||
          run.planning?.graph?.hash !== initial.planning?.graph?.hash
        )
          return;
        const evidence = reconcileReadiness(run, queue.positions);
        if (JSON.stringify(run.execution) === JSON.stringify(evidence)) return;
        if (await store.recordExecution(runId, run.revision, evidence)) return;
      }
    });
    projection = update.catch(() => {});
    return update;
  };
  queue.listeners.add(publish);
  try {
    for (;;) {
      await publish();
      const run = await store.getRun(runId);
      if (
        !run ||
        run.planning?.phase !== "execution_approved" ||
        (run.control && run.control.status !== "active") ||
        (run.control?.epoch ?? 0) !== epoch ||
        run.planning?.graph?.hash !== initial.planning?.graph?.hash
      )
        break;
      const ready = reconcileReadiness(run, queue.positions).issues.filter(
        (i) =>
          i.status === "ready" ||
          (i.status === "integration_queued" &&
            run.issueAttempts?.[i.id]?.status === "submitted" &&
            !workers.has(i.id)),
      );
      for (const issue of ready) {
        if (workers.has(issue.id)) continue;
        const worker = runIssue(store, adapter, runId, issue.id, options)
          .then(() => {})
          .catch((cause: unknown) => {
            fatal ??= cause;
          })
          .finally(async () => {
            workers.delete(issue.id);
            await publish();
          });
        workers.set(issue.id, worker);
      }
      if (fatal || !workers.size) break;
      await Promise.race(workers.values());
    }
    await Promise.all(workers.values());
    await publish();
    const latest = await store.getRun(runId);
    if (
      fatal &&
      latest?.planning?.graph?.hash === initial.planning?.graph?.hash &&
      latest?.planning?.phase === "execution_approved" &&
      (!latest?.control || latest.control.status === "active")
    )
      throw fatal;
    return latest;
  } finally {
    queue.listeners.delete(publish);
  }
}

