test(\"public status provides a working dashboard URL and plugin disposal closes it\", async () => {
  const { RalphPlugin } = await import(\"../../src/plugin.js\");
  const { createFakeOpenCode } = await import(\"../helpers/fake-opencode.js\");
  const project = await createTestProject();
  const hooks = await RalphPlugin({ client: createFakeOpenCode().client, directory: project.directory } as Parameters<typeof RalphPlugin>[0]);
  try {
    const store = await openRunStore(project.directory);
    await store.createRun(\"public\");
    const tool = hooks.tool?.ralph_status;
    const output = await tool?.execute({ runId: \"public\" }, {} as Parameters<NonNullable<typeof tool>[\"execute\"]>[1]);
    const url = new URL(JSON.parse(output ?? \"{}\").dashboardUrl);
    expect(url.hostname).toBe(\"127.0.0.1\");
    expect((await fetch("'`${url.origin}/api/runs/public`, { headers: { Authorization: `Bearer ${url.hash.slice(1)}` } })).status).toBe(200);
    await hooks.dispose?.();
    await expect(fetch(url.origin)).rejects.toThrow();
  } finally {
    await hooks.dispose?.();
    await project.cleanup();
  }
});

test("logs are known IDs, paged and bounded, sanitized on write and display", async () => {
  const project = await createTestProject();
  const store = await openRunStore(project.directory);
  await store.createRun("r");
  const job = { runId: "r", jobId: "j", attempt: 1, role: "executor", workspace: project.directory, inputRevisions: {}, baseCommit: project.commit, prompt: "never expose this prompt" };
  await store.recordIntent(job);
  await store.attachSession(job, "s");
  await store.recordResult({ ...job, sessionId: "s", outcome: "completed", evidence: [], text: `password=[REDACTED_SECRET] Bearer fixture-token'"\\u001b[31m\\n"'${"X".repeat(100000)}` });
  const dashboard = await startDashboard(store);
  const base = new URL(dashboard.url).origin;
  const headers = { Authorization: `Bearer ${new URL(dashboard.url).hash.slice(1)}` };
  try {
    expect((await store.getRun("r"))?.lastResult?.text).not.toContain("fixture-secret");
    const response = await fetch(`${base}/api/runs/r/logs/j--1?limit=999999`, { headers });
    const log = await response.json();
    expect(log.content.length).toBeLessThanOrEqual(4096);
    expect(log).toMatchObject({ total: 65536, truncated: true, nextOffset: 4096 });
    expect(log.content).not.toContain("fixture-token");
    expect(log.content).not.toContain("'"\\u001b\");
    const second = await (await fetch("'`${base}/api/runs/r/logs/j--1?offset=4096`, { headers })).json();
    expect(second.offset).toBe(4096);
    for (const id of ["unknown", "%2e%2e%2f%2e%2e%2fconfig", "%2fetc%2fpasswd"]) expect((await fetch(`${base}/api/runs/r/logs/${id}`, { headers })).status).toBe(404);
    expect((await fetch(`${base}/api/runs/r/logs/j--1?offset=-1`, { headers })).status).toBe(400);
    expect(await (await fetch(`${base}/api/runs/r`, { headers })).text()).not.toContain("never expose this prompt");
  } finally { await dashboard.stop(); await project.cleanup(); }
});
