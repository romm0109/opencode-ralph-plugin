import type { RunEvent, RunRecord } from \"../core/types.js\";

export type CheckStatus = \"waiting\" | \"running\" | \"failed\" | \"skipped\" | \"passed\";
/** Evidence supplied by execution; the dashboard never computes scheduler policy. */
export interface ExecutionEvidence {
  issues: {
    id: string;
    title: string;
    dependencies: string[];
    status: \"pending\" | \"ready\" | \"running\" | \"integration_queued\" | \"integrated\" | \"blocked\" | \"failed\";
    blockers: string[];
  }[];
  integrationQueue: string[];
  checks: {
    id: string;
    status: CheckStatus;
    reason?: string;
    attempt: number;
    candidateCommit: string;
    commandRevision: number;
  }[];
}
export interface RunSnapshot {
  schemaVersion: 1;
  runId: string;
  phase: string;
  revision: number;
  sequence: number;
  verification: \"unavailable\" | \"incomplete\" | \"failed\" | \"passed\";
  executionAvailable: boolean;
  issues: ExecutionEvidence[\"issues\"];
  integrationQueue: string[];
  checks: ExecutionEvidence[\"checks\"];
  agents: {
    jobId: string;
    issueId: string | null;
    role: string;
    attempt: number;
    sessionId: string | null;
    baseCommit: string;
    inputRevisions: Record<string, number>;
    status: string;
    logId: string | null;
    evidence: string[];
    error: { code: string; message: string } | null;
  }[];
  errors: { code: string; message: string }[];
}
export interface DashboardEvent {
  sequence: number;
  type: RunEvent[\"type\"];
  timestamp: string;
  snapshot: RunSnapshot;
}
export interface LogPage {
  logId: string;
  offset: number;
  nextOffset: number | null;
  total: number;
  truncated: boolean;
  content: string;
}
export const MAX_LOG_CHARS = 64 * 1024;
export const MAX_PAGE_CHARS = 4096;
/** Never send prompts, environment, paths or raw SDK causes to the browser. */
export function sanitizeDisplay(value: string, secrets: readonly string[] = []): string {
  let clean = value.replace(/\\x1b\\[[0-?]*[ -/]*[@-~]/g, \"\").replace(/[\\x00-\\x08\\x0b-\\x1f\\x7f]/g, \"\");
  for (const secret of secrets) if (secret) clean = clean.split(secret).join(\"[REDACTED]\");
  return clean
    .replace(/\\b(Bearer\\s+)[\\w.+/=-]+/gi, \""'$1[REDACTED]")
    .replace(/'"\\b((?:api[_-]?key|access[_-]?token|password|secret)\\s*[=:]\\s*)["'^'"\\s,;]+/gi, \""'$1[REDACTED]")
    .replace(/'"\\bsk-[A-Za-z0-9_-]{12,}/g, \"[REDACTED]\");
}
export function logId(jobId: string, attempt: number): string {
  return "'`${jobId}--${attempt}`;
}
export function projectRunSnapshot(run: RunRecord, sequence = 0, secrets: readonly string[] = []): RunSnapshot {
  const execution = run.execution;
  const checks = execution?.checks ?? [];
  const safe = (s: string) => sanitizeDisplay(s, secrets).slice(0, MAX_LOG_CHARS);
  return {
    schemaVersion: 1, runId: run.runId, phase: run.phase, revision: run.revision, sequence,
    verification: !checks.length ? "unavailable" : checks.some(c => c.status === "failed") ? "failed" : checks.every(c => c.status === "passed") ? "passed" : "incomplete",
    executionAvailable: !!execution,
    issues: execution?.issues.map(i => ({ ...i, title: safe(i.title) })) ?? [],
    integrationQueue: execution?.integrationQueue ?? [],
    checks: checks.map(c => ({ ...c, ...(c.reason !== undefined ? { reason: safe(c.reason) } : {}) })),
    agents: Object.values(run.jobs).map(({ envelope: j, status, result }) => ({
      jobId: j.jobId, issueId: j.issueId ?? null, role: safe(j.role), attempt: j.attempt,
      sessionId: j.sessionId ?? null, baseCommit: j.baseCommit, inputRevisions: j.inputRevisions,
      status: result?.outcome ?? (status === "intent" ? "waiting" : status),
      logId: result?.text !== undefined ? logId(j.jobId, j.attempt) : null,
      evidence: result?.evidence.map(safe) ?? [],
      error: result?.error ? { code: result.error.code, message: safe(result.error.message) } : null,
    })),
    errors: run.errors.map(e => ({ code: e.code, message: safe(e.message) })),
  };
}
