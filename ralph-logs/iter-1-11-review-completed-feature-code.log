      await store.recordIntent(job);
      await store.attachSession(job, "session-1");
      await store.recordResult({
        ...job,
        sessionId: "session-1",
        outcome: "completed",
        text: "actual response",
        evidence: ["message-1"],
      });
      const before = await createCommandRouter(store).status("run-1");
