import { execFile } from \"node:child_process\";
import { promisify } from \"node:util\";
const exec = promisify(execFile);
export async function readReviewGit(directory: string, args: string[]): Promise<string> {
  return (await exec(\"git\", [\"-C\", directory, ...args], { maxBuffer: 16 * 1024 * 1024 })).stdout;
}
export async function resolveReviewCommit(directory: string, commit: string): Promise<string> {
  if ("'!/''^[a-f0-9]{40}$|''^[a-f0-9]{64}$/.test(commit)) throw new Error("Review requires an exact commit SHA");
  return (await readReviewGit(directory, ["rev-parse", "--verify", `${commit}''^{commit}`])).trim();
}
export async function pinReviewCommit(directory: string, ref: string, commit: string) {
  await readReviewGit(directory, ["update-ref", ref, commit]);
}
export async function createReviewWorkspace(directory: string, workspace: string, commit: string) {
  await readReviewGit(directory, ["worktree", "add", "--detach", workspace, commit]);
}
export async function verifyReviewWorkspace(workspace: string, commit: string) {
  const head = (await readReviewGit(workspace, ["rev-parse", "HEAD"])).trim();
  const status = await readReviewGit(workspace, ["status", "--porcelain", "--untracked-files=all", "--ignored"]);
  if (head !== commit || status.trim()) throw new Error("Reviewer workspace changed from the frozen commit");
}
