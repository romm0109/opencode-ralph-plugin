diff --git a/src/review/after-execution.ts b/src/review/after-execution.ts
new file mode 100644
index 0000000000000000000000000000000000000000..56dd56fcf9f10172f8fd9cff8456977e58b51af3
--- /dev/null
+++ b/src/review/after-execution.ts
@@ -0,0 +1,31 @@
+import type { OpenCodeAdapter } from "../opencode/adapter.js";
+import type { RunStore } from "../state/run-store.js";
+import { readReviewGit } from "../git/review-workspace.js";
+import { runCodeReview } from "./code-review.js";
+import { createReviewSnapshot } from "./snapshot.js";
+
+/** Scheduler handoff only; functional review and repair coordination have separate owners. */
+export async function reviewIntegratedExecution(store: RunStore, adapter: OpenCodeAdapter, runId: string) {
+  const run = await store.getRun(runId);
+  if (!run || (run.control && run.control.status !== "active") ||
+    !run.execution?.issues.length || run.execution.issues.some((i) => i.status !== "integrated")) return run;
+  if (run.review) return run;
+  const planning = run.planning;
+  if (!planning?.graph || !planning.prd || !run.baseline?.workspace)
+    throw new Error("Missing approved execution review inputs");
+  const directory = run.baseline.workspace;
+  const commit = (await readReviewGit(directory, ["rev-parse", "HEAD"])).trim();
+  const snapshot = await createReviewSnapshot({
+    store, directory, runId, round: 1, commit,
+    baseCommit: run.baseline.candidateCommit,
+    prdRevision: planning.prd.hash,
+    graph: { revision: planning.graph.hash, issues: planning.graph.value.issues },
+    evidenceRefs: Object.values(run.issueAttempts ?? {}).map((attempt) => `integration:${attempt.issueId}:${attempt.attempt}:${attempt.integratedCommit}`),
+    approvedPlanning: true,
+  });
+  await runCodeReview(snapshot, { store, adapter, directory,
+    parentSessionId: planning.sessionId,
+    ...(planning.settings.models["code-review"] ? { model: planning.settings.models["code-review"] } : {}),
+  });
+  return store.getRun(runId);
+}
