/** Human provenance and the persisted request are the only approval authority. */
export async function handleInterviewResponse(
  store: RunStore,
  runId: string,
  response: UserInputResult,
): Promise<boolean> {
  const run = await store.getRun(runId);
  const state = run?.planning;
  const pending = state?.pending;
  if (
    !run ||
    !state ||
    !pending ||
    !response.ok ||
    response.source !== "user" ||
    !response.messageId ||
    !response.text.trim() ||
    response.requestId !== pending.requestId ||
    response.revision !== pending.revision ||
    response.sessionId !== pending.sessionId ||
    state.transcript.some((entry) => entry.messageId === response.messageId)
  )
    return false;
  const next = structuredClone(state);
  delete next.pending;
  delete next.error;
  next.transcript.push({
    source: "user",
    text: response.text,
    messageId: response.messageId,
    requestId: response.requestId,
    revision: response.revision,
  });
  if (state.phase === "explanation_approval") {
    const explanation = state.explanation;
    if (!explanation || explanation.revision !== response.revision)
      return false;
    if (response.text.trim() === `approve ${explanation.revision}`) {
      next.phase = "explanation_approved";
      next.approval = {
        revision: explanation.revision,
        hash: explanation.hash,
        messageId: response.messageId,
        requestId: response.requestId,
      };
    } else {
      next.phase = "interview";
      delete next.approval;
    }
      parentSessionId: options.parentSessionId,
    };
  };
  for (let number = workflow.rounds.length; number <= 3; number++) {
    await waitForDispatch(options.store, options.runId);
    const round = workflow.rounds.at(-1);
    if (!round) throw new Error("Missing round");
    const frozen = round.snapshot;
    const infrastructureUsed = workflow.rounds
      .slice(0, -1)
      .flatMap((r) => r.functional?.attempts ?? [])
      .filter(
        (a) =>
          a.blocker?.code === "unsupported" ||
          a.blocker?.code === "sdk-error" ||
          a.blocker?.code === "missing-output" ||
          a.blocker?.code === "permission-denied",
      ).length;
    const infrastructureRemaining = Math.max(0, 3 - infrastructureUsed);
    const results = await Promise.allSettled([
      Promise.resolve().then(() =>
        round.code
          ? round.code
          : options.reviewers
            ? options.reviewers.code(frozen)
            : runCodeReview(frozen, common()),
      ),
      Promise.resolve().then(() => {
        if (round.functional) return round.functional;
        if (!infrastructureRemaining)
          return {
            ...missing(
              frozen,
              "functional-review",
              "Functional infrastructure budget exhausted after three attempts",
            ),
            role: "functional-review" as const,
            criteria: [],
            evidence: [],
            attempts: [],
          };

