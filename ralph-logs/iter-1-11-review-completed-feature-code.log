  if (
    !run?.execution ||
    !ids.length ||
    new Set(ids).size !== ids.length ||
    ids.some(
      (id) =>
        run.execution?.issues.filter(
          (issue) => issue.id === id && issue.status === "integrated",
        ).length !== 1,
    ) ||
    run.execution.issues.some(
      (issue) => issue.status !== "integrated" || !ids.includes(issue.id),
    ) ||
    run.execution.integrationQueue.length ||
    Object.values(run.jobs).some(
      (job) =>
        job.status !== "terminal" &&
        !["code-review", "functional-review"].includes(job.envelope.role),
    )
  ) {
    throw new Error("All planned issues must be integrated before review");
  }
  if (
    !Number.isInteger(options.round) ||
    options.round < 1 ||
    options.round > 3 ||
    !options.prdRevision.trim() ||
    !options.graph.revision.trim() ||
    !options.evidenceRefs.length ||
    options.evidenceRefs.some((ref) => !ref.trim())
  )
    throw new Error("Invalid review revisions, round or evidence");
  const commit = await resolveReviewCommit(options.directory, options.commit);
  const baseCommit = await resolveReviewCommit(
    options.directory,
    options.baseCommit,
  );
  await readReviewGit(options.directory, [
    "merge-base",
    "--is-ancestor",
    baseCommit,
    commit,
  ]);
  const snapshot: ReviewSnapshot = {
    runId: options.runId,
    round: options.round,
    commit,
    prdRevision: options.prdRevision,
    graphRevision: options.graph.revision,
    evidenceRefs: [...options.evidenceRefs],
  };
  if (run.review) {
    if (
      !run.review.superseded &&
      JSON.stringify(run.review.snapshot) === JSON.stringify(snapshot)
    )
      return run.review.snapshot;
    if (run.review.snapshot.round >= options.round)
      throw new Error("Superseded or conflicting review round");
  }
  const prd = await readReviewGit(options.directory, [
    "show",
    `${commit}:${options.prdPath ?? "PRD.md"}`,
  ]);
  const graph = await readReviewGit(options.directory, [
    "show",
    `${commit}:${options.graphPath ?? "graph.json"}`,
  ]);
  const committedGraph = JSON.parse(graph);
  if (
    JSON.stringify(committedGraph) !== JSON.stringify(options.graph) ||
    !prd.trim()
  )
    throw new Error("Committed requirements do not match the approved graph");
  const diff = await readReviewGit(options.directory, [
    "diff",
    "--no-ext-diff",
    "--no-textconv",
    baseCommit,
    commit,
    "--",
  ]);
  if (
    !(await options.store.recordReviewSnapshot(options.runId, run.revision, {
      snapshot,
      inputs: {
        baseCommit,
        prd,
        graph,
        diff,
        tests: run.execution.checks,
        execution: run.execution,
      },
    }))
  )
    throw new Error("Execution changed while creating review snapshot");
  const operation = {
    operationId: `review-pin-${options.round}`,
    kind: "review.pin" as const,
    status: "intent" as const,
    job: {
      runId: options.runId,
      jobId: `review-pin-${options.round}`,
      attempt: 1,
      role: "review-snapshot",
      workspace: options.directory,
      inputRevisions: { round: options.round },
      baseCommit: commit,
      prompt: "Pin review commit",
    },
  };
  await options.store.recordOperation(operation);
  try {
    await pinReviewCommit(
      options.directory,
      `refs/ralph/reviews/${options.runId}/${options.round}`,
      commit,
    );
    await options.store.recordOperation({ ...operation, status: "completed" });
  } catch (cause) {
    await options.store.recordOperation({
      ...operation,
      status: "failed",
      error: {
        code: "sdk-error",
        message: "Cannot pin review commit",
        cause: String(cause),
      },
    });
    throw cause;
  }
  return snapshot;
}
import type { ReviewFinding, ReviewResult, ReviewSnapshot } from "./types.js";

const categories = [
  "correctness",
  "security",
  "acceptance",
  "regression",
  "style",
  "refactor",
];
function object(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}
function text(value: unknown): value is string {
  return typeof value === "string" && value.trim().length > 0;
}
function refs(value: unknown): value is string[] {
  return Array.isArray(value) && value.length > 0 && value.every(text);
}
/** Prose is never a verdict. Agent-controlled identity and dispositions are checked. */
export function validateReviewResult(
  raw: string,
  snapshot: ReviewSnapshot,
): ReviewResult {
  const value: unknown = JSON.parse(raw);
  if (
    !object(value) ||
    value.role !== "code-review" ||
    value.reviewedCommit !== snapshot.commit ||
    value.round !== snapshot.round ||
    !["passed", "findings", "unverified"].includes(String(value.outcome)) ||
    !Array.isArray(value.findings) ||
    !refs(value.evidenceRefs)
  ) {
    throw new Error(
      "Malformed review result, wrong commit/round, or missing evidence",
    );
  }
  const ids = new Set<string>();
  const findings: ReviewFinding[] = value.findings.map((finding: unknown) => {
    if (
      !object(finding) ||
      !text(finding.id) ||
      ids.has(finding.id) ||
      finding.reviewerRole !== "code-review" ||
      finding.reviewedCommit !== snapshot.commit ||
      !categories.includes(String(finding.category)) ||
      typeof finding.blocking !== "boolean" ||
      !text(finding.criterion) ||
      !refs(finding.evidence) ||
      !text(finding.suggestedRepair) ||
      finding.disposition !== "open"
    )
      throw new Error(
        "Malformed finding: identity, criterion, repair and evidence are required",
      );
    ids.add(finding.id);
    const blocking = ["style", "refactor"].includes(String(finding.category))
      ? false
      : finding.blocking;
    if (
      blocking &&
      !finding.evidence.some(
        (ref) =>
          /^\S+:\d+\b/.test(ref) ||
          snapshot.evidenceRefs.some(
            (known) => ref === known || ref.startsWith(`${known}:`),
          ),
      )
    )
      throw new Error(
        "Blocking finding must cite a concrete source location or supplied evidence reference",
      );
    return {
      id: finding.id,
      reviewerRole: "code-review",
      reviewedCommit: snapshot.commit,
      category: finding.category as ReviewFinding["category"],
      blocking,
      criterion: finding.criterion,
      evidence: finding.evidence,
      suggestedRepair: finding.suggestedRepair,
      disposition: "open",
    };
  });
  const blocking = findings.some((finding) => finding.blocking);
  if (value.outcome === "passed" && blocking)
    throw new Error("Passing verdict contradicts blocking findings");
  if (value.outcome === "findings" && !findings.length)
    throw new Error("Findings verdict has no findings");
  return {
    role: "code-review",
    reviewedCommit: snapshot.commit,
    round: snapshot.round,
    outcome:
      value.outcome === "unverified"
        ? "unverified"
        : blocking
          ? "findings"
          : "passed",
    findings,
    evidenceRefs: value.evidenceRefs,
  };
}
