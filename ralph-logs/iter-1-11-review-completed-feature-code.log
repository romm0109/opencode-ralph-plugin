import { randomUUID } from \"node:crypto\";
import { join } from \"node:path\";
import type { JobEnvelope } from \"../core/types.js\";
import { createReviewWorkspace, verifyReviewWorkspace } from \"../git/review-workspace.js\";
import type { OpenCodeAdapter } from \"../opencode/adapter.js\";
import { loadRoleInstructions } from \"../roles/instructions.js\";
import type { RunStore } from \"../state/run-store.js\";
import type { ReviewResult, ReviewSnapshot } from \"./types.js\";

export interface CodeReviewOptions {
  store: RunStore;
  adapter: OpenCodeAdapter;
  directory: string;
  parentSessionId: string;
  model?: JobEnvelope[\"model\"];
}
export async function runCodeReview(snapshot: ReviewSnapshot, options: CodeReviewOptions): Promise<ReviewResult> {
  const run = await options.store.getRun(snapshot.runId);
  if ("'!run?.review || JSON.stringify(run.review.snapshot) !== JSON.stringify(snapshot) ||
    run.operations[`review-pin-${snapshot.round}`]?.status !== "completed")
    throw new Error("Unknown or superseded review snapshot");
  if (run.review.result) return run.review.result;
  const workspace = join(options.store.root, "review-workspaces", randomUUID());
  const job: JobEnvelope = {
    runId: snapshot.runId, jobId: `code-review-${snapshot.round}`, attempt: 1,
    role: "code-review", readOnly: true, workspace, baseCommit: snapshot.commit,
    inputRevisions: { round: snapshot.round },
    prompt: `${loadRoleInstructions("code-review")}'"\\nReview input:\\n"'${JSON.stringify({ snapshot, ...run.review.inputs })}`,
    ...(options.model ? { model: options.model } : {}),
  };
  const operation = { operationId: `review-workspace-${snapshot.round}`, kind: "review.workspace" as const, status: "intent" as const, job };
  if (!(await options.store.recordOperation(operation))) throw new Error("Review dispatch already started; resume must reconcile the existing operation");
  try {
    await createReviewWorkspace(options.directory, workspace, snapshot.commit);
    await options.store.recordOperation({ ...operation, status: "completed" });
  } catch (cause) {
    await options.store.recordOperation({ ...operation, status: "failed", error: { code: "sdk-error", message: "Review workspace preparation failed", cause: String(cause) } });
    throw cause;
  }
  const response = await options.adapter.dispatchJob(job);
  const result: ReviewResult = { role: "code-review", reviewedCommit: snapshot.commit, round: snapshot.round, outcome: "unverified", findings: [], evidenceRefs: response.evidence, ...(response.sessionId ? { sessionId: response.sessionId } : {}) };
  if (response.outcome === "completed" && response.text) {
    const parsed = JSON.parse(response.text) as ReviewResult;
    result.findings = parsed.findings.map((finding) => ({ ...finding, blocking: ["style", "refactor"].includes(finding.category) ? false : finding.blocking }));
    result.evidenceRefs = [...parsed.evidenceRefs, ...response.evidence];
    result.outcome = result.findings.some((finding) => finding.blocking) ? "findings" : parsed.outcome;
  } else if (response.error) result.error = response.error;
  await verifyReviewWorkspace(workspace, snapshot.commit);
  const summary = `Code review round ${snapshot.round} at ${snapshot.commit}: ${result.outcome}.'"\\n"'${result.findings.map((finding) => `${finding.id} [${finding.blocking ? "blocking" : "optional"}] ${finding.category}: ${finding.criterion}'"\\nEvidence: "'${finding.evidence.join("; ")}'"\\nSuggested repair: "'${finding.suggestedRepair}`).join("'"\\n\")}\\nFunctional review is still required."'`;
  if (!(await options.store.recordReviewResult(snapshot.runId, snapshot, result, summary))) throw new Error("Superseded review result ignored");
  const publish = { operationId: `review-publish-${snapshot.round}`, kind: "review.publish" as const, status: "intent" as const, job };
  await options.store.recordOperation(publish);
  const published = await options.adapter.publishStatus(options.parentSessionId, options.directory, summary);
  await options.store.recordOperation({ ...publish, status: published.ok ? "completed" : "failed", ...(published.error ? { error: published.error } : {}) });
  return result;
}
EOF
