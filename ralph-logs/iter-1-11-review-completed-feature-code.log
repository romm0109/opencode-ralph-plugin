}
export function projectRunSnapshot(
  run: RunRecord,
  sequence = 0,
  secrets: readonly string[] = [],
): RunSnapshot {
  const execution = run.execution;
  const checks = execution?.checks ?? [];
  const safe = (s: string) =>
    sanitizeDisplay(s, secrets).slice(0, MAX_LOG_CHARS);
  return {
    schemaVersion: 1,
    runId: run.runId,
    phase: run.phase,
    revision: run.revision,
    sequence,
    verification: !checks.length
      ? "unavailable"
      : execution?.verification === "failed" ||
          checks.some((c) => c.status === "failed")
        ? "failed"
        : execution?.verification === "passed" &&
            checks.every((c) => c.status === "passed")
          ? "passed"
          : "incomplete",
    executionAvailable: !!execution,
    issues:
      execution?.issues.map((i) => ({
        id: i.id,
        title: safe(i.title),
        dependencies: [...i.dependencies],
        status: i.status,
        blockers: [...i.blockers],
      })) ?? [],
    integrationQueue: [...(execution?.integrationQueue ?? [])],
    checks: checks.map((c) => ({
      id: c.id,
      status: c.status,
      attempt: c.attempt,
      candidateCommit: c.candidateCommit,
      commandRevision: c.commandRevision,
      ...(c.reason !== undefined ? { reason: safe(c.reason) } : {}),
    })),
    agents: Object.values(run.jobs).map(({ envelope: j, status, result }) => ({
      jobId: j.jobId,
      issueId: j.issueId ?? null,
      role: safe(j.role),
      attempt: j.attempt,
      sessionId: j.sessionId ?? null,
      baseCommit: j.baseCommit,
      inputRevisions: { ...j.inputRevisions },
      status: result?.outcome ?? (status === "intent" ? "waiting" : status),
      logId: result?.text !== undefined ? logId(j.jobId, j.attempt) : null,
      evidence: result?.evidence.map(safe) ?? [],
      error: result?.error
        ? { code: result.error.code, message: safe(result.error.message) }
        : null,
    })),
    errors: run.errors.map((e) => ({ code: e.code, message: safe(e.message) })),
  };
}
/** Runtime values are read only for redaction and never serialized as configuration. */
export function runtimeSecretValues(): string[] {
  return Object.entries(process.env)
    .filter(
      ([name, value]) =>
        /TOKEN|PASSWORD|SECRET|API_?KEY|PRIVATE_?KEY/i.test(name) && !!value,
    )
    .map(([, value]) => value as string);
}
export function sanitizeDisplay(
  value: string,
  secrets: readonly string[] = [],
): string {
  let clean = value
    // biome-ignore lint/suspicious/noControlCharactersInRegex: strip terminal escape bytes.
    .replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, "")
    // biome-ignore lint/suspicious/noControlCharactersInRegex: remove control bytes from untrusted output.
    .replace(/[\x00-\x08\x0b-\x1f\x7f]/g, "");
  for (const secret of secrets)
    if (secret) clean = clean.split(secret).join("[REDACTED]");
  return clean
    .replace(/\b(Bearer\s+)[\w.+/=-]+/gi, "$1[REDACTED]")
    .replace(
      /\b((?:api[_-]?key|access[_-]?token|password|secret)\s*[=:]\s*)[^\s,;]+/gi,
      "$1[REDACTED]",
    )
    .replace(/\bsk-[A-Za-z0-9_-]{12,}/g, "[REDACTED]");
}

