test("superseded functional completion cannot replace or publish a newer snapshot", async () => {
  const f = await fixture();
  try {
    f.fake.respond(JSON.stringify({ reviewedCommit: f.snapshot.commit, round: 1, criteria: ["prd-1", "issue-a-1"].map(id => ({ id, status: "unverified", evidenceRefs: [], reason: "Unsupported feature surface" })) }));
    f.fake.hold();
    const pending = f.router.reviewFunctional(f.snapshot, { directory: f.project.directory, parentSessionId: "parent", surfaces: { ui: false, http: true }, tools: { http: "http" }, environment: { revision: 1, async prepare() { return { url: "http://localhost:1234", evidenceRefs: [] }; }, async dispose() { return { status: "completed", evidenceRefs: [] }; } } });
    const settled = pending.then(() => "accepted", (e: Error) => e.message);
    while (!f.fake.requests.some(r => r.path.endsWith("/message") && r.body.parts)) await Bun.sleep(5);
    const run = await f.store.getRun("r");
    await f.store.recordExecution("r", run!.revision, run!.execution!);
    f.fake.release();
    expect(await settled).toContain("superseded");
    expect((await f.store.getRun("r"))?.review?.functionalResult).toBeUndefined();
  } finally { f.fake.release(); await f.project.cleanup(); }
});

