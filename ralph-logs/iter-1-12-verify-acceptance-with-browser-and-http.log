/** Redact strings before serialization, including quotes and nested typed causes. */
export function sanitizeValue<T>(value: T, secrets: readonly string[] = []): T {
  if (typeof value === \"string\") return sanitizeDisplay(value, secrets) as T;
  if (Array.isArray(value)) return value.map(item => sanitizeValue(item, secrets)) as T;
  if (value && typeof value === \"object\") return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, sanitizeValue(item, secrets)])) as T;
  return value;
}
EOF
