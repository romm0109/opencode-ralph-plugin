  let workspaceReady = false;
  for (let attempt = 1; attempt <= 3; attempt++) {
    await current();
    job.attempt = attempt;
    const evidenceRefs: string[] = [];
    let blocker: Failure | undefined;
    let invalid = false;
    const operation = { operationId: `functional-environment-${snapshot.round}-${attempt}`, kind: "review.environment" as const, status: "intent" as const, job: { ...job } };
    await options.store.recordOperation(operation);
    try {
      if (!workspaceReady) {
        await createOwnedWorktree(options.directory, workspace, snapshot.commit);
        workspaceReady = true;
        await options.store.recordOperation({ ...workspaceIntent, status: "completed" });
      }
      const lease = await prepareEnvironment(options.environment, job);
      evidenceRefs.push(...lease.evidenceRefs);
      await options.store.recordOperation({ ...operation, status: "completed" });
      await verifyFunctionalWorkspace(workspace, snapshot.commit);
      const url = new URL(lease.url);
      if (!["http:", "https:"].includes(url.protocol) || !["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)) throw new Error("Approved review environment must be local");
      const missing = (options.requiredEnvRefs ?? []).filter(ref => !process.env[ref]);
      if (missing.length) throw new Error(`Missing required test access references: ${missing.join(", ")}`);
      const available = await options.adapter.discoverTools?.(workspace);
      if (!available || requested.some(tool => !tool || !available.includes(tool) || ["bash", "edit", "write", "patch", "apply_patch"].includes(tool))) throw new Error("Required browser/HTTP observation tools unavailable");
      job.prompt = `${await loadRoleInstructions("functional-review")}'"\\nReview input:\\n"'${JSON.stringify({ snapshot, checklist, prd: run.review!.inputs.prd, graph: run.review!.inputs.graph, url: lease.url, tools: options.tools, requiredEnvRefs: options.requiredEnvRefs ?? [] })}`;
      await current();
      const response = await options.adapter.dispatchJob({ ...job });
      evidenceRefs.push(...response.evidence);
