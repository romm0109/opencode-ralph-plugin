export function createFakeOpenCode() {
  const requests: {
    path: string;
    directory: string | null;
    body: Record<string, unknown>;
  }[] = [];
  let denied = false;
  let empty = false;
  let deniedTool = false;
  let invalidTool = false;
  let holdCreation = false;
  let release: (() => void) | undefined;
  let gate: Promise<void> | undefined;
  let count = 0;
  let reply = "actual response";
  const client = createAdapterClient(
    "http://fixture.invalid",
    async (input) => {
      const request = input instanceof Request ? input : new Request(input);
      const url = new URL(request.url);
      const raw = request.method === "POST" ? await request.text() : "";
      const body = raw ? (JSON.parse(raw) as Record<string, unknown>) : {};
      requests.push({
        path: url.pathname,
        directory: url.searchParams.get("directory"),
        body,
      });
      if (denied)
        return Response.json(
          { name: "PermissionDeniedError", message: "Permission denied" },
          { status: 403 },
        );
      if (url.pathname === "/experimental/tool/ids")
        return Response.json([
          "read",
          "glob",
          "grep",
          "edit",
          "write",
          "bash",
          "custom_tool",
        ]);
      if (url.pathname === "/session") {
        if (holdCreation) await gate;
        return Response.json({ id: `session-${++count}` });
      }
      if (url.pathname.endsWith("/abort")) return Response.json(true);
      if (url.pathname.endsWith("/message") && request.method === "GET")
        return Response.json([
          {
            info: {
              id: "earlier-message",
              role: "assistant",
              parentID: "user-1",
              sessionID: url.pathname.split("/")[2],
            },
            parts: invalidTool
              ? [
                  {
                    id: "invalid-part",
                    type: "tool",
                    tool: "invalid",
                    state: {
                      status: "completed",
                      input: {
                        tool: "bash",
                        error: "Model tried to call unavailable tool",
                      },
                      output: "unavailable",
                    },
                  },
                ]
              : deniedTool
                ? [
                    {
                      id: "denied-part",
                      type: "tool",
                      state: {
                        status: "error",
                        error: "The user rejected permission to use this tool",
                      },
                    },
                  ]
                : [],
          },
        ]);
      if (url.pathname.endsWith("/message")) {
        await gate;
        return Response.json({
          info: {
            id: "message-1",
            parentID: "user-1",
            sessionID: url.pathname.split("/")[2],
            role: "assistant",
            time: { created: 1, completed: 2 },
            finish: "stop",
          },
          parts: [{ type: "text", text: empty ? "" : reply }],
        });
      }
      return Response.json(true);
    },
  );
  return {
    client,
    requests,
    respond: (text: string) => {
      reply = text;
    },
    denyTool: () => {
      deniedTool = true;
    },
    invalidTool: () => {
      invalidTool = true;
    },
    empty: () => {
      empty = true;
    },
    holdCreation: () => {
      holdCreation = true;
      gate = new Promise<void>((r) => {
        release = r;
      });
    },
    deny: () => {
      denied = true;
    },
    hold: () => {
      gate = new Promise<void>((r) => {
        release = r;
      });
    },
    release: () => release?.(),
  };
}
/** Runtime values are read only for redaction and never serialized as configuration. */
export function runtimeSecretValues(): string[] {
  return Object.entries(process.env)
    .filter(
      ([name, value]) =>
        /TOKEN|PASSWORD|SECRET|API_?KEY|PRIVATE_?KEY/i.test(name) && !!value,
    )
    .map(([, value]) => value as string);
}
export function sanitizeDisplay(
  value: string,
  secrets: readonly string[] = [],
): string {
  let clean = value
    // biome-ignore lint/suspicious/noControlCharactersInRegex: strip terminal escape bytes.
    .replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, "")
    // biome-ignore lint/suspicious/noControlCharactersInRegex: remove control bytes from untrusted output.
    .replace(/[\x00-\x08\x0b-\x1f\x7f]/g, "");
  for (const secret of secrets)
    if (secret) clean = clean.split(secret).join("[REDACTED]");
  return clean
    .replace(/\b(Bearer\s+)[\w.+/=-]+/gi, "$1[REDACTED]")
    .replace(
      /\b((?:api[_-]?key|access[_-]?token|password|secret)\s*[=:]\s*)[^\s,;]+/gi,
      "$1[REDACTED]",
    )
    .replace(/\bsk-[A-Za-z0-9_-]{12,}/g, "[REDACTED]");
}
