import { randomUUID } from "node:crypto";
import {
  createOpencodeClient,
  type Event,
  type OpencodeClient,
} from "@opencode-ai/sdk";
import type {
  Failure,
  JobEnvelope,
  JobResult,
  UserInputRequest,
  UserInputResult,
} from "../core/types.js";
import type { RunStore } from "../state/run-store.js";
export interface OpenCodeAdapter {
  dispatchJob(job: JobEnvelope): Promise<JobResult>;
  cancelJob(job: JobEnvelope): Promise<{ ok: boolean; error?: Failure }>;
  requestUserInput(request: UserInputRequest): Promise<UserInputResult>;
  publishStatus(
    sessionId: string,
    workspace: string,
    text: string,
  ): Promise<{ ok: boolean; error?: Failure }>;
  receiveEvent(event: Event): Promise<void>;
}
export function createAdapterClient(
  baseUrl: string,
  fetch?: (input: Request) => Promise<Response>,
): OpencodeClient {
  return createOpencodeClient({ baseUrl, ...(fetch ? { fetch } : {}) });
}
function failure(cause: unknown, status?: number): Failure {
  const message =
    cause instanceof Error
      ? cause.message
      : (JSON.stringify(cause) ?? "Unknown SDK failure");
  return {
    code:
      status === 403 ||
      /permission.*(denied|rejected)|PermissionDenied|not allowed/i.test(
        message,
      )
        ? "permission-denied"
        : "sdk-error",
    message,
    cause:
      cause instanceof Error
        ? { name: cause.name, message: cause.message }
        : cause,
  };
}
export function createOpenCodeAdapter(
  client: OpencodeClient,
  store: RunStore,
): OpenCodeAdapter {
  async function finish(job: JobEnvelope, error: Failure): Promise<JobResult> {
    const result: JobResult = {
      ...job,
      outcome: error.code === "permission-denied" ? "denied" : "failed",
      error,
      evidence: [],
    };
    await store.recordResult(result);
    const current = (await store.getRun(job.runId))?.jobs[job.jobId];
    return current?.envelope.attempt === job.attempt && current.result
      ? current.result
      : { ...job, outcome: "cancelled", evidence: [] };
  }
  async function abortSession(
    job: JobEnvelope,
  ): Promise<{ ok: boolean; error?: Failure }> {
    if (!job.sessionId) return { ok: true };
    const operation = {
      operationId: randomUUID(),
      kind: "session.abort" as const,
      job,
      status: "intent" as const,
    };
    await store.recordOperation(operation);
    let error: Failure | undefined;
    try {
      const result = await client.session.abort({
        path: { id: job.sessionId },
        query: { directory: job.workspace },
      });
      if (!result.data) error = failure(result.error, result.response.status);
    } catch (cause) {
      error = failure(cause);
    }
    await store.recordOperation({
      ...operation,
      status: error ? "failed" : "completed",
      ...(error ? { error } : {}),
    });
    return error ? { ok: false, error } : { ok: true };
  }
  const adapter: OpenCodeAdapter = {
    async dispatchJob(job) {
      if (!(await store.recordIntent(job))) {
        const existing = (await store.getRun(job.runId))?.jobs[job.jobId];
        if (existing?.envelope.attempt === job.attempt && existing.result)
          return existing.result;
        return {
          ...job,
          outcome: "failed",
          error: {
            code: "sdk-error",
            message: "Duplicate or stale dispatch; no side effect performed",
          },
          evidence: [],
        };
      }
      let bound = job;
      try {
        const created = await client.session.create({
          query: { directory: job.workspace },
          body: { title: `Ralph ${job.runId}/${job.jobId}/${job.attempt}` },
        });
        if (!created.data)
          return finish(bound, failure(created.error, created.response.status));
        bound = { ...job, sessionId: created.data.id };
        if (!(await store.attachSession(job, created.data.id))) {
          const abort = await abortSession(bound);
          return {
            ...bound,
            outcome: "cancelled",
            evidence: [],
            ...(abort.error ? { error: abort.error } : {}),
          };
        }
        let tools: Record<string, boolean> | undefined;
        if (job.readOnly) {
          const available = await client.tool.ids({
            query: { directory: job.workspace },
          });
          if (!available.data)
            return finish(
              bound,
              failure(available.error, available.response.status),
            );
          tools = Object.fromEntries(
            available.data.map((name) => [
              name,
              ["read", "glob", "grep", "list"].includes(name),
            ]),
          );
        }
        const response = await client.session.prompt({
          path: { id: created.data.id },
          query: { directory: job.workspace },
          body: {
            parts: [{ type: "text", text: job.prompt }],
            ...(tools ? { tools } : {}),
            ...(job.model ? { model: job.model } : {}),
          },
        });
        if (!response.data)
          return finish(
            bound,
            failure(response.error, response.response.status),
          );
        const { info, parts } = response.data;
        const history = await client.session.messages({
          path: { id: created.data.id },
          query: { directory: job.workspace },
        });
        if (!history.data)
          return finish(bound, failure(history.error, history.response.status));
        const turnParts = history.data
          .filter(
            (message) =>
              message.info.role === "assistant" &&
              message.info.sessionID === bound.sessionId &&
              message.info.parentID === info.parentID,
          )
          .flatMap((message) => message.parts);
        const denied = [...parts, ...turnParts].find(
          (part) =>
            part.type === "tool" &&
            part.state.status === "error" &&
            /permission|rejected|not allowed/i.test(part.state.error),
        );
        if (denied && denied.type === "tool" && denied.state.status === "error")
          return finish(bound, {
            code: "permission-denied",
            message: denied.state.error,
            cause: denied,
          });
        const toolFailure = [...parts, ...turnParts].find(
          (part) =>
            part.type === "tool" &&
            (part.state.status === "error" || part.tool === "invalid"),
        );
        if (toolFailure && toolFailure.type === "tool")
          return finish(bound, {
            code: "sdk-error",
            message:
              toolFailure.state.status === "error"
                ? toolFailure.state.error
                : "OpenCode reported an invalid tool call",
            cause: toolFailure,
          });
        if (info.error) return finish(bound, failure(info.error));
        const text = parts
          .filter((part) => part.type === "text")
          .map((part) => part.text)
          .join("\n")
          .trim();
        if (
          info.role !== "assistant" ||
          info.sessionID !== bound.sessionId ||
          !info.time.completed ||
          !text
        )
          return finish(bound, {
            code: "missing-output",
            message: "No completed correlated assistant text response",
          });
        const result: JobResult = {
          ...bound,
          outcome: "completed",
          text,
          evidence: [info.id],
        };
        await store.recordResult(result);
        // Cancellation/denial may have won while the request was outstanding.
        const current = (await store.getRun(job.runId))?.jobs[job.jobId];
        return current?.envelope.attempt === job.attempt && current.result
          ? current.result
          : { ...bound, outcome: "cancelled", evidence: [] };
      } catch (cause) {
        return finish(bound, failure(cause));
      }
    },
    async cancelJob(job) {
      const entry = (await store.getRun(job.runId))?.jobs[job.jobId];
      if (!entry || entry.envelope.attempt !== job.attempt)
        return {
          ok: false,
          error: { code: "sdk-error", message: "Unknown or stale job" },
        };
      const bound = entry.envelope;
      if (entry.status === "terminal") return { ok: true };
      // Commit cancellation intent before abort; late prompt results cannot advance state.
      await store.recordResult({
        ...bound,
        outcome: "cancelled",
        evidence: [],
        error: { code: "cancelled", message: "Cancellation requested" },
      });
      return abortSession(bound);
    },
    async requestUserInput(_request) {
      return {
        ok: false,
        error: {
          code: "unsupported",
          message:
            "The supplied v1 client has no supported question creation API. No assistant text is accepted as user approval.",
        },
      };
    },
    async publishStatus(_sessionId, workspace, text) {
      try {
        const response = await client.tui.showToast({
          query: { directory: workspace },
          body: { title: "Ralph status", message: text, variant: "info" },
        });
        return response.data
          ? { ok: true }
          : {
              ok: false,
              error: failure(response.error, response.response.status),
            };
      } catch (cause) {
        return { ok: false, error: failure(cause) };
      }
    },
    async receiveEvent(event) {
      // Idle is deliberately not completion evidence.
      if (
        event.type !== "permission.replied" ||
        !["reject", "deny"].includes(event.properties.response)
      )
        return;
      for (const run of await store.listRuns()) {
        for (const entry of Object.values(run.jobs)) {
          if (
            entry.status !== "terminal" &&
            entry.envelope.sessionId === event.properties.sessionID
          ) {
            await finish(entry.envelope, {
              code: "permission-denied",
              message: "OpenCode permission rejected",
              cause: event.properties,
            });
          }
        }
      }
    },
  };
  return adapter;
}
import { expect, test } from "bun:test";
import { writeFile } from "node:fs/promises";
import { join } from "node:path";
