  const checklist = createFunctionalChecklist(run.review!.inputs.prd, run.review!.inputs.graph, options.surfaces);
  const result: FunctionalReviewResult = { role: "functional-review", reviewedCommit: snapshot.commit, round: snapshot.round, outcome: "unverified", findings: [], evidenceRefs: [], criteria: checklist.map(c => ({ ...c, status: "unverified", evidenceRefs: [], reason: "Review has not run" })), attempts: [] };
  const requested = [...(options.surfaces.ui ? [options.tools.browser] : []), ...(options.surfaces.http ? [options.tools.http] : [])];
  const workspace = join(options.store.root, "review-workspaces", randomUUID());
