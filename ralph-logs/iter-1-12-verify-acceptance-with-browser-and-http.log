        const disposed = await disposeEnvironment(options.environment, job);
        evidenceRefs.push(...disposed.evidenceRefs);
        if (disposed.status !== "completed") throw new Error(disposed.reason ?? `Cleanup ${disposed.status}`);
        await options.store.recordOperation({ ...cleanup, status: "completed" });
      } catch (cause) {
        blocker = { code: "unsupported", message: "Owned environment cleanup failed", cause: String(cause) };
        invalid = true; // Do not start another environment while resources may still be live.
        await options.store.recordOperation({ ...cleanup, status: "failed", error: blocker });
        if (!result.findings.length) result.outcome = "unverified";
