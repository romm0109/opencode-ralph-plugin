      if (!round || round.snapshot.commit !== snapshot.commit || round.snapshot.round !== snapshot.round)
        throw new Error("Stale dispute clarification");
      const origin = finding.reviewerRole === "code-review" ? round.code : round.functional;
      const operationId = `finding-clarify-${randomUUID()}`;
      const job = {
        runId, jobId: operationId, role: finding.reviewerRole, attempt: 1,
        workspace: join(store.root, "review-workspaces", operationId),
        baseCommit: snapshot.commit, readOnly: true,
        inputRevisions: { round: snapshot.round },
        ...(run?.planning?.settings.models[finding.reviewerRole] ? { model: run.planning.settings.models[finding.reviewerRole] } : {}),
        prompt: `Reconsider this finding as the originating reviewer role. One clarification exchange only. Inspect the frozen commit and supplied counterexample; withdraw only with evidence. Return JSON {disposition: "withdrawn" | "retained", evidenceRefs: string[], justification: string}.\n${JSON.stringify({ snapshot, finding, executorEvidence: evidence, originalReview: origin, inputs: run?.review?.inputs })}`,
      };
      const operation = { operationId, kind: "review.workspace" as const, status: "intent" as const, job };
      if (!(await store.recordOperation(operation))) throw new Error("Dispute intent rejected");
      try {
        await createReviewWorkspace(run?.baseline?.workspace ?? job.workspace, job.workspace, snapshot.commit);
        await store.recordOperation({ ...operation, status: "completed" });
