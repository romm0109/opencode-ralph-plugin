      }
      const result = await dispatchAttempt(store, adapter, job, run?.planning?.settings.agentTimeoutMs ?? 1800000, {});
      await verifyReviewWorkspace(job.workspace, snapshot.commit);
      return z.object({
        disposition: z.enum(["withdrawn", "retained"]),
        evidenceRefs: z.array(z.string().trim().min(1)).min(1),
        justification: z.string().trim().min(1),
      }).strict().parse(correlatedResult(job, result));
    },
    async executeIssue(task, context) {
      const attempt = await executeIssue(store, adapter, runId, task.id);
      if (attempt.attempt !== context.attempt || attempt.job.workspace !== context.workspace || attempt.job.baseCommit !== context.baseCommit)
        throw new Error("Repair execution identity mismatch");
      if (attempt.findingDispute) return { outcome: "disputed", ...attempt.findingDispute };
      if (attempt.status === "submitted" && attempt.submission) return {
        outcome: "candidate", commit: attempt.submission.submittedCommit,
        evidenceRefs: [`executor:${attempt.job.jobId}:TDD`, ...(attempt.executionResult?.evidence ?? [])],
      };
      return { outcome: "failed", error: attempt.error ?? { code: "missing-output", message: "Repair executor did not submit a TDD candidate" }, evidenceRefs: attempt.executionResult?.evidence ?? [] };
    },
    async integrateIssue(task, candidate, context) {
      const before = (await store.getRun(runId))?.issueAttempts?.[task.id];
      if (before?.submission?.submittedCommit !== candidate || before.attempt !== context.attempt)
        throw new Error("Repair integration identity mismatch");
      const attempt = await integrateIssue(store, adapter, runId, task.id);
      if (attempt.status === "integrated" && attempt.integratedCommit && attempt.validation) return {
        outcome: "integrated", commit: attempt.integratedCommit,
        checks: attempt.validation.checks.map((check) => ({
          id: check.id, status: check.status, ...(check.reason ? { reason: check.reason } : {}),
          attempt: attempt.attempt, candidateCommit: attempt.integratedCommit as string,
          commandRevision: attempt.validation?.commandRevision ?? 0,
        })),
        evidenceRefs: [`merger:${attempt.candidate?.job.jobId}:checks`],
      };
      return { outcome: "failed", error: attempt.error ?? { code: "missing-output", message: "Repair candidate was not integrated" }, evidenceRefs: attempt.candidate?.result?.evidence ?? [] };
    },
  };
}
import type { RunRecord } from "../core/types.js";
import type { IssueSpec } from "../planning/graph.js";

/** Repairs are authorized by a completed dual review, outside the approved graph. */
export function currentRepair(run: RunRecord, issueId: string) {
  const workflow = run.reviewWorkflow;
  const round = workflow?.rounds.at(-1);
  if (
    workflow?.status !== "running" || !round?.code || !round.functional ||
    round.snapshot.round >= 3 ||
    run.planning?.graph?.value.issues.some((issue) => issue.id === issueId)
  ) return undefined;
  return round.repairs.find((task) => task.id === issueId && task.status === "pending");
}
export function executionIssue(run: RunRecord, issueId: string): {
  issue: IssueSpec; text: string;
} | undefined {
  const original = run.planning?.graph?.value.issues.find((i) => i.id === issueId);
  if (original) return { issue: original, text: run.planning?.graph?.files[original.artifactPath] ?? "" };
  const repair = currentRepair(run, issueId);
  if (!repair) return undefined;
  return {
    issue: {
      id: repair.id,
      title: `Repair ${repair.findingIds.join(", ")}`,
      artifactPath: `issues/${repair.id}.md`,
      dependencies: repair.dependencies,
      acceptanceCriteria: repair.acceptanceCriteria,
      testableBehaviors: repair.testBehaviors,
    },
    text: `Dedicated TDD repair (do not expand approved scope):\n${JSON.stringify(repair)}\nA finding may be disputed with {"kind":"finding_dispute","findingIds":["role:id"],"evidenceRefs":["counterexample evidence"]}.`,
  };
}
import { readFile, rm } from "node:fs/promises";
import { join } from "node:path";
import type { RunStore } from "./run-store.js";

/** Only durable terminal reporting relinquishes the matching repository owner. */
export async function releaseTerminalRun(store: RunStore, runId: string, directory: string) {
  const run = await store.getRun(runId);
  if (run?.reviewWorkflow?.status !== "terminal" || !run.reviewWorkflow.report)
    throw new Error("Cannot release a nonterminal review run");
  const lock = join(store.root, "active-run.lock");
  let raw: string;
  try { raw = await readFile(join(lock, "owner.json"), "utf8"); }
  catch (cause) {
    if ((cause as NodeJS.ErrnoException).code === "ENOENT") return;
    throw cause;
  }
  const owner = JSON.parse(raw);
  if (owner.runId !== runId || owner.repositoryId !== store.repositoryId) return;
  const operation = {
    operationId: `terminal-release-${run.reviewWorkflow.ownerId}`,
    kind: "run.release" as const, status: "intent" as const,
    job: { runId, jobId: "terminal-release", role: "completion", attempt: 1,
      workspace: directory, inputRevisions: { round: run.reviewWorkflow.rounds.length },
      baseCommit: run.reviewWorkflow.commit, prompt: "Release terminal active-run ownership" },
  };
  if (!(await store.recordOperation(operation))) return;
  try {
    if ((await readFile(join(lock, "owner.json"), "utf8")) !== raw)
      throw new Error("Active-run ownership changed before release");
    await rm(lock, { recursive: true });
    await store.recordOperation({ ...operation, status: "completed" });
  } catch (cause) {
    await store.recordOperation({ ...operation, status: "failed", error: { code: "sdk-error", message: String(cause) } });
    throw cause;
  }
}

