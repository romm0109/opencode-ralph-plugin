      issueId: j.issueId ?? null,
      role: safe(j.role),
      attempt: j.attempt,
      sessionId: j.sessionId ?? null,
      baseCommit: j.baseCommit,
      inputRevisions: { ...j.inputRevisions },
      status: result?.outcome ?? (status === "intent" ? "waiting" : status),
      logId: result?.text !== undefined ? logId(j.jobId, j.attempt) : null,
      evidence: result?.evidence.map(safe) ?? [],
      error: result?.error
        ? { code: result.error.code, message: safe(result.error.message) }
        : null,
    })),
    errors: run.errors.map((e) => ({ code: e.code, message: safe(e.message) })),
  };
}
import { useEffect, useState } from "react";
import type { LogPage, RunSnapshot } from "../projections.js";
import type { DashboardApi, RunSummary } from "./api.js";

function State({ value }: { value: string }) {
  return <span className={`state ${value}`}>{value.replaceAll("_", " ")}</span>;
}
function Logs({
  api,
  runId,
  logId,
}: {
  api: DashboardApi;
  runId: string;
  logId: string;
}) {
  const [page, setPage] = useState<LogPage>();
  const [error, setError] = useState("");
  const read = (offset: number) => {
    api
      .log(runId, logId, offset)
      .then(setPage)
      .catch((e) => setError(String(e)));
  };
  // The component is keyed by log identity, so an old response cannot replace another log.
  useEffect(() => {
    let active = true;
    api
      .log(runId, logId, 0)
      .then((p) => {
        if (active) setPage(p);
      })
      .catch((e) => {
        if (active) setError(String(e));
      });
    return () => {
      active = false;
    };
  }, [api, runId, logId]);
  return (
    <section aria-label="Logs">
      <h3>Log {logId}</h3>
      {error && <p role="alert">{error}</p>}
      <pre>{page?.content ?? "Loading log…"}</pre>
      <p>
        {page &&
          `Characters ${page.offset}–${page.offset + page.content.length} of ${page.total}${page.truncated ? " (bounded; remaining output omitted)" : ""}`}
      </p>
      <button
        type="button"
        disabled={!page || page.offset === 0}
        onClick={() => read(Math.max(0, (page?.offset ?? 0) - 4096))}
      >
        Previous log page
      </button>{" "}
      <button
        type="button"
        disabled={page?.nextOffset == null}
        onClick={() => read(page?.nextOffset ?? 0)}
      >
        Next log page
      </button>
    </section>
  );
}
export function App({ api }: { api: DashboardApi }) {
  const [runs, setRuns] = useState<RunSummary[]>([]);
  const [runId, setRunId] = useState("");
  const [snapshot, setSnapshot] = useState<RunSnapshot>();
  const [connection, setConnection] = useState("connecting");
  const [error, setError] = useState("");
  const [log, setLog] = useState("");
  useEffect(() => {
    let active = true;
    const refresh = () =>
      api
        .runs()
        .then((items) => {
          if (active) {
            setRuns(items);
            setRunId((current) => current || items.at(-1)?.runId || "");
          }
        })
        .catch((e) => {
          if (active) setError(String(e));
        });
    void refresh();
    const timer = setInterval(refresh, 2000);
    return () => {
      active = false;
      clearInterval(timer);
    };
  }, [api]);
  useEffect(() => {
    if (!runId) return;
    const controller = new AbortController();
    let sequence = 0;
    let stream: AbortController | undefined;
    const offline = () => {
      stream?.abort();
      setConnection("reconnecting");
    };
    window.addEventListener("offline", offline);
    setSnapshot(undefined);
    setLog("");
    setError("");
    const receive = (next: RunSnapshot) => {
      if (!controller.signal.aborted) {
        sequence = next.sequence;
        setSnapshot(next);
        setConnection("connected");
      }
    };
    void (async () => {
      while (!controller.signal.aborted) {
        try {
          if (!sequence) receive(await api.snapshot(runId));
          stream = new AbortController();
          await api.subscribe(
            runId,
            sequence,
            AbortSignal.any([controller.signal, stream.signal]),
            receive,
          );
        } catch (e) {
          if (controller.signal.aborted) return;
          setConnection("reconnecting");
          setError(String(e));
          await new Promise<void>((resolve) => {
            const finish = () => {
              clearTimeout(timer);
              controller.signal.removeEventListener("abort", finish);
              resolve();
            };
            const timer = setTimeout(finish, 500);
            controller.signal.addEventListener("abort", finish, { once: true });
          });
        }
      }
    })();
    return () => {
      window.removeEventListener("offline", offline);
      controller.abort();
    };
  }, [api, runId]);
  return (
    <main>
      <header>
        <p className="eyebrow">RALPH · READ ONLY</p>
        <h1>Execution dashboard</h1>
        <output>Connection: {connection}</output>
        <label>
          Run{" "}
          <select value={runId} onChange={(e) => setRunId(e.target.value)}>
            <option value="">Select a run</option>
            {runs.map((r) => (
              <option key={r.runId} value={r.runId}>
                {r.runId}
              </option>
            ))}
          </select>
        </label>
      </header>
      {error && connection !== "connected" && <p role="alert">{error}</p>}
      {!runId && <p>No persisted runs yet.</p>}
      {snapshot && (
        <>
          <section>
            <h2>{snapshot.runId}</h2>
            <p>
              Phase: <State value={snapshot.phase} /> · Revision{" "}
              {snapshot.revision} · Event {snapshot.sequence}
            </p>
            <p>
              Verification: <State value={snapshot.verification} />
            </p>
            {snapshot.errors.map((e) => (
              <p key={`${e.code}-${e.message}`}>
                {e.code}: {e.message}
              </p>
            ))}
          </section>
          <section aria-label="Dependency graph">
            <h2>Dependency graph</h2>
            {!snapshot.executionAvailable && (
              <p>Execution graph evidence unavailable.</p>
            )}
            <div className="graph">
              {snapshot.issues.map((issue) => (
                <article key={issue.id}>
                  <h3>
                    {issue.id}: {issue.title}
                  </h3>
                  <State value={issue.status} />
                  <p>
                    Dependencies: {issue.dependencies.join(" → ") || "none"}
                  </p>
                  {issue.blockers.length > 0 && (
                    <p>Blocked by: {issue.blockers.join(", ")}</p>
                  )}
                </article>
              ))}
            </div>
          </section>
          <section>
            <h2>Agents and attempts</h2>
            {!snapshot.agents.length && <p>No agent evidence.</p>}
            {snapshot.agents.map((agent) => (
              <article key={`${agent.jobId}-${agent.attempt}`}>
                <h3>
                  {agent.issueId ?? agent.jobId} · {agent.role}
                </h3>
                <p>
                  Attempt {agent.attempt} · Session{" "}
                  {agent.sessionId ?? "waiting"} ·{" "}
                  <State value={agent.status} />
                </p>
                <p>
                  Base commit: <code>{agent.baseCommit}</code> · Input
                  revisions: <code>{JSON.stringify(agent.inputRevisions)}</code>
                </p>
                <p>Evidence: {agent.evidence.join(", ") || "unavailable"}</p>
                {agent.error && (
                  <p>
                    {agent.error.code}: {agent.error.message}
                  </p>
                )}
                {agent.logId && (
                  <button
                    type="button"
                    onClick={() => setLog(agent.logId ?? "")}
                  >
                    View log {agent.jobId}
                  </button>
                )}
              </article>
            ))}
          </section>
          <section>
            <h2>Integration queue</h2>
            {!snapshot.executionAvailable ? (
              <p>Queue evidence unavailable.</p>
            ) : (
              <ol>
                {snapshot.integrationQueue.map((id) => (
                  <li key={id}>{id}</li>
                ))}
              </ol>
            )}
          </section>
          <section>
            <h2>Validation checks</h2>
            {!snapshot.checks.length && (
              <p>No validation evidence available.</p>
            )}
            {snapshot.checks.map((check) => (
              <article
                key={`${check.id}-${check.candidateCommit}-${check.attempt}`}
              >
                <h3>
                  {check.id} <State value={check.status} />
                </h3>
                <p>{check.reason}</p>
                <p>
                  Attempt {check.attempt} · Command revision{" "}
                  {check.commandRevision} · Candidate{" "}
                  <code>{check.candidateCommit}</code>
                </p>
              </article>
            ))}
          </section>
          {log && (
            <Logs key={`${runId}-${log}`} api={api} runId={runId} logId={log} />
          )}
        </>
      )}
    </main>
  );
}
import { expect, test } from "bun:test";
import { writeFile } from "node:fs/promises";
import { join } from "node:path";
import { createCommandRouter } from "../../src/commands/router.js";
import { projectRunSnapshot } from "../../src/dashboard/projections.js";
import { createOpenCodeAdapter } from "../../src/opencode/adapter.js";
import { createReviewSnapshot } from "../../src/review/snapshot.js";
import { openRunStore } from "../../src/state/run-store.js";
import { createFakeOpenCode } from "../helpers/fake-opencode.js";
import { createTestProject, git } from "../helpers/project.js";

test("review cannot start until every planned issue has integrated", async () => {
  const project = await createTestProject();
  try {
    const store = await openRunStore(project.directory);
    await store.createRun("r");
    const graph = { revision: "graph-1", issues: [{ id: "a" }, { id: "b" }] };
    for (const status of [
      "pending",
      "ready",
      "running",
      "failed",
      "blocked",
      "integration_queued",
    ] as const) {
      const run = await store.getRun("r");
      if (!run) throw new Error("Missing run");
      await store.recordExecution("r", run.revision, {
        issues: [
          {
            id: "a",
            title: "A",
            dependencies: [],
            status: "integrated",
            blockers: [],
          },
          { id: "b", title: "B", dependencies: [], status, blockers: [] },
        ],
        integrationQueue: [],
        checks: [],
      });
      await expect(
        createReviewSnapshot({
          store,
          directory: project.directory,
          runId: "r",
          round: 1,
          commit: project.commit,
          baseCommit: project.commit,
          prdRevision: "prd-1",
          graph,
          evidenceRefs: ["execution-1"],
        }),
      ).rejects.toThrow("integrated");
    }
    expect((await store.getRun("r"))?.jobs).toEqual({});
  } finally {
    await project.cleanup();
  }
});

async function reviewFixture() {
  const project = await createTestProject();
  const graph = { revision: "graph-1", issues: [{ id: "a" }] };
  await writeFile(
    join(project.directory, "PRD.md"),
    "Approved AC-1: addition returns the sum.\n",
  );
  await writeFile(join(project.directory, "graph.json"), JSON.stringify(graph));
  await writeFile(
    join(project.directory, "add.ts"),
    "export const add = (a: number, b: number) => a - b;\n",
  );
  await git("git", ["-C", project.directory, "add", "."]);
  await git("git", [
    "-C",
    project.directory,
    "commit",
    "-m",
    "feature with planted defect",
  ]);
  const commit = (
    await git("git", ["-C", project.directory, "rev-parse", "HEAD"])
  ).stdout.trim();
  const store = await openRunStore(project.directory);
  const fake = createFakeOpenCode();
  const adapter = createOpenCodeAdapter(fake.client, store);
  const router = createCommandRouter(store, adapter);
  await router.runJob({
    runId: "r",
    jobId: "execute-a",
    attempt: 1,
    role: "executor",
    workspace: project.directory,
    inputRevisions: {},
    baseCommit: commit,
    prompt: "Implement A",
  });
  const run = await store.getRun("r");
  if (!run) throw new Error("Missing run");
  await store.recordExecution("r", run.revision, {
    verification: "passed",
    issues: [
      {
        id: "a",
        title: "A",
        dependencies: [],
        status: "integrated",
        blockers: [],
      },
    ],
    integrationQueue: [],
    checks: [
      {
        id: "tests",
        status: "passed",
        attempt: 1,
        candidateCommit: commit,
        commandRevision: 1,
      },
    ],
  });
  const options = {
    store,
    directory: project.directory,
    runId: "r",
    round: 1,
    commit,
    baseCommit: project.commit,
    prdRevision: "prd-1",
    graph,
    evidenceRefs: ["execution-1", "tests-1"],
  };
  return { project, store, fake, adapter, router, options, commit };
}

test("independent reviewer sees frozen requirements and diff; only the concrete defect blocks", async () => {
  const f = await reviewFixture();
  try {
    const snapshot = await createReviewSnapshot(f.options);
    f.fake.respond(
      JSON.stringify({
        role: "code-review",
        reviewedCommit: f.commit,
        round: 1,
        outcome: "findings",
        evidenceRefs: ["add.ts:1"],
        findings: [
          {
            id: "defect-1",
            reviewerRole: "code-review",
            reviewedCommit: f.commit,
            category: "correctness",
            blocking: true,
            criterion: "AC-1: addition returns sum",
            evidence: ["add.ts:1 subtracts; add(2,1) returns 1, expected 3"],
            suggestedRepair: "Replace subtraction with addition",
            disposition: "open",
          },
          {
            id: "style-1",
            reviewerRole: "code-review",
            reviewedCommit: f.commit,
            category: "style",
            blocking: true,
            criterion: "Name clarity",
            evidence: ["add.ts:1 uses a/b"],
            suggestedRepair: "Use descriptive parameters",
            disposition: "open",
          },
        ],
      }),
    );
    const result = await f.router.reviewCode(snapshot, {
      directory: f.project.directory,
      parentSessionId: "parent",
      model: { providerID: "fixture", modelID: "reviewer" },
    });
    expect(result.outcome).toBe("findings");
    expect(
      result.findings
        .filter((finding) => finding.blocking)
        .map((finding) => finding.id),
    ).toEqual(["defect-1"]);
    expect(result.sessionId).toBe("session-2");
    const prompt = f.fake.requests.find(
      (request) =>
        request.path === "/session/session-2/message" && request.body.parts,
    );
    expect(prompt?.directory).not.toBe(f.project.directory);
    expect(prompt?.body.model).toEqual({
      providerID: "fixture",
      modelID: "reviewer",
    });
    expect(JSON.stringify(prompt?.body.parts)).toContain("Approved AC-1");
    expect(JSON.stringify(prompt?.body.parts)).toContain("a - b");
    expect(prompt?.body.tools).toMatchObject({
      read: true,
      edit: false,
      write: false,
      bash: false,
      custom_tool: false,
    });
    const reopened = await openRunStore(f.project.directory);
    const state = await reopened.getRun("r");
    expect(state?.review?.result).toEqual(result);
    expect(state?.phase).toBe("running");
    expect(await createCommandRouter(reopened).status("r")).toContain(
      "defect-1",
    );
    expect(
      f.fake.requests.some(
        (request) =>
          request.path === "/tui/show-toast" &&
          JSON.stringify(request.body).includes("defect-1"),
      ),
    ).toBe(true);
  } finally {
    await f.project.cleanup();
  }
});

function passedReview(commit: string, round = 1) {
  return {
    role: "code-review",
    reviewedCommit: commit,
    round,
    outcome: "passed",
    findings: [],
    evidenceRefs: ["add.ts:1"],
  };
}

test("malformed review output is unverified and retains correlated failure evidence", async () => {
  const f = await reviewFixture();
  try {
    const snapshot = await createReviewSnapshot(f.options);
    f.fake.respond("passed");
    const result = await f.router.reviewCode(snapshot, {
      directory: f.project.directory,
      parentSessionId: "parent",
    });
    expect(result.outcome).toBe("unverified");
    expect(result.error?.code).toBe("invalid-review");
    expect(result.evidenceRefs).toContain("message-1");
    expect((await f.store.getRun("r"))?.review?.result?.outcome).toBe(
      "unverified",
    );
  } finally {
    await f.project.cleanup();
  }
});

test("wrong commit or round, missing evidence and contradictory verdicts cannot pass", async () => {
  for (const mutation of [
    { reviewedCommit: "a".repeat(40) },
    { round: 2 },
    { evidenceRefs: [] },
    {
      findings: [
        {
          id: "contradiction",
          reviewerRole: "code-review",
          reviewedCommit: "COMMIT",
          category: "correctness",
          blocking: true,
          criterion: "AC-1",
          evidence: ["add.ts:1 subtracts instead of adding"],
          suggestedRepair: "Add",
          disposition: "open",
        },
      ],
    },
    {
      outcome: "findings",
      findings: [
        {
          id: "vague",
          reviewerRole: "code-review",
          reviewedCommit: "COMMIT",
          category: "correctness",
          blocking: true,
          criterion: "AC-1",
          evidence: ["It seems wrong"],
          suggestedRepair: "Fix it",
          disposition: "open",
        },
      ],
    },
    {
      findings: [
        {
          id: "f",
          reviewerRole: "code-review",
          reviewedCommit: "invalid",
          category: "correctness",
          blocking: true,
        },
      ],
    },
  ]) {
    const f = await reviewFixture();
    try {
      const snapshot = await createReviewSnapshot(f.options);
      f.fake.respond(
        JSON.stringify({ ...passedReview(f.commit), ...mutation }),
      );
      const result = await f.router.reviewCode(snapshot, {
        directory: f.project.directory,
        parentSessionId: "parent",
      });
      expect(result.outcome).toBe("unverified");
      expect(result.error?.code).toBe("invalid-review");
    } finally {
      await f.project.cleanup();
    }
  }
});

test("execution updates invalidate a snapshot and cannot reuse its round", async () => {
  const f = await reviewFixture();
  try {
    await createReviewSnapshot(f.options);
    const run = await f.store.getRun("r");
    if (!run?.execution) throw new Error("Missing execution");
    await f.store.recordExecution("r", run.revision, run.execution);
    await expect(createReviewSnapshot(f.options)).rejects.toThrow("Superseded");
  } finally {
    await f.project.cleanup();
  }
});

test("a superseded in-flight reviewer cannot publish or replace the newer round", async () => {
  const f = await reviewFixture();
  try {
    const snapshot = await createReviewSnapshot(f.options);
    f.fake.respond(JSON.stringify(passedReview(f.commit)));
    f.fake.hold();
    const pending = f.router.reviewCode(snapshot, {
      directory: f.project.directory,
      parentSessionId: "parent",
    });
    const settled = pending.then(
      () => "accepted",
      (error: Error) => error.message,
    );
    while (
      !f.fake.requests.some(
        (request) =>
          request.path === "/session/session-2/message" && request.body.parts,
      )
    )
      await Bun.sleep(5);
    const second = await createReviewSnapshot({ ...f.options, round: 2 });
    f.fake.release();
    expect(await settled).toContain("Superseded");
    expect((await f.store.getRun("r"))?.review?.snapshot).toEqual(second);
    expect((await f.store.getRun("r"))?.review?.result).toBeUndefined();
    expect(
      f.fake.requests.filter((request) => request.path === "/tui/show-toast"),
    ).toHaveLength(0);
  } finally {
    await f.project.cleanup();
  }
});

test("workspace edits are rejected without touching the source branch", async () => {
  const f = await reviewFixture();
  try {
    const snapshot = await createReviewSnapshot(f.options);
    f.fake.respond(JSON.stringify(passedReview(f.commit)));
    f.fake.hold();
    const pending = f.router.reviewCode(snapshot, {
      directory: f.project.directory,
      parentSessionId: "parent",
    });
    while (
      !f.fake.requests.some(
        (request) =>
          request.path === "/session/session-2/message" && request.body.parts,
      )
    )
      await Bun.sleep(5);
    const workspace = f.fake.requests.find(
      (request) =>
        request.path === "/session/session-2/message" && request.body.parts,
    )?.directory;
    if (!workspace) throw new Error("Missing reviewer workspace");
    await writeFile(join(workspace, "add.ts"), "reviewer tried to repair\n");
    f.fake.release();
    const result = await pending;
    expect(result.outcome).toBe("unverified");
    expect(result.error?.message).toContain("workspace changed");
    expect(
      (
        await git("git", ["-C", f.project.directory, "rev-parse", "HEAD"])
      ).stdout.trim(),
    ).toBe(f.commit);
  } finally {
    await f.project.cleanup();
  }
});

test("optional-only review passes code review but never completes or verifies the feature", async () => {
  const f = await reviewFixture();
  try {
    const snapshot = await createReviewSnapshot(f.options);
    // Advance the source branch after freezing; reviewer still sees the pinned SHA.
    await writeFile(
      join(f.project.directory, "later.txt"),
      "later branch work\n",
    );
    await git("git", ["-C", f.project.directory, "add", "later.txt"]);
    await git("git", ["-C", f.project.directory, "commit", "-m", "later"]);
    f.fake.respond(
      JSON.stringify({
        ...passedReview(f.commit),
        outcome: "findings",
        findings: [
          {
            id: "style",
            reviewerRole: "code-review",
            reviewedCommit: f.commit,
            category: "refactor",
            blocking: true,
            criterion: "Clearer parameter names",
            evidence: ["add.ts:1"],
            suggestedRepair: "Rename parameters",
            disposition: "open",
          },
        ],
      }),
    );
    const result = await f.router.reviewCode(snapshot, {
      directory: f.project.directory,
      parentSessionId: "parent",
    });
    expect(result.outcome).toBe("passed");
    expect(result.findings[0]?.blocking).toBe(false);
    const run = await f.store.getRun("r");
    expect(run?.phase).toBe("running");
    if (!run) throw new Error("Missing run");
    expect(projectRunSnapshot(run).verification).toBe("incomplete");
    expect(run?.review?.snapshot.commit).toBe(f.commit);
    const requestsBefore = f.fake.requests.length;
    expect(
      await f.router.reviewCode(snapshot, {
        directory: f.project.directory,
        parentSessionId: "parent",
      }),
    ).toEqual(result);
    expect(f.fake.requests).toHaveLength(requestsBefore);
  } finally {
    await f.project.cleanup();
  }
});

