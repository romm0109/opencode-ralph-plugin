    const report = await coordinateReviewRound({ ...f.options, adapter: createOpenCodeAdapter(fake.client, f.store), parentSessionId: \"parent\", releaseActiveRun: async () => { expect((await f.store.getRun(\"r\"))?.reviewWorkflow?.status).toBe(\"terminal\"); released++; }, functionalOptions: {
      surfaces: { ui: true, http: false }, tools: { browser: \"agent-browser\" }, environment: { revision: 1,
