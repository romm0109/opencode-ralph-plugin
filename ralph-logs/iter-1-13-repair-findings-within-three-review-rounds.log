      const report = await coordinateReviewRound({ store, directory: project.directory, runId: \"r\", commit, baseCommit: project.commit, graph, prdRevision: \"p1\", evidenceRefs: [\"tests\"], reviewers: {
        code: async s => ({ role: \"code-review\", reviewedCommit: s.commit, round: s.round, outcome: outcome === \"unresolved\" ? \"findings\" : \"passed\", evidenceRefs: [\"tests\"], findings: outcome === \"unresolved\" ? [{ id: \"code-bug\", reviewerRole: \"code-review\", reviewedCommit: s.commit, category: \"correctness\", blocking: true, criterion: \"UI works\", evidence: [\"PRD.md:2\"], suggestedRepair: \"Fix behavior\", disposition: \"open\" }] : [] }),
        functional: async s => ({ role: \"functional-review\", reviewedCommit: s.commit, round: s.round, outcome: outcome === \"unverified\" ? \"unverified\" : \"passed\", findings: [], evidenceRefs: [\"observed\"], evidence: [], criteria: [{ id: \"ac\", criterion: \"UI works\", coverage: [\"browser\"], status: outcome === \"unverified\" ? \"unverified\" : \"pass\", reason: outcome === \"unverified\" ? \"Browser unavailable\" : \"Observed UI\", evidenceRefs: [\"observed\"] }], attempts: [{ attempt: 1, evidenceRefs: [\"observed\"] }] }),
      } });
