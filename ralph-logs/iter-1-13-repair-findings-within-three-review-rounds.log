            {
              ...(dashboardUrl ? { dashboardUrl } : {}),
              runId: run.runId,
              revision: run.revision,
              phase: run.phase,
              lastResult: run.lastResult ?? null,
              ...(run.review ? { review: run.review } : {}),
              errors: run.errors,
            },
