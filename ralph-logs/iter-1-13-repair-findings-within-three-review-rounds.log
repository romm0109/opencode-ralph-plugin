    delete job.sessionId;
    job.inputRevisions = {
      ...job.inputRevisions,
      prd: planning.prd.revision,
      graph: planning.graph.revision,
    };
    job.prompt += `\nClarification context: ${JSON.stringify(attempt.question)}\nCurrent approved PRD: ${JSON.stringify(planning.prd)}\nCurrent approved issue: ${JSON.stringify(issue)}\n${planning.graph.files[issue.artifactPath]}`;
    attempt.job = job;
    delete attempt.question;
    delete attempt.executionResult;
  }
  if (!(await store.recordIssueAttempt(runId, initial.revision, attempt)))
    return executeAttempt(store, adapter, runId, issueId, options);
