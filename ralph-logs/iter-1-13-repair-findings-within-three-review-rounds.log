  .object({
    id: z.string().regex(/^[A-Za-z0-9_-]+$/),
    title: z.string().trim().min(1),
    artifactPath: z.string().regex(/^issues\/[A-Za-z0-9_-]+\.md$/),
    dependencies: z.array(z.string().min(1)),
    acceptanceCriteria: strings,
    testableBehaviors: strings,
  })
  .strict();
const graph = z
  .object({
    schemaVersion: z.literal(1),
    prdRevision: artifactRevision,
    issues: z.array(issue).min(1),
  })
  .strict();
export type IssueSpec = z.infer<typeof issue>;
export type IssueGraph = z.infer<typeof graph>;
export function topologicalOrder(value: IssueGraph): string[] {
  const issues = new Map(value.issues.map((item) => [item.id, item]));
  if (issues.size !== value.issues.length)
    throw new Error("Duplicate issue IDs");
  const visited = new Set<string>();
  const visiting = new Set<string>();
  const order: string[] = [];
  function visit(id: string) {
    if (visiting.has(id)) throw new Error("Issue graph contains a cycle");
    if (visited.has(id)) return;
    const item = issues.get(id);
    if (!item) throw new Error(`Unknown dependency ${id}`);
    visiting.add(id);
    for (const dependency of item.dependencies) visit(dependency);
    visiting.delete(id);
    visited.add(id);
    order.push(id);
  }
  for (const item of value.issues) visit(item.id);
  return order;
}
export function validateIssueGraph(
  raw: unknown,
  files: Record<string, string>,
  prd: z.infer<typeof artifactRevision>,
): IssueGraph {
  const value = graph.parse(raw);
  if (
    JSON.stringify(value.prdRevision) !==
    JSON.stringify(artifactRevision.parse(prd))
  )
    throw new Error("Issue graph references a different PRD revision");
  const paths = new Set<string>();
  for (const item of value.issues) {
    if (paths.has(item.artifactPath))
      throw new Error("Duplicate issue artifact path");
    paths.add(item.artifactPath);
    const text = files[item.artifactPath];
    if (!text?.trim())
      throw new Error(`Missing issue file ${item.artifactPath}`);
    for (const heading of [
      "Context",
      "Implementation",
      "Tests",
      "Acceptance criteria",
      "Dependencies",
    ])
      if (!text.toLowerCase().includes(`## ${heading.toLowerCase()}`))
        throw new Error(`Issue ${item.id} missing ${heading}`);
  }
  if (Object.keys(files).some((path) => !paths.has(path)))
    throw new Error("Invalid issue file reference");
  topologicalOrder(value);
  return value;
}
import type { ExecutionEvidence, RunRecord } from "../core/types.js";
import { validateIssueGraph } from "../planning/graph.js";
import { type AttemptPolicy, attemptPolicy } from "./attempts.js";

/** Pure readiness: a submission is never a dependency completion. */
export function reconcileReadiness(
  run: RunRecord,
  queue: string[] = [],
  policy: AttemptPolicy = attemptPolicy,
): ExecutionEvidence {
  const planning = run.planning;
  if (!planning?.graph || !planning.prd)
    throw new Error("Missing approved graph");
  const graph = validateIssueGraph(
    planning.graph.value,
    planning.graph.files,
    planning.prd,
  );
  const states = new Map<string, ExecutionEvidence["issues"][number]>();
  function resolve(id: string): ExecutionEvidence["issues"][number] {
    const cached = states.get(id);
    if (cached) return cached;
    const issue = graph.issues.find((item) => item.id === id);
    if (!issue) throw new Error("Unknown dependency");
    const parents = issue.dependencies.map(resolve);
    const attempt = run.issueAttempts?.[id];
    const blockers = parents
      .filter((p) => ["blocked", "failed"].includes(p.status))
      .map((p) => p.id);
    let status: ExecutionEvidence["issues"][number]["status"];
    if (attempt?.status === "integrated") status = "integrated";
    else if (
      attempt?.status === "exhausted" ||
      (attempt?.status === "failed" && attempt.attempt >= policy.maxAttempts)
    )
      status = "failed";
    else if (attempt?.status === "waiting" || blockers.length)
      status = "blocked";
    else if (attempt && ["submitted", "merging"].includes(attempt.status))
      status = "integration_queued";
    else if (attempt?.status === "executing") status = "running";
    else
      status = parents.every((p) => p.status === "integrated")
        ? "ready"
        : "pending";
    const result = {
      id,
      title: issue.title,
      dependencies: issue.dependencies,
      status,
      blockers,
    };
    states.set(id, result);
    return result;
  }
  const issues = graph.issues.map((issue) => resolve(issue.id));
  const checks: ExecutionEvidence["checks"] = Object.values(
    run.issueAttempts ?? {},
  ).flatMap((attempt) =>
    (attempt.validation?.checks ?? []).map((check) => ({
      id: check.id,
      status: check.status,
      ...(check.reason ? { reason: check.reason } : {}),
      attempt: attempt.attempt,
      candidateCommit: attempt.validation?.candidateCommit ?? "",
      commandRevision: attempt.validation?.commandRevision ?? 0,
    })),
  );
  return {
    issues,
    integrationQueue: queue,
    checks,
    verification: issues.some(
      (i) => i.status === "failed" || i.status === "blocked",
    )
      ? "failed"
      : issues.every((i) => i.status === "integrated") &&
          !run.validationSkips?.length &&
          !checks.some((c) => c.status === "skipped")
        ? "passed"
        : "incomplete",
  };
}

