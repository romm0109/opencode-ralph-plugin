    last?.disputes
      .filter((d) => d.disposition === "withdrawn")
      .map((d) => `${d.finding.reviewerRole}:${d.finding.id}`),
  );
  const findings = [
    ...(last?.code?.findings ?? []),
    ...(last?.functional?.findings ?? []),
  ].map((f) => ({
    ...f,
    disposition: withdrawn.has(`${f.reviewerRole}:${f.id}`)
      ? ("withdrawn" as const)
