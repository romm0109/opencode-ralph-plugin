export type IntegrationResult = IssueAttempt;
const mergeResult = z.discriminatedUnion("kind", [
  z
    .object({
      kind: z.literal("merged"),
      candidateCommit: z.string().regex(/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/),
    })
    .strict(),
  z
    .object({
      kind: z.literal("behavior_conflict"),
      feedback: z.string().trim().min(1),
    })
    .strict(),
]);
export async function integrateSubmission(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  issueId: string,
  options: AttemptOptions = {},
): Promise<IntegrationResult> {
  const initial = await store.getRun(runId);
  const stored = initial?.issueAttempts?.[issueId];
  if (!initial || !stored) throw new Error("Missing issue submission");
  if (stored.status !== "submitted") return stored;
  const attempt = structuredClone(stored);
  const submission = attempt.submission;
  const planning = initial.planning;
  const baseline = initial.baseline;
  if (!submission || !planning || !baseline?.workspace || !baseline.branch)
    throw new Error("Missing integration inputs");
  assertCurrentAttempt(initial, initial, attempt);
  attempt.status = "merging";
  // Reserve before dispatch: another integrator may not dispatch this attempt again.
  await saveIssueAttempt(store, initial, attempt);
  try {
    const config = await loadProjectConfig(planning.workspace);
    if (commandConfigHash(config.commands) !== planning.commandHash)
      throw new Error("Approved commands changed");
    const skill = await loadRoleInstructions(
      planning.workspace,
      "merger",
      config.skillPaths,
    );
    for (let rebuild = 0; rebuild < 3; rebuild++) {
      const base = await inspectWorktree(baseline.workspace);
      if (
        base.repositoryId !== store.repositoryId ||
        base.branch !== `refs/heads/${baseline.branch}`
      )
        throw new Error("Integration identity changed");
      const operationId = `candidate-${randomUUID()}`;
      const job: JobEnvelope = {
        ...attempt.job,
        jobId: operationId,
        role: "merger",
        workspace: `${attempt.job.workspace}-${operationId}`,
        baseCommit: base.commit,
        ...(planning.settings.models.merger
          ? { model: planning.settings.models.merger }
          : {}),
        prompt: `${skill.text}\nSkill: ${JSON.stringify({ path: skill.path, hash: skill.hash })}\nApproved PRD: ${JSON.stringify(planning.prd)}\nApproved issue: ${JSON.stringify(executionIssue(initial, issueId))}\nLatest integration: ${base.commit}\nSUBMISSION\n${JSON.stringify(submission)}`,
      };
      delete job.sessionId;
      delete job.environment;
      if (!planning.settings.models.merger) delete job.model;
      attempt.candidate = {
        operationId,
        job,
        ref: `refs/heads/ralph/candidates/${runId}/${operationId}`,
      };
      await saveIssueAttempt(store, initial, attempt);
      await createOwnedWorktree(store, planning.workspace, {
        operationId,
        kind: "candidate.workspace",
        status: "intent",
        job,
        ref: attempt.candidate.ref,
        expectedNew: base.commit,
      });
      const result = await dispatchAttempt(
        store,
        adapter,
        job,
        attempt.agentTimeoutMs ?? planning.settings.agentTimeoutMs ?? 1800000,
        options,
      );
      assertCurrentAttempt(initial, await store.getRun(runId), attempt);
      attempt.candidate.result = result;
      if (result.outcome !== "completed") {
        attempt.error = result.error ?? {
          code:
            result.outcome === "denied"
              ? "permission-denied"
              : result.outcome === "cancelled"
                ? "cancelled"
                : "missing-output",
          message: "Merger did not complete",
        };
        throw new Error(attempt.error.message);
      }
      const output = mergeResult.parse(correlatedResult(job, result));
      attempt.mergerSessionId = result.sessionId as string;
      if (result.sessionId === submission.sessionId)
        throw new Error("Merger must use a separate session");
      if (output.kind === "behavior_conflict") {
        attempt.feedback = output.feedback;
        throw new Error("Merge requires behavior repair");
      }
      const found = await inspectWorktree(job.workspace);
      if (
        found.repositoryId !== store.repositoryId ||
        found.branch !== attempt.candidate.ref ||
        found.commit !== output.candidateCommit ||
        (
          await gitOutput(job.workspace, [
            "status",
            "--porcelain",
            "--untracked-files=all",
          ])
        ).trim()
      )
        throw new Error(
          "Merger output must be clean and committed on the owned candidate branch",
        );
      await gitOutput(job.workspace, [
        "merge-base",
        "--is-ancestor",
        base.commit,
        found.commit,
      ]);
      await gitOutput(job.workspace, [
        "merge-base",
        "--is-ancestor",
        submission.submittedCommit,
        found.commit,
      ]);
      attempt.candidate.commit = found.commit;
      await saveIssueAttempt(store, initial, attempt);
      const validationJob = {
        ...job,
        baseCommit: found.commit,
        sessionId: result.sessionId as string,
      };
      attempt.validation = await validateCandidate({
        store,
        adapter,
        job: validationJob,
        config: config.commands,
        sourceWorkspace: planning.workspace,
        ...(options.clock ? { clock: options.clock } : {}),
      });
      await saveIssueAttempt(store, initial, attempt);
      if (attempt.validation.status === "failed") {
        if (attempt.validation.failureCause)
          attempt.error = attempt.validation.failureCause;
        throw new Error(
          attempt.validation.blocker ?? "Candidate validation failed",
        );
      }
      assertCurrentAttempt(initial, await store.getRun(runId), attempt);
      const advanced = await compareAndAdvanceRef(store, planning.workspace, {
        operationId: `advance-${operationId}`,
        kind: "integration.advance",
        status: "intent",
        job,
        ref: `refs/heads/${baseline.branch}`,
        expectedOld: base.commit,
        expectedNew: found.commit,
      });
      if (!advanced) continue; // New base requires a new merger session and validation.
      attempt.status = "integrated";
      attempt.integratedCommit = found.commit;
      const advanceError = (await store.getRun(runId))?.operations[
        `advance-${operationId}`
      ]?.error;
      if (advanceError) attempt.cleanupErrors = [advanceError.message];
      await saveIssueAttempt(store, initial, attempt);
      for (const owned of [attempt.operationId, operationId]) {
        try {
          await removeOwnedWorktree(store, planning.workspace, owned);
        } catch (cause) {
          attempt.cleanupErrors ??= [];
          attempt.cleanupErrors.push(String(cause));
        }
      }
      await saveIssueAttempt(store, initial, attempt);
      return attempt;
    }
    throw new Error(
      "Integration kept changing; retained candidates require revalidation",
    );
  } catch (cause) {
    attempt.error ??= {
      code: "baseline-blocked",
      message: String(cause),
      cause: String(cause),
    };
    if (attempt.status !== "integrated") failAttempt(attempt);
    await saveIssueAttempt(store, initial, attempt).catch(() => {});
  }
  return attempt;
}

/** Every public integration caller shares the repository run's serial queue. */
export function integrateIssue(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  issueId: string,
  options: AttemptOptions = {},
) {
  return integrationQueue(store, runId).enqueue(
    store,
    adapter,
    runId,
    issueId,
    options,
  );
}
import { randomUUID } from "node:crypto";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { z } from "zod";
import type { executorQuestionSchema } from "../agents/results.js";
import { continuePlanning } from "../core/orchestrator.js";
import type {
  Failure,
  RunRecord,
  UserInputRequest,
  UserInputResult,
} from "../core/types.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { approvalMatchesRevision } from "../planning/approvals.js";
import { artifactHash, issueBundleHash } from "../planning/artifacts.js";
import { publishRevision } from "../planning/generation.js";
import { topologicalOrder, validateIssueGraph } from "../planning/graph.js";
import type { RunStore } from "../state/run-store.js";
import type { AttemptOptions } from "./attempts.js";
import type { IssueAttempt } from "./execute-issue.js";
import { scheduleReadyIssues } from "./scheduler.js";

export interface ExecutorQuestion
  extends z.infer<typeof executorQuestionSchema> {
  request: UserInputRequest;
  jobId: string;
  attempt: number;
  operationId: string;
  epoch: number;
  prdHash: string;
  graphHash: string;
  inputRevisions: Record<string, number>;
  answer?: Extract<UserInputResult, { ok: true }>;
  error?: Failure;
}
export function createExecutorQuestion(
  run: RunRecord,
  attempt: IssueAttempt,
  value: z.infer<typeof executorQuestionSchema>,
): ExecutorQuestion {
  const state = run.planning;
  if (!state?.prd || !state.graph)
    throw new Error("Missing approved question artifacts");
  return {
    kind: value.kind,
    question: value.question,
    recommendedAnswer: value.recommendedAnswer,
    affectedRequirement: value.affectedRequirement,
    jobId: attempt.job.jobId,
    attempt: attempt.attempt,
    operationId: attempt.operationId,
    epoch: run.control?.epoch ?? 0,
    prdHash: state.prd.hash,
    graphHash: state.graph.hash,
    inputRevisions: {
      ...attempt.job.inputRevisions,
      prd: state.prd.revision,
      graph: state.graph.revision,
    },
    request: {
      runId: run.runId,
      workspace: state.workspace,
      sessionId: state.sessionId,
      requestId: randomUUID(),
      revision: state.graph.revision,
      question: `Issue ${attempt.issueId}, attempt ${attempt.attempt}\nRequirement: ${value.affectedRequirement}\n${value.question}\nRecommended answer: ${value.recommendedAnswer}`,
    },
  };
}

/** Durable pending identity is the publication intent; waiting has no agent timer. */
const pending = new Map<string, Promise<void>>();
export function handleExecutorQuestion(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  issueId: string,
  requestId?: string,
  options: AttemptOptions = {},
) {
  const key = `${store.repositoryId}:${runId}:${issueId}:${requestId ?? "current"}`;
  if (pending.has(key)) return;
  const work = (async () => {
    const attempt = (await store.getRun(runId))?.issueAttempts?.[issueId];
    const question = attempt?.question;
    if (
      attempt?.status !== "waiting" ||
      !question ||
      question.answer ||
      (requestId && question.request.requestId !== requestId)
    )
      return;
    const published = await adapter.publishStatus(
      question.request.sessionId,
      question.request.workspace,
      question.request.question,
    );
    const response: UserInputResult = published.ok
      ? await adapter.requestUserInput(question.request)
      : {
          ok: false,
          error: published.error ?? {
            code: "sdk-error",
            message: "Could not publish executor question",
          },
        };
    if (!response.ok) {
      for (;;) {
        const latest = await store.getRun(runId);
        const current = latest?.issueAttempts?.[issueId];
        if (
          !latest ||
          (latest.control && latest.control.status !== "active") ||
          !current?.question ||
          current.question.request.requestId !== question.request.requestId ||
          current.question.answer
        )
          return;
        current.question.error = response.error;
        if (await store.recordIssueAttempt(runId, latest.revision, current))
          return;
      }
    }
    if (await answerExecutorQuestion(store, runId, issueId, response)) {
      if (
        (await store.getRun(runId))?.planning?.phase === "execution_approval"
      ) {
        await continuePlanning(store, adapter, runId);
      } else {
        // A scheduler may still be settling independent workers. Join it, then re-read.
        await scheduleReadyIssues(store, adapter, runId, options);
        await scheduleReadyIssues(store, adapter, runId, options);
      }
    }
  })()
    .catch(async (cause) => {
      const run = await store.getRun(runId);
      const attempt = run?.issueAttempts?.[issueId];
      if (
        run &&
        attempt?.question &&
        attempt.status === "waiting" &&
        (!requestId || attempt.question.request.requestId === requestId)
      ) {
        attempt.question.error = { code: "sdk-error", message: String(cause) };
        await store.recordIssueAttempt(runId, run.revision, attempt);
      }
    })
    .finally(() => {
      pending.delete(key);
    });
  pending.set(key, work);
}

export async function answerExecutorQuestion(
  store: RunStore,
  runId: string,
  issueId: string,
  response: UserInputResult,
) {
  for (;;) {
    const run = await store.getRun(runId);
    const attempt = run?.issueAttempts?.[issueId];
    const q = attempt?.question;
    const state = run?.planning;
    if (
      !run ||
      !state ||
      !attempt ||
      attempt.status !== "waiting" ||
      !q ||
      q.answer ||
      (run.control && run.control.status !== "active") ||
      (run.control?.epoch ?? 0) !== q.epoch ||
      attempt.operationId !== q.operationId ||
      attempt.job.jobId !== q.jobId ||
      attempt.attempt !== q.attempt ||
      state.phase !== "execution_approved" ||
      !approvalMatchesRevision(state) ||
      state.prd?.hash !== q.prdHash ||
      state.graph?.hash !== q.graphHash ||
      state.graph?.revision !== q.request.revision ||
      state.prd?.revision !== q.inputRevisions.prd ||
      !response.ok ||
      response.source !== "user" ||
      !response.messageId ||
      !response.text.trim() ||
      response.requestId !== q.request.requestId ||
      response.sessionId !== q.request.sessionId ||
      response.revision !== q.request.revision ||
      state.transcript.some(
        (entry) => entry.messageId === response.messageId,
      ) ||
      Object.values(run.issueAttempts ?? {}).some((a) =>
        [...(a.questions ?? []), ...(a.question ? [a.question] : [])].some(
          (q) => q.answer?.messageId === response.messageId,
        ),
      )
    )
      return false;
    if (
      artifactHash(
        await readFile(join(state.workspace, state.prd.artifactPath), "utf8"),
      ) !== state.prd.hash
    )
      return false;
    let raw: unknown;
    try {
      raw = JSON.parse(response.text);
    } catch {
      /* Ordinary clarification prose. */
    }
    if (
      raw &&
      typeof raw === "object" &&
      "kind" in raw &&
      raw.kind === "revise_scope"
    ) {
      const draft = z
        .object({
          kind: z.literal("revise_scope"),
          prd: z.string().trim().min(1),
          graph: z.unknown(),
          files: z.record(z.string(), z.string()),
        })
        .strict()
        .parse(raw);
      const currentPrd = await readFile(
        join(state.workspace, state.prd.artifactPath),
        "utf8",
      );
      const value = validateIssueGraph(
        { ...(draft.graph as object), prdRevision: state.prd },
        draft.files,
        state.prd,
      );
      if (
        draft.prd !== currentPrd ||
        issueBundleHash(value, draft.files) !== state.graph.hash
      ) {
        await reviseQuestionScope(
          store,
          run,
          attempt,
          response,
          draft.prd,
          value,
          draft.files,
        );
        return true;
      }
    }
    q.answer = response;
    attempt.status = "resume_ready";
    if (await store.recordIssueAttempt(runId, run.revision, attempt))
      return true;
  }
}

/** Explicit user-correlated artifact edits always pass the normal approval gate. */
async function reviseQuestionScope(
  store: RunStore,
  run: RunRecord,
  attempt: IssueAttempt,
  response: Extract<UserInputResult, { ok: true }>,
  text: string,
  value: import("../planning/graph.js").IssueGraph,
  files: Record<string, string>,
) {
  const state = structuredClone(run.planning);
  if (
    !state?.prd ||
    !state.graph ||
    !state.executionApproval ||
    !attempt.question
  )
    throw new Error("Missing scope revision context");
  const oldPrd = state.prd,
    oldGraph = state.graph,
    oldApproval = state.executionApproval;
  const revision = oldGraph.revision + 1;
  const directory = `.ralph/features/${run.runId}/graph-${revision}`;
  const prd = {
    revision: oldPrd.revision + 1,
    hash: artifactHash(text),
    artifactPath: `${directory}/PRD.md`,
  };
  value.prdRevision = prd;
  validateIssueGraph(value, files, prd);
  const affected = new Set<string>();
  const previousText = await readFile(
    join(state.workspace, oldPrd.artifactPath),
    "utf8",
  );
  for (const issue of value.issues) {
    const old = oldGraph.value.issues.find((i) => i.id === issue.id);
    if (
      text !== previousText ||
      JSON.stringify(old) !== JSON.stringify(issue) ||
      oldGraph.files[issue.artifactPath] !== files[issue.artifactPath]
    )
      affected.add(issue.id);
  }
  for (const old of oldGraph.value.issues)
    if (!value.issues.some((i) => i.id === old.id)) affected.add(old.id);
  for (const id of topologicalOrder(value)) {
    if (
      value.issues
        .find((i) => i.id === id)
        ?.dependencies.some((d) => affected.has(d))
    )
      affected.add(id);
  }
  state.scopeChange = {
    issueId: attempt.issueId,
    requestId: attempt.question.request.requestId,
    affectedIssueIds: [...affected],
    integratedIssueIds: [...affected].filter(
      (id) => run.issueAttempts?.[id]?.status === "integrated",
    ),
    previousPrd: oldPrd,
    previousGraph: oldGraph,
    previousApproval: oldApproval,
  };
  state.phase = "execution_approval";
  delete state.executionApproval;
  delete state.pending;
  state.generation = { role: "issues", revision, jobId: attempt.job.jobId };
  await publishRevision(
    store,
    run.revision,
    state,
    run.runId,
    `graph-${revision}`,
    { ...files, "PRD.md": text, "graph.json": JSON.stringify(value, null, 2) },
  );
  state.prd = prd;
  state.graph = {
    revision,
    hash: issueBundleHash(value, files),
    artifactPath: `${directory}/graph.json`,
    value,
    files,
    order: topologicalOrder(value),
  };
  state.transcript.push({
    source: "user",
    text: response.text,
    messageId: response.messageId,
    requestId: response.requestId,
    revision: response.revision,
  });
  for (;;) {
    const latest = await store.getRun(run.runId);
    if (
      !latest?.planning ||
      (latest.control && latest.control.status !== "active") ||
      latest.planning.scopeChange?.requestId !== state.scopeChange.requestId ||
      latest.planning.generation?.jobId !== state.generation.jobId ||
      latest.planning.phase !== "execution_approval"
    )
      throw new Error("Stale scope draft");
    if (await store.recordPlanning(run.runId, latest.revision, state)) break;
  }
  for (;;) {
    const latest = await store.getRun(run.runId);
    const current = latest?.issueAttempts?.[attempt.issueId];
    if (
      !latest ||
      (latest.control && latest.control.status !== "active") ||
      latest.planning?.scopeChange?.requestId !== state.scopeChange.requestId ||
      !current?.question ||
      current.question.request.requestId !== attempt.question?.request.requestId
    )
      return;
    current.question.answer = response;
    if (await store.recordIssueAttempt(run.runId, latest.revision, current))
      return;
  }
}

/** Keep baseline/code evidence; approval explicitly authorizes the changed artifacts. */
export async function prepareApprovedScope(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  let run = await store.getRun(runId);
  const state = run?.planning;
  if (
    !run ||
    !state?.scopeChange ||
    state.scopeChange.prepared ||
    state.phase !== "execution_approved" ||
    !approvalMatchesRevision(state) ||
    !state.executionApproval
  )
    return run;
  const change = state.scopeChange;
  const approval = state.executionApproval;
  // Settle sessions from the superseded artifacts before dispatching continuations.
  for (const job of Object.values(run.jobs).filter(
    (j) => j.status !== "terminal",
  )) {
    const cancelled = await adapter.cancelJob(job.envelope);
    if (!cancelled.ok)
      throw new Error("Superseded executor cancellation was not confirmed");
  }
  for (;;) {
    run = await store.getRun(runId);
    if (
      !run ||
      (run.control && run.control.status !== "active") ||
      run.planning?.executionApproval?.requestId !== approval.requestId
    )
      throw new Error("Scope approval changed");
    if (!run.planning || !approvalMatchesRevision(run.planning))
      throw new Error("Scope approval changed");
    if (
      !run.baseline ||
      run.baseline.commandHash !== state.commandHash ||
      run.baseline.candidateCommit !== state.executionApproval?.selectedCommit
    )
      throw new Error("Scope baseline changed");
    if (
      await store.recordBaseline(
        runId,
        run.revision,
        {
          ...run.baseline,
          approvalRequestId: approval.requestId,
        },
        run.validationSkips ?? [],
      )
    )
      break;
  }
  const reissued: { issueId: string; requestId: string }[] = [];
  for (const id of Object.keys(run.issueAttempts ?? {})) {
    for (;;) {
      const latest = await store.getRun(runId);
      const attempt = latest?.issueAttempts?.[id];
      if (
        !latest ||
        !attempt ||
        (latest.control && latest.control.status !== "active") ||
        latest.planning?.executionApproval?.requestId !== approval.requestId
      )
        throw new Error("Scope approval changed");
      if (id === change.issueId && attempt.question?.answer)
        attempt.status = "resume_ready";
      else if (
        attempt.status === "waiting" &&
        attempt.question &&
        !attempt.question.answer
      ) {
        const old = attempt.question;
        attempt.questions = [...(attempt.questions ?? []), old];
        attempt.question = createExecutorQuestion(latest, attempt, old);
        reissued.push({
          issueId: id,
          requestId: attempt.question.request.requestId,
        });
      } else if (
        ["executing", "submitted", "merging"].includes(attempt.status) ||
        (attempt.status === "integrated" &&
          change.affectedIssueIds.includes(id))
      ) {
        attempt.status = "failed";
        attempt.error = {
          code: "cancelled",
          message:
            "Approved scope revision requires execution against current artifacts; previous evidence retained",
        };
      } else break;
      if (await store.recordIssueAttempt(runId, latest.revision, attempt))
        break;
    }
  }
  for (;;) {
    run = await store.getRun(runId);
    if (
      !run ||
      (run.control && run.control.status !== "active") ||
      run.planning?.executionApproval?.requestId !== approval.requestId
    )
      throw new Error("Scope approval changed");
    const planning = structuredClone(run.planning);
    if (!planning?.scopeChange || !approvalMatchesRevision(planning))
      throw new Error("Scope approval changed");
    planning.scopeChange.prepared = true;
    if (await store.recordPlanning(runId, run.revision, planning)) {
      for (const q of reissued)
        handleExecutorQuestion(store, adapter, runId, q.issueId, q.requestId);
      return store.getRun(runId);
    }
  }
}
import { runIssue } from "../core/orchestrator.js";
import type { RunRecord } from "../core/types.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { reviewIntegratedExecution } from "../review/after-execution.js";
import type { RunStore } from "../state/run-store.js";
import type { AttemptOptions } from "./attempts.js";
import { integrationQueue } from "./integration-queue.js";
import { reconcileReadiness } from "./readiness.js";

export { reconcileReadiness } from "./readiness.js";

const active = new Map<string, Promise<RunRecord | undefined>>();
export function scheduleReadyIssues(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  options: AttemptOptions = {},
) {
  const key = `${store.repositoryId}:${runId}`;
  const existing = active.get(key);
  if (existing) return existing;
  const promise = schedule(store, adapter, runId, options).finally(() => {
    active.delete(key);
  });
  active.set(key, promise);
  return promise;
}
async function schedule(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  options: AttemptOptions,
) {
  const initial = await store.getRun(runId);
  if (
    initial?.review &&
    !initial.review.superseded &&
    initial.execution?.issues.every((i) => i.status === "integrated")
  )
    return initial;
  const concurrency = initial?.planning?.settings.concurrency ?? 2;
  if (!Number.isInteger(concurrency) || concurrency <= 0)
    throw new Error("Executor concurrency must be a positive integer");
  if (
    !initial?.baseline ||
    !["passed", "passed_with_omissions"].includes(initial.baseline.status) ||
    initial.planning?.phase !== "execution_approved"
  )
