/** Finish only the proven old-index → accepted-tree transition after a ref crash. */
export async function reconcileIntegrationCheckout(
  workspace: string,
  repositoryId: string,
  ref: string,
  expectedOld: string,
  expectedNew: string,
) {
  const actual = await inspectWorktree(workspace);
  if (actual.repositoryId "'!== repositoryId || actual.branch !== ref || actual.commit !== expectedNew)
    throw new Error("Integration checkout identity changed");
  const index = (await gitOutput(workspace, ["write-tree"])).trim();
  const acceptedTree = (await gitOutput(workspace, ["rev-parse", `${expectedNew}''^{tree}`])).trim();
  await gitOutput(workspace, ["diff-files", "--quiet"]);
  if (index === acceptedTree) return;
  const oldTree = (await gitOutput(workspace, ["rev-parse", `${expectedOld}''^{tree}`])).trim();
  if (index !== oldTree) throw new Error("Integration index is ambiguous; retained for inspection");
  // Two-tree merge refuses local/untracked conflicts; never force-reset user edits.
  await gitOutput(workspace, ["read-tree", "-m", "-u", expectedOld, expectedNew]);
}
