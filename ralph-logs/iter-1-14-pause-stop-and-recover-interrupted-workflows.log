  let reads = 0, intercept = false, waiting = false;
  f.store.recordIssueAttempt = async (id, revision, attempt) => {
    const saved = await save(id, revision, attempt);
    if (saved && attempt.validation?.status === \"passed\" && "'!intercept) {
