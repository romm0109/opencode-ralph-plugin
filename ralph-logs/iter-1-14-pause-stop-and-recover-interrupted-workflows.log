      notification = setImmediate(async () => {
        for (const text of recoveryNotifications) {
          if (disposed) break;
          await adapter.publishStatus("", directory, text);
        }
      });
      notification.unref();
      return dispose;
    } catch (cause) {
      await dispose();
      throw cause;
    }
  },
});
