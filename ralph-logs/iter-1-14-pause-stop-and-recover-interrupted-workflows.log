let stopping = false;
function stop() {
  if (stopping) return;
  stopping = true;
  if (process.platform === "win32") {
    execFile("taskkill.exe", ["/PID", String(process.pid), "/T", "/F"], () =>
      process.exit(0),
    );
  } else {
    process.kill(-process.pid, "SIGTERM");
    setTimeout(() => process.kill(-process.pid, "SIGKILL"), 250);
  }
}
process.on("SIGTERM", stop);
process.on("SIGINT", stop);
child.on("error", stop);
child.on("exit", stop);
