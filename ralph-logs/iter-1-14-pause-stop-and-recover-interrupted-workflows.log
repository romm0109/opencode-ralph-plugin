test(\"recovery retains and reports a matching active-run lock, blocking foreign ownership\", async () => {
  const f = await fixture();
  const lock = join(f.store.root, \"active-run.lock\");
  try {
    await mkdir(lock);
    await writeFile(join(lock, \"owner.json\"), JSON.stringify({runId: \"other-run\", repositoryId: f.store.repositoryId}));
    expect((await reconcileRun({store: f.store, directory: f.directory, runId: \"run\"})).status).toBe(\"blocked\");
    const {readFile} = await import(\"node:fs/promises\");
    expect(JSON.parse(await readFile(join(lock, \"owner.json\"), \"utf8\")).runId).toBe(\"other-run\");
    await writeFile(join(lock, \"owner.json\"), JSON.stringify({runId: \"run\", repositoryId: f.store.repositoryId}));
    const summary = await reconcileRun({store: f.store, directory: f.directory, runId: \"run\"});
    expect(summary.status).toBe(\"interrupted\");
    expect(summary.facts.some(fact => fact.includes(\"active-run lock\") && fact.includes(\"retained\"))).toBe(true);
  } finally {
    await f.cleanup();
  }
});
EOF
