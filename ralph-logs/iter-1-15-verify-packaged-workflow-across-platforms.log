export { generateIssues, handlePlanningResponse } from "../planning/issues.js";
export { generatePrd } from "../planning/prd.js";
/** Approved execution proceeds through baseline validation into DAG scheduling. */
export async function continuePlanning(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  for (;;) {
    let run = await store.getRun(runId);
    if (!run?.planning || (run.control && run.control.status !== "active"))
      return run;
    if (run.planning.phase === "explanation_approved")
      run = await generatePrd(store, adapter, runId);
    if (run?.planning?.phase !== "execution_approval" || run.planning.error)
      return run;
    if (!(await requestPlanningApproval(store, adapter, runId)))
      return store.getRun(runId);
    if ((await store.getRun(runId))?.planning?.phase === "execution_approved") {
      const current = await store.getRun(runId);
      const prepared = current?.planning?.scopeChange
        ? await prepareApprovedScope(store, adapter, runId)
        : await preflightRun(store, adapter, runId);
      if (
        prepared?.baseline &&
        ["passed", "passed_with_omissions"].includes(prepared.baseline.status)
      ) {
        await scheduleReadyIssues(store, adapter, runId);
        return scheduleReadyIssues(store, adapter, runId);
      }
      return prepared;
    }
  }
}

