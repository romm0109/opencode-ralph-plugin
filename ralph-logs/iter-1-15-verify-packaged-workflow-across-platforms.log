        kind: "merged",
        candidateCommit: (
          await gitOutput(job.workspace, ["rev-parse", "HEAD"])
        ).trim(),
      }),
    );
    return createOpenCodeAdapter(fake.client, f.store).dispatchJob(job);
  };
  return {
    ...f,
    jobs,
    holds,
    failures,
    router: createCommandRouter(f.store, f.adapter),
