test("interrupted issue planning discards late output without publishing a graph", async () => {
  const { project, store, adapter, router } = await fixture();
  try {
    adapter.requestUserInput = async (request) => ({
      ok: true,
      ...request,
      source: "user",
      messageId: request.requestId,
      text: `approve ${request.revision}`,
    });
    const dispatch = adapter.dispatchJob.bind(adapter);
    let notify: (job: import("../../src/core/types.js").JobEnvelope) => void =
      () => {};
    const started = new Promise<import("../../src/core/types.js").JobEnvelope>(
      (resolve) => {
        notify = resolve;
      },
    );
    let release: () => void = () => {};
    const gate = new Promise<void>((resolve) => {
      release = resolve;
    });
    adapter.dispatchJob = async (job) => {
      if (job.role === "issues") {
        notify(job);
        await gate;
      }
      return dispatch(job);
    };
    const pending = router.dispatch("ralph-orchestrator", "Diamond", {
      workspace: project.directory,
      sessionId: "main",
    });
    const job = await started;
    await store.recordControl(job.runId, {
      status: "interrupted",
      source: "recovery",
      facts: ["Fixture interruption"],
    });
    release();
    const run = JSON.parse(await pending);
    expect(run.planning.graph).toBeUndefined();
    expect(run.planning.executionApproval).toBeUndefined();
    expect(run.control.status).toBe("interrupted");
  } finally {
    await project.cleanup();
  }
});

test("issue timeout interrupts the run and late output cannot publish or approve", async () => {
  const { project, fake, store, adapter, router } = await fixture();
  try {
    const { writeFile } = await import("node:fs/promises");
    await writeFile(
      join(project.directory, ".ralph/project.json"),
      JSON.stringify({ timeoutMs: 100 }),
    );
    adapter.requestUserInput = async (request) => ({
      ok: true,
      ...request,
      source: "user",
      messageId: request.requestId,
      text: `approve ${request.revision}`,
    });
    const dispatch = adapter.dispatchJob.bind(adapter);
    adapter.dispatchJob = async (job) => {
      if (job.role === "issues") fake.hold();
      return dispatch(job);
    };
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Diamond", {
        workspace: project.directory,
        sessionId: "main",
      }),
    );
    expect(result.planning.phase).toBe("issue_generation");
    expect(result.planning.error.code).toBe("cancelled");
    expect(result.control.status).toBe("interrupted");
    fake.release();
    await new Promise((resolve) => setTimeout(resolve, 30));
    expect((await store.getRun(result.runId))?.planning?.graph).toBeUndefined();
    expect(
      (await store.getRun(result.runId))?.planning?.executionApproval,
    ).toBeUndefined();
  } finally {
    fake.release();
    await project.cleanup();
  }
});
import { afterAll, expect, setDefaultTimeout, test } from "bun:test";
import { readFile, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { createCommandRouter } from "../../src/commands/router.js";
import { loadProjectConfig } from "../../src/config/project.js";
import { preflightRun } from "../../src/execution/preflight.js";
import { validateCandidate } from "../../src/execution/validation.js";
import { createOpenCodeAdapter } from "../../src/opencode/adapter.js";
import { openRunStore } from "../../src/state/run-store.js";
import { createFakeOpenCode } from "../helpers/fake-opencode.js";
import { createTestProject, git } from "../helpers/project.js";

setDefaultTimeout(30000);
const originalScenario = process.env.RALPH_BASELINE_SCENARIO;
afterAll(() => {
  if (originalScenario === undefined)
    delete process.env.RALPH_BASELINE_SCENARIO;
  else process.env.RALPH_BASELINE_SCENARIO = originalScenario;
});

async function fixture(
  mutate?: (output: {
    graph: {
      schemaVersion: number;
      prdRevision: unknown;
      issues: {
        id: string;
        title: string;
        artifactPath: string;
        dependencies: string[];
        acceptanceCriteria: string[];
        testableBehaviors: string[];
      }[];
    };
    files: Record<string, string>;
  }) => void,
  extraCheck = false,
) {
  process.env.RALPH_BASELINE_SCENARIO = "pass";
  const project = await createTestProject();
  const fake = createFakeOpenCode();
  const store = await openRunStore(project.directory);
  const adapter = createOpenCodeAdapter(fake.client, store);
  adapter.getSessionModel = async () => ({
    providerID: "fixture",
    modelID: "default",
  });
  adapter.authorizeCommand = async () => ({ ok: true });
  const router = createCommandRouter(store, adapter);
  fake.respond(
    JSON.stringify({
      schemaVersion: 1,
      revision: 1,
      rationale: "Fixture",
      commands: [
        {
          id: "setup",
          phase: "setup",
          executable: process.execPath,
          args: [
            "-e",
            "if(process.env.SCENARIO === 'setupfail') process.exit(8); if(process.env.SCENARIO === 'setuptimeout') setTimeout(() => {}, 10000)",
          ],
          cwd: ".",
          timeoutMs: 2000,
          platforms: ["darwin", "linux", "win32"],
          env: { SCENARIO: "RALPH_BASELINE_SCENARIO" },
        },
        {
          id: "check",
          phase: "check",
          executable: process.execPath,
          args: [
            "-e",
            "if(process.env.SCENARIO === 'mutate') require('node:fs').writeFileSync('README.md', 'changed'); if(process.env.SCENARIO === 'fail') process.exit(7); if(process.env.SCENARIO === 'timeout') setTimeout(() => {}, 10000)",
          ],
          cwd: ".",
          timeoutMs: 2000,
          platforms: ["darwin", "linux", "win32"],
          env: { SCENARIO: "RALPH_BASELINE_SCENARIO" },
        },
        ...(extraCheck
          ? [
              {
                id: "second-check",
                phase: "check",
                executable: process.execPath,
                args: ["-e", "process.exit(0)"],
                cwd: ".",
                timeoutMs: 2000,
                platforms: ["darwin", "linux", "win32"],
                env: {},
              },
            ]
          : []),
        {
          id: "cleanup",
          phase: "cleanup",
          executable: process.execPath,
          args: ["-e", "process.exit(0)"],
          cwd: ".",
          timeoutMs: 2000,
          platforms: ["darwin", "linux", "win32"],
          env: {},
        },
      ],
    }),
  );
  adapter.requestUserInput = async (request) => ({
    ok: true,
    ...request,
    source: "user",
    messageId: "setup",
    text: `approve ${request.question.match(/hash ([a-f0-9]+)/)?.[1]}`,
  });
  await router.setupProject({
    workspace: project.directory,
    sessionId: "main",
  });
  const dispatch = adapter.dispatchJob.bind(adapter);
  adapter.dispatchJob = async (job) => {
    if (job.role === "interview")
      fake.respond(
        JSON.stringify({
          kind: "explanation",
          text: "Build diamond",
          scope: ["Diamond"],
          criteria: ["D works"],
        }),
      );
    if (job.role === "prd")
      fake.respond(
        JSON.stringify({
          text: "# Diamond\n## Problem\nBuild diamond.\n## User stories\n1. Diamond\n## Requirements\nD works\n## Acceptance criteria\nD works\n## Non-goals\nNone",
        }),
      );
    if (job.role === "issues") {
      const run = await store.getRun(job.runId);
      const prd = run?.planning?.prd;
      const issues = [
        ["D", ["B", "C"]],
        ["C", ["A"]],
        ["A", []],
        ["B", ["A"]],
      ] as [string, string[]][];
      const output = {
        graph: {
          schemaVersion: 1,
          prdRevision: prd,
          issues: issues.map(([id, dependencies]) => ({
            id,
            title: id,
            artifactPath: `issues/${id}.md`,
            dependencies,
            acceptanceCriteria: ["Works"],
            testableBehaviors: ["Works"],
          })),
        },
        files: Object.fromEntries(
          issues.map(([id]) => [
            `issues/${id}.md`,
            `# ${id}\n## Context\nGreenfield\n## Implementation\nBuild ${id}\n## Tests\nWorks\n## Acceptance criteria\nWorks\n## Dependencies\nSee graph`,
          ]),
        ),
      };
      mutate?.(output);
      fake.respond(JSON.stringify(output));
    }
    return dispatch(job);
  };
  return { project, fake, store, adapter, router };
}

async function approvedFixture(extraCheck = false) {
  const f = await fixture(undefined, extraCheck);
  f.adapter.requestUserInput = async (request) => ({
    ok: true,
    ...request,
    source: "user",
    messageId: `human-${request.requestId}`,
    text: `approve ${request.revision}`,
  });
  const run = JSON.parse(
    await f.router.dispatch("ralph-orchestrator", "Baseline", {
      workspace: f.project.directory,
      sessionId: "main",
    }),
  );
  await git("git", ["-C", f.project.directory, "add", "."]);
  await git("git", [
    "-C",
    f.project.directory,
    "commit",
    "-m",
    "approved planning",
  ]);
  return { ...f, runId: run.runId };
}

test("approved baseline isolates the exact selected commit and exposes readiness", async () => {
  const f = await approvedFixture();
  try {
    const head = (
      await git("git", ["-C", f.project.directory, "rev-parse", "HEAD"])
    ).stdout;
    const run = await preflightRun(f.store, f.adapter, f.runId);
    expect(run?.baseline?.status).toBe("passed");
    expect(run?.baseline?.candidateCommit).toBe(f.project.commit);
    expect(
      (await git("git", ["-C", f.project.directory, "rev-parse", "HEAD"]))
        .stdout,
    ).toBe(head);
    expect(JSON.parse(await f.router.status(f.runId)).baseline.status).toBe(
      "passed",
    );
    expect(Object.values(run?.jobs ?? {}).some((j) => j.envelope.issueId)).toBe(
      false,
    );
  } finally {
    await f.project.cleanup();
  }
});

test("completed baseline failure blocks without spending an issue attempt and removes only its worktree", async () => {
  const f = await approvedFixture();
  try {
    process.env.RALPH_BASELINE_SCENARIO = "fail";
    const configBefore = await readFile(
      join(f.project.directory, ".ralph/commands.json"),
      "utf8",
    );
    const run = await preflightRun(f.store, f.adapter, f.runId);
    expect(run?.baseline?.status).toBe("failed");
    expect(run?.baseline?.validation?.checks[0]?.result?.exitCode).toBe(7);
    expect(Object.values(run?.jobs ?? {}).some((j) => j.envelope.issueId)).toBe(
      false,
    );
    expect(
      (
        await git("git", [
          "-C",
          f.project.directory,
          "worktree",
          "list",
          "--porcelain",
        ])
      ).stdout,
    ).not.toContain(run?.baseline?.workspace as string);
    expect(
      await readFile(join(f.project.directory, ".ralph/commands.json"), "utf8"),
    ).toBe(configBefore);
  } finally {
    await f.project.cleanup();
  }
});

test("timeout omissions persist for this run, including when every check is skipped", async () => {
  const f = await approvedFixture();
  try {
    process.env.RALPH_BASELINE_SCENARIO = "timeout";
    const run = await preflightRun(f.store, f.adapter, f.runId);
    expect(run?.baseline?.status).toBe("passed_with_omissions");
    expect(run?.validationSkips).toEqual(["check"]);
    const owner = run?.operations[run.baseline?.operationId ?? ""];
    if (!owner) throw new Error("Missing ownership");
    process.env.RALPH_BASELINE_SCENARIO = "fail";
    const config = (await loadProjectConfig(f.project.directory)).commands;
    const result = await validateCandidate({
      store: f.store,
      adapter: f.adapter,
      job: owner.job,
      config,
      sourceWorkspace: f.project.directory,
    });
    expect(result.status).toBe("passed_with_omissions");
    expect(result.checks[0]?.result).toBeUndefined();
    const fresh = await f.store.createRun("fresh-run");
    expect(fresh.validationSkips).toBeUndefined();
  } finally {
    await f.project.cleanup();
  }
});

