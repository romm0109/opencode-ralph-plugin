] as const) {
  test(`invalid ${invalid} graph never reaches execution approval`, async () => {
    const { project, store, adapter, router } = await fixture((output) => {
      const first = output.graph.issues[0];
      const root = output.graph.issues.find((issue) => issue.id === "A");
      if (!first || !root) throw new Error("Missing fixture");
      if (invalid === "cycle") root.dependencies = ["D"];
      if (invalid === "unknown") first.dependencies = ["missing"];
      if (invalid === "duplicate") output.graph.issues.push(first);
      if (invalid === "missing-file") delete output.files[first.artifactPath];
      if (invalid === "escape") first.artifactPath = "../../escape.md";
      if (invalid === "wrong-prd")
        output.graph.prdRevision = {
          revision: 99,
          hash: "0".repeat(64),
          artifactPath: "PRD.md",
        };
    });
    try {
      let questions = 0;
      adapter.requestUserInput = async (request) => {
        questions++;
        return {
          ok: true,
          ...request,
          source: "user",
          messageId: request.requestId,
          text: `approve ${request.revision}`,
        };
      };
      const run = JSON.parse(
        await router.dispatch("ralph-orchestrator", "Diamond", {
          workspace: project.directory,
          sessionId: "main",
        }),
      );
      expect(run.planning.error.code).toBe("missing-output");
      expect(run.planning.executionApproval).toBeUndefined();
      expect(run.planning.graph).toBeUndefined();
      expect(questions).toBe(1);
      expect(
        Object.values((await store.getRun(run.runId))?.jobs ?? {}).some(
          (job) => job.envelope.role === "executor",
        ),
      ).toBe(false);
    } finally {
      await project.cleanup();
    }
  });
}

test("dependency revision publishes preserved revisions and ignores an old approval", async () => {
  let revised = false;
  const { project, store, adapter, router } = await fixture((output) => {
    if (revised) {
      const issue = output.graph.issues.find((item) => item.id === "C");
      if (issue) issue.dependencies = ["B"];
    }
  });
  try {
    let old: import("../../src/core/types.js").UserInputRequest | undefined;
    let approvals = 0;
    adapter.requestUserInput = async (request) => {
      const state = (await store.getRun(request.runId))?.planning;
      if (state?.phase === "execution_approval") {
        expect(state.executionApproval).toBeUndefined();
        approvals++;
        if (approvals === 1) {
          old = request;
          revised = true;
          return {
            ok: true,
            ...request,
            source: "user",
            messageId: "revision",
            text: "Make C depend on B",
          };
        }
        if (!old) throw new Error("Missing old request");
        const { handlePlanningResponse } = await import(
          "../../src/core/orchestrator.js"
        );
        expect(
          await handlePlanningResponse(store, request.runId, {
            ok: true,
            ...old,
            source: "user",
            messageId: "stale",
            text: "approve 1",
          }),
        ).toBe(false);
        expect(request.question).toContain("depends on B");
      }
      return {
        ok: true,
        ...request,
        source: "user",
        messageId: request.requestId,
        text: `approve ${request.revision}`,
      };
    };
    const run = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Diamond", {
        workspace: project.directory,
        sessionId: "main",
      }),
    );
    expect(run.planning.phase).toBe("execution_approved");
    expect(run.planning.graph.revision).toBe(2);
    expect(run.planning.prd.revision).toBe(2);
    expect(run.planning.executionApproval.revision).toBe(2);
    const snapshots = (await store.events(run.runId)).map(
      (event) => event.snapshot.planning,
    );
    const original = snapshots.find(
      (state) => state?.graph?.revision === 1,
    )?.graph;
    if (!original) throw new Error("Missing original graph");
    expect(run.planning.graph.hash).not.toBe(original.hash);
    expect(
      await readFile(join(project.directory, original.artifactPath), "utf8"),
    ).toContain('"C"');
    expect(run.planning.graph.order).toEqual(["A", "B", "C", "D"]);
  } finally {
    await project.cleanup();
  }
});

