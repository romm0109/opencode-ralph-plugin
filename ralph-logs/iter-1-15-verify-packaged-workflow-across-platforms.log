import { expect, test } from "bun:test";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { createCommandRouter } from "../../src/commands/router.js";
import { createOpenCodeAdapter } from "../../src/opencode/adapter.js";
import { openRunStore } from "../../src/state/run-store.js";
import { createFakeOpenCode } from "../helpers/fake-opencode.js";
import { createTestProject } from "../helpers/project.js";

async function fixture(
  mutate?: (output: {
    graph: {
      schemaVersion: number;
      prdRevision: unknown;
      issues: {
        id: string;
        title: string;
        artifactPath: string;
        dependencies: string[];
        acceptanceCriteria: string[];
        testableBehaviors: string[];
      }[];
    };
    files: Record<string, string>;
  }) => void,
) {
  const project = await createTestProject();
  const fake = createFakeOpenCode();
  const store = await openRunStore(project.directory);
  const adapter = createOpenCodeAdapter(fake.client, store);
  adapter.getSessionModel = async () => ({
    providerID: "fixture",
    modelID: "default",
  });
  adapter.authorizeCommand = async () => ({ ok: true });
  const router = createCommandRouter(store, adapter);
  fake.respond(
    JSON.stringify({
      schemaVersion: 1,
      revision: 1,
      rationale: "Fixture",
      commands: [
        {
          id: "check",
          phase: "check",
          executable: process.execPath,
          args: ["-e", "process.exit(0)"],
          cwd: ".",
          timeoutMs: 2000,
          platforms: ["darwin", "linux", "win32"],
          env: {},
        },
      ],
    }),
  );
  adapter.requestUserInput = async (request) => ({
    ok: true,
    ...request,
    source: "user",
    messageId: "setup",
    text: `approve ${request.question.match(/hash ([a-f0-9]+)/)?.[1]}`,
  });
  await router.setupProject({
    workspace: project.directory,
    sessionId: "main",
  });
  const dispatch = adapter.dispatchJob.bind(adapter);
  adapter.dispatchJob = async (job) => {
    if (job.role === "interview")
      fake.respond(
        JSON.stringify({
          kind: "explanation",
          text: "Build diamond",
          scope: ["Diamond"],
          criteria: ["D works"],
        }),
      );
    if (job.role === "prd")
      fake.respond(
        JSON.stringify({
          text: "# Diamond\n## Problem\nBuild diamond.\n## User stories\n1. Diamond\n## Requirements\nD works\n## Acceptance criteria\nD works\n## Non-goals\nNone",
        }),
      );
    if (job.role === "issues") {
      const run = await store.getRun(job.runId);
      const prd = run?.planning?.prd;
      const issues = [
        ["D", ["B", "C"]],
        ["C", ["A"]],
        ["A", []],
        ["B", ["A"]],
      ] as [string, string[]][];
      const output = {
        graph: {
          schemaVersion: 1,
          prdRevision: prd,
          issues: issues.map(([id, dependencies]) => ({
            id,
            title: id,
            artifactPath: `issues/${id}.md`,
            dependencies,
            acceptanceCriteria: ["Works"],
            testableBehaviors: ["Works"],
          })),
        },
        files: Object.fromEntries(
          issues.map(([id]) => [
            `issues/${id}.md`,
            `# ${id}\n## Context\nGreenfield\n## Implementation\nBuild ${id}\n## Tests\nWorks\n## Acceptance criteria\nWorks\n## Dependencies\nSee graph`,
          ]),
        ),
      };
      mutate?.(output);
      fake.respond(JSON.stringify(output));
    }
    return dispatch(job);
  };
  return { project, fake, store, adapter, router };
}

test("approved explanation automatically hands exact PRD to a fresh issue session and approves the local diamond together", async () => {
  const { project, store, adapter, router } = await fixture();
  try {
    adapter.requestUserInput = async (request) => ({
      ok: true,
      ...request,
      source: "user",
      messageId: `human-${request.requestId}`,
      text: `approve ${request.revision}`,
    });
    const run = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Diamond", {
        workspace: project.directory,
        sessionId: "main",
      }),
    );
    expect(run.planning.phase).toBe("execution_approved");
    const jobs = Object.values((await store.getRun(run.runId))?.jobs ?? {});
    const prd = jobs.find((job) => job.envelope.role === "prd");
    const issues = jobs.find((job) => job.envelope.role === "issues");
    expect(issues?.envelope.sessionId).not.toBe(prd?.envelope.sessionId);
    expect(issues?.envelope.prompt).toContain(run.planning.prd.hash);
    expect(issues?.envelope.inputRevisions.prd).toBe(run.planning.prd.revision);
    expect(run.planning.graph.order).toEqual(["A", "B", "C", "D"]);
    const { dirname } = await import("node:path");
    for (const id of run.planning.graph.order) {
      expect(
        await readFile(
          join(
            project.directory,
            dirname(run.planning.graph.artifactPath),
            `issues/${id}.md`,
          ),
          "utf8",
        ),
      ).toContain(`# ${id}`);
    }
    expect(run.planning.executionApproval.prdHash).toBe(run.planning.prd.hash);
    expect(run.planning.executionApproval.graphHash).toBe(
      run.planning.graph.hash,
    );
    expect(jobs.map((job) => job.envelope.role)).toEqual([
      "interview",
      "prd",
      "issues",
    ]);
    expect(
      await readFile(
        join(project.directory, run.planning.graph.artifactPath),
        "utf8",
      ),
    ).toContain('"schemaVersion": 1');
  } finally {
    await project.cleanup();
  }
});

