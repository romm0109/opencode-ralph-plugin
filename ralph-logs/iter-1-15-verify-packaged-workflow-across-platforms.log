import { assertDispatchAllowed, handleControlCommand } from "./control.js";
import { orchestrateFeature } from "./orchestrator.js";
import {
  type ProjectSetupOptions,
  projectStatus,
  setupProject,
} from "./project-setup.js";
export function createCommandRouter(
  store: RunStore,
  adapter?: OpenCodeAdapter,
  dashboardUrl?: string,
  workspace?: string,
) {
  return {
    projectStatus,
    async continuePlanning(runId: string) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      return continuePlanning(store, adapter, runId);
    },
    async answerExecutorQuestion(
      runId: string,
      issueId: string,
      response: UserInputResult,
    ) {
      return answerExecutorQuestion(store, runId, issueId, response);
    },
    async scheduleIssues(runId: string, options: AttemptOptions = {}) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      await assertDispatchAllowed(store, runId);
      return scheduleReadyIssues(store, adapter, runId, options);
    },
    async executeIssue(
      runId: string,
      issueId: string,
      options: AttemptOptions = {},
    ) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      await assertDispatchAllowed(store, runId);
      return runIssue(store, adapter, runId, issueId, options);
    },
    async setupProject(options: ProjectSetupOptions) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      return setupProject({ ...options, store, adapter });
    },
    async reviewFeature(
      options: Omit<ReviewCoordinatorOptions, "store" | "adapter">,
    ) {
      await assertDispatchAllowed(store, options.runId);
      return coordinateReviewRound({
        ...options,
        store,
        ...(adapter ? { adapter } : {}),
      });
    },
    async reviewFunctional(
      snapshot: ReviewSnapshot,
      options: Omit<FunctionalReviewOptions, "store" | "adapter">,
    ) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      await assertDispatchAllowed(store, snapshot.runId);
      return runFunctionalReview(snapshot, { ...options, store, adapter });
    },
    async reviewCode(
      snapshot: ReviewSnapshot,
      options: Omit<CodeReviewOptions, "store" | "adapter">,
    ) {
      if (!adapter) throw new Error("No OpenCode adapter supplied");
      await assertDispatchAllowed(store, snapshot.runId);
      return reviewCompletedCode(snapshot, { ...options, store, adapter });
    },
    async runJob(job: JobEnvelope): Promise<JobResult> {
      if (!adapter)
        return {
          ...job,
          outcome: "failed",
          evidence: [],
          error: {
            code: "unsupported",
            message: "No OpenCode adapter supplied",
          },
        };
      await store.createRun(job.runId);
      await assertDispatchAllowed(store, job.runId);
      return adapter.dispatchJob(job);
    },
    async status(runId?: string): Promise<string> {
      const projectSetup = workspace
        ? await projectStatus(workspace)
        : undefined;
      const run = runId
        ? await store.getRun(runId)
        : (await store.listRuns()).at(-1);
      return run
        ? JSON.stringify(
            {
              ...(dashboardUrl ? { dashboardUrl } : {}),
              ...(projectSetup ? { projectSetup } : {}),
              runId: run.runId,
              revision: run.revision,
              phase: run.phase,
              control: run.control ?? null,
              lastResult: run.lastResult ?? null,
              ...(run.review ? { review: run.review } : {}),
              ...(run.reviewWorkflow
                ? { reviewWorkflow: run.reviewWorkflow }
                : {}),
              ...(run.planning ? { planning: run.planning } : {}),
              ...(run.baseline
                ? {
                    baseline: run.baseline,
                    validationSkips: run.validationSkips ?? [],
                  }
                : {}),
              issueAttempts: run.issueAttempts ?? {},
              ...(run.execution ? { execution: run.execution } : {}),
              errors: run.errors,
            },
            null,
            2,
          )
        : dashboardUrl
          ? JSON.stringify({
              dashboardUrl,
              ...(projectSetup ? { projectSetup } : {}),
              message: "No Ralph run found.",
            })
          : projectSetup
            ? JSON.stringify({ projectSetup, message: "No Ralph run found." })
            : "No Ralph run found.";
    },
    async dispatch(command: string, args = "", context?: ProjectSetupOptions) {
      if (command === "ralph-orchestrator") {
        if (!context)
          throw new Error(
            "Feature planning requires the main session and workspace",
          );
        if (!adapter) throw new Error("No OpenCode adapter supplied");
        return JSON.stringify(
          await orchestrateFeature({
            ...context,
            feature: args,
            store,
            adapter,
          }),
          null,
          2,
        );
      }
      if (command === "ralph-commands") {
        if (!context)
          throw new Error(
            "Project setup requires the main session and workspace",
          );
        return JSON.stringify(await this.setupProject(context), null, 2);
      }
      if (["ralph-pause", "ralph-resume", "ralph-stop"].includes(command)) {
        const runId = args.trim() || (await store.listRuns()).at(-1)?.runId;
        if (!runId) throw new Error("No Ralph run found");
        const result = await handleControlCommand(
          command as "ralph-pause" | "ralph-resume" | "ralph-stop",
          runId,
          store,
          adapter,
        );
        if (command === "ralph-resume" && adapter) {
          const run = await store.getRun(runId);
          for (const attempt of Object.values(run?.issueAttempts ?? {}))
            if (
              attempt.status === "waiting" &&
              attempt.question &&
              !attempt.question.answer
            )
              handleExecutorQuestion(
                store,
                adapter,
                runId,
                attempt.issueId,
                attempt.question.request.requestId,
              );
        }
        return result;
      }
      if (command !== "ralph-status")
        throw new Error(`Unknown Ralph command: ${command}`);
      return this.status(args.trim() || undefined);
    },
  };
}
import { readReviewGit } from "../git/review-workspace.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { runCodeReview } from "./code-review.js";
import { createReviewSnapshot } from "./snapshot.js";

/** Scheduler handoff only; functional review and repair coordination have separate owners. */
export async function reviewIntegratedExecution(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  const run = await store.getRun(runId);
  if (
    !run ||
    (run.control && run.control.status !== "active") ||
    !run.execution?.issues.length ||
    run.execution.issues.some((i) => i.status !== "integrated")
  )
    return run;
  if (run.review) return run;
  const planning = run.planning;
  if (!planning?.graph || !planning.prd || !run.baseline?.workspace)
    throw new Error("Missing approved execution review inputs");
  const directory = run.baseline.workspace;
  const commit = (await readReviewGit(directory, ["rev-parse", "HEAD"])).trim();
  const integration = Object.values(run.operations)
    .filter(
      (operation) =>
        operation.kind === "integration.advance" &&
        operation.status === "completed",
    )
    .at(-1);
  if (!integration?.expectedNew || integration.expectedNew !== commit)
    throw new Error(
      "Integration workspace no longer matches the accepted feature commit",
    );
  const snapshot = await createReviewSnapshot({
    store,
    directory,
    runId,
    round: 1,
    commit,
    baseCommit: run.baseline.candidateCommit,
    prdRevision: planning.prd.hash,
    graph: {
      revision: planning.graph.hash,
      issues: planning.graph.value.issues,
    },
    evidenceRefs: Object.values(run.issueAttempts ?? {}).map(
      (attempt) =>
        `integration:${attempt.issueId}:${attempt.attempt}:${attempt.integratedCommit}`,
    ),
    approvedPlanning: true,
  });
  await runCodeReview(snapshot, {
    store,
    adapter,
    directory,
    parentSessionId: planning.sessionId,
    ...(planning.settings.models["code-review"]
      ? { model: planning.settings.models["code-review"] }
      : {}),
  });
  return store.getRun(runId);
}
