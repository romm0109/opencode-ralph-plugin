            ok: false,
            error: published.error ?? {
              code: "sdk-error",
              message: "Could not publish question",
            },
          };
      if (!response.ok) {
        const latest = await store.getRun(runId);
        if (latest?.planning?.pending?.requestId === state.pending.requestId)
