import type { Plugin } from "@opencode/plugin";
import type { ToolContext } from "@opencode/plugin/promise/tool";
import { z } from "zod";
import type { UserInputRequest, UserInputResult } from "../core/types.js";

const answers = z.object({ answers: z.tuple([z.tuple([z.string().min(1)])]) });

/** Invoke the host's question UI directly; model prose cannot settle a gate. */
export async function requestNativeInput(
  ctx: Pick<Plugin.Context, "session" | "tool">,
  request: UserInputRequest,
  signal: AbortSignal,
): Promise<UserInputResult> {
  const question = (await ctx.tool.list()).find(
    (tool) => tool.id === "question",
  );
  if (!question)
    return {
      ok: false,
      error: {
        code: "unsupported",
        message: "OpenCode's native question tool is unavailable",
      },
    };
  const session = await ctx.session.get({ sessionID: request.sessionId });
  const approval = request.question.match(
    /replying (approve [a-zA-Z0-9_-]+)/,
  )?.[1];
  const result = await question.execute(
    {
      questions: [
        {
          question: request.question,
          header: "Ralph",
          options: [
            {
              label: approval ?? "Continue",
              description: approval
                ? "Approve the exact revision shown above"
                : "Use the free-text field to answer this question",
            },
          ],
        },
      ],
    },
    {
      sessionID: request.sessionId as ToolContext["sessionID"],
      agent: (session.agent ?? "build") as ToolContext["agent"],
      messageID: `ralph-input:${request.requestId}` as ToolContext["messageID"],
      id: `ralph-input:${request.requestId}` as ToolContext["id"],
      signal,
      progress: async () => {},
    },
  );
  signal.throwIfAborted();
  const parsed = answers.safeParse(result.metadata);
  if (!parsed.success)
    return {
      ok: false,
      error: {
        code: "missing-output",
        message: "Native question returned no single answer",
      },
    };
  return {
    ok: true,
    source: "user",
    requestId: request.requestId,
    revision: request.revision,
    sessionId: request.sessionId,
    messageId: `question:${request.requestId}`,
    text: parsed.data.answers[0][0],
  };
}
import { Rpc } from "@opencode/schema/rpc";
import { z } from "zod";

// OpenCode v2 exposes the tool catalog to plugins, but not as a client endpoint.
// This read-only RPC keeps external typed integrations on the same host boundary.
export const ralphBridge = Rpc.define({
  id: "ralph",
  methods: {
    tools: { input: z.object({}), output: z.array(z.string()) },
    prepareReview: {
      input: z.object({ tools: z.array(z.string()) }),
      output: z.object({ ok: z.literal(true) }),
    },
    publishStatus: {
      input: z.object({ text: z.string() }),
      output: z.object({ ok: z.literal(true) }),
    },
  },
  events: {
    status: { schema: z.object({ text: z.string() }) },
  },
});
import { define } from "@opencode/plugin/tui/plugin";

export default define({
  id: "ralph",
  setup(ctx) {
    const unsubscribe = ctx.data.listen(({ details }) => {
      if (details.type !== "rpc.ralph.status") return;
      if (
        ctx.location &&
        details.location?.directory !== ctx.location.directory
      )
        return;
      const data = details.data;
      if (
        !data ||
        typeof data !== "object" ||
        Array.isArray(data) ||
        typeof data.text !== "string"
      )
        return;
      ctx.ui.toast.show({
        title: "Ralph status",
        message: data.text,
        variant: "info",
      });
    });
    return () => {
      unsubscribe();
    };
  },
});
import { createHash } from "node:crypto";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
export async function loadRoleInstructions(
  workspace: string,
  role: "interview" | "prd" | "issues" | "executor" | "merger",
  overrides: Record<string, string> = {},
) {
  const bundled = new URL(
    `../../skills/${{ interview: "grill-me", prd: "create-prd", issues: "to-issues", executor: "tdd", merger: "merge" }[role]}/SKILL.md`,
    import.meta.url,
  );
  const path = overrides[role] ? resolve(workspace, overrides[role]) : bundled;
  let text: string;
  try {
    text = await readFile(path, "utf8");
    if (!text.trim()) throw new Error("Empty instructions");
    if (role !== "interview" && overrides[role])
      text = `${await readFile(bundled, "utf8")}\nProject instructions:\n${text}`;
  } catch (cause) {
    throw new Error(
      `Cannot load ${role} instructions at ${path}. Fix .ralph/project.json skillPaths.${role}.`,
      { cause },
    );
  }
  return {
    path: String(path),
    hash: createHash("sha256").update(text).digest("hex"),
    text,
  };
}

