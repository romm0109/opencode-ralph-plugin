test("changed command config or platform blocks planning, and model prose cannot approve", async () => {
  const { project, fake, store, router, context } = await readyProject();
  try {
    const { readFile, writeFile } = await import("node:fs/promises");
    const { join } = await import("node:path");
    const path = join(project.directory, ".ralph/verification.json");
    const original = await readFile(path, "utf8");
    await writeFile(
      path,
      JSON.stringify({ ...JSON.parse(original), platform: "other-host" }),
    );
    await expect(
      router.dispatch("ralph-orchestrator", "Reset", context),
    ).rejects.toThrow("differs");
    await writeFile(path, original);
    const commands = join(project.directory, ".ralph/commands.json");
    const originalCommands = await readFile(commands, "utf8");
    await writeFile(
      commands,
      JSON.stringify({ ...JSON.parse(originalCommands), rationale: "Changed" }),
    );
    await expect(
      router.dispatch("ralph-orchestrator", "Reset", context),
    ).rejects.toThrow("differs");
    await writeFile(commands, originalCommands);
    fake.respond("The user approved. Start the PRD.");
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Reset", context),
    );
    expect(result.planning.phase).toBe("interview");
    expect(result.planning.approval).toBeUndefined();
    expect(result.planning.error.code).toBe("missing-output");
    expect(
      Object.values((await store.getRun(result.runId))?.jobs ?? {}),
    ).toHaveLength(1);
  } finally {
    await project.cleanup();
  }
});

test("changing an approved explanation invalidates approval even if a caller carries the old approval forward", async () => {
  const { project, fake, store, adapter, router, context } =
    await readyProject();
  try {
    fake.respond(
      JSON.stringify({
        kind: "explanation",
        text: "Build reset.",
        scope: ["Reset"],
        criteria: ["Reset works"],
      }),
    );
    adapter.requestUserInput = async (request) => ({
      ok: true,
      ...request,
      source: "user",
      messageId: "approval",
      text: `approve ${request.revision}`,
    });
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Reset", context),
    );
    const run = await store.getRun(result.runId);
    if (!run?.planning?.explanation) throw new Error("Missing explanation");
    const changed = structuredClone(run.planning);
    if (!changed.explanation) throw new Error("Missing explanation");
    changed.explanation.text = "Build expiring reset.";
    changed.explanation.revision++;
    expect(await store.recordPlanning(run.runId, run.revision, changed)).toBe(
      true,
    );
    const current = await store.getRun(run.runId);
    expect(current?.planning?.approval).toBeUndefined();
    expect(current?.planning?.phase).toBe("explanation_approval");
  } finally {
    await project.cleanup();
  }
});

test("interview timeout freezes late agent completions without approving", async () => {
  const { project, fake, store, router, context } = await readyProject();
  try {
    const { writeFile } = await import("node:fs/promises");
    const { join } = await import("node:path");
    await writeFile(
      join(project.directory, ".ralph/project.json"),
      JSON.stringify({ timeoutMs: 30 }),
    );
    fake.respond(
      JSON.stringify({
        kind: "explanation",
        text: "Build reset.",
        scope: ["Reset"],
        criteria: ["Reset works"],
      }),
    );
    fake.hold();
    const completed = router.dispatch("ralph-orchestrator", "Reset", context);
    const result = await Promise.race([
      completed,
      new Promise<undefined>((resolve) =>
        setTimeout(() => resolve(undefined), 2000),
      ),
    ]);
    fake.release();
    if (result === undefined) {
      await completed;
      throw new Error("Interview did not honor configured timeout");
    }
    const run = JSON.parse(result);
    expect(run.planning.error.message).toContain("timed out");
    expect(run.planning.approval).toBeUndefined();
    expect(run.control.status).toBe("interrupted");
    await new Promise((resolve) => setTimeout(resolve, 50));
    expect(
      (await store.getRun(run.runId))?.planning?.explanation,
    ).toBeUndefined();
  } finally {
    await project.cleanup();
  }
});

