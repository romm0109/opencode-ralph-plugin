    }
    const latest = await store.getRun(runId);
    if (
      !latest?.planning ||
      latest.planning.turn !== state.turn ||
      latest.planning.pending ||
      latest.planning.phase !== "interview" ||
      (latest.control && latest.control.status !== "active")
