import { randomUUID } from \"node:crypto\";
import { lstat, mkdir, realpath, rename, rm, writeFile } from \"node:fs/promises\";
import { join } from \"node:path\";
import { z } from \"zod\";
import { commandConfigHash } from \"../config/commands.js\";
import { loadProjectConfig } from \"../config/project.js\";
import { readReviewGit } from \"../git/review-workspace.js\";
import type { RunStore } from \"../state/run-store.js\";
import { explanationHash } from \"./artifacts.js\";
import { assertPlanningOwner } from \"./completion.js\";

export const planningFileInput = z.object({
  runId: z.string().regex(/"'^feature-[A-Za-z0-9-]+$/),
  attempt: z.number().int().positive(),
  path: z.literal("PRD.md"),
  content: z.string().trim().min(1),
}).strict();

async function stat(path: string) {
  try { return await lstat(path); }
  catch (cause) {
    if ((cause as NodeJS.ErrnoException).code !== "ENOENT") throw cause;
    return undefined;
  }
}

/** A stage-relative filename is the entire writable namespace. No source paths. */
export async function writePlanningFile(store: RunStore, input: z.infer<typeof planningFileInput>, sessionId: string) {
  const value = planningFileInput.parse(input);
  const { run, state } = await assertPlanningOwner(store, value.runId, value.attempt, sessionId);
  if (state.owner?.stage !== "prd" || state.phase !== "prd_generation" ||
      !state.approval || !state.explanation || state.prd ||
      state.approval.hash !== explanationHash(state.explanation) ||
      state.approval.revision !== state.explanation.revision ||
      state.approval.sessionId !== sessionId)
    throw new Error("Planning writer requires the authorized owning PRD draft stage");
  const config = await loadProjectConfig(state.workspace);
  if (commandConfigHash(config.commands) !== state.approval.commandHash ||
      (await readReviewGit(state.workspace, ["rev-parse", "HEAD"])).trim() !== state.approval.sha)
    throw new Error("Approved commit or configuration changed; renew explanation approval");
  let directory = await realpath(state.workspace);
  for (const part of [".ralph", "features", value.runId, `prd-draft-${value.attempt}`]) {
    directory = join(directory, part);
    const info = await stat(directory);
    if (info && (info.isSymbolicLink() || !info.isDirectory()))
      throw new Error("Planning draft ancestors must be real directories, never symlinks");
    if (!info) await mkdir(directory);
    if ((await lstat(directory)).isSymbolicLink() || await realpath(directory) !== directory)
      throw new Error("Planning draft symlink escape denied");
  }
  const target = join(directory, value.path);
  const existing = await stat(target);
  if (existing && (existing.isSymbolicLink() || !existing.isFile()))
    throw new Error("Planning file symlink or non-file denied");
  const temporary = join(directory, `.write-${randomUUID()}`);
  try {
    await writeFile(temporary, input.content, { flag: "wx" });
    const latest = await assertPlanningOwner(store, value.runId, value.attempt, sessionId);
    if (latest.run.revision !== run.revision) throw new Error("Stale planning write; retry from current state");
    await rename(temporary, target);
  } finally { await rm(temporary, { force: true }); }
  return { outcome: "accepted", path: `.ralph/features/${value.runId}/prd-draft-${value.attempt}/PRD.md` };
}
