export async function generatePrd(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if (
    !state?.explanation ||
    !state.approval ||
    state.approval.hash !== explanationHash(state.explanation) ||
    state.approval.revision !== state.explanation.revision
  )
    throw new Error("An approved explanation is required");
  try {
    const config = await loadProjectConfig(state.workspace);
    const skill = await loadRoleInstructions(
      state.workspace,
      "prd",
      config.skillPaths,
    );
    const generated = await dispatchGeneration(
      store,
      adapter,
      runId,
      "prd",
      `${skill.text}\nRepository: ${state.workspace}\nApproved explanation: ${JSON.stringify(state.explanation)}\nTranscript: ${JSON.stringify(state.transcript)}`,
      { prd: { path: skill.path, hash: skill.hash } },
    );
    if (!generated) return store.getRun(runId);
    const { text } = z
      .object({ text: z.string().trim().min(1) })
      .strict()
      .parse(JSON.parse(generated.result.text ?? ""));
    for (const heading of [
      "Problem",
      "User stories",
      "Requirements",
      "Acceptance criteria",
      "Non-goals",
    ])
      if (!text.toLowerCase().includes(`## ${heading.toLowerCase()}`))
        throw new Error(`PRD missing ${heading}`);
    const revision = (generated.state.prd?.revision ?? 0) + 1;
    const publication = await publishRevision(
      store,
      generated.run.revision,
      generated.state,
      runId,
      `prd-${generated.state.generation?.revision}`,
      { "PRD.md": text },
    );
    generated.state.prd = {
      revision,
      hash: artifactHash(text),
      artifactPath: `${publication.directory}/PRD.md`,
    };
    delete generated.state.executionApproval;
    await savePlanning(store, runId, publication.revision, generated.state);
  } catch (cause) {
    await planningFailure(store, runId, cause);
    return store.getRun(runId);
  }
  return generateIssues(store, adapter, runId);
}
