test(\"native explanation rejection requires a new displayed revision and scope changes revoke the writer\", async () => {
  const { startNativeFeature } = await import(\"../../src/commands/orchestrator.js\");
  const { completeInterview } = await import(\"../../src/planning/completion.js\");
  const { writePlanningFile } = await import(\"../../src/planning/artifact-writer.js\");
  const { project, fake, adapter, store, context } = await readyProject();
  try {
    adapter.discoverTools = async () => [\"question\"];
    adapter.requestUserInput = async (request) => ({ ok: true, ...request, source: \"user\", messageId: \"feature\", text: \"Reset\" });
    fake.respond(\"Ready\");
    const run = await startNativeFeature({ ...context, adapter, store });
    if ("'!run?.planning) throw new Error("Missing run");
    const session = run.planning.sessionId;
    const proposal = { runId: run.runId, attempt: 1, text: "Build reset", scope: ["Reset"], criteria: ["Expired tokens fail"] };
    let approvals = 0;
    adapter.requestUserInput = async (request) => {
      approvals++;
      expect(request.revision).toBe(approvals);
      return { ok: true, ...request, source: "user", messageId: `human-${approvals}`, text: approvals === 2 ? request.options?.[0]?.label ?? "" : "Use shorter expiry" };
    };
    await expect(completeInterview(store, adapter, { ...proposal, attempt: 2 }, session)).rejects.toThrow("ownership");
    await expect(completeInterview(store, adapter, { ...proposal, answer: "approve" } as never, session)).rejects.toThrow();
    expect((await completeInterview(store, adapter, proposal, session)).outcome).toBe("correctable-invalid");
    expect((await store.getRun(run.runId))?.planning?.phase).toBe("interview");
    expect(fake.requests.some(r => String(r.body.text).includes("**15. Appendix**"))).toBe(false);
    expect((await completeInterview(store, adapter, { ...proposal, criteria: ["Tokens expire after ten minutes"] }, session)).outcome).toBe("accepted");
    const approved = (await store.getRun(run.runId))?.planning;
    expect(approved?.approval?.revision).toBe(2);
    expect(approved?.approval?.sha).toBe(project.commit);
    expect(approved?.approval?.commandRevision).toBe(1);
    const { mkdir, symlink, readFile } = await import("node:fs/promises");
    const { join } = await import("node:path");
    const feature = join(project.directory, ".ralph/features", run.runId);
    await mkdir(feature, { recursive: true });
    await symlink(project.directory, join(feature, "prd-draft-1"));
    await expect(writePlanningFile(store, { runId: run.runId, attempt: 1, path: "PRD.md", content: "# Draft" }, session)).rejects.toThrow("symlink");
    await expect(readFile(join(project.directory, "PRD.md"))).rejects.toThrow();
    // New scope is displayed and rejected. It must revoke the old scope immediately.
    expect((await completeInterview(store, adapter, { ...proposal, scope: ["Reset", "Email delivery"] }, session)).outcome).toBe("correctable-invalid");
    const revised = (await store.getRun(run.runId))?.planning;
    expect(revised?.approval).toBeUndefined();
    expect(revised?.prdDelivery).toBeUndefined();
    expect(revised?.owner?.stage).toBe("interview");
    await expect(writePlanningFile(store, { runId: run.runId, attempt: 1, path: "PRD.md", content: "# Draft" }, session)).rejects.toThrow("authorized");
  } finally { await project.cleanup(); }
});

test("native approval rejects stale results and repeated completion reports the recorded request", async () => {
  const { startNativeFeature } = await import("../../src/commands/orchestrator.js");
  const { completeInterview } = await import("../../src/planning/completion.js");
  const { handleInterviewResponse } = await import("../../src/planning/interview.js");
  const { project, fake, adapter, store, context } = await readyProject();
  try {
    adapter.discoverTools = async () => ["question"];
    adapter.requestUserInput = async (request) => ({ ok: true, ...request, source: "user", messageId: "feature", text: "Reset" });
    fake.respond("Ready");
    const run = await startNativeFeature({ ...context, adapter, store });
    if (!run?.planning) throw new Error("Missing run");
    const proposal = { runId: run.runId, attempt: 1, text: "Reset", scope: ["Reset"], criteria: ["Works"] };
    let count = 0;
    adapter.requestUserInput = async request => {
      count++;
      return { ok: true, ...request, sessionId: "foreign", source: "user", messageId: "wrong-session", text: request.options?.[0]?.label ?? "" };
    };
    expect((await completeInterview(store, adapter, proposal, run.planning.sessionId)).outcome).toBe("stale");
    const pending = (await store.getRun(run.runId))?.planning?.pending;
    if (!pending) throw new Error("Missing request");
    for (const patch of [{ source: "assistant" }, { revision: pending.revision + 1 }, { requestId: "other" }]) {
      expect(await handleInterviewResponse(store, run.runId, { ok: true, ...pending, source: "user", messageId: "fabricated", text: pending.options?.[0]?.label ?? "", ...patch } as never)).toBe(false);
    }
    expect((await completeInterview(store, adapter, proposal, run.planning.sessionId)).outcome).toBe("already-requested");
    expect(count).toBe(1);
    expect((await store.getRun(run.runId))?.planning?.approval).toBeUndefined();
    expect(fake.requests.some(r => String(r.body.text).includes("**15. Appendix**"))).toBe(false);
  } finally { await project.cleanup(); }
