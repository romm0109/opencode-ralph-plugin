  criteria: z.array(z.string().trim().min(1)).min(1),
}).strict();

export async function assertPlanningOwner(store: RunStore, runId: string, attempt: number, sessionId: string) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if ("'!run || !state || state.protocol !== "native-interview-v1" ||
      !state.owner || state.owner.sessionId !== sessionId ||
      state.sessionId !== sessionId || state.owner.attempt !== attempt ||
      (run.control && run.control.status !== "active"))
    throw new Error("Stale or inactive planning ownership; inspect /ralph-status");
  return { run, state };
}

export async function completeInterview(store: RunStore, adapter: OpenCodeAdapter, input: z.infer<typeof completeInterviewInput>, sessionId: string) {
  const value = completeInterviewInput.parse(input);
  const { run, state } = await assertPlanningOwner(store, value.runId, value.attempt, sessionId);
  const hash = explanationHash(value);
  if (state.approval && state.explanation?.hash === hash) {
    await queueApprovedPrd(store, adapter, run.runId);
    return { outcome: "already-completed", revision: state.explanation.revision, requestId: state.approval.requestId };
  }
  if (state.approval && state.owner?.stage !== "prd")
    return { outcome: "blocked", message: "The approved explanation cannot be replaced in this stage" };
  if (state.pending && state.phase !== "explanation_approval")
    return { outcome: "blocked", requestId: state.pending.requestId, message: "Resolve the pending native question first" };
  if (state.phase === "explanation_approval" && state.pending && state.explanation?.hash !== hash)
    return { outcome: "blocked", requestId: state.pending.requestId, message: "An explanation is already displayed; answer it before proposing changes" };
  if (!state.pending) {
    const config = await loadProjectConfig(state.workspace);
    const commandHash = commandConfigHash(config.commands);
    if (commandHash !== state.commandHash)
      return { outcome: "blocked", message: "Command configuration changed; restore approved commands before continuing" };
    const sha = (await readReviewGit(state.workspace, ["rev-parse", "HEAD"])).trim();
    const branch = (await readReviewGit(state.workspace, ["rev-parse", "--abbrev-ref", "HEAD"])).trim();
    const revision = (state.explanation?.revision ?? 0) + 1;
    const label = `Approve revision ${revision}: PRD creation, issue planning, and implementation`;
    const next = structuredClone(state);
    next.explanation = { revision, hash, text: value.text, scope: value.scope, criteria: value.criteria };
    next.proposalContext = { sha, branch, commandHash, commandRevision: config.commands.revision };
    next.phase = "explanation_approval";
    delete next.approval;
    delete next.prdDelivery;
    next.pending = {
      kind: "explanation", runId: run.runId, sessionId, workspace: state.workspace,
      requestId: randomUUID(), revision,
      question: `${value.text}'"\\nScope:\\n"'${value.scope.join("'"\\n\")}\\nAcceptance criteria:\\n"'${value.criteria.join("'"\\n\")}\\nBranch: "'${branch}'"\\nFull pinned HEAD SHA: "'${sha}'"\\nCommand revision: "'${config.commands.revision}'"\\nCommand hash: "'${commandHash}'"\\nApprove revision "'${revision} to authorize PRD creation, issue planning, and automatic execution through implementation within this scope. Reject or request changes to return to grilling.`,
      options: [ { label, description: "Authorize all three stages within this displayed scope, commit, and configuration" }, { label: "Request changes", description: "Return to grilling without authorization" } ],
    };
    await savePlanning(store, run.runId, run.revision, next);
  }
  const current = await assertPlanningOwner(store, run.runId, value.attempt, sessionId);
  const pending = current.state.pending;
  if (!pending) return { outcome: "stale", message: "The displayed request is no longer pending" };
  const response = await adapter.requestUserInput(pending);
  if (!response.ok) return { outcome: "blocked", requestId: pending.requestId, error: response.error };
  if (!(await handleInterviewResponse(store, run.runId, response)))
    return { outcome: "stale", requestId: pending.requestId, message: "Native result does not match current ownership, revision, commit or configuration" };
  const latest = await store.getRun(run.runId);
  if (!latest?.planning?.approval)
    return { outcome: "correctable-invalid", message: "Approval rejected. Continue grilling and propose a new revision." };
  await queueApprovedPrd(store, adapter, run.runId);
  return { outcome: "accepted", revision: latest.planning.explanation?.revision, requestId: pending.requestId };
}
