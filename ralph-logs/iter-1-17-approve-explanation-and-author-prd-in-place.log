      }
      if (!(await handleInterviewResponse(store, runId, response)))
        return store.getRun(runId);
      continue;
    }
    if (state.phase === "explanation_approval" && state.explanation) {
      const artifact = state.explanation;
      state.pending = {
        runId,
        workspace: state.workspace,
        sessionId: state.sessionId,
        requestId: randomUUID(),
        revision: artifact.revision,
        question: `${artifact.text}\nScope:\n${artifact.scope.join("\n")}\nAcceptance criteria:\n${artifact.criteria.join("\n")}\nApprove revision ${artifact.revision} by replying approve ${artifact.revision}, or reply with revisions.`,
      };
      await save(store, runId, run.revision, state);
      continue;
    }
    if (!state.feature) {
      state.pending = {
        runId,
        workspace: state.workspace,
        sessionId: state.sessionId,
        requestId: randomUUID(),
        revision: 0,
        question: "What feature should we build? Describe the result you need.",
      };
      await save(store, runId, run.revision, state);
      continue;
    }
    state.turn++;
    await save(store, runId, run.revision, state);
    const selectedModel = state.settings.models.interview;
    if (!selectedModel)
      throw new Error("Planning run has no captured interview model");
