    if (
      state.protocol === "native-interview-v1" &&
      parsed.kind === "explanation"
    ) {
      // This slice has no explanation completion or approval transition.
      return latest;
    }
    next.transcript.push({ source: "interviewer", text: result.text });
    let question: string;
    if (parsed.kind === "question")
      question = `${parsed.question}\nRecommended: ${parsed.recommendation}`;
    else {
      const revision = (next.explanation?.revision ?? 0) + 1;
      next.explanation = {
        revision,
        hash: explanationHash(parsed),
        text: parsed.text,
        scope: parsed.scope,
        criteria: parsed.criteria,
      };
      delete next.approval;
      next.phase = "explanation_approval";
      question = `${parsed.text}\nScope:\n${parsed.scope.join("\n")}\nAcceptance criteria:\n${parsed.criteria.join("\n")}\nApprove revision ${revision} by replying approve ${revision}, or reply with revisions.`;
    }
    next.pending = {
      runId,
      sessionId: next.sessionId,
      workspace: next.workspace,
      requestId: randomUUID(),
      revision: next.explanation?.revision ?? 0,
      question,
      ...(state.protocol === "native-interview-v1" && parsed.kind === "question"
        ? { kind: "interview" as const, recommendation: parsed.recommendation }
        : {}),
    };
    await save(store, runId, latest.revision, next);
  }
}
export async function startInterview(options: InterviewOptions) {
  const { store, adapter, sessionId } = options;
  const workspace = await realpath(options.workspace);
  await verifyReviewRepository(workspace, store.repositoryId);
  await assertProjectConfigured(workspace);
  const config = await loadProjectConfig(workspace);
  const skill = await loadRoleInstructions(
    workspace,
    "interview",
    config.skillPaths,
  );
  const model =
    config.models.interview ?? (await adapter.getSessionModel?.(sessionId));
  if (!model)
    throw new Error(
      "Main session model is unavailable. Set models.interview in .ralph/project.json.",
    );
  if (
    options.native &&
    (!adapter.createInterviewSession ||
      !(await adapter.discoverTools?.(workspace))?.includes("question"))
  )
    throw new Error(
      "OpenCode native question capability is unavailable. Enable the question tool before starting /ralph-orchestrator.",
    );
  if (options.native) {
    for (const existing of await store.listRuns()) {
      if (
        existing.planning &&
        existing.control?.status !== "stopped" &&
        existing.phase !== "completed"
      ) {
        if (existing.planning.protocol !== "native-interview-v1")
          throw new Error(
            "Unsupported planning protocol owns this repository. Inspect /ralph-status and settle /ralph-stop before starting fresh; no migration is available.",
          );
        throw new Error(
          `Interview ${existing.runId} already owns this repository (${existing.planning.phase}). Inspect /ralph-status; use /ralph-stop before starting a fresh interview.`,
        );
      }
    }
  }
  const lock = join(store.root, "active-run.lock");
  try {
    await mkdir(lock);
  } catch (cause) {
    throw new Error(
      "A feature run already owns this repository. Inspect /ralph-status; interrupted locks require reconciliation.",
      { cause },
    );
  }
  const runId = `feature-${randomUUID()}`;
  let created = false;
  try {
    await writeFile(
      join(lock, "owner.json"),
      JSON.stringify({ runId, repositoryId: store.repositoryId }),
    );
    await assertProjectConfigured(workspace);
    const setup = await projectStatus(workspace);
    if (!setup.hash || setup.hash !== commandConfigHash(config.commands))
      throw new Error(
        "Configuration changed during interview startup; verify project commands again",
      );
    const run = await store.createRun(runId);
    created = true;
    let interviewSession = sessionId;
    if (options.native) {
      if (!adapter.createInterviewSession)
        throw new Error("Interview sessions are unavailable");
      interviewSession = await adapter.createInterviewSession(
        workspace,
        runId,
        model,
      );
    }
    await save(store, runId, run.revision, {
      ...(options.native
        ? {
            protocol: "native-interview-v1" as const,
            owner: {
              stage: "interview" as const,
              sessionId: interviewSession,
              attempt: 1,
            },
            pending: {
              kind: "feature" as const,
              runId,
              workspace,
              sessionId: interviewSession,
              requestId: randomUUID(),
              revision: 0,
              options: options.feature?.trim()
                ? [
                    {
                      label: options.feature.trim(),
                      description:
                        "Confirm this feature, or enter your changes",
                    },
                  ]
                : [],
              question:
                "What feature should we build? Describe the result you need." +
                (options.feature?.trim()
                  ? `\nSuggested feature: ${options.feature.trim()}\nConfirm this description or enter your changes.`
                  : ""),
            },
          }
        : {}),
      phase: "interview",
      workspace,
      sessionId: interviewSession,
      feature: options.native ? "" : (options.feature?.trim() ?? ""),
      commandHash: setup.hash,
      settings: {
        concurrency: config.concurrency,
        timeoutMs: config.timeoutMs,
        agentTimeoutMs: config.agentTimeoutMs,
        models: {
          ...Object.fromEntries(
            ["executor", "merger", "code-review", "functional-review"].map(
              (role) => [role, model],
            ),
          ),
          ...config.models,
          interview: model,
        },
        skills: { interview: { path: skill.path, hash: skill.hash } },
      },
      transcript:
        !options.native && options.feature?.trim()
          ? [{ source: "user", text: options.feature.trim() }]
          : [],
      turn: 0,
    });
    if (options.native)
      await adapter.focusStageSession?.(workspace, runId, interviewSession);
    return await continueInterview(store, adapter, runId, skill.text);
  } catch (cause) {
    if (!created) await rm(lock, { recursive: true, force: true });
    else if (options.native) {
      const current = await store.getRun(runId);
      if (!current?.control || current.control.status === "active")
        await store.recordControl(
          runId,
          {
            status: "interrupted",
            source: "recovery",
            facts: [
              `Interview startup interrupted: ${String(cause)}. Inspect /ralph-status and settle /ralph-stop before restarting.`,
            ],
          },
          current?.revision,
        );
    }
    throw cause;
  }
}
import { z } from "zod";
import { loadRoleInstructions } from "../agents/skills.js";
import { loadProjectConfig } from "../config/project.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { artifactHash, explanationHash } from "./artifacts.js";
import {
  dispatchGeneration,
  planningFailure,
  publishRevision,
  savePlanning,
} from "./generation.js";
import { generateIssues } from "./issues.js";

export async function generatePrd(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if (
    !state?.explanation ||
    !state.approval ||
    state.approval.hash !== explanationHash(state.explanation) ||
    state.approval.revision !== state.explanation.revision
  )
    throw new Error("An approved explanation is required");
  try {
    const config = await loadProjectConfig(state.workspace);
    const skill = await loadRoleInstructions(
      state.workspace,
      "prd",
      config.skillPaths,
    );
    const generated = await dispatchGeneration(
      store,
      adapter,
      runId,
      "prd",
      `${skill.text}\nRepository: ${state.workspace}\nApproved explanation: ${JSON.stringify(state.explanation)}\nTranscript: ${JSON.stringify(state.transcript)}`,
      { prd: { path: skill.path, hash: skill.hash } },
    );
    if (!generated) return store.getRun(runId);
    const { text } = z
      .object({ text: z.string().trim().min(1) })
      .strict()
      .parse(JSON.parse(generated.result.text ?? ""));
    for (const heading of [
      "Problem",
      "User stories",
      "Requirements",
      "Acceptance criteria",
      "Non-goals",
    ])
      if (!text.toLowerCase().includes(`## ${heading.toLowerCase()}`))
        throw new Error(`PRD missing ${heading}`);
    const revision = (generated.state.prd?.revision ?? 0) + 1;
    const publication = await publishRevision(
      store,
      generated.run.revision,
      generated.state,
      runId,
      `prd-${generated.state.generation?.revision}`,
      { "PRD.md": text },
    );
    generated.state.prd = {
      revision,
      hash: artifactHash(text),
      artifactPath: `${publication.directory}/PRD.md`,
    };
    delete generated.state.executionApproval;
    await savePlanning(store, runId, publication.revision, generated.state);
  } catch (cause) {
    await planningFailure(store, runId, cause);
    return store.getRun(runId);
  }
  return generateIssues(store, adapter, runId);
}
import { randomUUID } from "node:crypto";
import { lstat, mkdir, rename, rm, writeFile } from "node:fs/promises";
import { join } from "node:path";
import type { JobEnvelope, JobResult } from "../core/types.js";
import { readReviewGit } from "../git/review-workspace.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { issueBundleHash } from "./artifacts.js";
import type { PlanningState } from "./types.js";

export async function savePlanning(
  store: RunStore,
  runId: string,
  revision: number,
  state: PlanningState,
) {
  if (!(await store.recordPlanning(runId, revision, state)))
    throw new Error("Stale planning transition");
}
export async function featureRoot(state: PlanningState, runId: string) {
  if (!/^feature-[A-Za-z0-9-]+$/.test(runId))
    throw new Error("Invalid feature ID");
  let path = state.workspace;
  for (const part of [".ralph", "features", runId]) {
    path = join(path, part);
    await mkdir(path, { recursive: true });
    if (
      !(await lstat(path)).isDirectory() ||
      (await lstat(path)).isSymbolicLink()
    )
      throw new Error("Feature path must be a real directory");
  }
  return path;
}
/** Rename a complete revision directory; never expose a partial bundle. */
export async function publishRevision(
  store: RunStore,
  expectedRevision: number,
  state: PlanningState,
  runId: string,
  name: string,
  files: Record<string, string>,
) {
  if (!/^(prd|graph)-[1-9][0-9]*$/.test(name))
    throw new Error("Invalid revision directory");
  const jobId = state.generation?.jobId;
  if (!jobId) throw new Error("Artifact publication requires a generation job");
  state.publication = {
    jobId,
    name,
    hash: issueBundleHash({ name }, files),
    status: "intent",
  };
  await savePlanning(store, runId, expectedRevision, state);
  const persisted = await store.getRun(runId);
  if (
    !persisted?.planning ||
    persisted.planning.publication?.jobId !== jobId ||
    persisted.planning.publication?.name !== name ||
    (persisted.control && persisted.control.status !== "active")
  )
    throw new Error("Stale artifact publication");
  const root = await featureRoot(state, runId);
  const staged = join(root, `.draft-${randomUUID()}`);
  await mkdir(staged);
  try {
    for (const [path, text] of Object.entries(files)) {
      if (!/^(PRD\.md|graph\.json|issues\/[A-Za-z0-9_-]+\.md)$/.test(path))
        throw new Error("Invalid artifact reference");
      if (path.startsWith("issues/"))
        await mkdir(join(staged, "issues"), { recursive: true });
      await writeFile(join(staged, path), text, { flag: "wx" });
    }
    await rename(staged, join(root, name));
  } finally {
    await rm(staged, { recursive: true, force: true });
  }
  state.publication.status = "completed";
  return {
    directory: `.ralph/features/${runId}/${name}`,
    revision: persisted.revision,
  };
}
export async function dispatchGeneration(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  role: "prd" | "issues",
  prompt: string,
  skills: PlanningState["settings"]["skills"],
) {
  const run = await store.getRun(runId);
  if (!run?.planning || (run.control && run.control.status !== "active"))
    return;
  const state = structuredClone(run.planning);
  const revision = (state.generation?.revision ?? 0) + 1;
  const jobId = `${role}-${revision}`;
  state.phase = role === "prd" ? "prd_generation" : "issue_generation";
  state.generation = { role, revision, jobId };
  state.settings.skills = { ...state.settings.skills, ...skills };
  delete state.pending;
  delete state.executionApproval;
  delete state.error;
  await savePlanning(store, runId, run.revision, state);
  const job: JobEnvelope = {
    runId,
    jobId,
    attempt: 1,
    role,
    workspace: state.workspace,
    baseCommit: (
      await readReviewGit(state.workspace, ["rev-parse", "HEAD"])
    ).trim(),
    readOnly: true,
    model:
      state.settings.models[role] ??
      state.settings.models.interview ??
      (() => {
        throw new Error("Missing planning model");
      })(),
    inputRevisions: {
      explanation: state.explanation?.revision ?? 0,
      prd: state.prd?.revision ?? 0,
      graph: state.graph?.revision ?? 0,
      generation: revision,
    },
    prompt,
  };
  let timer: ReturnType<typeof setTimeout> | undefined;
  let result: JobResult | undefined;
  try {
    result = await Promise.race([
      adapter.dispatchJob(job).catch(
        (cause): JobResult => ({
          ...job,
          outcome: "failed",
          evidence: [],
          error: {
            code: "sdk-error",
            message: "Planning dispatch failed",
            cause: String(cause),
          },
        }),
      ),
      new Promise<undefined>((resolve) => {
        timer = setTimeout(() => resolve(undefined), state.settings.timeoutMs);
      }),
    ]);
  } finally {
    if (timer) clearTimeout(timer);
  }
  const latest = await store.getRun(runId);
  if (
    !latest?.planning ||
    latest.planning.generation?.jobId !== jobId ||
    latest.planning.phase !== state.phase ||
    latest.planning.explanation?.hash !== state.explanation?.hash ||
    latest.planning.explanation?.revision !== state.explanation?.revision ||
    latest.planning.graph?.hash !== state.graph?.hash ||
    latest.planning.graph?.revision !== state.graph?.revision ||
    latest.planning.prd?.hash !== state.prd?.hash ||
    latest.planning.prd?.revision !== state.prd?.revision ||
    (latest.control && latest.control.status !== "active")
  )
    return;
  if (
    !result ||
    result.outcome !== "completed" ||
    !result.text ||
    !result.sessionId ||
    result.runId !== job.runId ||
    result.jobId !== job.jobId ||
    result.attempt !== job.attempt ||
    result.role !== role ||
    JSON.stringify(result.inputRevisions) !== JSON.stringify(job.inputRevisions)
  ) {
    await savePlanning(store, runId, latest.revision, {
      ...latest.planning,
      error: result?.error ?? {
        code: result ? "missing-output" : "cancelled",
        message: result ? "Planning returned no output" : "Planning timed out",
      },
    });
    if (!result) {
      await store.recordControl(runId, {
        status: "interrupted",
        source: "recovery",
        facts: ["Planning timed out"],
      });
      const bound = (await store.getRun(runId))?.jobs[jobId]?.envelope ?? job;
      await adapter.cancelJob(bound);
    }
    return;
  }
  return { run: latest, state: structuredClone(latest.planning), result };
}
export async function planningFailure(
  store: RunStore,
  runId: string,
  cause: unknown,
) {
  const latest = await store.getRun(runId);
  if (latest?.planning)
    await store.recordPlanning(runId, latest.revision, {
      ...latest.planning,
      error: {
        code: "missing-output",
        message: `Invalid planning output: ${String(cause)}`,
        cause: String(cause),
      },
    });
}
import type { UserInputResult } from "../core/types.js";
import type { PlanningState } from "./types.js";

export function approvalMatchesRevision(state: PlanningState) {
  const approval = state.executionApproval;
  return !!(
    approval &&
    state.prd &&
    state.graph &&
    approval.revision === state.graph.revision &&
    approval.prdHash === state.prd.hash &&
    approval.graphHash === state.graph.hash
  );
}
export function recordApproval(
  state: PlanningState,
  response: UserInputResult,
) {
  if (
    !response.ok ||
    response.source !== "user" ||
    !response.messageId ||
    !state.pending ||
    response.requestId !== state.pending.requestId ||
    response.sessionId !== state.sessionId ||
    response.revision !== state.graph?.revision ||
    response.text.trim() !== `approve ${state.graph.revision}` ||
    !state.prd
  )
    return false;
  state.executionApproval = {
    revision: state.graph.revision,
    ...(state.selectedCommit ? { selectedCommit: state.selectedCommit } : {}),
    prdHash: state.prd.hash,
    graphHash: state.graph.hash,
    requestId: response.requestId,
    messageId: response.messageId,
    timestamp: new Date().toISOString(),
  };
  state.phase = "execution_approved";
  return true;
}

