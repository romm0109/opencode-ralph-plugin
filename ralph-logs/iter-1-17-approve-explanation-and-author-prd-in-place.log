test(\"native approved prompt delivery retains intent on denial and retries without reapproving\", async () => {
  const { startNativeFeature } = await import(\"../../src/commands/orchestrator.js\");
  const { completeInterview } = await import(\"../../src/planning/completion.js\");
  const { project, fake, adapter, store, context } = await readyProject();
  try {
    adapter.discoverTools = async () => [\"question\"];
    adapter.requestUserInput = async request => ({ ok: true, ...request, source: \"user\", messageId: \"feature\", text: \"Reset\" });
    fake.respond(\"Ready\");
    const run = await startNativeFeature({ ...context, adapter, store });
    if ("'!run?.planning) throw new Error("Missing run");
    let approvals = 0;
    adapter.requestUserInput = async request => {
      approvals++;
      return { ok: true, ...request, source: "user", messageId: "approval", text: request.options?.[0]?.label ?? "" };
    };
    const queue = adapter.queueStagePrompt;
    adapter.queueStagePrompt = async () => { throw new Error("Permission denied by host"); };
    const proposal = { runId: run.runId, attempt: 1, text: "Reset", scope: ["Reset"], criteria: ["Works"] };
    await expect(completeInterview(store, adapter, proposal, run.planning.sessionId)).rejects.toThrow("Permission denied");
    const intent = (await store.getRun(run.runId))?.planning?.prdDelivery;
    expect(intent?.status).toBe("intent");
    expect(intent?.id).toStartWith("msg_");
    adapter.queueStagePrompt = queue;
    expect((await completeInterview(store, adapter, proposal, run.planning.sessionId)).outcome).toBe("already-completed");
    expect(approvals).toBe(1);
    expect((await store.getRun(run.runId))?.planning?.prdDelivery?.status).toBe("queued");
    expect(fake.requests.filter(r => r.body.id === intent?.id)).toHaveLength(1);
