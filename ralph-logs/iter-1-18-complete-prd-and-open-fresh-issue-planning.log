    await savePlanning(store, runId, latest.revision, {
      ...latest.planning,
      error: result?.error ?? {
        code: result ? "missing-output" : "cancelled",
        message: result ? "Planning returned no output" : "Planning timed out",
      },
    });
    if (!result) {
      await store.recordControl(runId, {
        status: "interrupted",
        source: "recovery",
        facts: ["Planning timed out"],
      });
      const bound = (await store.getRun(runId))?.jobs[jobId]?.envelope ?? job;
