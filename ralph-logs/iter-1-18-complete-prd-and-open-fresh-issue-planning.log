test("historical planning API: feature input is collected in the main session and an assistant response cannot approve", async () => {
  const { project, fake, store, adapter, router, context } =
    await readyProject();
  try {
    fake.respond(
      JSON.stringify({
        kind: "explanation",
        text: "Build reset.",
        scope: ["Reset"],
        criteria: ["Reset works"],
      }),
    );
    let count = 0;
    adapter.requestUserInput = async (request) => {
      expect(
        (await store.getRun(request.runId))?.planning?.pending?.requestId,
      ).toBe(request.requestId);
      count++;
      if (count === 1)
        return {
          ok: true,
          ...request,
          source: "user",
          messageId: "feature",
          text: "Add reset",
        };
      return {
        ok: true,
        ...request,
        source: "assistant",
        messageId: "fabricated",
        text: `approve ${request.revision}`,
      } as unknown as import("../../src/core/types.js").UserInputResult;
    };
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "", context),
    );
    expect(result.planning.feature).toBe("Add reset");
    expect(result.planning.phase).toBe("explanation_approval");
    expect(result.planning.approval).toBeUndefined();
    expect(
      result.planning.transcript.some(
        (entry: { messageId?: string }) => entry.messageId === "fabricated",
      ),
    ).toBe(false);
  } finally {
    await project.cleanup();
  }
});

