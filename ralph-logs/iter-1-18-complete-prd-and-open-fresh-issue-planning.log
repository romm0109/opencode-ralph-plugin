export const completePrdInput = z.object({
  runId: z.string().regex(/"'^feature-[A-Za-z0-9-]+$/),
  attempt: z.number().int().positive(),
  path: z.literal("PRD.md"),
}).strict();

const prdCompletions = new Map<string, Promise<unknown>>();

/** Serialize live retries; revision guards protect persisted transitions. */
export async function completePrd(
  store: RunStore, adapter: OpenCodeAdapter,
  input: z.infer<typeof completePrdInput>, sessionId: string,
) {
  const value = completePrdInput.parse(input);
  const key = `${store.root}:${value.runId}`;
  const previous = prdCompletions.get(key);
  if (previous) await previous.catch(() => {});
  const operation = acceptPrd(store, adapter, value, sessionId);
  prdCompletions.set(key, operation);
  try { return await operation; }
  finally { if (prdCompletions.get(key) === operation) prdCompletions.delete(key); }
}

async function acceptPrd(
  store: RunStore, adapter: OpenCodeAdapter,
  value: z.infer<typeof completePrdInput>, sessionId: string,
) {
  const run = await store.getRun(value.runId);
  const state = run?.planning;
  if (!run || !state || state.protocol !== "native-interview-v1" ||
      (run.control && run.control.status !== "active"))
    throw new Error("Stale or inactive planning ownership; inspect /ralph-status");
  const accepted = state.prdAcceptance;
  if (accepted ? accepted.sessionId !== sessionId || accepted.attempt !== value.attempt :
      state.owner?.stage !== "prd" || state.owner.sessionId !== sessionId ||
      state.owner.attempt !== value.attempt || state.phase !== "prd_generation")
    throw new Error("Stale PRD stage ownership; use the current owner and attempt");
  if (!state.approval || !state.explanation ||
      state.approval.hash !== explanationHash(state.explanation) ||
      state.approval.revision !== state.explanation.revision ||
      state.approval.sessionId !== sessionId)
    throw new Error("Current explanation approval is required");
  if (state.issueHandoff?.focused && state.issueHandoff.queued)
    return {outcome: "accepted", prd: state.prd, sessionId: state.issueHandoff.sessionId};
  const config = await loadProjectConfig(state.workspace);
  if (commandConfigHash(config.commands) !== state.approval.commandHash ||
      (await readReviewGit(state.workspace, ["rev-parse", "HEAD"])).trim() !== state.approval.sha)
    return {outcome: "blocked", message: "Approved commit or command configuration changed; renew explanation approval"};
  let next = structuredClone(state);
  if (!accepted) {
    let text: string;
    try {
      text = await readFile(await readPrdDraft(state.workspace, value.runId, value.attempt), "utf8");
      validateWrittenPrd(text, state.explanation);
    } catch (cause) {
      return {outcome: "correctable-invalid", message: `Fix PRD.md and call ralph_complete_prd again: ${String(cause)}`};
    }
    const revision: ArtifactRevision = {
      revision: 1, hash: artifactHash(text),
      artifactPath: `.ralph/features/${value.runId}/prd-1/PRD.md`,
    };
    next.prdAcceptance = {sessionId, attempt: value.attempt, path: value.path, text, revision};
    await savePlanning(store, value.runId, run.revision, next);
  }
  let current = await store.getRun(value.runId);
  if (!current?.planning?.prdAcceptance) throw new Error("Missing PRD acceptance intent");
  next = structuredClone(current.planning);
  const intent = current.planning.prdAcceptance;
  if (!next.prd) {
    const publication = await publishRevision(store, current.revision, next, value.runId,
      `prd-${intent.revision.revision}`, {"PRD.md": intent.text}, `complete-prd-${intent.attempt}`);
    next.prd = intent.revision;
    await savePlanning(store, value.runId, publication.revision, next);
  }
  try {
    await queueIssuePlanner(store, adapter, value.runId);
  } catch (cause) {
    return {outcome: "blocked", prd: intent.revision, message: `PRD accepted; retry this completion to reconcile the issue handoff: ${String(cause)}`};
  }
  current = await store.getRun(value.runId);
  return {outcome: "accepted", prd: current?.planning?.prd, sessionId: current?.planning?.issueHandoff?.sessionId};
}
