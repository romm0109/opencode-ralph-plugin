import type { RunStore } from "../state/run-store.js";
import { ralphBridge } from "./bridge.js";

export interface JobToolEvidence {
  source: "opencode.session.context";
  sessionId: string;
  promptMessageId?: string;
  resultMessageId?: string;
  observations: {
    messageId: string;
    callId: string;
    tool: string;
    input: string;
