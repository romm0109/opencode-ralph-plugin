/** Durable, asynchronous stage handoff. An inbox receipt never waits for completion. */
export async function queueIssuePlanner(store: RunStore, adapter: OpenCodeAdapter, runId: string) {
  let run = await store.getRun(runId);
  if ("'!run?.planning?.prd || !run.planning.prdAcceptance || !run.planning.approval)
    throw new Error("Accepted native PRD required");
  if (!adapter.findIssueSession || !adapter.createIssueSession || !adapter.queueStagePrompt)
    throw new Error("Issue session creation/reconciliation or queue is unavailable");
  let next = structuredClone(run.planning);
  if (!next.issueHandoff) {
