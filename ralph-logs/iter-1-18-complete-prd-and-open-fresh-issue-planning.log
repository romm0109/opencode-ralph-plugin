  const text = headings.map((h, i) => `## ${i + 1}. ${h}'"\\nConcrete diamond requirements."'`).join("'"\\n\")
    + "'`'"\\nApproved explanation: revision "'${state?.explanation?.revision}, hash ${state?.explanation?.hash}'"\\n"'`;
  const input = {runId: run.runId, attempt: 1, path: "PRD.md"};
  const write = async (content: string) => host.tools.get("ralph_write_planning_file")?.execute({...input, content}, context);
  const complete = async (args = input, ctx = context) => {
    const tool = host.tools.get("ralph_complete_prd");
    if (!tool) throw new Error("Missing PRD completion tool");
    return JSON.parse(String((await tool.execute(args, ctx)).content));
  };
  return {...f, host, dispose, run, context, text, input, write, complete};
}

test("native PRD completion accepts exact bytes and opens one restricted fresh planner", async () => {
  const f = await nativePrdFixture();
  try {
    await f.write(f.text);
    const result = await f.complete();
    expect(result.outcome).toBe("accepted");
    const state = (await f.store.getRun(f.run.runId))?.planning;
    expect(state?.owner?.stage).toBe("issues");
    expect(state?.sessionId).not.toBe(f.run.planning?.sessionId);
    expect(await readFile(join(f.project.directory, state?.prd?.artifactPath ?? ""), "utf8")).toBe(f.text);
    const prompts = f.fake.requests.filter(r => r.path.endsWith("/prompt") && String(r.body.text).includes("# To Issues"));
    expect(prompts).toHaveLength(1);
    for (const value of [f.text, state?.prd?.hash, f.project.commit, f.project.directory, "Approved commands:", "Step-by-step tasks", "ralph_complete_issues"])
      expect(String(prompts[0]?.body.text)).toContain(value as string);
    expect(String(prompts[0]?.body.text)).not.toContain("/setup-matt-pocock-skills");
    const before = f.fake.requests.length;
    expect(await f.complete()).toEqual(result);
    expect(f.fake.requests).toHaveLength(before);
    const writer = f.host.tools.get("ralph_write_planning_file");
    const planner = {...(f.context as object), sessionID: state?.sessionId} as never;
    for (const path of ["graph.json", "issues/1-foundation.md"])
      expect((await writer?.execute({...f.input, path, content: "{}"}, planner))?.content).toContain("accepted");
    for (const path of ["PRD.md", "src/plugin.ts", "../graph.json", "issues/../../escape.md", "issues/A.md"])
      await expect(writer?.execute({...f.input, path, content: "bad"}, planner)).rejects.toThrow();
    await expect(f.write("replace accepted")).rejects.toThrow();
    expect(state?.executionApproval).toBeUndefined();
    expect(f.host.events.filter(e => e.type === "ralph.stage.focus")).toHaveLength(1);
  } finally { await f.dispose(); await f.project.cleanup(); }
});

test("native PRD completion rejects foreign ownership, stale attempts and malformed drafts without creating a planner", async () => {
  const f = await nativePrdFixture();
  try {
    const count = () => f.fake.requests.filter(r => r.path === "/api/session").length;
    const before = count();
    await f.write(f.text);
    await expect(f.complete(f.input, {...(f.context as object), sessionID: "foreign"} as never)).rejects.toThrow("ownership");
    await expect(f.complete({...f.input, attempt: 2})).rejects.toThrow("ownership");
    await expect(f.complete({...f.input, path: "../PRD.md"})).rejects.toThrow();
    for (const text of [" ", "# Incomplete", f.text.replace(/hash [a-f0-9]{64}/, "hash " + "0".repeat(64)),
      f.text.replace("Concrete diamond requirements.", "")]) {
      // Empty drafts can also arrive from interrupted disk writes.
      const {writeFile} = await import("node:fs/promises");
      await writeFile(join(f.project.directory, ".ralph/features", f.run.runId, "prd-draft-1/PRD.md"), text);
      expect((await f.complete()).outcome).toBe("correctable-invalid");
    }
    expect(count()).toBe(before);
    expect((await f.store.getRun(f.run.runId))?.planning?.prd).toBeUndefined();
  } finally { await f.dispose(); await f.project.cleanup(); }
});
