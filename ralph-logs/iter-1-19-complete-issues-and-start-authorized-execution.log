    try {
      text = await readFile(
        await readPrdDraft(state.workspace, value.runId, value.attempt),
        "utf8",
      );
      validateWrittenPrd(text, state.explanation);
    } catch (cause) {
      return {
        outcome: "correctable-invalid",
        message: `Fix PRD.md and call ralph_complete_prd again: ${String(cause)}`,
      };
    }
    const revision: ArtifactRevision = {
      revision: 1,
      hash: artifactHash(text),
      artifactPath: `.ralph/features/${value.runId}/prd-1/PRD.md`,
    };
    next.prdAcceptance = {
      sessionId,
      attempt: value.attempt,
      path: value.path,
      text,
      revision,
    };
    await savePlanning(store, value.runId, run.revision, next);
  }
  let current = await store.getRun(value.runId);
  if (!current?.planning?.prdAcceptance)
    throw new Error("Missing PRD acceptance intent");
  next = structuredClone(current.planning);
  const intent = current.planning.prdAcceptance;
  if (!next.prd) {
    const publication = await publishRevision(
      store,
      current.revision,
      next,
      value.runId,
      `prd-${intent.revision.revision}`,
      { "PRD.md": intent.text },
      `complete-prd-${intent.attempt}`,
    );
    next.prd = intent.revision;
    await savePlanning(store, value.runId, publication.revision, next);
  }
  try {
    await queueIssuePlanner(store, adapter, value.runId);
  } catch (cause) {
    return {
      outcome: "blocked",
      prd: intent.revision,
      message: `PRD accepted; retry this completion to reconcile the issue handoff: ${String(cause)}`,
    };
  }
  current = await store.getRun(value.runId);
  return {
    outcome: "accepted",
    prd: current?.planning?.prd,
    sessionId: current?.planning?.issueHandoff?.sessionId,
  };
}
import { randomUUID } from "node:crypto";
import { readFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { z } from "zod";
import { loadRoleInstructions } from "../agents/skills.js";
import { commandConfigHash } from "../config/commands.js";
import { loadProjectConfig } from "../config/project.js";
import type { UserInputResult } from "../core/types.js";
import { readReviewGit } from "../git/review-workspace.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { recordApproval } from "./approvals.js";
import { artifactHash, issueBundleHash } from "./artifacts.js";
import {
  dispatchGeneration,
  planningFailure,
  publishRevision,
  savePlanning,
} from "./generation.js";
import { topologicalOrder, validateIssueGraph } from "./graph.js";

export async function generateIssues(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if (state?.protocol === "native-interview-v1")
    throw new Error(
      "Native issue planning requires ralph_complete_prd and its recorded handoff",
    );
  if (!state?.prd) throw new Error("A PRD revision is required");
  try {
    const config = await loadProjectConfig(state.workspace);
    const skill = await loadRoleInstructions(
      state.workspace,
      "issues",
      config.skillPaths,
    );
    const text = await readFile(
      join(state.workspace, state.prd.artifactPath),
      "utf8",
    );
    if (artifactHash(text) !== state.prd.hash)
      throw new Error("PRD artifact changed");
    const generated = await dispatchGeneration(
      store,
      adapter,
      runId,
      "issues",
      `${skill.text}\nRepository: ${state.workspace}\nPRD revision: ${JSON.stringify(state.prd)}\nPRD content:\n${text}\nExplanation: ${JSON.stringify(state.explanation)}\nRevision feedback: ${JSON.stringify(state.transcript)}`,
      { issues: { path: skill.path, hash: skill.hash } },
    );
    if (!generated) return store.getRun(runId);
    const output = z
      .object({ graph: z.unknown(), files: z.record(z.string(), z.string()) })
      .strict()
      .parse(JSON.parse(generated.result.text ?? ""));
    const value = validateIssueGraph(output.graph, output.files, state.prd);
    const order = topologicalOrder(value);
    const files = Object.fromEntries(
      order.map((id) => {
        const issue = value.issues.find((item) => item.id === id);
        if (!issue) throw new Error("Missing issue");
        return [issue.artifactPath, output.files[issue.artifactPath] as string];
      }),
    );
    const publication = await publishRevision(
      store,
      generated.run.revision,
      generated.state,
      runId,
      `graph-${generated.state.generation?.revision}`,
      { ...files, "graph.json": JSON.stringify(value, null, 2) },
    );
    generated.state.graph = {
      revision: (generated.state.graph?.revision ?? 0) + 1,
      hash: issueBundleHash(value, files),
      artifactPath: `${publication.directory}/graph.json`,
      value,
      files,
      order,
    };
    generated.state.phase = "execution_approval";
    delete generated.state.executionApproval;
    await savePlanning(store, runId, publication.revision, generated.state);
  } catch (cause) {
    await planningFailure(store, runId, cause);
  }
  return store.getRun(runId);
}

export async function handlePlanningResponse(
  store: RunStore,
  runId: string,
  response: UserInputResult,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  const pending = state?.pending;
  if (
    !run ||
    state?.phase !== "execution_approval" ||
    !state.prd ||
    !state.graph ||
    !pending ||
    !response.ok ||
    response.source !== "user" ||
    !response.messageId ||
    !response.text.trim() ||
    response.requestId !== pending.requestId ||
    response.sessionId !== pending.sessionId ||
    response.revision !== pending.revision ||
    state.transcript.some((entry) => entry.messageId === response.messageId)
  )
    return false;
  try {
    const text = await readFile(
      join(state.workspace, state.prd.artifactPath),
      "utf8",
    );
    const value = JSON.parse(
      await readFile(join(state.workspace, state.graph.artifactPath), "utf8"),
    );
    const files: Record<string, string> = {};
    for (const path of Object.keys(state.graph.files))
      files[path] = await readFile(
        join(state.workspace, dirname(state.graph.artifactPath), path),
        "utf8",
      );
    validateIssueGraph(value, files, state.prd);
    if (
      artifactHash(text) !== state.prd.hash ||
      issueBundleHash(value, files) !== state.graph.hash
    )
      throw new Error(
        "Published artifacts changed; regenerate and approve a new revision",
      );
  } catch (cause) {
    await planningFailure(store, runId, cause);
    return false;
  }
  const next = structuredClone(state);
  delete next.pending;
  delete next.error;
  next.transcript.push({
    source: "user",
    text: response.text,
    messageId: response.messageId,
    requestId: response.requestId,
    revision: response.revision,
  });
  if (response.text.trim() === `approve ${state.graph.revision}`) {
    // Keep pending identity while the shared approval validator records provenance.
    next.pending = pending;
    if (!recordApproval(next, response)) return false;
    delete next.pending;
  } else {
    next.phase = "explanation_approved";
    delete next.executionApproval;
  }
  return store.recordPlanning(runId, run.revision, next);
}
export async function requestPlanningApproval(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  selectedCommit?: string,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if (
    !run ||
    state?.phase !== "execution_approval" ||
    !state.prd ||
    !state.graph ||
    (state.scopeChange &&
      (state.publication?.status !== "completed" ||
        state.graph.revision <= state.scopeChange.previousGraph.revision))
  )
    return false;
  if (!state.pending) {
    try {
      state.selectedCommit = (
        await readReviewGit(state.workspace, [
          "rev-parse",
          "--verify",
          `${selectedCommit ?? state.selectedCommit ?? "HEAD"}^{commit}`,
        ])
      ).trim();
    } catch (cause) {
      await planningFailure(
        store,
        runId,
        new Error(
          "Select a committed starting point; this repository may be unborn",
          { cause },
        ),
      );
      return false;
    }
    const text = await readFile(
      join(state.workspace, state.prd.artifactPath),
      "utf8",
    );
    state.pending = {
      runId,
      workspace: state.workspace,
      sessionId: state.sessionId,
      requestId: randomUUID(),
      revision: state.graph.revision,
      question: `${state.scopeChange ? `Scope revision affects: ${state.scopeChange.affectedIssueIds.join(", ")}\nAlready integrated evidence retained pending approval: ${state.scopeChange.integratedIssueIds.join(", ") || "none"}\n` : ""}Starting commit: ${state.selectedCommit}\n${text}\nPRD: ${state.prd.artifactPath} (${state.prd.hash})\nGraph: ${state.graph.artifactPath} (${state.graph.hash})\n${state.graph.order
        .map((id, index) => {
          const item = state.graph?.value.issues.find(
            (issue) => issue.id === id,
          );
          return `${index + 1}. ${id}: ${item?.title}; depends on ${item?.dependencies.join(", ") || "none"}`;
        })
        .join(
          "\n",
        )}\nApprove both artifacts for execution by replying approve ${state.graph.revision}, or reply with revisions.`,
    };
    await savePlanning(store, runId, run.revision, state);
  }
  const published = await adapter.publishStatus(
    state.sessionId,
    state.workspace,
    state.pending.question,
  );
  const response = published.ok
    ? await adapter.requestUserInput(state.pending)
    : {
        ok: false as const,
        error: published.error ?? {
          code: "sdk-error" as const,
          message: "Could not publish planning approval",
        },
      };
  if (!response.ok) {
    const latest = await store.getRun(runId);
    if (latest?.planning)
      await store.recordPlanning(runId, latest.revision, {
        ...latest.planning,
        error: response.error,
      });
    return false;
  }
  return handlePlanningResponse(store, runId, response);
}

/** Durable, asynchronous stage handoff. An inbox receipt never waits for completion. */
export async function queueIssuePlanner(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  let run = await store.getRun(runId);
  if (
    !run?.planning?.prd ||
    !run.planning.prdAcceptance ||
    !run.planning.approval
  )
    throw new Error("Accepted native PRD required");
  if (run.control && run.control.status !== "active")
    throw new Error("Inactive issue handoff; inspect /ralph-status");
  const approvedConfig = await loadProjectConfig(run.planning.workspace);
  if (
    commandConfigHash(approvedConfig.commands) !==
      run.planning.approval.commandHash ||
    (
      await readReviewGit(run.planning.workspace, ["rev-parse", "HEAD"])
    ).trim() !== run.planning.approval.sha
  )
    throw new Error(
      "Approved commit or commands changed; renew explanation approval",
    );
  if (
    !adapter.findIssueSession ||
    !adapter.createIssueSession ||
    !adapter.queueStagePrompt
  )
    throw new Error(
      "Issue session creation/reconciliation or queue is unavailable",
    );
  let next = structuredClone(run.planning);
  if (!next.issueHandoff) {
    const config = await loadProjectConfig(next.workspace);
    const skill = await loadRoleInstructions(
      next.workspace,
      "issues",
      config.skillPaths,
    );
    let projectInstructions =
      "No root AGENTS.md exists; inspect repository-local instructions.";
    try {
      projectInstructions = await readFile(
        join(next.workspace, "AGENTS.md"),
        "utf8",
      );
    } catch (cause) {
      if ((cause as NodeJS.ErrnoException).code !== "ENOENT") throw cause;
    }
    const prd = run.planning.prd;
    const text = await readFile(join(next.workspace, prd.artifactPath), "utf8");
    if (artifactHash(text) !== prd.hash)
      throw new Error("Accepted PRD bytes changed");
    next.settings.skills.issues = { path: skill.path, hash: skill.hash };
    next.issueHandoff = {
      jobId: `issues-prd-${prd.revision}`,
      attempt: 1,
      prd,
      messageId: `msg_ralph-issues-${runId}-${prd.revision}`,
      prompt: `${skill.text}
Ralph issue-planning stage: runId=${runId}, attempt=1.
Repository: ${next.workspace}
Repository context: read AGENTS.md, repository instructions, docs/wiki and relevant code/tests before drafting.
Project instructions (AGENTS.md):
${projectInstructions}
PRD revision: ${JSON.stringify(prd)}
Exact accepted PRD content:
${text}
Approved explanation: ${JSON.stringify(next.explanation)}
Authorization: ${JSON.stringify(next.approval)}
Pinned HEAD: ${next.approval?.sha}
Approved commands: ${JSON.stringify(config.commands)}
Draft directory: .ralph/features/${runId}/issues-draft-1
Use ralph_write_planning_file for graph.json and issues/<number>-<slug>.md only.
graph.json is a strict object {schemaVersion:1, prdRevision:<exact PRD revision object above>, issues:[{id,title,artifactPath,dependencies,acceptanceCriteria,testableBehaviors}]}.
Dependencies are issue IDs; acceptanceCriteria and testableBehaviors are nonempty string arrays.
Explore deeply, author self-sufficient vertical slices, then call ralph_complete_issues with runId, attempt and graph path. That completion tool is not available until validated issue completion is installed; retain local drafts and report the blocker. Do not start execution or request breakdown approval. Prose cannot complete this stage.
`,
    };
    await savePlanning(store, runId, run.revision, next);
  }
  run = await store.getRun(runId);
  if (!run?.planning?.issueHandoff) throw new Error("Missing handoff intent");
  next = structuredClone(run.planning);
  let handoff = next.issueHandoff;
  if (!handoff) throw new Error("Missing handoff");
  if (!handoff.sessionId) {
    // Always inspect correlated host metadata before retrying an ambiguous creation.
    let sessionId = await adapter.findIssueSession(
      next.workspace,
      runId,
      handoff.jobId,
      handoff.attempt,
    );
    if (!sessionId) {
      handoff.creationStarted = true;
      await savePlanning(store, runId, run.revision, next);
      const model =
        next.settings.models.issues ?? next.settings.models.interview;
      if (!model) throw new Error("Missing issue planning model");
      sessionId = await adapter.createIssueSession(
        next.workspace,
        runId,
        handoff.jobId,
        handoff.attempt,
        model,
      );
    }
    const latest = await store.getRun(runId);
    if (
      !latest?.planning?.issueHandoff ||
      latest.planning.issueHandoff.jobId !== handoff.jobId
    )
      throw new Error("Stale issue-session attachment");
    next = structuredClone(latest.planning);
    if (!next.issueHandoff) throw new Error("Missing handoff");
    next.issueHandoff.sessionId = sessionId;
    await savePlanning(store, runId, latest.revision, next);
  }
  run = await store.getRun(runId);
  if (!run?.planning?.issueHandoff?.sessionId)
    throw new Error("Missing attached issue session");
  next = structuredClone(run.planning);
  handoff = next.issueHandoff;
  if (!handoff?.sessionId) throw new Error("Missing handoff session");
  if (next.owner?.stage !== "issues") {
    next.owner = {
      stage: "issues",
      sessionId: handoff.sessionId,
      attempt: handoff.attempt,
    };
    next.sessionId = handoff.sessionId;
    next.phase = "issue_generation";
    await savePlanning(store, runId, run.revision, next);
  }
  if (!handoff.queued) {
    await adapter.queueStagePrompt(
      handoff.sessionId,
      handoff.messageId,
      handoff.prompt,
    );
    const latest = await store.getRun(runId);
    if (
      !latest?.planning?.issueHandoff ||
      latest.planning.owner?.sessionId !== handoff.sessionId
    )
      throw new Error("Stale issue prompt receipt");
    next = structuredClone(latest.planning);
    if (!next.issueHandoff) throw new Error("Missing handoff");
    next.issueHandoff.queued = true;
    await savePlanning(store, runId, latest.revision, next);
  }
  if (!handoff.focused) {
    await adapter.focusStageSession?.(
      next.workspace,
      runId,
      handoff.sessionId,
      "issues",
    );
    const latest = await store.getRun(runId);
    if (!latest?.planning?.issueHandoff) throw new Error("Stale issue focus");
    next = structuredClone(latest.planning);
    if (!next.issueHandoff) throw new Error("Missing handoff");
    next.issueHandoff.focused = true;
    await savePlanning(store, runId, latest.revision, next);
  }
}
import type { UserInputResult } from "../core/types.js";
import type { PlanningState } from "./types.js";

export function approvalMatchesRevision(state: PlanningState) {
  const approval = state.executionApproval;
  return !!(
    approval &&
    state.prd &&
    state.graph &&
    approval.revision === state.graph.revision &&
    approval.prdHash === state.prd.hash &&
    approval.graphHash === state.graph.hash
  );
}
export function recordApproval(
  state: PlanningState,
  response: UserInputResult,
) {
  if (
    !response.ok ||
    response.source !== "user" ||
    !response.messageId ||
    !state.pending ||
    response.requestId !== state.pending.requestId ||
    response.sessionId !== state.sessionId ||
    response.revision !== state.graph?.revision ||
    response.text.trim() !== `approve ${state.graph.revision}` ||
    !state.prd
  )
    return false;
  state.executionApproval = {
    revision: state.graph.revision,
    ...(state.selectedCommit ? { selectedCommit: state.selectedCommit } : {}),
    prdHash: state.prd.hash,
    graphHash: state.graph.hash,
    requestId: response.requestId,
    messageId: response.messageId,
    timestamp: new Date().toISOString(),
  };
  state.phase = "execution_approved";
  return true;
}
import type { Failure, JobEnvelope, UserInputRequest } from "../core/types.js";
export interface PlanningState {
  protocol?: "native-interview-v1";
  owner?: {
    stage: "interview" | "prd" | "issues";
    sessionId: string;
    attempt: number;
