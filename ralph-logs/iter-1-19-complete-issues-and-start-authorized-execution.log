      outcome: "already-completed",
      revision: state.explanation.revision,
      requestId: state.approval.requestId,
    };
  }
  if (state.approval && state.owner?.stage !== "prd")
    return {
      outcome: "blocked",
      message: "The approved explanation cannot be replaced in this stage",
    };
