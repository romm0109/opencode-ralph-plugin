    store,
    run.runId,
    value.attempt,
    sessionId,
  );
  const pending = current.state.pending;
  if (!pending)
    return {
      outcome: "stale",
      message: "The displayed request is no longer pending",
    };
  const response = await adapter.requestUserInput(pending);
  if (!response.ok)
    return {
      outcome: "blocked",
      requestId: pending.requestId,
      error: response.error,
