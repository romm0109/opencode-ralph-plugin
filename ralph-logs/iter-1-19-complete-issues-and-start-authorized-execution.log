for (const change of ["HEAD", "commands", "artifact", "tracked", "untracked", "foreign-output"] as const) {
  test(`native issue completion blocks changed ${change} before commands or workers`, async () => {
    const f = await nativeIssueFixture();
    try {
      const { mkdir, writeFile } = await import("node:fs/promises");
      const { git } = await import("../helpers/project.js");
      if (change === "HEAD") await git("git", ["-C", f.project.directory, "commit", "--allow-empty", "-m", "changed HEAD"]);
      if (change === "commands") {
        const path = join(f.project.directory, ".ralph/commands.json");
        const config = JSON.parse(await readFile(path, "utf8")); config.revision++;
        await writeFile(path, JSON.stringify(config));
      }
      if (change === "artifact") await writeFile(join(f.project.directory, f.state.prd!.artifactPath), "Changed PRD");
      if (change === "tracked") await writeFile(join(f.project.directory, "README.md"), "User changes");
      if (change === "untracked") await writeFile(join(f.project.directory, "user.txt"), "User changes");
      if (change === "foreign-output") {
        const dir = join(f.project.directory, `.ralph/features/${f.run.runId}/issues-draft-1`);
        await mkdir(dir, { recursive: true }); await writeFile(join(dir, "user.md"), "Unrecorded work");
      }
      const result = await f.completeIssues();
      const run = await f.store.getRun(f.run.runId);
      if (["HEAD", "commands"].includes(change)) { expect(result.outcome).toBe("blocked"); expect(run?.planning?.error?.code).toBe("baseline-blocked"); }
      else if (change === "artifact") expect(result.outcome).toBe("correctable-invalid");
      else expect(run?.baseline?.blocker).toContain("Checkout is dirty");
      expect(Object.values(run?.operations ?? {}).some(op => op.kind === "baseline.workspace")).toBe(false);
      expect(Object.values(run?.jobs ?? {}).some(job => job.envelope.role === "executor")).toBe(false);
    } finally { await f.cleanup(); }
  });
}

