test("interrupted issue planning discards late output without publishing a graph", async () => {
  const { project, store, adapter, router } = await fixture();
  try {
    adapter.requestUserInput = async (request) => ({
      ok: true,
      ...request,
      source: "user",
      messageId: request.requestId,
      text: `approve ${request.revision}`,
    });
    const dispatch = adapter.dispatchJob.bind(adapter);
    let notify: (job: import("../../src/core/types.js").JobEnvelope) => void =
      () => {};
    const started = new Promise<import("../../src/core/types.js").JobEnvelope>(
      (resolve) => {
        notify = resolve;
      },
    );
    let release: () => void = () => {};
    const gate = new Promise<void>((resolve) => {
      release = resolve;
    });
    adapter.dispatchJob = async (job) => {
      if (job.role === "issues") {
        notify(job);
        await gate;
      }
      return dispatch(job);
    };
    const pending = router.dispatch("ralph-orchestrator", "Diamond", {
      workspace: project.directory,
      sessionId: "main",
    });
    const job = await started;
    await store.recordControl(job.runId, {
      status: "interrupted",
      source: "recovery",
      facts: ["Fixture interruption"],
    });
    release();
    const run = JSON.parse(await pending);
    expect(run.planning.graph).toBeUndefined();
    expect(run.planning.executionApproval).toBeUndefined();
    expect(run.control.status).toBe("interrupted");
  } finally {
    await project.cleanup();
  }
});

test("issue timeout interrupts the run and late output cannot publish or approve", async () => {
