        const graphPath = request.question.match(/Graph: (\S+)/)?.[1];
        if (!graphPath) throw new Error("Missing graph path");
        await writeFile(
          join(project.directory, dirname(graphPath), "issues/A.md"),
          "Changed artifact",
        );
      }
      return {
        ok: true,
        ...request,
        source: "user",
        messageId: request.requestId,
        text: `approve ${request.revision}`,
      };
    };
    const run = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Diamond", {
        workspace: project.directory,
        sessionId: "main",
      }),
    );
    expect(run.planning.phase).toBe("execution_approval");
    expect(run.planning.executionApproval).toBeUndefined();
    expect(run.planning.error.code).toBe("missing-output");
  } finally {
    await project.cleanup();
  }
});

