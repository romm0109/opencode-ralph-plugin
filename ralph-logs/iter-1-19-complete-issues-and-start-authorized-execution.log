import type { UserInputResult } from "../core/types.js";
import { explanationHash } from "./artifacts.js";
import type { PlanningState } from "./types.js";

export function approvalMatchesRevision(state: PlanningState) {
  const approval = state.executionEligibility;
  return !!(
    approval &&
    (state.protocol !== "native-interview-v1" ||
      (!!state.approval && !!state.explanation &&
        state.approval.hash === explanationHash(state.explanation) &&
        state.approval.revision === state.explanation.revision &&
        approval.explanationHash === state.approval.hash &&
        approval.requestId === state.approval.requestId &&
        approval.messageId === state.approval.messageId &&
        approval.selectedCommit === state.approval.sha &&
        approval.commandHash === state.approval.commandHash &&
        approval.commandHash === state.commandHash &&
        approval.commandRevision === state.approval.commandRevision)) &&
    state.prd &&
    state.graph &&
    approval.revision === state.graph.revision &&
    approval.prdHash === state.prd.hash &&
    approval.graphHash === state.graph.hash
  );
}
export function recordApproval(
  state: PlanningState,
  response: UserInputResult,
) {
  if (
    state.protocol === "native-interview-v1" ||
    !response.ok ||
    response.source !== "user" ||
    !response.messageId ||
    !state.pending ||
    response.requestId !== state.pending.requestId ||
    response.sessionId !== state.sessionId ||
    response.revision !== state.graph?.revision ||
    response.text.trim() !== `approve ${state.graph.revision}` ||
    !state.prd
  )
    return false;
  state.executionEligibility = {
    revision: state.graph.revision,
    ...(state.selectedCommit ? { selectedCommit: state.selectedCommit } : {}),
    prdHash: state.prd.hash,
    graphHash: state.graph.hash,
    requestId: response.requestId,
    messageId: response.messageId,
    timestamp: new Date().toISOString(),
  };
  state.phase = "execution_approved";
  return true;
}
# Feature execution baseline

## Summary
Human execution approval hands off to preflight before any issue dispatch. Preflight creates an owned integration branch and worktree at the exact approved SHA and validates it with the captured command configuration.

## Key behavior
- Preflight command permission belongs to the approving main session, before an executor/merger session exists.
- Continuing an already approved run can retry a failed baseline without silently replacing approvals or resetting attempts.
- Approval presents and captures the starting SHA; `requestPlanningApproval` accepts an optional alternative starting reference before the request is issued. Approval binds that SHA to the approved PRD and issue graph.
- `preflightRun` verifies artifact hashes, project verification, command hash, canonical repository lock, committed HEAD, selected commit and clean tracked/untracked state. It never commits or stashes user changes.
- Branch `ralph/<run-id>` and workspace under the canonical run root are recorded with operation intent before Git mutations. Existing branches block; the user's branch and unrelated worktrees remain unchanged.
- Baseline command envelopes use role `baseline`, attempt zero and no issue ID. Failures consume no issue attempts. Failed baselines attempt environment and owned worktree cleanup; ambiguous ownership blocks deletion.
- `validateCandidate` prepares the environment, runs checks and disposes partial startup. Evidence includes the exact candidate SHA, command revision/hash, lifecycle results and check results. Changed candidate HEAD or tracked files invalidate results.
- A check timeout with successful process cleanup persists that exact ID in `RunRecord.validationSkips`. Later validation skips those IDs; setup/readiness failures and nonzero check exits never qualify. Approved JSON is unchanged. All skipped checks yield `passed_with_omissions`, never `passed`.
- `/ralph-status` and adapter status publication expose baseline readiness/blockers and skips. Compare-and-swap reservations avoid duplicate preflight effects; stale completion cannot publish readiness. Cached readiness rechecks approval, configuration and artifact identity. A matching accepted baseline is reused before fresh-checkout checks; later guard failures throw and preserve its validation evidence instead of overwriting it with a failed baseline.

## Code references
- `src/execution/preflight.ts` — approval gates, baseline orchestration and typed blocker evidence.
- `src/execution/validation.ts` — qualified validation and shared run-local skip policy.
- `src/git/worktrees.ts` — Git argument arrays, owned workspace inspection and guarded removal.
- `src/state/run-store.ts` — baseline events and durable skip persistence.
- `src/planning/issues.ts`, `src/commands/router.ts`, `src/core/orchestrator.ts` — approval SHA, status and automatic handoff.
- `src/process/environment.ts` — optional separate check execution; initial project verification remains strict.
- `tests/integration/05-baseline.test.ts` — real Git fixtures and public command demonstrations.

## Related
- [Planning approval](feature-planning.md)
- [Project commands](project-commands.md)

## Notes
Scheduling and automatic final review are wired in production. Native questions provide approval inputs. Project commands and generated artifacts must be committed or otherwise leave a clean checkout before baseline creation; preflight reports this explicitly. Native Linux/Windows remain unverified locally.

