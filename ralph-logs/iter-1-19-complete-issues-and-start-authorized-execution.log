const issueCompletions = new Map<string, Promise<unknown>>();

export async function completeIssues(store: RunStore, adapter: OpenCodeAdapter, input: z.infer<typeof completeIssuesInput>, sessionId: string) {
  const value = completeIssuesInput.parse(input);
  const key = `${stateKey(store)}:${value.runId}`;
  const previous = issueCompletions.get(key);
  const operation = (previous ?? Promise.resolve()).catch(() => {}).then(() => acceptIssues(store, adapter, value, sessionId));
  issueCompletions.set(key, operation);
  try { return await operation; }
  finally { if (issueCompletions.get(key) === operation) issueCompletions.delete(key); }
}

