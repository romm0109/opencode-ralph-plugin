child.stderr?.pipe(process.stderr);
child.once("spawn", () => process.send?.({ type: "started" }));
child.once("error", (error: NodeJS.ErrnoException) => process.send?.({ type: "error", code: error.code, message: error.message }));
child.once("exit", (code, signal) => process.send?.({ type: "exit", code, signal }));
process.on("SIGTERM", () => {}); // Group termination also reaches descendants; allow escalation.
let inspecting = false;
setInterval(async () => {
  if (inspecting) return;
  inspecting = true;
  try {
