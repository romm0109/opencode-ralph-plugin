  const cleaned = join(project.directory, \"cleanup.txt\");
  const previous = process.env.RALPH_FIXTURE_SECRET;
  process.env.RALPH_FIXTURE_SECRET = \"fixture-sensitive-value\";
  try {
    const fake = createFakeOpenCode();
    const fixture = join(import.meta.dir, \"../fixtures/process-child.ts\");
    const command = (id: string, phase: string, args: string[], env = {}) => ({ id, phase, executable: process.execPath, args: [fixture, ...args], cwd: \".\", timeoutMs: 4000, platforms: [\"darwin\", \"linux\", \"win32\"], env });
    fake.respond(JSON.stringify({ schemaVersion: 1, revision: 1, rationale: \"Portable fixture lifecycle.\", commands: [command(\"setup\", \"setup\", [\"record\", record, \"argument with spaces\", \""'$(literal)"], { FIXTURE_VALUE: "RALPH_FIXTURE_SECRET" }), command("check", "check", ["record", record, "argument with spaces", "$(literal)"], { FIXTURE_VALUE: "RALPH_FIXTURE_SECRET" }), command("app", "start", ["service", service]), command("ready", "readiness", ["readiness", service]), command("cleanup", "cleanup", ["cleanup", cleaned])] }));
    const store = await openRunStore(project.directory);
