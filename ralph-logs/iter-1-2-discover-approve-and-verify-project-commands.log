test(\"missing executable reports its cause and cleanup still runs\", async () => {
  const project = await createTestProject();
  try {
    const check = { ...fixtureCommand(\"check\", \"check\", \"fail\"), executable: \"ralph-no-such-executable-928374\" };
    const { router } = await workflow(project, [check, fixtureCommand(\"cleanup\", \"cleanup\", \"cleanup\", [join(project.directory, \"cleaned\")])]);
    const result = await router.setupProject({ workspace: project.directory, sessionId: \"main\" });
    expect(result.status).toBe(\"not-ready\");
    expect(result.results?.[0]?.cause?.code).toBe(\"ENOENT\");
    expect(await Bun.file(join(project.directory, \"cleaned\")).text()).toBe(\"cleaned\");
  } finally { await project.cleanup(); }
});

test(\"readiness deadline blocks setup and disposes the partially started service\", async () => {
  const project = await createTestProject();
  try {
    const service = join(project.directory, \"service.json\");
    const { router } = await workflow(project, [fixtureCommand(\"check\", \"check\", \"cleanup\", [join(project.directory, \"checked\")]), fixtureCommand(\"app\", \"start\", \"service\", [service]), fixtureCommand(\"ready\", \"readiness\", \"fail\", [], 100)]);
    const result = await router.setupProject({ workspace: project.directory, sessionId: \"main\" });
    expect(result.status).toBe(\"not-ready\");
    expect(result.reason).toContain(\"readiness:\");
    expect(result.results?.at(-1)?.status).toBe(\"timed_out\");
    const info = await Bun.file(service).json();
    expect(() => process.kill(info.pid, 0)).toThrow();
    expect(() => process.kill(info.descendant, 0)).toThrow();
  } finally { await project.cleanup(); }
}, 10000);

test(\"public runner requires host execution permission and reports cancellation\", async () => {
  const { runCommand } = await import(\"../../src/process/runner.js\");
  const { parseCommandConfig } = await import(\"../../src/config/commands.js\");
  const { mkdir, writeFile } = await import(\"node:fs/promises\");
  const project = await createTestProject();
  try {
    const config = parseCommandConfig({ schemaVersion: 1, revision: 1, rationale: \"Hang fixture\", commands: [fixtureCommand(\"check\", \"check\", \"hang\", [], 2000)] });
    const { store, adapter } = await workflow(project, config.commands);
    await mkdir(join(project.directory, \".ralph\"));
    await writeFile(join(project.directory, \".ralph/commands.json\"), JSON.stringify(config));
    const job = { runId: \"runner\", jobId: \"check\", role: \"verification\", attempt: 1, workspace: project.directory, baseCommit: project.commit, inputRevisions: { commands: 1 }, prompt: \"Check fixture\" };
    await store.createRun(job.runId);
    await store.recordIntent(job);
    adapter.authorizeCommand = async () => ({ ok: false });
    expect((await runCommand(config.commands[0]"'!, { store, adapter, job, config })).status).toBe("permission_denied");
    adapter.authorizeCommand = async () => ({ ok: true });
    const result = await runCommand(config.commands[0]!, { store, adapter, job, config, signal: AbortSignal.timeout(100) });
    expect(result.status).toBe("cancelled");
    expect(result.ownedProcess).toBeDefined();
    expect(() => process.kill(result.ownedProcess!.pid, 0)).toThrow();
  } finally { await project.cleanup(); }
});
