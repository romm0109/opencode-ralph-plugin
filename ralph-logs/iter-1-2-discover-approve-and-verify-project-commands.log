import { randomUUID } from \"node:crypto\";
import { mkdir, readFile, rename, rm, writeFile } from \"node:fs/promises\";
import { join } from \"node:path\";
import { commandConfigHash, parseCommandConfig, type ApprovedCommandConfig } from \"../config/commands.js\";
import type { OpenCodeAdapter } from \"../opencode/adapter.js\";
import type { RunStore } from \"../state/run-store.js\";

export interface ProjectSetupOptions { workspace: string; sessionId: string }
export interface ProjectSetupStatus { status: \"rejected\" | \"not-ready\" | \"verified\"; hash?: string; revision?: number; platform?: string; reason?: string }
export async function setupProject(options: ProjectSetupOptions & { store: RunStore; adapter: OpenCodeAdapter }): Promise<ProjectSetupStatus> {
  const { store, adapter, workspace, sessionId } = options;
  const runId = "'`setup-${randomUUID()}`;
  await store.createRun(runId);
  const previous = await readFile(join(workspace, ".ralph/commands.json"), "utf8").catch((e) => { if (e.code === "ENOENT") return undefined; throw e; });
  const revision = previous ? parseCommandConfig(JSON.parse(previous)).revision + 1 : 1;
  const job = { runId, jobId: "command-discovery", attempt: 1, role: "command-discovery", workspace, inputRevisions: { commands: revision }, baseCommit: "", readOnly: true, prompt: `Explore this repository using read-only tools. Return ONLY a complete JSON command configuration: schemaVersion:1, revision:${revision}, rationale, commands with id, phase(setup/check/start/readiness/cleanup), executable, args array, cwd relative to workspace, timeoutMs, platforms(darwin/linux/win32), env mapping target variable names to source variable names; optional explicit shell. Explain absent scripts honestly in rationale, unsupported platforms in unsupportedPlatforms. Require a check per supported platform; order lifecycle phases. Never execute commands, write files, or include secret values. This proposal is not approval.` };
  const result = await adapter.dispatchJob(job);
  if (result.outcome !== "completed" || !result.text) return { status: "not-ready", reason: result.error?.message ?? "No discovery output" };
  let config: ApprovedCommandConfig;
  try { config = parseCommandConfig(JSON.parse(result.text)); if (config.revision !== revision) throw new Error("Unexpected command revision"); }
  catch (e) { return { status: "not-ready", reason: String(e) }; }
  const hash = commandConfigHash(config);
  const request = { runId, sessionId, workspace, requestId: randomUUID(), revision, question: `Approve this exact command configuration (hash ${hash}) by replying approve ${hash}, or reject:'"\\n"'${JSON.stringify(config, null, 2)}` };
  await adapter.publishStatus(sessionId, workspace, request.question);
  const approval = await adapter.requestUserInput(request);
  if (!approval.ok) return { status: "not-ready", reason: approval.error.message };
  if (approval.requestId !== request.requestId || approval.revision !== revision || approval.sessionId !== sessionId || approval.source !== "user" || !approval.messageId || approval.text.trim() !== `approve ${hash}`) return { status: "rejected", reason: "Rejected, modified or stale approval" };
  const current = await readFile(join(workspace, ".ralph/commands.json"), "utf8").catch((e) => { if (e.code === "ENOENT") return undefined; throw e; });
  if (current !== previous) return { status: "rejected", reason: "Configuration changed while awaiting approval" };
  await mkdir(join(workspace, ".ralph"), { recursive: true });
  const temporary = join(workspace, `.ralph/commands-${randomUUID()}.tmp`);
  try { await writeFile(temporary, `${JSON.stringify(config, null, 2)}'"\\n"'`, { flag: "wx" }); await rename(temporary, join(workspace, ".ralph/commands.json")); }
  finally { await rm(temporary, { force: true }); }
  return { status: "not-ready", revision, hash, platform: process.platform, reason: "Verification pending" };
}
