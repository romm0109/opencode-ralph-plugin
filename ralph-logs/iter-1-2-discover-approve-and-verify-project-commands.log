test(\"overlapping setup cannot replace a pending approval\", async () => {
  const project = await createTestProject();
  try {
    const first = await workflow(project, [fixtureCommand(\"check\", \"check\", \"cleanup\", [join(project.directory, \"check\")])]);
    let release"'!: () => void;
    let entered!: () => void;
    const ready = new Promise<void>((r) => { entered = r; });
    const gate = new Promise<void>((r) => { release = r; });
    first.adapter.requestUserInput = async () => { entered(); await gate; return { ok: false, error: { code: "cancelled", message: "Fixture rejected" } }; };
    const pending = first.router.setupProject({ workspace: project.directory, sessionId: "main" });
    await ready;
    try {
      const second = await workflow(project, [fixtureCommand("check", "check", "fail")]);
      const result = await second.router.setupProject({ workspace: project.directory, sessionId: "other" });
      expect(result.status).toBe("not-ready");
      expect(result.reason).toContain("already active");
    } finally { release(); await pending; }
  } finally { await project.cleanup(); }
});
