/** Canonical repository lock covers discovery, approval, save and verification. */
export async function setupProject(options: ProjectSetupOptions & { store: RunStore; adapter: OpenCodeAdapter }): Promise<ProjectSetupStatus> {
  const lock = join(options.store.root, \"project-setup.lock\");
  try { await mkdir(lock); }
  catch (e) {
    if ((e as NodeJS.ErrnoException).code === \"EEXIST\") return { status: \"not-ready\", reason: \"Project setup is already active; interrupted locks require reconciliation\" };
    throw e;
  }
  try {
    const result = await performSetup(options);
    await options.adapter.publishStatus(options.sessionId, options.workspace, JSON.stringify(result, null, 2));
    return result;
  } finally { await rm(lock, { recursive: true }); }
}
