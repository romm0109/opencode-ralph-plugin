async function workflow(project: Awaited<ReturnType<typeof createTestProject>>, commands: unknown[], revision = 1) {
  const fake = createFakeOpenCode();
  fake.respond(JSON.stringify({ schemaVersion: 1, revision, commands, rationale: \"Fixture commands; no other scripts exist.\" }));
  const store = await openRunStore(project.directory);
  const adapter = createOpenCodeAdapter(fake.client, store);
  adapter.requestUserInput = async (request) => ({ ok: true, ...request, source: \"user\", messageId: \"human\", text: "'`approve ${request.question.match(/hash ([a-f0-9]+)/)?.[1]}` });
  adapter.authorizeCommand = async () => ({ ok: true });
  return { router: createCommandRouter(store, adapter), adapter, store };
}
function fixtureCommand(id: string, phase: string, mode: string, args: string[] = [], timeoutMs = 2000) {
  return { id, phase, executable: process.execPath, args: [join(import.meta.dir, "../fixtures/process-child.ts"), mode, ...args], cwd: ".", timeoutMs, platforms: ["darwin", "linux", "win32"], env: {} };
}

test("failed check blocks readiness and still attempts cleanup", async () => {
  const project = await createTestProject();
  try {
    const cleaned = join(project.directory, "cleaned");
    const { router } = await workflow(project, [fixtureCommand("check", "check", "fail"), fixtureCommand("cleanup", "cleanup", "cleanup", [cleaned])]);
    const result = await router.setupProject({ workspace: project.directory, sessionId: "main" });
    expect(result).toMatchObject({ status: "not-ready" });
    expect(result.reason).toContain("check:");
    expect(result.results?.[0]?.exitCode).toBe(7);
    expect(await Bun.file(cleaned).text()).toBe("cleaned");
    expect(await router.projectStatus(project.directory)).toMatchObject({ status: "not-ready" });
  } finally { await project.cleanup(); }
});

for (const phase of ["setup", "check"] as const) {
  test(`hung ${phase} is timed out, never skipped during initial verification`, async () => {
    const project = await createTestProject();
    try {
      const commands = [fixtureCommand("hung", phase, "hang", [], 100)];
      if (phase === "setup") commands.push(fixtureCommand("check", "check", "fail"));
      const { router } = await workflow(project, commands);
      const result = await router.setupProject({ workspace: project.directory, sessionId: "main" });
      expect(result.status).toBe("not-ready");
      expect(result.reason).toContain(`${phase}:`);
      expect(result.results?.[0]?.status).toBe("timed_out");
    } finally { await project.cleanup(); }
  });
}

test("denied execution is never bypassed, even after configuration approval", async () => {
  const project = await createTestProject();
  try {
    const record = join(project.directory, "must-not-exist");
    const { router, adapter } = await workflow(project, [fixtureCommand("check", "check", "record", [record])]);
    adapter.authorizeCommand = async () => ({ ok: false, error: { code: "permission-denied", message: "Host denied" } });
    const result = await router.setupProject({ workspace: project.directory, sessionId: "main" });
    expect(result.results?.[0]?.status).toBe("permission_denied");
    expect(await access(record).then(() => true, () => false)).toBe(false);
  } finally { await project.cleanup(); }
});

test("modified, stale and rejected replacement approvals preserve the verified configuration", async () => {
  const project = await createTestProject();
  try {
    const check = fixtureCommand("check", "check", "cleanup", [join(project.directory, "check")]);
    const first = await workflow(project, [check]);
    expect((await first.router.setupProject({ workspace: project.directory, sessionId: "main" })).status).toBe("verified");
    const saved = await Bun.file(join(project.directory, ".ralph/commands.json")).text();
    for (const change of ["reject", "modified", "stale"]) {
      const next = await workflow(project, [check], 2);
      const approve = next.adapter.requestUserInput;
      next.adapter.requestUserInput = async (request) => {
        const result = await approve(request);
        if (!result.ok) return result;
        return { ...result, ...(change === "stale" ? { revision: 1 } : { text: change === "reject" ? "reject" : `${result.text} modified` }) };
      };
      expect((await next.router.setupProject({ workspace: project.directory, sessionId: "main" })).status).toBe("rejected");
      expect(await Bun.file(join(project.directory, ".ralph/commands.json")).text()).toBe(saved);
      expect((await next.router.projectStatus(project.directory)).status).toBe("verified");
    }
  } finally { await project.cleanup(); }
}, 10000);
EOF
