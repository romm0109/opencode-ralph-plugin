    if (commandConfigHash(saved) !== hash || !config.commands.some((c) => JSON.stringify(c) === JSON.stringify(command))) throw new Error("Command is not in the saved approved revision");
    if (!command.platforms.some((p) => p === platform)) throw new Error(`Command unsupported on ${platform}`);
    const root = await realpath(job.workspace);
    cwd = await realpath(resolve(root, command.cwd));
