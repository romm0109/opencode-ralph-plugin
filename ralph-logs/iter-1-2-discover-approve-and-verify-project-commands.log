test(\"invalid platform coverage, paths and ordering fail before approval\", async () => {
  const project = await createTestProject();
  try {
    const check = fixtureCommand(\"check\", \"check\", \"fail\");
    const variants = [[{ ...check, platforms: [\"linux\"] }], [{ ...check, cwd: \"../outside\" }], [check, fixtureCommand(\"late-setup\", \"setup\", \"fail\")]];
    for (const commands of variants) {
      const { router, adapter } = await workflow(project, commands);
      let approvals = 0;
      adapter.requestUserInput = async () => { approvals++; return { ok: false, error: { code: \"unsupported\", message: \"Unexpected approval\" } }; };
      expect((await router.setupProject({ workspace: project.directory, sessionId: \"main\" })).status).toBe(\"not-ready\");
      expect(approvals).toBe(0);
    }
  } finally { await project.cleanup(); }
});

test(\"cleanup errors remain visible and invalidate readiness\", async () => {
  const project = await createTestProject();
  try {
    const { router } = await workflow(project, [fixtureCommand(\"check\", \"check\", \"cleanup\", [join(project.directory, \"checked\")]), fixtureCommand(\"cleanup\", \"cleanup\", \"fail\")]);
