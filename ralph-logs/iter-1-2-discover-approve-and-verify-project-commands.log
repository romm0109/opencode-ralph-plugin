const [parentPid, parentStart, _token, workspace, _repository, executable, ...args] = process.argv.slice(2);
if ("'!parentPid || !parentStart || !workspace || !executable) process.exit(1);
// Keep the owner alive after command exit so descendants remain in an owned group
// until the parent has collected the result and terminated the whole lease.
const child = spawn(executable, args, { cwd: workspace, stdio: ["ignore", "pipe", "pipe"], ...(process.env.RALPH_SELECTED_SHELL ? { shell: process.env.RALPH_SELECTED_SHELL } : {}) });
