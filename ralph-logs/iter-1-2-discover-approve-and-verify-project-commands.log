// Linked worktrees activate separate OpenCode locations in the same server.
// Recover shared state once; tearing down one location must not stop another.
const repositories = new Map<
  string,
  { instances: number; ready: Promise<void>; error?: unknown }
>();

export const RalphPlugin = Plugin.define({
  id: "ralph",
  async setup(ctx) {
    const directory = ctx.location.directory;
    const store = await openRunStore(directory);
    const existing = repositories.get(store.root);
    let activate: () => void = () => {};
    const repository = existing ?? {
      instances: 0,
      ready: new Promise<void>((resolve) => {
        activate = resolve;
      }),
    };
    repositories.set(store.root, repository);
    repository.instances++;
    const registrations: Registration[] = [];
    const observationAliases = new Set<string>();
    async function prepareReview(_workspace: string, allowed: string[]) {
      const catalog = await ctx.tool.list();
      const selected = catalog.filter(
        (tool) => allowed.includes(tool.id) && !observationAliases.has(tool.id),
      );
      if (!selected.length) return;
      registrations.push(
        await ctx.tool.transform((editor) => {
          for (const tool of selected)
            editor.add({
              name: reviewToolAlias(tool.id),
              description: tool.description,
              input: tool.input,
              ...(tool.output ? { output: tool.output } : {}),
              options: {
                codemode: false,
                permission: tool.options?.permission ?? tool.id,
              },
              execute: tool.execute,
            });
        }),
      );
      for (const tool of selected) observationAliases.add(tool.id);
      await ctx.tool.reload();
    }
    let statusEvents:
      | Awaited<ReturnType<typeof ctx.rpc.register<typeof ralphBridge>>>
      | undefined;
    const adapter = createOpenCodeAdapter(
      {
        session: ctx.session,
        assertCommandPermission: async (sessionId, command, hash) => {
          await ctx.permission.assert({
            sessionID: sessionId,
            action: "shell",
            resources: [
              JSON.stringify({
                executable: command.executable,
                args: command.args,
                cwd: command.cwd,
                shell: command.shell,
              }),
            ],
            metadata: { ralphCommandHash: hash, commandId: command.id },
          });
        },
        tools: async () => (await ctx.tool.list()).map((tool) => tool.id),
        prepareReview,
        notify: async (_workspace, text) => {
          await statusEvents?.events.emit("status", { text });
        },
      },
      store,
    );
    const recoveryNotifications: string[] = [];
    try {
      if (existing) {
        await repository.ready;
        if (repository.error) throw repository.error;
      } else
        for (const run of await store.listRuns()) {
          if (
            run.reviewWorkflow?.status === "terminal" &&
            Object.values(run.operations).every((op) => op.status !== "intent")
          )
            continue;

