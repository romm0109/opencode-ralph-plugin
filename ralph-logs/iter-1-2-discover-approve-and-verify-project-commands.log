    expect(result.status).toBe("verified");
    expect(await Bun.file(record).json()).toEqual({ argv: ["argument with spaces", "$(literal)"], cwd: project.directory, env: "fixture-sensitive-value" });
    expect(await Bun.file(cleaned).text()).toBe("cleaned");
    expect(JSON.stringify(result)).not.toContain("fixture-sensitive-value");
