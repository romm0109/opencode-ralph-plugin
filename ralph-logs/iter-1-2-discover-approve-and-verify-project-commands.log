    expect(result.status).toBe(\"not-ready\");
    expect(result.cleanupError).toContain(\"cleanup:\");
    const { assertProjectReady } = await import(\"../../src/commands/project-setup.js\");
    await expect(assertProjectReady(project.directory)).rejects.toThrow(\"cleanup:\");
  } finally { await project.cleanup(); }
});
