    denyTool: () => {
      deniedTool = true;
    },
    invalidTool: () => {
      invalidTool = true;
    },
    failCodeMode: () => {
      failedCodeMode = true;
    },
    empty: () => {
      empty = true;
    },
    holdCreation: () => {
      holdCreation = true;
