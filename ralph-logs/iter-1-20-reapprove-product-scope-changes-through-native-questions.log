      delete next.prd;
      delete next.graph;
      delete next.prdAcceptance;
      delete next.issueAcceptance;
      delete next.issueHandoff;
      delete next.executionEligibility;
      delete next.publication;
      delete next.error;
    }
    next.explanation = {
      revision,
      hash,
      text: value.text,
      scope: value.scope,
      criteria: value.criteria,
    };
    next.proposalContext = {
      sha,
      branch,
      commandHash,
      commandRevision: config.commands.revision,
    };
    next.phase = "explanation_approval";
    delete next.approval;
    delete next.prdDelivery;
    next.pending = {
      kind: "explanation",
      runId: run.runId,
      sessionId,
      workspace: state.workspace,
      requestId: randomUUID(),
      revision,
      question: `${value.text}\nScope:\n${value.scope.join("\n")}\nAcceptance criteria:\n${value.criteria.join("\n")}\nBranch: ${branch}\nFull pinned HEAD SHA: ${sha}\nCommand revision: ${config.commands.revision}\nCommand hash: ${commandHash}\nApprove revision ${revision} to authorize PRD creation, issue planning, and automatic execution through implementation within this scope. Reject or request changes to return to grilling.`,
      options: [
        {
          label,
          description:
            "Authorize all three stages within this displayed scope, commit, and configuration",
        },
        {
          label: "Request changes",
          description: "Return to grilling without authorization",
        },
      ],
    };
