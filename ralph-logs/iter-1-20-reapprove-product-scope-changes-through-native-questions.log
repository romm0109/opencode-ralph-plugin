      questions.push(required(q).question);
      return { content: "", metadata: { answers: [[required(q).options[0]?.label]] } };
    }});
    const result = JSON.parse(String((await required(f.host.tools.get("ralph_request_product_decision")).execute({
      runId: f.run.runId, attempt: 1, question: "Retain results?", recommendation: "Retain one day",
      revisedExplanation: { text: "Build diamond with retention", scope: ["Diamond", "One day retention"], criteria: ["D works", "Expires after one day"] },
    }, f.planner)).content));
    expect(result.outcome).toBe("accepted");
    expect(questions).toHaveLength(2);
    expect(questions[1]).toContain("Expires after one day");
    const after = required((await f.store.getRun(f.run.runId))?.planning);
    expect(after.approval?.requestId).not.toBe(f.state.approval?.requestId);
    expect(after.phase).toBe("prd_generation");
    expect(after.prd).toBeUndefined();
