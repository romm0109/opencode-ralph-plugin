}
import { loadRoleInstructions } from "../agents/skills.js";
import { continuePlanning } from "../core/orchestrator.js";
import { readReviewGit } from "../git/review-workspace.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { continueInterview } from "../planning/interview.js";
import { generateIssues } from "../planning/issues.js";
import { generatePrd } from "../planning/prd.js";
import { retryUnverifiedReview } from "../review/retry.js";
import type { RunStore } from "../state/run-store.js";

/** Called after an explicit native resume command has passed recovery/control checks. */
export async function resumeWorkflow(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  options: { selectedCommit?: string; review?: boolean } = {},
) {
  const run = await store.getRun(runId);
  const planning = run?.planning;
  if (options.review) return retryUnverifiedReview(store, adapter, runId);
  if (!planning || run.reviewWorkflow?.status === "terminal") return run;
  const activePlanning = Object.values(run.jobs).some(
    (job) =>
      ["interview", "prd", "issues"].includes(job.envelope.role) &&
      job.status !== "terminal",
  );
  if (activePlanning) {
    if (options.selectedCommit)
      throw new Error(
        "Wait for the active planning job before selecting a starting commit",
      );
    return run;
  }
  if (options.selectedCommit) {
    if (planning.protocol === "native-interview-v1")
      throw new Error(
        "Pinned commit changes require renewed explanation approval",
      );
    if (
      !planning.prd ||
      !planning.graph ||
      !["execution_approval", "execution_approved"].includes(planning.phase)
    )
      throw new Error("Select a starting commit after PRD and issue planning");
    if (
      Object.keys(run.issueAttempts ?? {}).length ||
      (run.baseline && run.baseline.status !== "failed")
    )
      throw new Error(
        "The starting commit can change only before issue attempts and after failed baseline cleanup",
      );
    const selectedCommit = (
      await readReviewGit(planning.workspace, [
        "rev-parse",
        "--verify",
        `${options.selectedCommit}^{commit}`,
      ])
    ).trim();
    const next = structuredClone(planning);
    next.selectedCommit = selectedCommit;
    next.phase = "execution_approval";
    delete next.executionEligibility;
    delete next.pending;
    delete next.error;
    if (!(await store.recordPlanning(runId, run.revision, next)))
      throw new Error("Planning changed before starting-commit selection");
    return continuePlanning(store, adapter, runId);
  }
  if (["interview", "explanation_approval"].includes(planning.phase)) {
    const path = planning.settings.skills.interview?.path;
    if (!path) throw new Error("Missing captured interview instructions");
    await continueInterview(
      store,
      adapter,
      runId,
      (
        await loadRoleInstructions(
          planning.workspace,
          "interview",
          path.startsWith("file:") ? {} : { interview: path },
        )
      ).text,
    );
  } else if (planning.phase === "prd_generation")
    await generatePrd(store, adapter, runId);
  else if (planning.phase === "issue_generation")
    await generateIssues(store, adapter, runId);
  return continuePlanning(store, adapter, runId);
}
import type { Plugin } from "@opencode/plugin";
import type { ToolContext } from "@opencode/plugin/promise/tool";
import { z } from "zod";
import type { UserInputRequest, UserInputResult } from "../core/types.js";

const answers = z.object({ answers: z.tuple([z.tuple([z.string().min(1)])]) });

/** Invoke the host's question UI directly; model prose cannot settle a gate. */
export async function requestNativeInput(
  ctx: Pick<Plugin.Context, "session" | "tool">,
  request: UserInputRequest,
  signal: AbortSignal,
): Promise<UserInputResult> {
  signal.throwIfAborted();
  const question = (await ctx.tool.list()).find(
    (tool) => tool.id === "question",
  );
  if (!question)
    return {
      ok: false,
      error: {
        code: "unsupported",
        message: "OpenCode's native question tool is unavailable",
      },
    };
  const session = await ctx.session.get({ sessionID: request.sessionId });
  const result = await question.execute(
    {
      questions: [
        {
          question: request.question,
          header: "Ralph",
          custom: true,
          options:
            request.options ??
            (request.kind === "feature"
              ? []
              : [
                  {
                    label: request.recommendation ?? "Continue",
                    description: request.recommendation
                      ? "Recommended answer; you can also enter your own answer"
                      : "Use the free-text field to describe or revise the feature",
                  },
                ]),
        },
      ],
    },
    {
      sessionID: request.sessionId as ToolContext["sessionID"],
      agent: (session.agent ?? "build") as ToolContext["agent"],
      messageID: `ralph-input:${request.requestId}` as ToolContext["messageID"],
      id: `ralph-input:${request.requestId}` as ToolContext["id"],
      signal,
      progress: async () => {},
    },
  );
  signal.throwIfAborted();
  const parsed = answers.safeParse(result.metadata);
  if (!parsed.success)
    return {
      ok: false,
      error: {
        code: "missing-output",
        message: "Native question returned no single answer",
      },
    };
  return {
    ok: true,
    source: "user",
    requestId: request.requestId,
    revision: request.revision,
    sessionId: request.sessionId,
    messageId: `question:${request.requestId}`,
    text: parsed.data.answers[0][0],
  };
}
