      ok: true,
      ...pending,
      source: "user",
      messageId: "question-wait",
      text: "One",
    });
    await work;
    now += 100;
    await supervisePlanning(f.store, f.adapter, f.run.runId, now);
    await setPlanningQuestionWaiting(
      f.store,
      f.run.runId,
      required(f.run.planning).sessionId,
      "native",
      true,
    );
    now += initial.remainingMs * 2;
    await supervisePlanning(f.store, f.adapter, f.run.runId, now);
    await setPlanningQuestionWaiting(
      f.store,
      f.run.runId,
      required(f.run.planning).sessionId,
      "native",
      false,
    );
    await handleControlCommand("ralph-pause", f.run.runId, f.store, f.adapter);
    now += initial.remainingMs * 2;
    await supervisePlanning(f.store, f.adapter, f.run.runId, now);
    await handleControlCommand("ralph-resume", f.run.runId, f.store, f.adapter);
