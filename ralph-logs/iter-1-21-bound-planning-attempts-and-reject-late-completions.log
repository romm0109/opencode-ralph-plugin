    !state.approval ||
    !state.explanation ||
    state.approval.hash !== explanationHash(state.explanation) ||
    state.approval.revision !== state.explanation.revision ||
    state.approval.sessionId !== sessionId
  )
    throw new Error("Current explanation approval is required");
