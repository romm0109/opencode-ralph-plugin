      Math.max(0, ...(state.history ?? []).map((h) => h.prd?.revision ?? 0)) +
      1;
    const revision: ArtifactRevision = {
      revision: prdRevision,
      hash: artifactHash(text),
      artifactPath: `.ralph/features/${value.runId}/prd-${prdRevision}/PRD.md`,
    };
