/** Injectable scheduling and time keep native waits independent of authoring time. */
export function startPlanningSupervision(
  store: RunStore,
  adapter: OpenCodeAdapter,
  options: { clock?: Clock; onError?: (cause: unknown) => void } = {},
) {
  const clock = options.clock ?? systemClock;
  let disposed = false;
  let cancel = () => {};
  const report = options.onError ?? (cause => console.error(\"Ralph planning supervision failed\", cause));
  async function tick() {
    try {
      for (const run of await store.listRuns()) {
        if (disposed) return;
        void supervisePlanning(store, adapter, run.runId, clock.now?.() ?? Date.now()).catch(report);
      }
    } catch (cause) { if ("'!disposed) report(cause); }
    finally { if (!disposed) cancel = clock.schedule(250, () => { void tick(); }); }
  }
  cancel = clock.schedule(250, () => { void tick(); });
  return () => { disposed = true; cancel(); };
}
