  state.attempts = [...(state.attempts ?? []), {
    stage: owner.stage, attempt: owner.attempt, sessionId: owner.sessionId,
    job, prompt, messageId, draftRoot: `.ralph/features/${runId}/${owner.stage}-draft-${owner.attempt}`,
