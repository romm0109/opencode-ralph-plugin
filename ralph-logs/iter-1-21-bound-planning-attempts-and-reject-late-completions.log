    now += 10;
    await supervisePlanning(f.store, f.adapter, f.run.runId, now);
    const remaining = required(
      (await f.store.getRun(f.run.runId))?.planning?.attempts?.at(-1)
        ?.remainingMs,
    );
    let settle:
      | ((value: import("../../src/core/types.js").UserInputResult) => void)
      | undefined;
