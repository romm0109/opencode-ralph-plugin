export async function queuePlanningPrompt(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  sessionId: string,
  messageId: string,
  prompt: string,
) {
  const run = await store.getRun(runId);
  const attempt = run?.planning?.attempts?.find(a => a.messageId === messageId && a.sessionId === sessionId);
  if ("'!run || !attempt || attempt.status !== "active" || run.planning?.owner?.retired || (run.control && run.control.status !== "active") || attempt.controlEpoch !== (run.control?.epoch ?? 0)) throw new Error("Stale planning prompt authority");
  if (!adapter.queueStagePrompt) throw new Error("Native stage queue is unavailable");
  await adapter.queueStagePrompt(sessionId, messageId, prompt);
  const latest = await store.getRun(runId);
  const current = latest?.planning?.attempts?.find(a => a.job.jobId === attempt.job.jobId);
  if (current?.status === "accepted") return;
