          question: `${stage} exhausted three authoring attempts. ${state.error?.message ?? attempt.reason?.message}. Partial drafts are retained. Reset the budget and retry, or stop?`,
          options: [
            {
              label: "Reset budget and retry",
              description: "Authorize three new authoring attempts",
            },
            { label: "Stop", description: "Retain drafts and stop the run" },
          ],
        };
        if (!(await store.recordPlanning(runId, run.revision, state))) return;
        await adapter.publishStatus(
          owner.sessionId,
          state.workspace,
          state.pending.question,
        );
      }
      const request = state.pending;
      if (request.kind !== "planning-recovery") return;
      const beforeQuestion = await store.getRun(runId);
      if (
        !beforeQuestion ||
        (beforeQuestion.control?.epoch ?? 0) !== controlEpoch ||
        (beforeQuestion.control &&
          beforeQuestion.control.status !== "active") ||
        beforeQuestion.planning?.pending?.requestId !== request.requestId ||
        !beforeQuestion.planning.owner?.retired ||
        beforeQuestion.planning.owner.attempt !== attempt.attempt
      )
        return;
      const answer = await adapter.requestUserInput(request);
      run = await store.getRun(runId);
      state = run?.planning;
      if (
        !run ||
        (run.control?.epoch ?? 0) !== controlEpoch ||
        !state ||
        (run.control && run.control.status !== "active") ||
        state.pending?.requestId !== request.requestId
      )
        return;
      if (!answer.ok) {
        const error = {
          ...answer.error,
          message: `${stage} exhausted three attempts: ${attempt.reason?.message}. Native recovery input unavailable: ${answer.error.message}`,
        };
        if (
          state.error?.message !== error.message ||
          state.error.code !== error.code
        ) {
          state.error = error;
          if (await store.recordPlanning(runId, run.revision, state))
            await adapter.publishStatus(
              request.sessionId,
              state.workspace,
              error.message,
            );
        }
        return;
      }
      if (
        answer.source !== "user" ||
        !answer.messageId ||
        answer.sessionId !== request.sessionId ||
        answer.requestId !== request.requestId ||
        answer.revision !== request.revision ||
        state.budgetResets?.some((r) => r.answer.messageId === answer.messageId)
      )
        return;
      if (answer.text === "Stop") {
        await handleControlCommand("ralph-stop", runId, store, adapter, {
          source: "human",
          expectedRevision: run.revision,
        });
        return;
      }
      if (answer.text !== "Reset budget and retry") return;
      state.budgetResets = [
        ...(state.budgetResets ?? []),
        {
          stage,
          afterAttempt: owner.attempt,
          explanationRevision: state.explanation?.revision ?? 0,
          answer,
        },
      ];
      delete state.pending;
      if (!(await store.recordPlanning(runId, run.revision, state))) return;
    }
    run = await store.getRun(runId);
    state = run?.planning;
    if (
      !run ||
      (run.control?.epoch ?? 0) !== controlEpoch ||
      !state?.owner?.retired ||
      (run.control && run.control.status !== "active")
    )
      return;
    // A native recovery question can wait indefinitely. Its earlier idle receipt
    // cannot authorize dispatch after the user answers into a now-busy session.
    const settled = await adapter.inspectSession?.(attempt.job);
    if (
      !["idle", "missing"].includes(settled ?? "unknown") ||
      (stage === "prd" && settled === "missing")
    ) {
      state.error = {
        code: "cancelled",
        message:
          "Planning owner is not settled after recovery; retry waits for session reconciliation",
      };
      await store.recordPlanning(runId, run.revision, state);
      return;
    }
    const afterInspection = await store.getRun(runId);
    if (
      !afterInspection ||
      afterInspection.revision !== run.revision ||
      (afterInspection.control?.epoch ?? 0) !== controlEpoch ||
      (afterInspection.control && afterInspection.control.status !== "active")
    )
      return;
    const number = state.owner.attempt + 1;
    let sessionId = state.owner.sessionId;
    if (stage === "issues") {
      if (!adapter.findIssueSession || !adapter.createIssueSession) return;
      const jobId = `retry-${attempt.job.jobId}-${number}`;
      sessionId =
        (await adapter.findIssueSession(
          state.workspace,
          runId,
          jobId,
          number,
        )) ??
        (await adapter.createIssueSession(
          state.workspace,
          runId,
          jobId,
          number,
          requiredPlanningModel(state, stage),
        ));
    }
    // Re-read after external work: stop/pause/completion cannot authorize this retry.
    const latest = await store.getRun(runId);
    if (
      !latest ||
      latest.revision !== run.revision ||
      (latest.control?.epoch ?? 0) !== controlEpoch
    )
      return;
    state.owner = { stage, attempt: number, sessionId };
    state.sessionId = sessionId;
    delete state.error;
    const messageId = `msg_ralph-${stage}-retry-${randomUUID()}`;
    const prompt = `${attempt.prompt}\nRETRY AUTHORITATIVE IDENTITY: runId=${runId}, attempt=${number}. All tools MUST use attempt ${number}. Draft directory: .ralph/features/${runId}/${stage}-draft-${number}. Previous partial drafts (read only): ${JSON.stringify(state.attempts?.filter((a) => a.stage === stage).map((a) => a.draftRoot))}. Failure: ${attempt.reason?.message}. Approved explanation: ${JSON.stringify(state.explanation)}. Accepted PRD: ${JSON.stringify(state.prd)}. Product decisions: ${JSON.stringify(state.decisions ?? [])}. Final prose does not complete this stage; call ralph_complete_${stage}.`;
    if (stage === "prd")
      state.prdDelivery = { id: messageId, text: prompt, status: "intent" };
    else if (state.issueHandoff)
      state.issueHandoff = {
        ...state.issueHandoff,
        sessionId,
        attempt: number,
        messageId,
        prompt,
        queued: false,
        focused: false,
      };
    // Append the new record in the same guarded ownership transition.
    const { reason: _reason, ...previous } = attempt;
    state.attempts = [
      ...(state.attempts ?? []),
      {
        ...previous,
        attempt: number,
        sessionId,
        job: {
          ...attempt.job,
          jobId: `planning-${stage}-${randomUUID()}`,
          sessionId,
          attempt: number,
          prompt,
        },
        messageId,
        prompt,
        draftRoot: `.ralph/features/${runId}/${stage}-draft-${number}`,
        remainingMs: state.settings.agentTimeoutMs ?? state.settings.timeoutMs,
        controlEpoch: run.control?.epoch ?? 0,
        observedAt: now,
        suspended: false,
        status: "active",
      },
    ];
    if (!(await store.recordPlanning(runId, run.revision, state))) return;
    attempt = state.attempts?.at(-1);
    if (!attempt) throw new Error("Missing persisted planning attempt");
    if (!(await store.recordIntent(attempt.job))) return;
    const beforeQueue = await store.getRun(runId);
    if (
      !beforeQueue ||
      (beforeQueue.control && beforeQueue.control.status !== "active") ||
      beforeQueue.planning?.owner?.attempt !== number
    )
      return;
    await queuePlanningPrompt(
      store,
      adapter,
      runId,
      sessionId,
      messageId,
      prompt,
    );
    if (stage === "issues")
      await adapter.focusStageSession?.(
        state.workspace,
        runId,
        sessionId,
        "issues",
      );
  } finally {
    supervising.delete(key);
  }
}
function requiredPlanningModel(state: PlanningState, stage: "prd" | "issues") {
  const model = state.settings.models[stage] ?? state.settings.models.interview;
  if (!model) throw new Error("Missing planning model");
  return model;
}

/** Native question tools can also be invoked directly by the stage agent. */
export async function setPlanningQuestionWaiting(
  store: RunStore,
  runId: string,
  sessionId: string,
  id: string,
  waiting: boolean,
) {
  let run = await store.getRun(runId);
  const epoch = run?.control?.epoch ?? 0;
  while (run?.control?.status === "paused") {
    await new Promise((resolve) => setTimeout(resolve, 20));
    run = await store.getRun(runId);
  }
  const state = run?.planning;
  if ((run?.control?.epoch ?? 0) !== epoch) return;
  if (
    !run ||
    !state ||
    state.owner?.sessionId !== sessionId ||
    state.owner.retired ||
    (run.control && run.control.status !== "active")
  )
    return;
  state.nativeQuestions = waiting
    ? [...new Set([...(state.nativeQuestions ?? []), id])]
    : (state.nativeQuestions ?? []).filter((value) => value !== id);
  for (const attempt of state.attempts ?? [])
    if (attempt.status === "active") {
      attempt.suspended = true;
      delete attempt.observedAt;
    }
  await savePlanning(store, runId, run.revision, state);
}

/** Injectable scheduling and time keep native waits independent of authoring time. */
export function startPlanningSupervision(
  store: RunStore,
  adapter: OpenCodeAdapter,
  options: { clock?: Clock; onError?: (cause: unknown) => void } = {},
) {
  const clock = options.clock ?? systemClock;
  let disposed = false;
  let cancel = () => {};
  const report =
    options.onError ??
    ((cause) => console.error("Ralph planning supervision failed", cause));
  async function tick() {
    try {
      for (const run of await store.listRuns()) {
        if (disposed) return;
        void supervisePlanning(
          store,
          adapter,
          run.runId,
          clock.now?.() ?? Date.now(),
        ).catch(report);
      }
    } catch (cause) {
      if (!disposed) report(cause);
    } finally {
      if (!disposed)
        cancel = clock.schedule(250, () => {
          void tick();
        });
    }
  }
  cancel = clock.schedule(250, () => {
    void tick();
  });
  return () => {
    disposed = true;
    cancel();
  };
}

/** Check authority on both sides of inbox delivery, which may outlive stop cleanup. */
export async function queuePlanningPrompt(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  sessionId: string,
  messageId: string,
  prompt: string,
) {
  const run = await store.getRun(runId);
  const attempt = run?.planning?.attempts?.find(
    (a) => a.messageId === messageId && a.sessionId === sessionId,
  );
  if (
    !run ||
    !attempt ||
    attempt.status !== "active" ||
    run.planning?.owner?.retired ||
    (run.control && run.control.status !== "active") ||
    attempt.controlEpoch !== (run.control?.epoch ?? 0)
  )
    throw new Error("Stale planning prompt authority");
  if (!adapter.queueStagePrompt)
    throw new Error("Native stage queue is unavailable");
  await adapter.queueStagePrompt(sessionId, messageId, prompt);
  const latest = await store.getRun(runId);
  const current = latest?.planning?.attempts?.find(
    (a) => a.job.jobId === attempt.job.jobId,
  );
  if (current?.status === "accepted") return;
  if (
    !latest ||
    current?.status !== "active" ||
    (latest.control?.epoch ?? 0) !== attempt.controlEpoch ||
    (latest.control && !["active", "paused"].includes(latest.control.status))
  ) {
    const cancelled = await adapter.cancelJob(attempt.job);
    if (!cancelled.ok)
      throw new Error(
        "Late planning delivery cancellation is unconfirmed; reconcile the owned session",
      );
    throw new Error("Planning authority retired during prompt delivery");
  }
}
import { createHash, randomUUID } from "node:crypto";
import { mkdir, realpath, rm, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { z } from "zod";
import { loadRoleInstructions } from "../agents/skills.js";
import {
  assertProjectConfigured,
  projectStatus,
} from "../commands/project-setup.js";
import { commandConfigHash } from "../config/commands.js";
import { loadProjectConfig } from "../config/project.js";
import type { JobEnvelope, JobResult, UserInputResult } from "../core/types.js";
import {
  readReviewGit,
  verifyReviewRepository,
} from "../git/review-workspace.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { explanationHash } from "./artifacts.js";
import type { PlanningState } from "./types.js";

const output = z.discriminatedUnion("kind", [
  z
    .object({
      kind: z.literal("question"),
      question: z.string().min(1),
      recommendation: z.string().min(1),
    })
    .strict(),
  z
    .object({
      kind: z.literal("explanation"),
      text: z.string().min(1),
      scope: z.array(z.string().min(1)).min(1),
      criteria: z.array(z.string().min(1)).min(1),
    })
    .strict(),
]);
export interface InterviewOptions {
  workspace: string;
  sessionId: string;
  feature?: string;
  store: RunStore;
  adapter: OpenCodeAdapter;
  native?: boolean;
}
async function save(
  store: RunStore,
  runId: string,
  revision: number,
  state: PlanningState,
) {
  if (!(await store.recordPlanning(runId, revision, state)))
    throw new Error("Stale interview transition");
}
/** Human provenance and the persisted request are the only approval authority. */
export async function handleInterviewResponse(
  store: RunStore,
  runId: string,
  response: UserInputResult,
): Promise<boolean> {
  const run = await store.getRun(runId);
  const state = run?.planning;
  const pending = state?.pending;
  if (
    !run ||
    !state ||
    !pending ||
    !response.ok ||
    response.source !== "user" ||
    !response.messageId ||
    !response.text.trim() ||
    response.requestId !== pending.requestId ||
    response.revision !== pending.revision ||
    response.sessionId !== pending.sessionId ||
    state.transcript.some((entry) => entry.messageId === response.messageId)
  )
    return false;
  const next = structuredClone(state);
  delete next.pending;
  delete next.error;
  next.transcript.push({
    source: "user",
    text: response.text,
    messageId: response.messageId,
    requestId: response.requestId,
    revision: response.revision,
  });
  if (state.phase === "explanation_approval") {
    const explanation = state.explanation;
    if (state.protocol === "native-interview-v1") {
      const context = state.proposalContext;
      const config = await loadProjectConfig(state.workspace);
      if (
        !context ||
        state.owner?.sessionId !== response.sessionId ||
        pending.kind !== "explanation" ||
        context.sha !==
          (
            await readReviewGit(state.workspace, ["rev-parse", "HEAD"])
          ).trim() ||
        context.branch !==
          (
            await readReviewGit(state.workspace, [
              "rev-parse",
              "--abbrev-ref",
              "HEAD",
            ])
          ).trim() ||
        context.commandHash !== commandConfigHash(config.commands) ||
        context.commandRevision !== config.commands.revision
      )
        return false;
    }
    if (!explanation || explanation.revision !== response.revision)
      return false;
    if (
      response.text.trim() ===
      (state.protocol === "native-interview-v1"
        ? pending.options?.[0]?.label
        : `approve ${explanation.revision}`)
    ) {
      next.phase = "explanation_approved";
      next.approval = {
        ...(state.protocol === "native-interview-v1"
          ? {
              ...state.proposalContext,
              sessionId: response.sessionId,
              timestamp: new Date().toISOString(),
            }
          : {}),
        revision: explanation.revision,
        hash: explanation.hash,
        messageId: response.messageId,
        requestId: response.requestId,
      };
    } else {
      next.phase = "interview";
      if (next.owner) next.owner.stage = "interview";
      delete next.prdDelivery;
      delete next.approval;
    }
  } else if (pending.kind === "feature" || !next.feature)
    next.feature = response.text;
  return store.recordPlanning(runId, run.revision, next);
}
export async function continueInterview(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  instructions: string,
) {
  for (;;) {
    const run = await store.getRun(runId);
    if (!run?.planning) throw new Error("Unknown planning run");
    const state = structuredClone(run.planning);
    if (
      createHash("sha256").update(instructions).digest("hex") !==
      state.settings.skills.interview?.hash
    )
      throw new Error(
        "Interview instructions differ from the captured run hash. Restore the selected skill before continuing.",
      );
    if (
      state.phase === "explanation_approved" ||
      (state.protocol === "native-interview-v1" &&
        state.owner?.stage === "prd") ||
      (run.control && run.control.status !== "active")
    )
      return run;
    if (state.pending) {
      const published = await adapter.publishStatus(
        state.sessionId,
        state.workspace,
        state.pending.question,
      );
      const response: UserInputResult = published.ok
        ? await adapter.requestUserInput(state.pending)
        : {
            ok: false,
            error: published.error ?? {
              code: "sdk-error",
              message: "Could not publish question",
            },
          };
      if (!response.ok) {
        const latest = await store.getRun(runId);
        if (latest?.planning?.pending?.requestId === state.pending.requestId)
          await save(store, runId, latest.revision, {
            ...latest.planning,
            error: response.error ?? {
              code: "sdk-error",
              message: "Could not publish question",
            },
          });
        return store.getRun(runId);
      }
      if (!(await handleInterviewResponse(store, runId, response)))
        return store.getRun(runId);
      continue;
    }
    if (state.phase === "explanation_approval" && state.explanation) {
      const artifact = state.explanation;
      state.pending = {
        runId,
        workspace: state.workspace,
        sessionId: state.sessionId,
        requestId: randomUUID(),
        revision: artifact.revision,
        question: `${artifact.text}\nScope:\n${artifact.scope.join("\n")}\nAcceptance criteria:\n${artifact.criteria.join("\n")}\nApprove revision ${artifact.revision} by replying approve ${artifact.revision}, or reply with revisions.`,
      };
      await save(store, runId, run.revision, state);
      continue;
    }
    if (!state.feature) {
      state.pending = {
        runId,
        workspace: state.workspace,
        sessionId: state.sessionId,
        requestId: randomUUID(),
        revision: 0,
        question: "What feature should we build? Describe the result you need.",
      };
      await save(store, runId, run.revision, state);
      continue;
    }
    state.turn++;
    await save(store, runId, run.revision, state);
    const selectedModel = state.settings.models.interview;
    if (!selectedModel)
      throw new Error("Planning run has no captured interview model");
    const job: JobEnvelope = {
      runId,
      jobId: `interview-${state.turn}`,
      attempt: 1,
      role: "interview",
      workspace: state.workspace,
      baseCommit: "",
      inputRevisions: {
        interview: state.turn,
        explanation: state.explanation?.revision ?? 0,
      },
      readOnly: true,
      ...(state.protocol === "native-interview-v1"
        ? { sessionId: state.sessionId }
        : {}),
      model: selectedModel,
      prompt: `${instructions}\nFeature: ${state.feature}\nTranscript: ${JSON.stringify(state.transcript)}\nPrevious explanation: ${JSON.stringify(state.explanation ?? null)}\nStage identity: runId=${runId}, attempt=${state.owner?.attempt ?? 1}. Finish with ralph_complete_interview.`,
    };
    let timer: ReturnType<typeof setTimeout> | undefined;
    const timeout = new Promise<undefined>((resolve) => {
      timer = setTimeout(() => resolve(undefined), state.settings.timeoutMs);
    });
    let result: JobResult | undefined;
    try {
      result = await Promise.race([
        adapter.dispatchJob(job).catch(
          (cause): JobResult => ({
            ...job,
            outcome: "failed",
            evidence: [],
            error: {
              code: "sdk-error",
              message: "Interview dispatch failed",
              cause: String(cause),
            },
          }),
        ),
        timeout,
      ]);
    } finally {
      if (timer) clearTimeout(timer);
    }
    if (!result) {
      const timed = await store.getRun(runId);
      if (
        timed?.planning &&
        timed.planning.turn === state.turn &&
        (!timed.control || timed.control.status === "active")
      ) {
        await save(store, runId, timed.revision, {
          ...timed.planning,
          error: {
            code: "cancelled",
            message: `Interview timed out after ${state.settings.timeoutMs}ms`,
          },
        });
        await store.recordControl(runId, {
          status: "interrupted",
          source: "recovery",
          facts: [
            "Interview timed out; inspect the correlated session before resuming.",
          ],
        });
        await adapter.cancelJob(job);
      }
      return store.getRun(runId);
    }
    const latest = await store.getRun(runId);
    if (
      !latest?.planning ||
      latest.planning.turn !== state.turn ||
      latest.planning.pending ||
      latest.planning.phase !== "interview" ||
      (latest.control && latest.control.status !== "active")
    )
      return latest;
    const next = structuredClone(latest.planning);
    if (result.outcome !== "completed" || !result.text) {
      next.error = result.error ?? {
        code: "missing-output",
        message: "Interview returned no output",
      };
      await save(store, runId, latest.revision, next);
      return store.getRun(runId);
    }
    let parsed: z.infer<typeof output>;
    try {
      parsed = output.parse(JSON.parse(result.text));
      if (
        parsed.kind === "explanation" &&
        /(?:ASD[\s-]*)?STE[\s-]*100/i.test(
          [parsed.text, ...parsed.scope, ...parsed.criteria].join(" "),
        )
      )
        throw new Error(
          "Use simplified English without formal STE compliance claims.",
        );
    } catch (cause) {
      next.error = {
        code: "missing-output",
        message: `Invalid interview output. Return a recommended question or an explanation with scope and criteria. ${String(cause)}`,
        cause: String(cause),
      };
      await save(store, runId, latest.revision, next);
      return store.getRun(runId);
    }
    if (
      state.protocol === "native-interview-v1" &&
      parsed.kind === "explanation"
    ) {
      // This slice has no explanation completion or approval transition.
      return latest;
    }
    next.transcript.push({ source: "interviewer", text: result.text });
    let question: string;
    if (parsed.kind === "question")
      question = `${parsed.question}\nRecommended: ${parsed.recommendation}`;
    else {
      const revision = (next.explanation?.revision ?? 0) + 1;
      next.explanation = {
        revision,
        hash: explanationHash(parsed),
        text: parsed.text,
        scope: parsed.scope,
        criteria: parsed.criteria,
      };
      delete next.approval;
      next.phase = "explanation_approval";
      question = `${parsed.text}\nScope:\n${parsed.scope.join("\n")}\nAcceptance criteria:\n${parsed.criteria.join("\n")}\nApprove revision ${revision} by replying approve ${revision}, or reply with revisions.`;
    }
    next.pending = {
      runId,
      sessionId: next.sessionId,
      workspace: next.workspace,
      requestId: randomUUID(),
      revision: next.explanation?.revision ?? 0,
      question,
      ...(state.protocol === "native-interview-v1" && parsed.kind === "question"
        ? { kind: "interview" as const, recommendation: parsed.recommendation }
        : {}),
    };
    await save(store, runId, latest.revision, next);
  }
}
export async function startInterview(options: InterviewOptions) {
  const { store, adapter, sessionId } = options;
  const workspace = await realpath(options.workspace);
  await verifyReviewRepository(workspace, store.repositoryId);
  await assertProjectConfigured(workspace);
  const config = await loadProjectConfig(workspace);
  const skill = await loadRoleInstructions(
    workspace,
    "interview",
    config.skillPaths,
  );
  const model =
    config.models.interview ?? (await adapter.getSessionModel?.(sessionId));
  if (!model)
    throw new Error(
      "Main session model is unavailable. Set models.interview in .ralph/project.json.",
    );
  if (
    options.native &&
    (!adapter.createInterviewSession ||
      !(await adapter.discoverTools?.(workspace))?.includes("question"))
  )
    throw new Error(
      "OpenCode native question capability is unavailable. Enable the question tool before starting /ralph-orchestrator.",
    );
  if (options.native) {
    for (const existing of await store.listRuns()) {
      if (
        existing.planning &&
        existing.control?.status !== "stopped" &&
        existing.phase !== "completed"
      ) {
        if (existing.planning.protocol !== "native-interview-v1")
          throw new Error(
            "Unsupported planning protocol owns this repository. Inspect /ralph-status and settle /ralph-stop before starting fresh; no migration is available.",
          );
        throw new Error(
          `Interview ${existing.runId} already owns this repository (${existing.planning.phase}). Inspect /ralph-status; use /ralph-stop before starting a fresh interview.`,
