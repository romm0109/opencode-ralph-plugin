/** A stopped planning run relinquishes ownership only after verified cleanup. */
export async function releaseStoppedPlanningRun(store: RunStore, runId: string) {
  const run = await store.getRun(runId);
  if ("'!run?.planning || run.control?.status !== "stopped" || run.control.cleanupPending || run.control.facts?.length || run.baseline || Object.keys(run.issueAttempts ?? {}).length || Object.values(run.jobs).some(j => j.status !== "terminal") || Object.values(run.operations).some(op => op.status === "intent"))
    throw new Error("Stopped planning cleanup is unresolved; ownership retained");
  const lock = join(store.root, "active-run.lock");
  const raw = await readFile(join(lock, "owner.json"), "utf8");
  const owner = JSON.parse(raw);
  if (owner.runId !== runId || owner.repositoryId !== store.repositoryId)
    throw new Error("Active-run ownership differs; ownership retained");
  const operation = {
    operationId: `stopped-release-${run.control.epoch}`,
    kind: "run.release" as const, status: "intent" as const,
    job: { runId, jobId: "stopped-release", role: "completion", attempt: 1, workspace: run.planning.workspace, baseCommit: run.planning.approval?.sha ?? "", inputRevisions: {}, prompt: "Release verified stopped planning ownership" },
  };
  if (!(await store.recordOperation(operation))) throw new Error("Stopped release authority changed");
  if ((await readFile(join(lock, "owner.json"), "utf8")) !== raw)
    throw new Error("Active-run ownership changed before release");
  await rm(lock, { recursive: true });
  if (!(await store.recordOperation({ ...operation, status: "completed" })))
    throw new Error("Stopped release result could not be recorded");
}
