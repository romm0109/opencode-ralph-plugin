  if (
    !latest ||
    latest.control?.epoch !== (run.control?.epoch ?? 0) + 1 ||
    latest.control.source !== "recovery" ||
    !latest.control.cleanupPending ||
    !(await store.recordControl(
      runId,
      {
        status: summary.status,
        source: "recovery",
        facts: summary.facts,
      },
      latest.revision,
    ))
