for (const boundary of [\"acceptance\", \"eligibility\", \"result\"] as const) {
  test("'`native recovery after issue ${boundary} starts baseline once from exact accepted graph`, async () => {
    const f = await nativeRecoveryFixture();
    try {
      await (await acceptRecoveryPrd(f))();
      const { writePlanningFile } = await import("../../src/planning/artifact-writer.js");
      const { completeIssues } = await import("../../src/planning/completion.js");
      const state = (await f.store.getRun(f.run.runId))?.planning;
      if (!state?.prd) throw new Error("Missing PRD");
      const graph = { schemaVersion: 1, prdRevision: state.prd, issues: [{ id: "A", title: "Feature", artifactPath: "issues/1-feature.md", dependencies: [], acceptanceCriteria: ["Feature works"], testableBehaviors: ["Feature works"] }] };
      const issue = "# Feature'"\\n## What to build\\nFeature\\n## Context: files to read before implementing\\nREADME.md\\n## Patterns to follow\\nExisting tests\\n## Step-by-step tasks\\nAdd behavior and tests\\n## Acceptance criteria\\nFeature works\\n## Validation commands\\nApproved checks\\n## Blocked by\\nNone\";
      for (const [path, content] of [[\"issues/1-feature.md\", issue], [\"graph.json\", JSON.stringify(graph)]])
        await writePlanningFile(f.store, { runId: f.run.runId, attempt: 1, path: path as string, content: content as string }, state.sessionId);
      const save = f.store.recordPlanning.bind(f.store);
      let lost = false;
      f.store.recordPlanning = async (id, rev, next) => {
        const crash = boundary === \"acceptance\" ? "'!!next.issueAcceptance && !next.graph : boundary === "eligibility" ? !!next.executionEligibility && !next.issueAcceptance?.result : !!next.issueAcceptance?.result;
        const result = await save(id, rev, next);
        if (crash && !lost) { lost = true; throw new Error("Lost issue acceptance receipt"); }
        return result;
      };
      try { await completeIssues(f.store, f.adapter, { runId: f.run.runId, attempt: 1, graphPath: "graph.json" }, state.sessionId); } catch (error) { expect(String(error)).toContain("Lost issue acceptance"); }
      f.store.recordPlanning = save;
      const before = (await f.store.getRun(f.run.runId))?.planning;
      expect(before?.issueAcceptance).toBeDefined();
      // Denial must remain a baseline blocker, never invented execution evidence.
      f.adapter.authorizeCommand = async () => ({ ok: false, error: { code: "permission-denied", message: "Fixture denies baseline" } });
      await reconcileRun({ store: f.store, adapter: f.adapter, directory: f.project.directory, runId: f.run.runId });
      const { resumeWorkflow } = await import("../../src/commands/resume.js");
      await resumeWorkflow(f.store, f.adapter, f.run.runId);
      const after = await f.store.getRun(f.run.runId);
      expect(after?.planning?.graph).toEqual(before?.issueAcceptance?.graph);
      expect(after?.planning?.approval).toEqual(before?.approval);
      expect(after?.baseline?.status).toBe("failed");
      expect(after?.planning?.executionEligibility?.requestId).toBe(before?.approval?.requestId);
      expect(Object.values(after?.operations ?? {}).filter(op => op.kind === "baseline.workspace")).toHaveLength(1);
      const events = (await f.store.events(f.run.runId)).length;
      await completeIssues(f.store, f.adapter, { runId: f.run.runId, attempt: 1, graphPath: "graph.json" }, state.sessionId);
      expect((await f.store.events(f.run.runId)).length).toBe(events);
    } finally { await f.project.cleanup(); }
  });
}

test("native accepted recovery blocks changed immutable PRD before reactivating control", async () => {
  const f = await nativeRecoveryFixture();
  try {
    await (await acceptRecoveryPrd(f))();
    const state = (await f.store.getRun(f.run.runId))?.planning;
    if (!state?.prd) throw new Error("Missing PRD");
    await writeFile(join(f.project.directory, state.prd.artifactPath), "changed accepted PRD");
    await f.store.recordControl(f.run.runId, { status: "interrupted", source: "recovery" });
    const { resumeWorkflow } = await import("../../src/commands/resume.js");
    await expect(resumeWorkflow(f.store, f.adapter, f.run.runId)).rejects.toThrow("Accepted PRD bytes changed");
    expect((await f.store.getRun(f.run.runId))?.control?.status).toBe("blocked");
  } finally { await f.project.cleanup(); }
});

test("native stopped release rejects a foreign lock and does not revive a released run", async () => {
  const f = await nativeRecoveryFixture();
  try {
    const { releaseStoppedPlanningRun } = await import("../../src/state/active-run.js");
    await handleControlCommand("ralph-stop", f.run.runId, f.store, f.adapter);
    const path = join(f.store.root, "active-run.lock/owner.json");
    const raw = await Bun.file(path).text();
    await writeFile(path, JSON.stringify({ runId: "foreign", repositoryId: f.store.repositoryId }));
    await expect(releaseStoppedPlanningRun(f.store, f.run.runId)).rejects.toThrow("ownership differs");
    expect(JSON.parse(await Bun.file(path).text()).runId).toBe("foreign");
    await writeFile(path, raw);
    await releaseStoppedPlanningRun(f.store, f.run.runId);
    await expect(handleControlCommand("ralph-resume", f.run.runId, f.store, f.adapter)).rejects.toThrow("released");
    expect((await f.store.getRun(f.run.runId))?.control?.status).toBe("stopped");
  } finally { await f.project.cleanup(); }
});
