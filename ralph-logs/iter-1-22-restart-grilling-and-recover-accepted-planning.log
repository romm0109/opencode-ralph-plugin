      runId,
      jobId: "terminal-release",
      role: "completion",
      attempt: 1,
      workspace: directory,
      inputRevisions: { round: run.reviewWorkflow.rounds.length },
      baseCommit: run.reviewWorkflow.commit,
      prompt: "Release terminal active-run ownership",
    },
  };
