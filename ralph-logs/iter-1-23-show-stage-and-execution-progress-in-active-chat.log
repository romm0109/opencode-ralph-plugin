  .object({
    id: z.string().regex(/^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$/),
    phase: z.enum(phases),
    executable: nonempty,
    args: z.array(z.string().refine((s) => !s.includes("\0"))),
    cwd: relativePath,
    timeoutMs: z.number().int().positive().max(86_400_000),
    platforms: z.array(z.enum(platforms)).min(1),
    env: z.record(
