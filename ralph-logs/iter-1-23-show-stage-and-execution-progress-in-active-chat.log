import { randomUUID } from "node:crypto";
import type { ToolContext } from "@opencode/plugin/promise/tool";
import { z } from "zod";
import { ChatInputRequired } from "../core/chat-input.js";
import type { UserInputRequest } from "../core/types.js";
import { answerExecutorQuestion } from "../execution/questions.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { handleInterviewResponse } from "../planning/interview.js";
import { handlePlanningResponse } from "../planning/issues.js";
import { runAutomaticReview } from "../review/automatic.js";
import type { RunStore } from "../state/run-store.js";
import { runtimeSecretValues, sanitizeValue } from "../state/sanitize.js";
import { handleControlCommand } from "./control.js";
import { orchestrateFeature } from "./orchestrator.js";
import { resumeWorkflow } from "./resume.js";

export const workflowInput = z.object({
  action: z.enum(["start", "resume", "reply"]),
  feature: z.string().optional(),
  runId: z.string().optional(),
  requestId: z.string().optional(),
  selectedCommit: z.string().optional(),
  review: z.boolean().optional(),
});
export const chatWorkflowPrompt = `Run Ralph in this conversation using ralph_workflow.
Keep worker and reviewer agents; show their progress and results here. Start a new feature with action=start, or continue an existing run with action=resume.
When waiting_for_reply is returned, show the exact question/proposal and recommended answer, end your turn and wait for the user. On their next reply use action=reply with its runId and requestId. The tool reads the actual user message; never invent or supply an answer. Ordinary "approve" or "yes" approves the displayed revision.
Show the PRD, issue/dependency plan and selected starting commit before execution approval. Requested changes require a revised proposal and renewed approval. Never start detached background work or poll while waiting for a reply. Explain blockers and final results here; do not require /ralph-answer or another interface.`;

export function pendingChatRequests(
  runs: Awaited<ReturnType<RunStore["listRuns"]>>,
  sessionID: string,
) {
  return runs
    .filter((run) => !run.control || run.control.status === "active")
    .flatMap((run) => [
      ...(run.planning?.pending ? [run.planning.pending] : []),
      ...Object.values(run.issueAttempts ?? {}).flatMap((attempt) =>
        attempt.question && !attempt.question.answer
          ? [attempt.question.request]
          : [],
      ),
    ])
    .filter((request) => request.sessionId === sessionID);
}
export function approvesChat(text: string) {
  return /^(?:approve(?:d)?(?: (?:it|this|the proposal|removal))?|yes(?:[, ]+(?:please|proceed|do it|go ahead|remove it))?|go ahead|looks good|proceed|do it)[.!]?$/i.test(
    text.trim(),
  );
}
export interface ChatReceipt {
  messageId: string;
  text: string;
  requests: Set<string>;
}

export async function runChatWorkflow(options: {
  input: z.infer<typeof workflowInput>;
  context: ToolContext;
  workspace: string;
  store: RunStore;
  adapter: OpenCodeAdapter;
  receipt?: ChatReceipt;
}) {
  const { input, context, workspace, store, adapter: base } = options;
  const steps: string[] = [];
  const jobs: {
    role: string;
    issueId?: string;
    sessionId?: string;
    attempt: number;
    outcome: string;
  }[] = [];
  const secrets = runtimeSecretValues();
  let stepCharacters = 0;
  const runIds = new Set<string>(input.runId ? [input.runId] : []);
  let finished = false,
    cancellation: Promise<unknown> | undefined;
  const progress = async (title: string, output: string) => {
    const safe = sanitizeValue(output, secrets).slice(0, 16000);
    const step = `${title}\n${safe}`;
    steps.push(step);
    stepCharacters += step.length;
    while (stepCharacters > 48000 && steps.length > 1)
      stepCharacters -= steps.shift()?.length ?? 0;
    if (!finished && !context.signal.aborted)
      await context.progress({ title, output: safe });
  };
  const adapter: OpenCodeAdapter = {
    ...base,
    async dispatchJob(job) {
      context.signal.throwIfAborted();
      runIds.add(job.runId);
      await progress(
        `Ralph ${job.role}${job.issueId ? `: ${job.issueId}` : ""}`,
        `Starting attempt ${job.attempt}`,
      );
      const result = await base.dispatchJob(job);
      context.signal.throwIfAborted();
      jobs.push({
        role: job.role,
        attempt: job.attempt,
        outcome: result.outcome,
        ...(job.issueId ? { issueId: job.issueId } : {}),
        ...(result.sessionId ? { sessionId: result.sessionId } : {}),
      });
      await progress(
        `Ralph ${job.role}: ${result.outcome}`,
        result.text ?? result.error?.message ?? result.outcome,
      );
      return result;
    },
    async authorizeCommand(request) {
      context.signal.throwIfAborted();
      runIds.add(request.job.runId);
      await progress(
        `Ralph ${request.command.phase}`,
        `${request.command.executable} ${request.command.args.join(" ")} (cwd ${request.command.cwd})`,
      );
      const result = await base.authorizeCommand?.(request);
      context.signal.throwIfAborted();
      return (
        result ?? {
          ok: false,
          error: {
            code: "unsupported",
            message: "Host command permission unavailable",
          },
        }
      );
    },
    async requestUserInput(request) {
      runIds.add(request.runId);
      throw new ChatInputRequired(request);
    },
    async publishStatus(_session, _workspace, text) {
      await progress("Ralph progress", text);
      return { ok: true };
    },
  };
  adapter.finalizeExecution = (snapshot) =>
    runAutomaticReview(store, adapter, snapshot);
  const cancel = () => {
    cancellation = Promise.all(
      [...runIds].map((id) =>
        handleControlCommand("ralph-stop", id, store, base),
      ),
    ).catch(() => {});
  };
  context.signal.throwIfAborted();
  context.signal.addEventListener("abort", cancel, { once: true });
  let waiting: UserInputRequest | undefined;
  try {
    if (input.action === "start") {
      await orchestrateFeature({
        workspace,
        sessionId: context.sessionID,
        feature: input.feature ?? "",
        store,
        adapter,
      });
    } else {
      const runId =
        input.runId ??
        (await store.listRuns()).filter((run) => run.planning).at(-1)?.runId;
      if (!runId) throw new Error("No Ralph feature found");
      runIds.add(runId);
      let run = await store.getRun(runId);
      if (!run?.planning) throw new Error("Unknown Ralph feature");
      if (Object.values(run.jobs).some((job) => job.status !== "terminal"))
        throw new Error(
          "Ralph already has an active worker. Wait for it or stop the run before resuming.",
        );
      if (
        input.action === "resume" &&
        run.control &&
        run.control.status !== "active"
      ) {
        await handleControlCommand("ralph-resume", runId, store, adapter);
        const current = await store.getRun(runId);
        if (!current?.planning)
          throw new Error("Planning state is unavailable");
        run = current;
      }
      if (!run.planning) throw new Error("Planning state is unavailable");
      if (run.planning.sessionId !== context.sessionID) {
        if (input.action !== "resume")
          throw new Error(
            "Use /ralph-resume to bring this feature into the current chat before answering.",
          );
        const planning = structuredClone(run.planning);
        planning.sessionId = context.sessionID;
        if (planning.pending)
          planning.pending = {
            ...planning.pending,
            sessionId: context.sessionID,
            requestId: randomUUID(),
          };
        if (!(await store.recordPlanning(runId, run.revision, planning)))
          throw new Error("Ralph changed during resume; try again");
        const rebound = await store.getRun(runId);
        if (!rebound) throw new Error("Ralph run disappeared during resume");
        run = rebound;
        for (const attempt of Object.values(run.issueAttempts ?? {})) {
          if (!attempt.question || attempt.question.answer) continue;
          attempt.question.request = {
            ...attempt.question.request,
            sessionId: context.sessionID,
            requestId: randomUUID(),
          };
          const current = await store.getRun(runId);
          if (
            !current ||
            !(await store.recordIssueAttempt(runId, current.revision, attempt))
          )
            throw new Error("Question changed during resume");
        }
      }
      if (!run.planning) throw new Error("Planning state is unavailable");
      if (input.action === "reply") {
        if (run.control && run.control.status !== "active")
          throw new Error(
            "Use /ralph-resume before answering a paused or stopped run.",
          );
        const request = pendingChatRequests([run], context.sessionID).find(
          (item) => item.requestId === input.requestId,
        );
        const receipt = options.receipt;
        if (!request || !receipt?.requests.has(request.requestId))
          throw new Error(
            "No new user reply for this pending question. Ask in chat and wait.",
          );
        const text =
          ["explanation_approval", "execution_approval"].includes(
            run.planning.phase,
          ) && approvesChat(receipt.text)
            ? `approve ${request.revision}`
            : receipt.text;
        const response = {
          ok: true as const,
          source: "user" as const,
          messageId: receipt.messageId,
          text,
          requestId: request.requestId,
          revision: request.revision,
          sessionId: context.sessionID,
        };
        const issue = Object.values(run.issueAttempts ?? {}).find(
          (attempt) =>
            attempt.question?.request.requestId === request.requestId,
        );
        const accepted = issue
          ? await answerExecutorQuestion(store, runId, issue.issueId, response)
          : run.planning.phase === "execution_approval"
            ? await handlePlanningResponse(store, runId, response)
            : await handleInterviewResponse(store, runId, response);
        if (!accepted)
          throw new Error(
            "Question or proposal changed. Show the current proposal and ask again.",
          );
        receipt.requests.clear();
      } else if (run.control && run.control.status !== "active")
        await handleControlCommand("ralph-resume", runId, store, adapter);
      await resumeWorkflow(store, adapter, runId, {
        ...(input.selectedCommit
          ? { selectedCommit: input.selectedCommit }
          : {}),
        ...(input.review ? { review: true } : {}),
      });
    }
  } catch (cause) {
    if (cause instanceof ChatInputRequired) waiting = cause.request;
    else throw cause;
  } finally {
    finished = true;
    context.signal.removeEventListener("abort", cancel);
    await cancellation;
  }
  const runs = (await store.listRuns()).filter((run) => runIds.has(run.runId));
  const pending = pendingChatRequests(runs, context.sessionID);
  if (
    waiting &&
    !pending.some((request) => request.requestId === waiting.requestId)
  )
    pending.push(waiting);
  return sanitizeValue(
    {
      status: pending.length ? "waiting_for_reply" : "settled",
      pending,
      jobs,
      runs: runs.map((run) => ({
        runId: run.runId,
        phase: run.planning?.phase,
        control: run.control?.status,
        baseline: run.baseline?.status,
        issues: run.execution?.issues,
        report: run.reviewWorkflow?.report,
        error: run.planning?.error,
      })),
      instruction: pending.length
        ? "Show these questions/proposals, end your turn and wait for the user's reply. Do not call reply without a new user message."
        : "Explain results and blockers in chat.",
      steps,
    },
    secrets,
  );
}

