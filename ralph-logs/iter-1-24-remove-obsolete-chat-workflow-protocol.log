  } finally {
    await f.cleanup();
  }
});

test("visible execution runs workers and both independent reviewers and returns their report in chat", async () => {
  const f = await singleIssueFixture();
  try {
    const planning = required(required(await f.store.getRun(f.runId)).planning);
    const graph = required(planning.graph);
    await mkdir(join(f.project.directory, "issues"));
    await writeFile(
      join(f.project.directory, "graph.json"),
      JSON.stringify(graph.value),
    );
    await writeFile(
      join(f.project.directory, "issues/A.md"),
      required(graph.files["issues/A.md"]),
    );
    await mkdir(join(f.store.root, "active-run.lock"));
    await writeFile(
      join(f.store.root, "active-run.lock/owner.json"),
      JSON.stringify({ runId: f.runId, repositoryId: f.store.repositoryId }),
    );
    const dispatch = f.adapter.dispatchJob.bind(f.adapter);
    f.adapter.dispatchJob = async (job) => {
      if (!["code-review", "functional-review"].includes(job.role))
        return dispatch(job);
      const fake = createFakeOpenCode({ sessionPrefix: job.jobId });
      fake.respond(
        JSON.stringify({
          role: job.role,
          reviewedCommit: job.baseCommit,
          round: 1,
          outcome: "passed",
          findings: [],
          evidenceRefs: ["log"],
          criteria: [
            {
              id: "issue-A-1",
              status: "pass",
              coverage: ["log"],
              evidenceRefs: ["log"],
            },
          ],
          evidence: [
            {
              id: "log",
              kind: "log",
              summary: "Approved checks passed",
              reviewedCommit: job.baseCommit,
            },
          ],
        }),
      );
      return createOpenCodeAdapter(fake.client, f.store).dispatchJob(job);
    };
    const progress: string[] = [];
    const result = await runChatWorkflow({
      input: { action: "resume", runId: f.runId },
      workspace: f.project.directory,
      store: f.store,
      adapter: f.adapter,
      context: {
        sessionID: "main",
        signal: new AbortController().signal,
        progress: async (update: { title: string }) => {
          progress.push(update.title);
        },
      } as never,
    });
    expect(result.status).toBe("settled");
    expect(progress).toContain("Ralph executor: completed");
    expect(progress).toContain("Ralph merger: completed");
    expect(progress).toContain("Ralph code-review: completed");
    expect(progress).toContain("Ralph functional-review: completed");
    expect(
      new Set(
        result.jobs
          .filter((job) => job.role.endsWith("review"))
          .map((job) => job.sessionId),
      ).size,
    ).toBe(2);
    expect(result.runs[0]?.report).toBeDefined();
    expect((await f.store.getRun(f.runId))?.reviewWorkflow?.status).toBe(
      "terminal",
    );
  } finally {
    await f.project.cleanup();
  }
}, 30000);

test("interrupting a visible worker stops its owned run and does not leave hidden work", async () => {
  const f = await fixture();
  const controller = new AbortController();
  f.fake.holdPrompt();
  try {
    const running = f
      .invoke({ action: "start", feature: "Reset" }, "main", controller.signal)
      .catch(() => undefined);
    const deadline = Date.now() + 5000;
    while (
      !f.fake.requests.some((request) => request.path.endsWith("/prompt")) &&
      Date.now() < deadline
    )
      await Bun.sleep(10);
    expect(
      f.fake.requests.some((request) => request.path.endsWith("/prompt")),
    ).toBe(true);
    controller.abort();
    f.fake.release();
    await running;
    const run = (await f.store.listRuns())[0];
    expect(run?.control?.status).toBe("stopped");
    expect(
      Object.values(run?.jobs ?? {}).every((job) => job.status === "terminal"),
    ).toBe(true);
  } finally {
    f.fake.release();
    await f.cleanup();
  }
});

