});

for (const invalid of ["old-template", "empty-section"] as const) {
  test(`issue graph rejects ${invalid} instead of accepting arbitrary Markdown`, async () => {
    const { project, adapter, router } = await fixture((output) => {
      const first = output.graph.issues[0];
      if (!first) throw new Error("Missing issue");
      output.files[first.artifactPath] =
        invalid === "old-template"
          ? "# Issue\n## Context\nOld\n## Implementation\nOld\n## Tests\nOld\n## Acceptance criteria\nOld\n## Dependencies\nNone"
          : (output.files[first.artifactPath] ?? "").replace(
              "## What to build\nBuild D",
              "## What to build\n",
            );
    });
    try {
      adapter.requestUserInput = async (request) => ({
        ok: true,
        ...request,
        source: "user",
        messageId: request.requestId,
        text: `approve ${request.revision}`,
      });
      const run = JSON.parse(
        await router.dispatch("ralph-orchestrator", "Diamond", {
          workspace: project.directory,
          sessionId: "main",
        }),
      );
      expect(run.planning.graph).toBeUndefined();
      expect(run.planning.error.message).toContain(
        "missing or empty What to build",
      );
    } finally {
      await project.cleanup();
    }
  });
}

