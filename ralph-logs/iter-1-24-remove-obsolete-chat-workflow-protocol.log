  }
});

test(\"every public resume rejects unsupported saved planning without changing its bytes or artifacts\", async () => {
  const project = await createTestProject();
  const fake = createFakeOpenCode();
  const host = createFakePluginContext(project.directory, fake.client);
  const dispose = await RalphPlugin.setup(host.context);
  try {
    const store = await openRunStore(project.directory);
    await store.createRun(\"old-feature\");
    // Historical records are disk input, never accepted through a new planning write.
    const path = join(store.root, \"old-feature\", \"run.json\");
    const run = await store.getRun(\"old-feature\");
    await writeFile(path, JSON.stringify({ ...run, planning: { phase: \"execution_approved\", workspace: project.directory, sessionId: \"main\" } }));
    await mkdir(join(project.directory, \".ralph\"));
    const artifact = join(project.directory, \".ralph\", \"old-draft.md\");
    await writeFile(artifact, \"Preserve this draft\");
    const before = await readFile(path, \"utf8\");
    const router = createCommandRouter(store, createOpenCodeAdapter(fake.client, store));
    await expect(router.dispatch(\"ralph-resume\", \"old-feature\", { workspace: project.directory, sessionId: \"main\" })).rejects.toThrow(\"fresh workflow\");
    await expect(host.tools.get(\"ralph_control\")?.execute({ action: \"resume\", runId: \"old-feature\" }, { sessionID: \"main\", signal: new AbortController().signal } as never)).rejects.toThrow(\"fresh workflow\");
    expect(await readFile(path, \"utf8\")).toBe(before);
    expect(await readFile(artifact, \"utf8\")).toBe(\"Preserve this draft\");
    expect(fake.requests.filter((r) => r.path.endsWith(\"/prompt\"))).toHaveLength(0);
  } finally {
    await dispose?.();
    await project.cleanup();
  }
});
