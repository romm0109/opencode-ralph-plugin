import { expect, test } from "bun:test";
import { mkdir, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { runChatWorkflow } from "../../src/commands/chat-workflow.js";
import { createOpenCodeAdapter } from "../../src/opencode/adapter.js";
import { RalphPlugin } from "../../src/plugin.js";
import { openRunStore } from "../../src/state/run-store.js";
import {
  createFakeOpenCode,
  createFakePluginContext,
} from "../helpers/fake-opencode.js";
import { createTestProject } from "../helpers/project.js";
import { required, singleIssueFixture } from "../helpers/single-issue.js";

const prd =
  "# Reset\n## Problem\nReset counter\n## User stories\nReset counter\n## Requirements\nReset to zero\n## Acceptance criteria\nCounter is zero\n## Non-goals\nOther changes";
const explanation = {
  kind: "explanation",
  text: "Reset the counter to zero",
  scope: ["Counter reset"],
  criteria: ["Counter is zero"],
};
async function fixture() {
  const project = await createTestProject();
  await mkdir(join(project.directory, ".ralph"));
  await writeFile(
    join(project.directory, ".ralph/project.json"),
    JSON.stringify({
      models: { interview: { providerID: "fixture", modelID: "fixture" } },
    }),
  );
  await writeFile(
    join(project.directory, ".ralph/commands.json"),
    JSON.stringify({
      schemaVersion: 1,
      revision: 1,
      rationale: "Fixture check",
      commands: [
        {
          id: "check",
          phase: "check",
          executable: "bun",
          args: ["--version"],
          cwd: ".",
          timeoutMs: 10000,
          platforms: ["darwin", "linux", "win32"],
          env: {},
        },
      ],
    }),
  );
  const fake = createFakeOpenCode();
  const host = createFakePluginContext(project.directory, fake.client);
  const dispose = await RalphPlugin.setup(host.context);
  const progress: string[] = [];
  const tool = host.tools.get("ralph_workflow");
  if (!tool) throw new Error("Missing workflow tool");
  const invoke = async (
    input: unknown,
    sessionID = "main",
    signal = new AbortController().signal,
  ) =>
    JSON.parse(
      (
        await tool.execute(input, {
          sessionID,
          signal,
          progress: async (update: { title: string }) => {
            progress.push(update.title);
          },
        } as never)
      ).content as string,
    );
  const say = async (text: string, messageID: string, sessionID = "main") =>
    host.hooks.get("session.prompt")?.({
      sessionID,
      messageID,
      prompt: { text },
    });
  return {
    project,
    fake,
    host,
    progress,
    invoke,
    say,
    store: await openRunStore(project.directory),
    cleanup: async () => {
      await dispose?.();
      await project.cleanup();
    },
  };
}

test("workflow settles at chat questions, rejects fabricated approval, and waits again after revisions", async () => {
  const f = await fixture();
  try {
    f.fake.respond(
      JSON.stringify({
        kind: "question",
        question: "What should reset do?",
        recommendation: "Reset to zero",
      }),
    );
    await f.host.commands.get("ralph-orchestrator")?.execute({
      sessionID: "main",
      prompt: { text: "Add reset" },
      delivery: "steer",
    } as never);
    expect(await f.store.listRuns()).toHaveLength(0);
    const first = await f.invoke({ action: "start", feature: "Add reset" });
    expect(first.status).toBe("waiting_for_reply");
    const runId = first.pending[0].runId;
    const context = {
      sessionID: "main",
      tools: { question: {}, read: {}, ralph_workflow: {} },
      system: [],
    };
    await f.host.hooks.get("session.context")?.(context);
    expect(Object.keys(context.tools)).toEqual(["read", "ralph_workflow"]);
    await expect(
      f.host.hooks.get("tool.execute.before")?.({
        sessionID: "main",
        tool: "question",
      }),
    ).rejects.toThrow("ordinary reply");
    await expect(
      f.invoke({
        action: "reply",
        runId,
        requestId: first.pending[0].requestId,
      }),
    ).rejects.toThrow("No new user reply");
    await f.say("Reset to zero", "user-1");
    f.fake.respond(JSON.stringify(explanation));
    const approval = await f.invoke({
      action: "reply",
      runId,
      requestId: first.pending[0].requestId,
    });
    expect(approval.runs[0].phase).toBe("explanation_approval");
    expect(f.progress).toContain("Ralph interview: completed");
    await expect(
      f.invoke({
        action: "reply",
        runId,
        requestId: approval.pending[0].requestId,
      }),
    ).rejects.toThrow("No new user reply");
    await f.say("Change the requirement", "user-2");
    const revised = await f.invoke({
      action: "reply",
      runId,
      requestId: approval.pending[0].requestId,
    });
    expect(revised.pending[0].revision).toBe(2);
    expect((await f.store.getRun(runId))?.planning?.approval).toBeUndefined();
    await f.say("yes", "user-3");
    f.fake.respond((prompt) => {
      if (prompt.includes("PRD content:")) {
        const revision = JSON.parse(
          prompt.match(/PRD revision: (.*)/)?.[1] ?? "null",
        );
        return JSON.stringify({
          graph: {
            schemaVersion: 1,
            prdRevision: revision,
            issues: [
              {
                id: "A",
                title: "Reset",
                artifactPath: "issues/A.md",
                dependencies: [],
                acceptanceCriteria: ["Zero"],
                testableBehaviors: ["Zero"],
              },
            ],
          },
          files: {
            "issues/A.md":
              "# Reset\n## Context: files to read before implementing\nCounter\n## What to build\nReset\n## Patterns to follow\nMirror repository code and integration test helpers.\n## Step-by-step tasks\nUpdate source and add a public behavior test.\n## Validation commands\nZero\n## Acceptance criteria\nZero\n## Blocked by\nNone",
          },
        });
      }
      return JSON.stringify({ text: prd });
    });
    const planned = await f.invoke({
      action: "reply",
      runId,
      requestId: revised.pending[0].requestId,
    });
    expect(planned.runs[0].phase).toBe("execution_approval");
    expect(planned.pending[0].question).toContain("Starting commit:");
    expect(planned.pending[0].question).toContain("## Requirements");
    expect(f.progress).toContain("Ralph prd: completed");
    expect(f.progress).toContain("Ralph issues: completed");
    expect(
      (await f.store.getRun(runId))?.planning?.executionEligibility,
    ).toBeUndefined();
    await f.say("approve", "user-4");
    const execution = await f.invoke({
      action: "reply",
      runId,
      requestId: planned.pending[0].requestId,
    });
    expect(execution.status).toBe("settled");
    expect(execution.runs[0].baseline).toBe("failed");
    expect(execution.steps.join("\n")).toContain("Checkout is dirty");
  } finally {
    await f.cleanup();
  }
});

test("resume moves a pending question into the selected chat and invalidates old reply identity", async () => {
  const f = await fixture();
  try {
    const first = await f.invoke({ action: "start" });
    await expect(
      f.invoke(
        {
          action: "reply",
          runId: first.pending[0].runId,
          requestId: first.pending[0].requestId,
        },
        "other",
      ),
    ).rejects.toThrow("Use /ralph-resume");
    const resumed = await f.invoke(
      { action: "resume", runId: first.pending[0].runId },
      "other",
    );
    expect(resumed.pending[0].sessionId).toBe("other");
    expect(resumed.pending[0].requestId).not.toBe(first.pending[0].requestId);
    await f.say("yes", "late", "main");
    await expect(
      f.invoke({
        action: "reply",
        runId: first.pending[0].runId,
        requestId: first.pending[0].requestId,
      }),
    ).rejects.toThrow("Use /ralph-resume");
  } finally {
    await f.cleanup();
  }
});

