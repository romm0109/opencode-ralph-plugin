      await Bun.file(join(f.store.root, "active-run.lock/owner.json")).text(),
    ).toBe(before);
    expect(
      (await f.store.getRun(f.run.runId))?.control?.facts?.length,
    ).toBeGreaterThan(0);
    expect(await f.store.listRuns()).toHaveLength(2);
  } finally {
    await f.project.cleanup();
  }
});

