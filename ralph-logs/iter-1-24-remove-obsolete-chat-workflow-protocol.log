    if (state.phase === "explanation_approval" && state.explanation) {
      const artifact = state.explanation;
      state.pending = {
        runId,
        workspace: state.workspace,
        sessionId: state.sessionId,
        requestId: randomUUID(),
        revision: artifact.revision,
        question: `${artifact.text}\nScope:\n${artifact.scope.join("\n")}\nAcceptance criteria:\n${artifact.criteria.join("\n")}\nApprove revision ${artifact.revision} by replying approve ${artifact.revision}, or reply with revisions.`,
      };
      await save(store, runId, run.revision, state);
      continue;
    }
    if (!state.feature) {
      state.pending = {
        runId,
        workspace: state.workspace,
        sessionId: state.sessionId,
        requestId: randomUUID(),
        revision: 0,
        question: "What feature should we build? Describe the result you need.",
      };
      await save(store, runId, run.revision, state);
      continue;
    }
    state.turn++;
    await save(store, runId, run.revision, state);
    const selectedModel = state.settings.models.interview;
    if (!selectedModel)
      throw new Error("Planning run has no captured interview model");
    const job: JobEnvelope = {
      runId,
      jobId: `interview-${state.turn}`,
      attempt: 1,
      role: "interview",
      workspace: state.workspace,
      baseCommit: "",
      inputRevisions: {
        interview: state.turn,
        explanation: state.explanation?.revision ?? 0,
      },
      readOnly: true,
      ...(state.protocol === "native-interview-v1"
        ? { sessionId: state.sessionId }
        : {}),
      model: selectedModel,
      prompt: `${instructions}\nFeature: ${state.feature}\nTranscript: ${JSON.stringify(state.transcript)}\nPrevious explanation: ${JSON.stringify(state.explanation ?? null)}\nStage identity: runId=${runId}, attempt=${state.owner?.attempt ?? 1}. Finish with ralph_complete_interview.`,
    };
    let timer: ReturnType<typeof setTimeout> | undefined;
    const timeout = new Promise<undefined>((resolve) => {
      timer = setTimeout(() => resolve(undefined), state.settings.timeoutMs);
    });
    let result: JobResult | undefined;
    try {
      result = await Promise.race([
        adapter.dispatchJob(job).catch(
          (cause): JobResult => ({
            ...job,
            outcome: "failed",
      next.error = {
        code: "missing-output",
        message: `Invalid interview output. Return a recommended question or an explanation with scope and criteria. ${String(cause)}`,
        cause: String(cause),
      };
      await save(store, runId, latest.revision, next);
      return store.getRun(runId);
    }
    if (
      state.protocol === "native-interview-v1" &&
      parsed.kind === "explanation"
    ) {
      // This slice has no explanation completion or approval transition.
      return latest;
    }
    next.transcript.push({ source: "interviewer", text: result.text });
    let question: string;
    if (parsed.kind === "question")
      question = `${parsed.question}\nRecommended: ${parsed.recommendation}`;
    else {
      const revision = (next.explanation?.revision ?? 0) + 1;
      next.explanation = {
        revision,
        hash: explanationHash(parsed),
        text: parsed.text,
        scope: parsed.scope,
        criteria: parsed.criteria,
      };
      delete next.approval;
      next.phase = "explanation_approval";
      question = `${parsed.text}\nScope:\n${parsed.scope.join("\n")}\nAcceptance criteria:\n${parsed.criteria.join("\n")}\nApprove revision ${revision} by replying approve ${revision}, or reply with revisions.`;
    }
    next.pending = {
      runId,
      sessionId: next.sessionId,
      workspace: next.workspace,
      requestId: randomUUID(),
      revision: next.explanation?.revision ?? 0,
      question,
      ...(state.protocol === "native-interview-v1" && parsed.kind === "question"
        ? { kind: "interview" as const, recommendation: parsed.recommendation }
        : {}),
    };
    await save(store, runId, latest.revision, next);
  }
}
