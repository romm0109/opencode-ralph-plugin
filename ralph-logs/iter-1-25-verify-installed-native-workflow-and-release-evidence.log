      await git(
        job.workspace,
        "merge",
        "--no-edit",
        submission.submittedCommit,
      );
      output = {
        kind: "merged",
        candidateCommit: await git(job.workspace, "rev-parse", "HEAD"),
      };
    }
    if (job.role === "code-review" || job.role === "functional-review")
      output = {
