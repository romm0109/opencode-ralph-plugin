        tool = {
          name: "glob",
          arguments: JSON.stringify({ pattern: "README.md" }),
        };
      else if (
        setup &&
        last?.role === "user" &&
        text === "Approve the proposed commands"
      )
        tool = {
          name: "ralph_save_commands",
          arguments: JSON.stringify(config),
        };
      else if (last?.role === "user" && text === "RALPH_FOREGROUND")
        tool = {
          name: "shell",
          arguments: JSON.stringify({
            command: "bun --version",
            background: true,
            timeout: 10000,
          }),
        };
      else if (
        last?.role === "user" &&
        (text === "RALPH_DENIAL" || text?.startsWith("RALPH_REVIEW_MUTATION"))
      )
        tool = {
          name: "shell",
          arguments: JSON.stringify({
            command: "echo bypass > denied-sentinel",
            description: "Denied smoke operation",
          }),
        };
      else if (
        last?.role === "user" &&
        text?.includes("ralph_status") &&
        body.tools?.some((t) => t.function.name === "ralph_status")
      )
        tool = {
          name: "ralph_status",
          arguments: JSON.stringify({ runId: "smoke-run" }),
        };
      let workerOutput: string | undefined;
      if (last?.role === "user" && text?.startsWith("# Feature interview"))
        workerOutput = JSON.stringify(
          text.includes('"text":"Reset to zero"')
            ? {
                kind: "explanation",
                text: "Reset the counter to zero",
                scope: ["Counter"],
                criteria: ["Counter is zero"],
              }
            : {
                kind: "question",
                question: "What should reset do?",
                recommendation: "Reset to zero",
              },
        );
      const content =
        workerOutput ??
        (setup && !tool && !text?.includes("configured")
          ? "Proposed commands: bun test (check, cwd ., 30 seconds, macOS/Linux/Windows, no environment mappings). Do you approve?"
          : discovery
            ? JSON.stringify({
                schemaVersion: 1,
                revision: 1,
                rationale: "Native setup/wrapper probe",
                unsupportedPlatforms: {},
                commands: [
                  {
                    id: "bun-version",
                    phase: "check",
                    executable: "bun",
                    args: ["--version"],
                    cwd: ".",
                    timeoutMs: 10000,
                    platforms: ["darwin", "linux", "win32"],
                    env: {},
                  },
                ],
              })
            : last?.role === "tool"
              ? text
              : "actual response");
      const chunk = (delta: unknown, finish: string | null) =>
        `data: ${JSON.stringify({ id: "chatcmpl-fixture", object: "chat.completion.chunk", created: 1, model: "fixture", choices: [{ index: 0, delta, finish_reason: finish }] })}\n\n`;
      const response =
        chunk(
          {
            role: "assistant",
            ...(tool
              ? {
                  tool_calls: [
                    {
                      index: 0,
                      id: `call-${calls}`,
                      type: "function",
                      function: tool,
                    },
                  ],
                }
              : { content }),
          },
          null,
        ) +
        chunk({}, tool ? "tool_calls" : "stop") +
        "data: [DONE]\n\n";
      return new Response(response, {
        headers: { "Content-Type": "text/event-stream" },
      });
    },
  });
  return {
    url: `http://127.0.0.1:${server.port}/v1`,
    calls: () => calls,
    holding: () => holding,
    reviewTools: () => reviewTools,
    release: () => release?.(),
    close: () => server.stop(true),
  };
}
import { expect, test } from "bun:test";
import { verifyPackage } from "../helpers/package.js";

test("installed setup-to-report workflow preserves verified versus skipped validation in two projects", async () => {
  const evidence = await verifyPackage(true);
  expect(evidence.repositories.map((repository) => repository.outcome)).toEqual(
    ["verified", "incomplete-validation"],
  );
  for (const repository of evidence.repositories) {
    expect(repository.stages).toEqual([
      "setup",
      "interview",
      "prd",
      "issues",
      "executor",
      "merger",
      "review",
      "report",
    ]);
  }
  console.log(
    `Packaged workflow: ${evidence.platform}, Bun ${evidence.bun}; complete deterministic workflow.`,
  );
}, 180_000);
import { expect, test } from "bun:test";
import { access, copyFile, mkdir, realpath, writeFile } from "node:fs/promises";
import { join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import {
  createAdapterClient,
  createOpenCodeAdapter,
} from "../../src/opencode/adapter.js";
