import { createHash } from \"node:crypto\";
export function explanationHash(value:{text:string;scope:string[];criteria:string[]}) {
  return createHash(\"sha256\").update(JSON.stringify({kind:\"explanation\",text:value.text,scope:value.scope,criteria:value.criteria})).digest(\"hex\");
}
