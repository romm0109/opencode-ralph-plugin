  })
  .strict();
const configSchema = z
  .object({
    schemaVersion: z.literal(1),
    revision: z.number().int().positive(),
    commands: z.array(commandSchema).min(1),
    rationale: nonempty,
    unsupportedPlatforms: z.record(z.enum(platforms), nonempty).optional(),
    url: z.url().optional(),
