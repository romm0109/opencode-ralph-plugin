}
export async function startInterview(options:InterviewOptions) {
  const {store,adapter,sessionId} = options;
  const workspace = await realpath(options.workspace);
  await verifyReviewRepository(workspace,store.repositoryId);
  await assertProjectReady(workspace);
  const config = await loadProjectConfig(workspace);
  const skill = await loadRoleInstructions(workspace,"interview",config.skillPaths);
  const model = config.models.interview ?? await adapter.getSessionModel?.(sessionId);
  if(!model) throw new Error("Main session model is unavailable. Set models.interview in .ralph/project.json.");
  const lock = join(store.root,"active-run.lock");
  try {await mkdir(lock);}
  catch(cause) {throw new Error("A feature run already owns this repository. Inspect /ralph-status; interrupted locks require reconciliation.",{cause});}
  const runId = `feature-${randomUUID()}`;
  let created = false;
  try {
    await writeFile(join(lock,"owner.json"),JSON.stringify({runId,repositoryId:store.repositoryId}));
    await assertProjectReady(workspace);
    const setup = await projectStatus(workspace);
    const run = await store.createRun(runId);
    created = true;
    await save(store,runId,run.revision,{phase:"interview",workspace,sessionId,feature:options.feature?.trim() ?? "",commandHash:setup.hash!,settings:{concurrency:config.concurrency,timeoutMs:config.timeoutMs,models:{...config.models,interview:model},skills:{interview:{path:skill.path,hash:skill.hash}}},transcript:options.feature?.trim() ? [{source:"user",text:options.feature.trim()}] : [],turn:0});
    return await continueInterview(store,adapter,runId,skill.text);
  } catch(cause) {
    if(!created) await rm(lock,{recursive:true,force:true});
    throw cause;
  }
}
