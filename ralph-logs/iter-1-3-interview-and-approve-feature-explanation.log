export async function loadProjectConfig(
  workspace: string,
): Promise<ProjectConfig> {
  let raw = "{}";
  try {
    raw = await readFile(join(workspace, ".ralph/project.json"), "utf8");
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
  }
  try {
    return {
      ...schema.parse(JSON.parse(raw)),
      commands: parseCommandConfig(
        JSON.parse(
          await readFile(join(workspace, ".ralph/commands.json"), "utf8"),
        ),
      ),
    };
  } catch (cause) {
    throw new Error(
      "Invalid Ralph project configuration. Check .ralph/project.json and commands.json",
      { cause },
    );
  }
}
import { createHash } from "node:crypto";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
export async function loadRoleInstructions(
  workspace: string,
  role: "interview" | "prd" | "issues",
  overrides: Record<string, string> = {},
) {
  const bundled = new URL(
    `../../skills/${{ interview: "grill-me", prd: "create-prd", issues: "to-issues" }[role]}/SKILL.md`,
    import.meta.url,
  );
  const path = overrides[role] ? resolve(workspace, overrides[role]) : bundled;
  let text: string;
  try {
    text = await readFile(path, "utf8");
    if (!text.trim()) throw new Error("Empty instructions");
    if (role !== "interview" && overrides[role])
      text = `${await readFile(bundled, "utf8")}\nProject instructions:\n${text}`;
  } catch (cause) {
    throw new Error(
      `Cannot load ${role} instructions at ${path}. Fix .ralph/project.json skillPaths.${role}.`,
      { cause },
    );
  }
  return {
    path: String(path),
    hash: createHash("sha256").update(text).digest("hex"),
    text,
  };
}
