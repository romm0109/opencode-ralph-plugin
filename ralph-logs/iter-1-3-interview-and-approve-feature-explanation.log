/** Human provenance and the persisted request are the only approval authority. */
export async function handleInterviewResponse(store:RunStore,runId:string,response:UserInputResult):Promise<boolean> {
  const run = await store.getRun(runId);
  const state = run?.planning;
  const pending = state?.pending;
  if(!run || !state || !pending || !response.ok || response.source !== "user" || !response.messageId || !response.text.trim() || response.requestId !== pending.requestId || response.revision !== pending.revision || response.sessionId !== pending.sessionId || state.transcript.some(entry=>entry.messageId === response.messageId)) return false;
  const next = structuredClone(state);
  delete next.pending;
  delete next.error;
  next.transcript.push({source:"user",text:response.text,messageId:response.messageId,requestId:response.requestId,revision:response.revision});
  if(state.phase === "explanation_approval") {
    const explanation = state.explanation;
    if(!explanation || explanation.revision !== response.revision) return false;
    if(response.text.trim() === `approve ${explanation.revision}`) {
      next.phase = "explanation_approved";
      next.approval = {revision:explanation.revision,hash:explanation.hash,messageId:response.messageId,requestId:response.requestId};
    } else {
      next.phase = "interview";
      delete next.approval;
    }
  } else if(!next.feature) next.feature = response.text;
  return store.recordPlanning(runId,run.revision,next);
}
export async function continueInterview(store:RunStore,adapter:OpenCodeAdapter,runId:string,instructions:string) {
  for(;;) {
    const run = await store.getRun(runId);
    if(!run?.planning) throw new Error("Unknown planning run");
    const state = structuredClone(run.planning);
    if(state.phase === "explanation_approved" || (run.control && run.control.status !== "active")) return run;
    if(state.pending) {
      const published = await adapter.publishStatus(state.sessionId,state.workspace,state.pending.question);
      const response = published.ok ? await adapter.requestUserInput(state.pending) : published;
      if(!response.ok) {
        const latest = await store.getRun(runId);
        if(latest?.planning?.pending?.requestId === state.pending.requestId) await save(store,runId,latest.revision,{...latest.planning,error:response.error ?? {code:"sdk-error",message:"Could not publish question"}});
        return store.getRun(runId);
      }
      if(!await handleInterviewResponse(store,runId,response)) return store.getRun(runId);
      continue;
    }
    if(!state.feature) {
      state.pending = {runId,workspace:state.workspace,sessionId:state.sessionId,requestId:randomUUID(),revision:0,question:"What feature should we build? Describe the result you need."};
      await save(store,runId,run.revision,state);
      continue;
    }
    state.turn++;
    await save(store,runId,run.revision,state);
    const job:JobEnvelope = {runId,jobId:`interview-${state.turn}`,attempt:1,role:"interview",workspace:state.workspace,baseCommit:"",inputRevisions:{interview:state.turn,explanation:state.explanation?.revision ?? 0},readOnly:true,model:state.settings.models.interview!,prompt:`${instructions}'"\\nFeature: "'${state.feature}'"\\nTranscript: "'${JSON.stringify(state.transcript)}'"\\nPrevious explanation: "'${JSON.stringify(state.explanation ?? null)}`};
    const result = await adapter.dispatchJob(job);
    const latest = await store.getRun(runId);
    if(!latest?.planning || latest.planning.turn !== state.turn || latest.planning.pending || latest.planning.phase !== "interview" || (latest.control && latest.control.status !== "active")) return latest;
    const next = structuredClone(latest.planning);
    if(result.outcome !== "completed" || !result.text) {
      next.error = result.error ?? {code:"missing-output",message:"Interview returned no output"};
      await save(store,runId,latest.revision,next);
      return store.getRun(runId);
    }
    let parsed:z.infer<typeof output>;
    try {parsed = output.parse(JSON.parse(result.text));}
    catch(cause) {
      next.error = {code:"missing-output",message:"Interview must return a question with a recommendation or an explanation with scope and criteria",cause:String(cause)};
      await save(store,runId,latest.revision,next);
      return store.getRun(runId);
    }
    next.transcript.push({source:"interviewer",text:result.text});
    let question:string;
    if(parsed.kind === "question") question = `${parsed.question}'"\\nRecommended: "'${parsed.recommendation}`;
    else {
      const revision = (next.explanation?.revision ?? 0)+1;
      next.explanation = {revision,hash:createHash("sha256").update(JSON.stringify(parsed)).digest("hex"),text:parsed.text,scope:parsed.scope,criteria:parsed.criteria};
      delete next.approval;
      next.phase = "explanation_approval";
      question = `${parsed.text}'"\\nScope:\\n"'${parsed.scope.join("'"\\n\")}\\nAcceptance criteria:\\n"'${parsed.criteria.join("'"\\n\")}\\nApprove revision "'${revision} by replying approve ${revision}, or reply with revisions.`;
    }
    next.pending = {runId,sessionId:next.sessionId,workspace:next.workspace,requestId:randomUUID(),revision:next.explanation?.revision ?? 0,question};
    await save(store,runId,latest.revision,next);
