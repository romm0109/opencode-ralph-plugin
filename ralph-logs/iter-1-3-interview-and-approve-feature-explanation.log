  const directory = await mkdtemp(join(tmpdir(), prefix));
  await git("git", ["init", directory]);
  await git("git", [
    "-C",
    directory,
    "config",
    "user.email",
    "fixture@example.invalid",
  ]);
  await git("git", ["-C", directory, "config", "user.name", "Fixture"]);
  await writeFile(join(directory, "README.md"), "Fixture\n");
  await git("git", ["-C", directory, "add", "."]);
  await git("git", ["-C", directory, "commit", "-m", "fixture"]);
  const commit = (
    await git("git", ["-C", directory, "rev-parse", "HEAD"])
  ).stdout.trim();
  return {
    directory,
    commit,
    cleanup: () => rm(directory, { recursive: true, force: true }),
  };
}
import type { Plugin } from "@opencode/plugin";
import type { CommandDefinition } from "@opencode/plugin/promise/command";
import type { Info } from "@opencode/plugin/promise/tool";
import { createAdapterClient } from "../../src/opencode/adapter.js";

export function createFakeOpenCode() {
  const requests: {
    path: string;
    directory: string | null;
    body: Record<string, unknown>;
  }[] = [];
  const sessions = new Map<string, { directory: string; text?: string }>();
  let denied = false,
    empty = false,
    deniedTool = false,
    invalidTool = false,
    holdCreation = false;
  let release: (() => void) | undefined;
  let gate: Promise<void> | undefined;
  let count = 0;
  let reply = "actual response";
  let failedCodeMode = false;
  const client = createAdapterClient(
    "http://fixture.invalid",
    async (request) => {
      const url = new URL(request.url);
      const raw = request.method === "POST" ? await request.text() : "";
      const body = raw ? (JSON.parse(raw) as Record<string, unknown>) : {};
      const sessionID = url.pathname.match(/\/session\/([^/]+)/)?.[1];
      const location = body.location as { directory?: string } | undefined;
      requests.push({
        path: url.pathname,
        directory:
          location?.directory ??
          (sessionID ? sessions.get(sessionID)?.directory : undefined) ??
          url.searchParams.get("location[directory]"),
        body,
      });
      if (denied)
        return Response.json(
          { _tag: "PermissionDeniedError", message: "Permission denied" },
          { status: 403 },
        );
      if (url.pathname.startsWith("/api/rpc/")) {
        const method = url.pathname.split("/").at(-1);
        return Response.json({
          output:
            method === "tools"
              ? [
                  "read",
                  "glob",
                  "grep",
                  "edit",
                  "write",
                  "shell",
                  "custom_tool",
                  "http",
                  "agent-browser",
                ]
              : { ok: true },
        });
      }
      if (url.pathname === "/api/session") {
        if (holdCreation) await gate;
        const id = `session-${++count}`;
        sessions.set(id, { directory: location?.directory ?? "" });
        return Response.json({
          data: {
            id,
            location: { directory: location?.directory },
            time: { created: 1, updated: 1 },
          },
        });
      }
      if (url.pathname.endsWith("/interrupt"))
        return Response.json({ data: { interrupted: true } });
      if (url.pathname.endsWith("/wait")) {
        await gate;
        return new Response(null, { status: 204 });
      }
      if (url.pathname.endsWith("/prompt")) {
        const session = sessions.get(sessionID as string);
        if (session) session.text = String(body.text);
        return Response.json({
          data: {
            id: "user-1",
            type: "user",
            sessionID,
            payload: { text: body.text },
            time: { created: 1 },
            delivery: "steer",
          },
        });
      }
      if (url.pathname.endsWith("/context")) {
        return Response.json({
          data: [
            {
              id: "user-1",
              type: "user",
              text: sessions.get(sessionID as string)?.text,
              time: { created: 1 },
            },
            {
              id: "earlier-message",
              type: "assistant",
              time: { created: 1, completed: 2 },
              content: invalidTool
                ? [
                    {
                      type: "tool",
                      name: "invalid",
                      state: {
                        status: "completed",
                        input: {},
                        content: [{ type: "text", text: "unavailable" }],
                      },
                    },
                  ]
                : failedCodeMode
                  ? [
                      {
                        type: "tool",
                        name: "execute",
                        state: {
                          status: "completed",
                          input: {},
                          content: [
                            { type: "text", text: "caught inner failure" },
                          ],
                          metadata: {
                            toolCalls: [{ tool: "shell", status: "error" }],
                          },
                        },
                      },
                    ]
                  : deniedTool
                    ? [
                        {
                          type: "tool",
                          name: "shell",
                          state: {
                            status: "error",
                            error: {
                              type: "PermissionDenied",
                              message:
                                "The user rejected permission to use this tool",
                            },
                          },
                        },
                      ]
                    : [],
            },
            {
              id: "message-1",
              type: "assistant",
              time: { created: 1, completed: 2 },
              finish: "stop",
              content: [{ type: "text", text: empty ? "" : reply }],
            },
            {
              id: "idle-1",
              type: "idle",
              outcome: "succeeded",
              time: { created: 3 },
            },
          ],
        });
      }
      if (url.pathname.endsWith("/synthetic"))
        return Response.json({
          data: {
            id: "synthetic-1",
            sessionID,
            type: "synthetic",
            payload: body,
            time: { created: 1 },
            delivery: "steer",
          },
        });
      return Response.json({ data: true });
    },
  );
  return {
    client,
    requests,
    respond: (text: string) => {
      reply = text;
    },
    denyTool: () => {
      deniedTool = true;
    },
    invalidTool: () => {
      invalidTool = true;
    },
    failCodeMode: () => {
      failedCodeMode = true;
    },
    empty: () => {
      empty = true;
    },
    holdCreation: () => {
      holdCreation = true;
      gate = new Promise<void>((r) => {
        release = r;
      });
    },
    deny: () => {
      denied = true;
    },
    hold: () => {
      gate = new Promise<void>((r) => {
        release = r;
      });
    },
    release: () => release?.(),
  };
}

// Exercises the actual v2 registration and cleanup contracts without a model.
export function createFakePluginContext(
  directory: string,
  client = createFakeOpenCode().client,
) {
  const commands = new Map<string, CommandDefinition>();
  const tools = new Map<string, Info & { id: string }>();
  const hooks = new Map<string, (input: unknown) => Promise<void> | void>();
  const statuses: string[] = [];
  const rpcHandlers = new Map<string, (input: never) => Promise<unknown>>();
  const registration = (dispose = async () => {}) => ({ dispose });
  const context = {
    location: { directory },
    session: {
      ...client.session,
      hook: async (
        name: string,
        hook: (input: unknown) => Promise<void> | void,
      ) => {
        hooks.set(`session.${name}`, hook);
        return registration(async () => {
          hooks.delete(`session.${name}`);
        });
      },
    },
    command: {
      transform: async (
        apply: (editor: { add(definition: CommandDefinition): void }) => void,
      ) => {
        apply({
          add: (definition) => {
            commands.set(definition.name, definition);
          },
        });
        return registration(async () => {
          commands.clear();
        });
      },
    },
    tool: {
      list: async () => [...tools.values()],
      reload: async () => {},
      transform: async (apply: (editor: { add(info: Info): void }) => void) => {
        const added: string[] = [];
        apply({
          add: (info) => {
            tools.set(info.name, { ...info, id: info.name });
            added.push(info.name);
          },
        });
        return registration(async () => {
          for (const name of added) tools.delete(name);
        });
      },
      hook: async (
        name: string,
        hook: (input: unknown) => Promise<void> | void,
      ) => {
        hooks.set(`tool.${name}`, hook);
        return registration(async () => {
          hooks.delete(`tool.${name}`);
        });
      },
    },
    rpc: {
      register: async (
        _definition: unknown,
        handlers: Record<string, (input: never) => Promise<unknown>>,
      ) => {
        for (const [name, handler] of Object.entries(handlers))
          rpcHandlers.set(name, handler);
        return {
          ...registration(async () => {
            rpcHandlers.clear();
          }),
          events: {
            emit: async (_name: string, data: { text: string }) => {
              statuses.push(data.text);
            },
          },
        };
      },
    },
    event: {
      subscribe: async function* (_options: { signal?: AbortSignal }) {},
    },
  } as unknown as Plugin.Context;
  return { context, commands, tools, hooks, statuses, rpcHandlers };
}
import { Plugin } from "@opencode/plugin";
import type { Registration } from "@opencode/plugin/promise/registration";
import { z } from "zod";
import { handleControlCommand } from "./commands/control.js";
import { createCommandRouter } from "./commands/router.js";
import { startDashboard } from "./dashboard/server.js";
import {
  createOpenCodeAdapter,
  reviewToolAlias,
  reviewTools,
} from "./opencode/adapter.js";
import { ralphBridge } from "./opencode/bridge.js";
import { reconcileRun } from "./recovery/reconcile.js";
import { openRunStore } from "./state/run-store.js";

// Linked worktrees activate separate OpenCode locations in the same server.
// Recover shared state once; tearing down one location must not stop another.
const repositories = new Map<
  string,
  { instances: number; ready: Promise<void>; error?: unknown }
>();

export const RalphPlugin = Plugin.define({
  id: "ralph",
  async setup(ctx) {
    const directory = ctx.location.directory;
    const store = await openRunStore(directory);
    const existing = repositories.get(store.root);
    let activate: () => void = () => {};
    const repository = existing ?? {
      instances: 0,
      ready: new Promise<void>((resolve) => {
        activate = resolve;
      }),
    };
    repositories.set(store.root, repository);
    repository.instances++;
    const registrations: Registration[] = [];
    const observationAliases = new Set<string>();
    async function prepareReview(_workspace: string, allowed: string[]) {
      const catalog = await ctx.tool.list();
      const selected = catalog.filter(
        (tool) => allowed.includes(tool.id) && !observationAliases.has(tool.id),
      );
      if (!selected.length) return;
      registrations.push(
        await ctx.tool.transform((editor) => {
          for (const tool of selected)
            editor.add({
              name: reviewToolAlias(tool.id),
              description: tool.description,
              input: tool.input,
              ...(tool.output ? { output: tool.output } : {}),
              options: {
                codemode: false,
                permission: tool.options?.permission ?? tool.id,
              },
              execute: tool.execute,
            });
        }),
      );
      for (const tool of selected) observationAliases.add(tool.id);
      await ctx.tool.reload();
    }
    let statusEvents:
      | Awaited<ReturnType<typeof ctx.rpc.register<typeof ralphBridge>>>
      | undefined;
    const adapter = createOpenCodeAdapter(
      {
        session: ctx.session,
        assertCommandPermission: async (sessionId, command, hash) => {
          await ctx.permission.assert({
            sessionID: sessionId,
            action: "shell",
            resources: [
              JSON.stringify({
                executable: command.executable,
                args: command.args,
                cwd: command.cwd,
                shell: command.shell,
              }),
            ],
            metadata: { ralphCommandHash: hash, commandId: command.id },
          });
        },
        tools: async () => (await ctx.tool.list()).map((tool) => tool.id),
        prepareReview,
        notify: async (_workspace, text) => {
          await statusEvents?.events.emit("status", { text });
        },
      },
      store,
    );
    const recoveryNotifications: string[] = [];
    try {
      if (existing) {
        await repository.ready;
        if (repository.error) throw repository.error;
      } else
        for (const run of await store.listRuns()) {
          if (
            run.reviewWorkflow?.status === "terminal" &&
            Object.values(run.operations).every((op) => op.status !== "intent")
          )
            continue;
          recoveryNotifications.push(
            JSON.stringify(
              await reconcileRun({
                store,
                directory,
                runId: run.runId,
                adapter,
              }),
            ),
          );
        }
    } catch (cause) {
      repository.error = cause;
      if (--repository.instances === 0) repositories.delete(store.root);
      throw cause;
    } finally {
      activate();
    }
    let dashboard: Awaited<ReturnType<typeof startDashboard>>;
    try {
      dashboard = await startDashboard(store);
    } catch (cause) {
      if (--repository.instances === 0) repositories.delete(store.root);
      throw cause;
    }
    const router = createCommandRouter(
      store,
      adapter,
      dashboard.url,
      directory,
    );
    const eventsAbort = new AbortController();
    let disposed = false;
    let notification: ReturnType<typeof setImmediate> | undefined;
    async function reviewJob(sessionID: string) {
      for (const run of await store.listRuns()) {
        const entry = Object.values(run.jobs).find(
          (job) => job.envelope.sessionId === sessionID,
        );
        if (entry?.envelope.readOnly) return entry.envelope;
      }
    }
    async function dispose() {
      if (disposed) return;
      disposed = true;
      if (notification) clearImmediate(notification);
      eventsAbort.abort();
      const lastInstance = --repository.instances === 0;
      if (lastInstance) repositories.delete(store.root);
      try {
        if (lastInstance)
          for (const run of await store.listRuns()) {
            if (
              (run.control?.status === "stopped" ||
                run.reviewWorkflow?.status === "terminal") &&
              !Object.values(run.operations).some((op) => op.ownedProcess)
            )
              continue;
            await handleControlCommand(
              "ralph-stop",
              run.runId,
              store,
              adapter,
              {
                source: "shutdown",
              },
            );
            const current = await store.getRun(run.runId);
            await store.recordControl(run.runId, {
              status: "interrupted",
              source: "shutdown",
              facts: current?.control?.facts ?? [],
            });
          }
      } finally {
        await Promise.allSettled(
          registrations.map((registration) => registration.dispose()),
        );
        await dashboard.stop();
      }
    }
    try {
      statusEvents = await ctx.rpc.register(ralphBridge, {
        tools: async () => (await ctx.tool.list()).map((tool) => tool.id),
        prepareReview: async ({ tools }) => {
          await prepareReview(directory, tools);
          return { ok: true };
        },
        publishStatus: async ({ text }) => {
          await statusEvents?.events.emit("status", { text });
          return { ok: true };
        },
      });
      registrations.push(statusEvents);
      registrations.push(
        await ctx.command.transform((editor) => {
          for (const name of [
            "ralph-status",
            "ralph-commands",
            "ralph-pause",
            "ralph-resume",
            "ralph-stop",
          ]) {
            editor.add({
              name,
              description:
                name === "ralph-status"
                  ? "Read durable Ralph run status"
                  : `${name.slice(6)} the durable Ralph run`,
              async execute(input) {
                const text = await router.dispatch(
                  name,
                  input.prompt.text.trim(),
                  { workspace: directory, sessionId: input.sessionID },
                );
                await adapter.publishStatus(input.sessionID, directory, text);
                await ctx.session.synthetic({
                  sessionID: input.sessionID,
                  text,
                  description: "Ralph command result",
                  resume: false,
                });
              },
            });
          }
        }),
      );
      registrations.push(
        await ctx.tool.transform((editor) => {
          editor.add({
            name: "ralph_status",
            description:
              "Read persisted Ralph phase, correlated job result, errors and dashboard URL.",
            input: z.object({ runId: z.string().optional() }),
            options: { codemode: false },
            async execute({ runId }) {
              return {
                content: await router.status(runId?.trim() || undefined),
              };
            },
          });
          editor.add({
            name: "ralph_control",
            description:
              "Pause, resume or stop a durable Ralph run. Use slash commands for explicit user intent.",
            input: z.object({
              action: z.enum(["pause", "resume", "stop"]),
              runId: z.string().optional(),
            }),
            options: { codemode: false },
            async execute({ action, runId }) {
              return {
                content: await router.dispatch(
                  `ralph-${action}`,
                  runId?.trim() ?? "",
                ),
              };
            },
          });
        }),
      );
      registrations.push(
        await ctx.session.hook("context", async (input) => {
          const job = await reviewJob(input.sessionID);
          const allowed = job
            ? new Set([...reviewTools(job)].map(reviewToolAlias))
            : undefined;
          for (const name of Object.keys(input.tools)) {
            if (allowed ? !allowed.has(name) : name.startsWith("ralph_review_"))
              delete input.tools[name];
          }
        }),
      );
      // Execution checks also cover tools reached through code mode or renamed
      // definitions. Never change a host denial into an allow.
      registrations.push(
        await ctx.tool.hook("execute.before", async (input) => {
          const job = await reviewJob(input.sessionID);
          if (
            job &&
            !new Set([...reviewTools(job)].map(reviewToolAlias)).has(input.tool)
          )
            throw new Error(
              `Permission denied: Ralph review cannot execute ${input.tool}`,
            );
        }),
      );
      const events = ctx.event.subscribe({ signal: eventsAbort.signal });
      void (async () => {
        try {
          for await (const event of events) {
            if (disposed) break;
            await adapter.receiveEvent(event);
          }
        } catch (cause) {
          if (!eventsAbort.signal.aborted)
            console.error("Ralph event subscription failed", cause);
        }
      })();
      // Host activation must finish before emitting notifications.
      notification = setImmediate(async () => {
        for (const text of recoveryNotifications) {
          if (disposed) break;
          await adapter.publishStatus("", directory, text);
        }
      });
      notification.unref();
      return dispose;
    } catch (cause) {
      await dispose();
      throw cause;
    }
  },
});
export default RalphPlugin;
