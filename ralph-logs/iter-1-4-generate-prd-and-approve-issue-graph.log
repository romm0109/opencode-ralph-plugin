import { z } from \"zod\";
import { loadRoleInstructions } from \"../agents/skills.js\";
import { loadProjectConfig } from \"../config/project.js\";
import type { OpenCodeAdapter } from \"../opencode/adapter.js\";
import type { RunStore } from \"../state/run-store.js\";
import { artifactHash, explanationHash } from \"./artifacts.js\";
import { dispatchGeneration, planningFailure, publishRevision, savePlanning } from \"./generation.js\";
import { generateIssues } from \"./issues.js\";

export async function generatePrd(store: RunStore, adapter: OpenCodeAdapter, runId: string) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if ("'!state?.explanation || !state.approval || state.approval.hash !== explanationHash(state.explanation) || state.approval.revision !== state.explanation.revision) throw new Error("An approved explanation is required");
  try {
    const config = await loadProjectConfig(state.workspace);
    const skill = await loadRoleInstructions(state.workspace, "prd", config.skillPaths);
    const generated = await dispatchGeneration(store, adapter, runId, "prd", `${skill.text}'"\\nRepository: "'${state.workspace}'"\\nApproved explanation: "'${JSON.stringify(state.explanation)}'"\\nTranscript: "'${JSON.stringify(state.transcript)}`, { prd: { path: skill.path, hash: skill.hash } });
    if (!generated) return store.getRun(runId);
    const { text } = z.object({ text: z.string().trim().min(1) }).strict().parse(JSON.parse(generated.result.text ?? ""));
    for (const heading of ["Problem", "User stories", "Requirements", "Acceptance criteria", "Non-goals"]) if (!text.toLowerCase().includes(`## ${heading.toLowerCase()}`)) throw new Error(`PRD missing ${heading}`);
    const revision = (generated.state.prd?.revision ?? 0) + 1;
    const directory = await publishRevision(generated.state, runId, `prd-${generated.state.generation?.revision}`, { "PRD.md": text });
    generated.state.prd = { revision, hash: artifactHash(text), artifactPath: `${directory}/PRD.md` };
    delete generated.state.executionApproval;
    await savePlanning(store, runId, generated.run.revision, generated.state);
  } catch (cause) { await planningFailure(store, runId, cause); return store.getRun(runId); }
  return generateIssues(store, adapter, runId);
}
EOF
cat > src/planning/issues.ts <<'"'EOF'
import { randomUUID } from \"node:crypto\";
import { readFile } from \"node:fs/promises\";
import { dirname, join } from \"node:path\";
import { z } from \"zod\";
import { loadRoleInstructions } from \"../agents/skills.js\";
import { loadProjectConfig } from \"../config/project.js\";
import type { UserInputResult } from \"../core/types.js\";
import type { OpenCodeAdapter } from \"../opencode/adapter.js\";
import type { RunStore } from \"../state/run-store.js\";
import { artifactHash, issueBundleHash } from \"./artifacts.js\";
import { dispatchGeneration, planningFailure, publishRevision, savePlanning } from \"./generation.js\";
import { topologicalOrder, validateIssueGraph } from \"./graph.js\";

export async function generateIssues(store: RunStore, adapter: OpenCodeAdapter, runId: string) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if ("'!state?.prd) throw new Error("A PRD revision is required");
  try {
    const config = await loadProjectConfig(state.workspace);
    const skill = await loadRoleInstructions(state.workspace, "issues", config.skillPaths);
    const text = await readFile(join(state.workspace, state.prd.artifactPath), "utf8");
    if (artifactHash(text) !== state.prd.hash) throw new Error("PRD artifact changed");
    const generated = await dispatchGeneration(store, adapter, runId, "issues", `${skill.text}'"\\nRepository: "'${state.workspace}'"\\nPRD revision: "'${JSON.stringify(state.prd)}'"\\nPRD content:\\n"'${text}'"\\nExplanation: "'${JSON.stringify(state.explanation)}'"\\nRevision feedback: "'${JSON.stringify(state.transcript)}`, { issues: { path: skill.path, hash: skill.hash } });
    if (!generated) return store.getRun(runId);
    const output = z.object({ graph: z.unknown(), files: z.record(z.string(), z.string()) }).strict().parse(JSON.parse(generated.result.text ?? ""));
    const value = validateIssueGraph(output.graph, output.files, state.prd);
    const order = topologicalOrder(value);
    const files = Object.fromEntries(order.map((id) => { const issue = value.issues.find((item) => item.id === id); if (!issue) throw new Error("Missing issue"); return [issue.artifactPath, output.files[issue.artifactPath] as string]; }));
    const directory = await publishRevision(generated.state, runId, `graph-${generated.state.generation?.revision}`, { ...files, "graph.json": JSON.stringify(value, null, 2) });
    generated.state.graph = { revision: (generated.state.graph?.revision ?? 0) + 1, hash: issueBundleHash(value, files), artifactPath: `${directory}/graph.json`, value, files, order };
    generated.state.phase = "execution_approval";
    delete generated.state.executionApproval;
    await savePlanning(store, runId, generated.run.revision, generated.state);
  } catch (cause) { await planningFailure(store, runId, cause); }
  return store.getRun(runId);
}

export async function handlePlanningResponse(store: RunStore, runId: string, response: UserInputResult) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  const pending = state?.pending;
  if (!run || state?.phase !== "execution_approval" || !state.prd || !state.graph || !pending || !response.ok || response.source !== "user" || !response.messageId || !response.text.trim() || response.requestId !== pending.requestId || response.sessionId !== pending.sessionId || response.revision !== pending.revision || state.transcript.some((entry) => entry.messageId === response.messageId)) return false;
  try {
    const text = await readFile(join(state.workspace, state.prd.artifactPath), "utf8");
    const value = JSON.parse(await readFile(join(state.workspace, state.graph.artifactPath), "utf8"));
