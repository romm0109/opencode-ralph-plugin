  }
  const published = await adapter.publishStatus(state.sessionId, state.workspace, state.pending.question);
  const response = published.ok ? await adapter.requestUserInput(state.pending) : { ok: false as const, error: published.error ?? { code: "sdk-error" as const, message: "Could not publish planning approval" } };
