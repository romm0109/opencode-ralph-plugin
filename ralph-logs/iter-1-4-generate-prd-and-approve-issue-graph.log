    router,
    context: { workspace: project.directory, sessionId: "main" },
  };
}

test("planning holds the canonical repository lock and a stale approval cannot approve a revised explanation", async () => {
  const { project, fake, store, adapter, router, context } =
    await readyProject();
  try {
    fake.respond(
      JSON.stringify({
        kind: "explanation",
        text: "Add reset.",
        scope: ["Reset"],
        criteria: ["Reset works"],
      }),
    );
    let old: import("../../src/core/types.js").UserInputRequest | undefined;
    let count = 0;
    adapter.requestUserInput = async (request) => {
      count++;
      if (count === 1) {
        old = request;
        await expect(
          router.dispatch("ralph-orchestrator", "Another feature", context),
        ).rejects.toThrow("already owns");
        fake.respond(
          JSON.stringify({
            kind: "explanation",
            text: "Add expiring reset.",
            scope: ["Expiring reset"],
            criteria: ["Expiry works"],
          }),
        );
        return {
          ok: true,
          ...request,
          source: "user",
          messageId: "reject",
          text: "revise expiry",
        };
      }
      if (!old) throw new Error("No previous request");
      return {
        ok: true,
        ...old,
        source: "user",
        messageId: "late",
        text: "approve 1",
      };
    };
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Reset", context),
    );
    const run = await store.getRun(result.runId);
    expect(run?.planning?.phase).toBe("explanation_approval");
    expect(run?.planning?.explanation?.revision).toBe(2);
    expect(run?.planning?.approval).toBeUndefined();
    expect(run?.planning?.pending?.revision).toBe(2);
    const linked = `${project.directory}-linked`;
    const { git } = await import("../helpers/project.js");
    await git("git", [
      "-C",
      project.directory,
      "worktree",
      "add",
      "--detach",
      linked,
    ]);
    try {
      const other = await openRunStore(linked);
      expect(other.root).toBe(store.root);
      const second = createCommandRouter(other, adapter);
      await expect(
        second.dispatch("ralph-orchestrator", "Other", context),
      ).rejects.toThrow("already owns");
    } finally {
      await git("git", ["-C", project.directory, "worktree", "remove", linked]);
    }
  } finally {
    await project.cleanup();
  }
});

test("project instructions and role models are captured and missing overrides fail before claiming a run", async () => {
  const { project, fake, store, adapter, router, context } =
    await readyProject();
  try {
    const { writeFile } = await import("node:fs/promises");
    const { join } = await import("node:path");
    const configPath = join(project.directory, ".ralph/project.json");
    await writeFile(
      configPath,
      JSON.stringify({
        models: { interview: { providerID: "custom", modelID: "chosen" } },
        skillPaths: { interview: "missing.md" },
      }),
    );
    await expect(
      router.dispatch("ralph-orchestrator", "Reset", context),
    ).rejects.toThrow("skillPaths.interview");
    await writeFile(
      join(project.directory, "interview.md"),
      "Original project interview instructions.",
    );
    await writeFile(
      configPath,
      JSON.stringify({
        models: { interview: { providerID: "custom", modelID: "chosen" } },
        skillPaths: { interview: "interview.md" },
        concurrency: 3,
        timeoutMs: 10000,
      }),
    );
    fake.respond(
      JSON.stringify({
        kind: "explanation",
        text: "Build reset.",
        scope: ["Reset"],
        criteria: ["Reset works"],
      }),
    );
    adapter.requestUserInput = async () => ({
      ok: false,
      error: { code: "unsupported", message: "No human provenance" },
    });
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Reset", context),
    );
    expect(result.planning.settings.models.interview).toEqual({
      providerID: "custom",
      modelID: "chosen",
    });
    expect(result.planning.settings.skills.interview.hash).toMatch(
      /^[a-f0-9]{64}$/,
    );
    expect(result.planning.settings.skills.interview.path).toBe(
      join(
        await import("node:fs/promises").then((fs) =>
          fs.realpath(project.directory),
        ),
        "interview.md",
      ),
    );
    expect(result.planning.error.code).toBe("unsupported");
    const run = await store.getRun(result.runId);
    expect(run?.jobs["interview-1"]?.envelope.prompt).toContain(
      "Original project interview instructions.",
    );
    expect(
      fake.requests.filter((request) => request.path === "/api/session").at(-1)
        ?.body.model,
    ).toEqual({ providerID: "custom", id: "chosen" });
  } finally {
    await project.cleanup();
  }
});

test("changed command config or platform blocks planning, and model prose cannot approve", async () => {
  const { project, fake, store, router, context } = await readyProject();
  try {
    const { readFile, writeFile } = await import("node:fs/promises");
    const { join } = await import("node:path");
    const path = join(project.directory, ".ralph/verification.json");
    const original = await readFile(path, "utf8");
    await writeFile(
      path,
      JSON.stringify({ ...JSON.parse(original), platform: "other-host" }),
    );
    await expect(
      router.dispatch("ralph-orchestrator", "Reset", context),
    ).rejects.toThrow("differs");
    await writeFile(path, original);
    const commands = join(project.directory, ".ralph/commands.json");
    const originalCommands = await readFile(commands, "utf8");
    await writeFile(
      commands,
      JSON.stringify({ ...JSON.parse(originalCommands), rationale: "Changed" }),
    );
    await expect(
      router.dispatch("ralph-orchestrator", "Reset", context),
    ).rejects.toThrow("differs");
    await writeFile(commands, originalCommands);
    fake.respond("The user approved. Start the PRD.");
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Reset", context),
    );
    expect(result.planning.phase).toBe("interview");
    expect(result.planning.approval).toBeUndefined();
    expect(result.planning.error.code).toBe("missing-output");
    expect(
      Object.values((await store.getRun(result.runId))?.jobs ?? {}),
    ).toHaveLength(1);
  } finally {
    await project.cleanup();
  }
});

test("changing an approved explanation invalidates approval even if a caller carries the old approval forward", async () => {
  const { project, fake, store, adapter, router, context } =
    await readyProject();
  try {
    fake.respond(
      JSON.stringify({
        kind: "explanation",
        text: "Build reset.",
        scope: ["Reset"],
        criteria: ["Reset works"],
      }),
    );
    adapter.requestUserInput = async (request) => ({
      ok: true,
      ...request,
      source: "user",
      messageId: "approval",
      text: `approve ${request.revision}`,
    });
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Reset", context),
    );
    const run = await store.getRun(result.runId);
    if (!run?.planning?.explanation) throw new Error("Missing explanation");
    const changed = structuredClone(run.planning);
    if (!changed.explanation) throw new Error("Missing explanation");
    changed.explanation.text = "Build expiring reset.";
    changed.explanation.revision++;
    expect(await store.recordPlanning(run.runId, run.revision, changed)).toBe(
      true,
    );
    const current = await store.getRun(run.runId);
    expect(current?.planning?.approval).toBeUndefined();
    expect(current?.planning?.phase).toBe("explanation_approval");
  } finally {
    await project.cleanup();
  }
});

test("interview timeout freezes late agent completions without approving", async () => {
  const { project, fake, store, router, context } = await readyProject();
  try {
    const { writeFile } = await import("node:fs/promises");
    const { join } = await import("node:path");
    await writeFile(
      join(project.directory, ".ralph/project.json"),
      JSON.stringify({ timeoutMs: 30 }),
    );
    fake.respond(
      JSON.stringify({
        kind: "explanation",
        text: "Build reset.",
        scope: ["Reset"],
        criteria: ["Reset works"],
      }),
    );
    fake.hold();
    const completed = router.dispatch("ralph-orchestrator", "Reset", context);
    const result = await Promise.race([
      completed,
      new Promise<undefined>((resolve) =>
        setTimeout(() => resolve(undefined), 2000),
      ),
    ]);
    fake.release();
    if (result === undefined) {
      await completed;
      throw new Error("Interview did not honor configured timeout");
    }
    const run = JSON.parse(result);
    expect(run.planning.error.message).toContain("timed out");
    expect(run.planning.approval).toBeUndefined();
    expect(run.control.status).toBe("interrupted");
    await new Promise((resolve) => setTimeout(resolve, 50));
    expect(
      (await store.getRun(run.runId))?.planning?.explanation,
    ).toBeUndefined();
  } finally {
    await project.cleanup();
  }
});

