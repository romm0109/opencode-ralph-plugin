import { randomUUID } from \"node:crypto\";
import { mkdir, readFile, rename, rm, lstat } from \"node:fs/promises\";
import { join } from \"node:path\";
import type { JobEnvelope, JobResult } from \"../core/types.js\";
import type { OpenCodeAdapter } from \"../opencode/adapter.js\";
import type { RunStore } from \"../state/run-store.js\";
import type { PlanningState } from \"./types.js\";

export async function savePlanning(store: RunStore, runId: string, revision: number, state: PlanningState) {
  if ("'!(await store.recordPlanning(runId, revision, state))) throw new Error("Stale planning transition");
}
export async function featureRoot(state: PlanningState, runId: string) {
  if (!/''^feature-[A-Za-z0-9-]+$/.test(runId)) throw new Error("Invalid feature ID");
  let path = state.workspace;
  for (const part of [".ralph", "features", runId]) {
    path = join(path, part);
    await mkdir(path, { recursive: true });
    if (!(await lstat(path)).isDirectory() || (await lstat(path)).isSymbolicLink()) throw new Error("Feature path must be a real directory");
  }
  return path;
}
/** Rename a complete revision directory; never expose a partial bundle. */
export async function publishRevision(state: PlanningState, runId: string, name: string, files: Record<string, string>) {
  const root = await featureRoot(state, runId);
  const staged = join(root, `.draft-${randomUUID()}`);
  await mkdir(staged);
  try {
    for (const [path, text] of Object.entries(files)) {
      if (!/''^(PRD'"\\.md|graph\\.json|issues\\/[A-Za-z0-9_-]+\\.md)"'$/.test(path)) throw new Error("Invalid artifact reference");
      const { writeFile } = await import("node:fs/promises");
      if (path.startsWith("issues/")) await mkdir(join(staged, "issues"), { recursive: true });
      await writeFile(join(staged, path), text, { flag: "wx" });
    }
    await rename(staged, join(root, name));
  } finally { await rm(staged, { recursive: true, force: true }); }
  return `.ralph/features/${runId}/${name}`;
}
export async function dispatchGeneration(store: RunStore, adapter: OpenCodeAdapter, runId: string, role: "prd" | "issues", prompt: string, skills: PlanningState["settings"]["skills"]) {
  const run = await store.getRun(runId);
  if (!run?.planning || (run.control && run.control.status !== "active")) return;
  const state = structuredClone(run.planning);
  const revision = (state.generation?.revision ?? 0) + 1;
  const jobId = `${role}-${revision}`;
  state.phase = role === "prd" ? "prd_generation" : "issue_generation";
  state.generation = { role, revision, jobId };
  state.settings.skills = { ...state.settings.skills, ...skills };
  delete state.pending;
  delete state.executionApproval;
  delete state.error;
  await savePlanning(store, runId, run.revision, state);
  const job: JobEnvelope = { runId, jobId, attempt: 1, role, workspace: state.workspace, baseCommit: "", readOnly: true, model: state.settings.models[role] ?? state.settings.models.interview, inputRevisions: { explanation: state.explanation?.revision ?? 0, prd: state.prd?.revision ?? 0, graph: state.graph?.revision ?? 0, generation: revision }, prompt };
  let timer: ReturnType<typeof setTimeout> | undefined;
  let result: JobResult | undefined;
  try {
    result = await Promise.race([adapter.dispatchJob(job).catch((cause): JobResult => ({ ...job, outcome: "failed", evidence: [], error: { code: "sdk-error", message: "Planning dispatch failed", cause: String(cause) } })), new Promise<undefined>((resolve) => { timer = setTimeout(() => resolve(undefined), state.settings.timeoutMs); })]);
  } finally { if (timer) clearTimeout(timer); }
  const latest = await store.getRun(runId);
  if (!latest?.planning || latest.planning.generation?.jobId !== jobId || (latest.control && latest.control.status !== "active")) return;
  if (!result || result.outcome !== "completed" || !result.text) {
    await savePlanning(store, runId, latest.revision, { ...latest.planning, error: result?.error ?? { code: result ? "missing-output" : "cancelled", message: result ? "Planning returned no output" : "Planning timed out" } });
    if (!result) {
      await store.recordControl(runId, { status: "interrupted", source: "recovery", facts: ["Planning timed out"] });
      const bound = (await store.getRun(runId))?.jobs[jobId]?.envelope ?? job;
      await adapter.cancelJob(bound);
    }
    return;
  }
  return { run: latest, state: structuredClone(latest.planning), result };
}
export async function planningFailure(store: RunStore, runId: string, cause: unknown) {
  const latest = await store.getRun(runId);
  if (latest?.planning) await store.recordPlanning(runId, latest.revision, { ...latest.planning, error: { code: "missing-output", message: `Invalid planning output: ${String(cause)}`, cause: String(cause) } });
