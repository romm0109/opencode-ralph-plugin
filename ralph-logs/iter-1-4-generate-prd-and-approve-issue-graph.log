        );
      if (url.pathname.startsWith("/api/rpc/")) {
        const method = url.pathname.split("/").at(-1);
        return Response.json({
          output:
            method === "tools"
              ? [
                  "read",
                  "glob",
                  "grep",
                  "edit",
                  "write",
                  "shell",
                  "custom_tool",
                  "http",
                  "agent-browser",
                ]
              : { ok: true },
        });
      }
      if (url.pathname === "/api/session") {
        if (holdCreation) await gate;
        const id = `session-${++count}`;
        sessions.set(id, { directory: location?.directory ?? "" });
        return Response.json({
          data: {
            id,
            location: { directory: location?.directory },
            time: { created: 1, updated: 1 },
          },
        });
      }
      if (url.pathname.endsWith("/interrupt"))
        return Response.json({ data: { interrupted: true } });
      if (url.pathname.endsWith("/wait")) {
        await gate;
        return new Response(null, { status: 204 });
      }
      if (url.pathname.endsWith("/prompt")) {
        const session = sessions.get(sessionID as string);
        if (session) session.text = String(body.text);
        return Response.json({
          data: {
            id: "user-1",
            type: "user",
            sessionID,
            payload: { text: body.text },
            time: { created: 1 },
            delivery: "steer",
          },
        });
      }
      if (url.pathname.endsWith("/context")) {
        return Response.json({
          data: [
            {
              id: "user-1",
              type: "user",
              text: sessions.get(sessionID as string)?.text,
              time: { created: 1 },
            },
            {
              id: "earlier-message",
              type: "assistant",
              time: { created: 1, completed: 2 },
              content: invalidTool
                ? [
                    {
                      type: "tool",
                      name: "invalid",
                      state: {
                        status: "completed",
                        input: {},
                        content: [{ type: "text", text: "unavailable" }],
                      },
                    },
                  ]
                : failedCodeMode
                  ? [
                      {
                        type: "tool",
                        name: "execute",
                        state: {
                          status: "completed",
                          input: {},
                          content: [
                            { type: "text", text: "caught inner failure" },
                          ],
                          metadata: {
                            toolCalls: [{ tool: "shell", status: "error" }],
                          },
                        },
                      },
                    ]
                  : deniedTool
                    ? [
                        {
                          type: "tool",
                          name: "shell",
                          state: {
                            status: "error",
                            error: {
                              type: "PermissionDenied",
                              message:
                                "The user rejected permission to use this tool",
                            },
                          },
                        },
                      ]
                    : [],
            },
            {
              id: "message-1",
              type: "assistant",
              time: { created: 1, completed: 2 },
              finish: "stop",
              content: [{ type: "text", text: empty ? "" : reply }],
            },
            {
              id: "idle-1",
              type: "idle",
              outcome: "succeeded",
              time: { created: 3 },
            },
          ],
        });
      }
      if (url.pathname.endsWith("/synthetic"))
        return Response.json({
          data: {
            id: "synthetic-1",
            sessionID,
            type: "synthetic",
            payload: body,
            time: { created: 1 },
            delivery: "steer",
          },
        });
      return Response.json({ data: true });
    },
  );
  return {
    client,
    requests,
    respond: (text: string) => {
      reply = text;
    },
    denyTool: () => {
      deniedTool = true;
    },
    invalidTool: () => {
      invalidTool = true;
    },
    failCodeMode: () => {
      failedCodeMode = true;
    },
    empty: () => {
      empty = true;
    },
    holdCreation: () => {
      holdCreation = true;
      gate = new Promise<void>((r) => {
        release = r;
      });
    },
    deny: () => {
      denied = true;
    },
    hold: () => {
      gate = new Promise<void>((r) => {
        release = r;
      });
    },
    release: () => release?.(),
  };
}

// Exercises the actual v2 registration and cleanup contracts without a model.
export function createFakePluginContext(
  directory: string,
  client = createFakeOpenCode().client,
) {
  const commands = new Map<string, CommandDefinition>();
  const tools = new Map<string, Info & { id: string }>();
  const hooks = new Map<string, (input: unknown) => Promise<void> | void>();
  const statuses: string[] = [];
  const rpcHandlers = new Map<string, (input: never) => Promise<unknown>>();
  const registration = (dispose = async () => {}) => ({ dispose });
  const context = {
    location: { directory },
    session: {
      ...client.session,
      hook: async (
        name: string,
        hook: (input: unknown) => Promise<void> | void,
      ) => {
        hooks.set(`session.${name}`, hook);
        return registration(async () => {
          hooks.delete(`session.${name}`);
        });
      },
    },
    command: {
      transform: async (
        apply: (editor: { add(definition: CommandDefinition): void }) => void,
      ) => {
        apply({
          add: (definition) => {
            commands.set(definition.name, definition);
          },
        });
        return registration(async () => {
          commands.clear();
        });
      },
    },
    tool: {
      list: async () => [...tools.values()],
      reload: async () => {},
      transform: async (apply: (editor: { add(info: Info): void }) => void) => {
        const added: string[] = [];
        apply({
          add: (info) => {
            tools.set(info.name, { ...info, id: info.name });
            added.push(info.name);
          },
        });
        return registration(async () => {
          for (const name of added) tools.delete(name);
        });
      },
      hook: async (
        name: string,
        hook: (input: unknown) => Promise<void> | void,
      ) => {
        hooks.set(`tool.${name}`, hook);
        return registration(async () => {
          hooks.delete(`tool.${name}`);
        });
      },
    },
    rpc: {
      register: async (
        _definition: unknown,
        handlers: Record<string, (input: never) => Promise<unknown>>,
      ) => {
        for (const [name, handler] of Object.entries(handlers))
          rpcHandlers.set(name, handler);
        return {
          ...registration(async () => {
            rpcHandlers.clear();
          }),
          events: {
            emit: async (_name: string, data: { text: string }) => {
              statuses.push(data.text);
            },
          },
        };
      },
    },
    event: {
      subscribe: async function* (_options: { signal?: AbortSignal }) {},
    },
  } as unknown as Plugin.Context;
  return { context, commands, tools, hooks, statuses, rpcHandlers };
}
import { execFile } from "node:child_process";
import { mkdtemp, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { promisify } from "node:util";
export const git = promisify(execFile);
export async function createTestProject(prefix = "ralph-") {
  const directory = await mkdtemp(join(tmpdir(), prefix));
  await git("git", ["init", directory]);
  await git("git", [
    "-C",
    directory,
    "config",
    "user.email",
    "fixture@example.invalid",
  ]);
  await git("git", ["-C", directory, "config", "user.name", "Fixture"]);
  await writeFile(join(directory, "README.md"), "Fixture\n");
  await git("git", ["-C", directory, "add", "."]);
  await git("git", ["-C", directory, "commit", "-m", "fixture"]);
  const commit = (
    await git("git", ["-C", directory, "rev-parse", "HEAD"])
  ).stdout.trim();
  return {
    directory,
    commit,
    cleanup: () => rm(directory, { recursive: true, force: true }),
  };
}
import { expect, test } from "bun:test";
import { createCommandRouter } from "../../src/commands/router.js";
import { createOpenCodeAdapter } from "../../src/opencode/adapter.js";
import { openRunStore } from "../../src/state/run-store.js";
import { createFakeOpenCode } from "../helpers/fake-opencode.js";
import { createTestProject } from "../helpers/project.js";

test("orchestrator rejects a feature before verified setup", async () => {
  const project = await createTestProject();
  try {
    const fake = createFakeOpenCode();
    const store = await openRunStore(project.directory);
    const router = createCommandRouter(
      store,
      createOpenCodeAdapter(fake.client, store),
    );
    await expect(
      router.dispatch("ralph-orchestrator", "Add reset", {
        workspace: project.directory,
        sessionId: "main",
      }),
    ).rejects.toThrow("verification");
    expect(await store.listRuns()).toHaveLength(0);
  } finally {
    await project.cleanup();
  }
});

test("recommended interview question, rejected revision and human approval end at explanation", async () => {
  const project = await createTestProject();
  try {
    const fake = createFakeOpenCode();
    const store = await openRunStore(project.directory);
    const adapter = createOpenCodeAdapter(fake.client, store);
    adapter.getSessionModel = async () => ({
      providerID: "fixture",
      modelID: "default",
    });
    const router = createCommandRouter(
      store,
      adapter,
      undefined,
      project.directory,
    );
    fake.respond(
      JSON.stringify({
        schemaVersion: 1,
        revision: 1,
        rationale: "Fixture",
        commands: [
          {
            id: "check",
            phase: "check",
            executable: process.execPath,
            args: ["-e", "process.exit(0)"],
            cwd: ".",
            timeoutMs: 2000,
            platforms: ["darwin", "linux", "win32"],
            env: {},
          },
        ],
      }),
    );
    adapter.authorizeCommand = async () => ({ ok: true });
    adapter.requestUserInput = async (request) => ({
      ok: true,
      ...request,
      source: "user",
      messageId: "setup-human",
      text: `approve ${request.question.match(/hash ([a-f0-9]+)/)?.[1]}`,
    });
    await router.setupProject({
      workspace: project.directory,
      sessionId: "main",
    });
    fake.respond(
      JSON.stringify({
        kind: "question",
        question: "How long should tokens last?",
        recommendation: "15 minutes",
      }),
    );
    let count = 0;
    adapter.requestUserInput = async (request) => {
      expect(request.sessionId).toBe("main");
      count++;
      if (count === 1) {
        fake.respond(
          JSON.stringify({
            kind: "explanation",
            text: "Expire reset tokens after 15 minutes.",
            scope: ["Reset tokens"],
            criteria: ["Expired tokens fail"],
          }),
        );
        return {
          ok: true,
          ...request,
          source: "user",
          messageId: "answer",
          text: "15 minutes",
        };
      }
      if (count === 2) {
        fake.respond(
          JSON.stringify({
            kind: "explanation",
            text: "Expire reset tokens after 10 minutes.",
            scope: ["Reset tokens"],
            criteria: ["Tokens fail after 10 minutes"],
          }),
        );
        return {
          ok: true,
          ...request,
          source: "user",
          messageId: "reject",
          text: "revise: use 10 minutes",
        };
      }
      return {
        ok: true,
        ...request,
        source: "user",
        messageId: "approve",
        text: `approve ${request.revision}`,
      };
    };
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Add password reset", {
        workspace: project.directory,
        sessionId: "main",
      }),
    );
    const run = await store.getRun(result.runId);
    expect(run?.planning?.phase).toBe("explanation_approved");
    expect(run?.planning?.explanation?.revision).toBe(2);
    expect(run?.planning?.approval?.revision).toBe(2);
    expect(
      run?.planning?.transcript.filter((entry) => entry.source === "user"),
    ).toHaveLength(4);
    expect(
      Object.values(run?.jobs ?? {}).every(
        (job) => job.envelope.role === "interview",
      ),
    ).toBe(true);
    expect(JSON.parse(await router.status(result.runId)).planning.phase).toBe(
      "explanation_approved",
    );
  } finally {
    await project.cleanup();
  }
});

async function readyProject() {
  const project = await createTestProject();
  const fake = createFakeOpenCode();
  const store = await openRunStore(project.directory);
  const adapter = createOpenCodeAdapter(fake.client, store);
  adapter.getSessionModel = async () => ({
    providerID: "fixture",
    modelID: "default",
  });
  const router = createCommandRouter(
    store,
    adapter,
    undefined,
    project.directory,
  );
  fake.respond(
    JSON.stringify({
      schemaVersion: 1,
      revision: 1,
      rationale: "Fixture",
      commands: [
        {
          id: "check",
          phase: "check",
          executable: process.execPath,
          args: ["-e", "process.exit(0)"],
          cwd: ".",
          timeoutMs: 2000,
          platforms: ["darwin", "linux", "win32"],
          env: {},
        },
      ],
    }),
  );
  adapter.authorizeCommand = async () => ({ ok: true });
  adapter.requestUserInput = async (request) => ({
    ok: true,
    ...request,
    source: "user",
    messageId: "setup",
