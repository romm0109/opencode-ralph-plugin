            context.sourceWorkspace ?? job.workspace,
            ".ralph/commands.json",
          ),
          "utf8",
        ),
      ),
    );
    if (
      commandConfigHash(saved) !== summary.commandHash ||
      initial?.planning?.commandHash !== summary.commandHash
