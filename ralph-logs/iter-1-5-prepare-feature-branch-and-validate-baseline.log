  }
  let owned: RunOperation | undefined;
  try {
    if (initial.control && initial.control.status !== "active") return initial;
    if (
      state.phase !== "execution_approved" ||
      !state.prd ||
      !state.graph ||
      !state.executionApproval ||
      state.executionApproval.prdHash !== state.prd.hash ||
      state.executionApproval.graphHash !== state.graph.hash ||
      state.executionApproval.revision !== state.graph.revision ||
      !baseline.candidateCommit ||
      state.selectedCommit !== baseline.candidateCommit
    )
      throw new Error(
        "Matching execution approval and selected commit are required",
      );
    await verifyReviewRepository(state.workspace, store.repositoryId);
    const lock = JSON.parse(
      await readFile(join(store.root, "active-run.lock/owner.json"), "utf8"),
    );
    if (lock.runId !== runId || lock.repositoryId !== store.repositoryId)
      throw new Error("Repository lock belongs to another run");
    await assertProjectReady(state.workspace);
    const config = await loadProjectConfig(state.workspace);
    baseline.commandRevision = config.commands.revision;
    if (commandConfigHash(config.commands) !== state.commandHash)
      throw new Error("Approved command configuration changed");
    validateIssueGraph(state.graph.value, state.graph.files, state.prd);
    const graph = JSON.parse(
      await readFile(join(state.workspace, state.graph.artifactPath), "utf8"),
    );
    const files: Record<string, string> = {};
    for (const path of Object.keys(state.graph.files))
      files[path] = await readFile(
        join(state.workspace, dirname(state.graph.artifactPath), path),
        "utf8",
      );
    if (
      artifactHash(
        await readFile(join(state.workspace, state.prd.artifactPath), "utf8"),
      ) !== state.prd.hash ||
      issueBundleHash(graph, files) !== state.graph.hash
    )
      throw new Error("Approved planning artifacts changed");
    try {
      await gitOutput(state.workspace, [
        "rev-parse",
        "--verify",
        "HEAD^{commit}",
      ]);
    } catch (cause) {
      throw new Error(
        "Repository HEAD is unborn or invalid; create a commit before execution",
        { cause },
      );
    }
    if (
      !/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/.test(baseline.candidateCommit) ||
      (
        await gitOutput(state.workspace, [
          "rev-parse",
          "--verify",
          `${baseline.candidateCommit}^{commit}`,
        ])
      ).trim() !== baseline.candidateCommit
    )
      throw new Error(
        "Selected starting commit is invalid; select and approve a committed starting point",
      );
    if (
      (
        await gitOutput(state.workspace, [
          "status",
          "--porcelain",
          "--untracked-files=all",
        ])
      ).trim()
    )
      throw new Error(
        "Checkout is dirty; commit or remove tracked and relevant untracked changes before execution",
      );
    if (
      initial.baseline &&
      ["passed", "passed_with_omissions"].includes(initial.baseline.status) &&
      initial.baseline.candidateCommit === baseline.candidateCommit &&
      initial.baseline.commandHash === baseline.commandHash &&
      initial.baseline.approvalRequestId === state.executionApproval.requestId
    )
      return initial;
    baseline.branch = `ralph/${runId}`;
    baseline.workspace = join(store.root, "worktrees", runId);
    if (
      (
        await gitOutput(state.workspace, [
          "for-each-ref",
          "--format=%(refname)",
          `refs/heads/${baseline.branch}`,
        ])
      ).trim()
    )
      throw new Error(
        `Branch ${baseline.branch} already exists; inspect it and select a new feature ID`,
      );
    await save(initial.revision);
    await mkdir(dirname(baseline.workspace), { recursive: true });
    const job: JobEnvelope = {
      runId,
      jobId: baseline.operationId,
      role: "baseline",
      attempt: 0,
      workspace: baseline.workspace,
      baseCommit: baseline.candidateCommit,
      inputRevisions: {
        commands: config.commands.revision,
        approval: state.executionApproval.revision,
      },
      prompt: "Validate approved feature baseline",
    };
    owned = {
      operationId: baseline.operationId,
      kind: "baseline.workspace",
      status: "intent",
      job,
      ref: `refs/heads/${baseline.branch}`,
      expectedOld: baseline.candidateCommit,
      expectedNew: baseline.candidateCommit,
    };
    await createOwnedWorktree(store, state.workspace, owned);
    baseline.validation = await validateCandidate({
      store,
      adapter,
      job,
      config: config.commands,
      sourceWorkspace: state.workspace,
    });
    baseline.status = baseline.validation.status;
    if (baseline.validation.blocker) {
      baseline.blocker = baseline.validation.blocker;
      baseline.error = {
        code: "baseline-blocked",
        message: baseline.validation.blocker,
        cause: baseline.validation.blocker,
      };
    }
    if (baseline.status === "failed")
      await removeOwnedWorktree(store, state.workspace, owned.operationId);
    await save();
  } catch (cause) {
    baseline.status = "failed";
    baseline.blocker = String(cause);
    baseline.error = {
      code: "baseline-blocked",
      message: String(cause),
      cause: String(cause),
    };
    if (
      owned &&
      (await store.getRun(runId))?.operations[owned.operationId]?.status ===
        "completed"
    ) {
      try {
        await removeOwnedWorktree(store, state.workspace, owned.operationId);
      } catch (cleanup) {
        baseline.blocker += `; cleanup: ${String(cleanup)}`;
      }
    }
    await save().catch(() => {});
  }
  const latest = await store.getRun(runId);
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { commandConfigHash, parseCommandConfig } from "../config/commands.js";
import { gitOutput } from "../git/worktrees.js";
import {
  createApprovedEnvironment,
  disposeEnvironment,
  prepareEnvironment,
} from "../process/environment.js";
import {
  type CommandContext,
  type CommandResult,
  runCommand,
} from "../process/runner.js";

export interface ValidationSummary {
  status: "passed" | "passed_with_omissions" | "failed";
  candidateCommit: string;
  commandHash: string;
  commandRevision: number;
  checks: {
    id: string;
    status: "passed" | "failed" | "skipped";
    reason?: string;
    result?: CommandResult;
  }[];
  lifecycle: CommandResult[];
  skippedCheckIds: string[];
  blocker?: string;
}
export async function validateCandidate(
  context: CommandContext,
): Promise<ValidationSummary> {
  const { store, job, config } = context;
  const initial = await store.getRun(job.runId);
  const epoch = initial?.control?.epoch ?? 0;
  const summary: ValidationSummary = {
    status: "failed",
    candidateCommit: job.baseCommit,
    commandHash: commandConfigHash(config),
    commandRevision: config.revision,
    checks: [],
    lifecycle: [],
    skippedCheckIds: [...(initial?.validationSkips ?? [])],
  };
  const environment = createApprovedEnvironment(context, { skipChecks: true });
  try {
    const saved = parseCommandConfig(
      JSON.parse(
        await readFile(
          join(
            context.sourceWorkspace ?? job.workspace,
            ".ralph/commands.json",
          ),
          "utf8",
        ),
      ),
    );
    if (
      commandConfigHash(saved) !== summary.commandHash ||
      initial?.planning?.commandHash !== summary.commandHash
    )
      throw new Error(
        "Candidate validation requires the exact approved command configuration",
      );
    if (
      !/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/.test(job.baseCommit) ||
      (
        await gitOutput(job.workspace, ["rev-parse", "HEAD^{commit}"])
      ).trim() !== job.baseCommit
    )
      throw new Error("Candidate HEAD differs from the exact approved commit");
    await prepareEnvironment(environment, job);
    for (const command of config.commands.filter(
      (c) =>
        c.phase === "check" && c.platforms.some((p) => p === process.platform),
    )) {
      if (summary.skippedCheckIds.includes(command.id)) {
        summary.checks.push({
          id: command.id,
          status: "skipped",
          reason: "Earlier timeout in this feature run",
        });
        continue;
      }
      const result = await runCommand(command, context);
      if (
        result.status === "timed_out" &&
        !result.cleanupError &&
        !result.cause
      ) {
        summary.skippedCheckIds.push(command.id);
        summary.checks.push({
          id: command.id,
          status: "skipped",
          reason: "Timed out; omitted for the rest of this run",
          result,
        });
        const run = await store.getRun(job.runId);
        if (
          !run?.baseline ||
          run.baseline.operationId !== initial?.baseline?.operationId ||
          (run.control?.epoch ?? 0) !== epoch ||
          !(await store.recordBaseline(
            job.runId,
            run.revision,
            run.baseline,
            summary.skippedCheckIds,
          ))
        )
          throw new Error("Stale timeout completion");
      } else if (
        result.status !== "completed" ||
        result.exitCode !== 0 ||
        result.cause ||
        result.cleanupError
      ) {
        summary.checks.push({ id: command.id, status: "failed", result });
        throw new Error(
          `Check ${command.id}: ${result.status}, exit ${result.exitCode}${result.cause ? `: ${result.cause.message}` : ""}`,
        );
      } else summary.checks.push({ id: command.id, status: "passed", result });
    }
    summary.status = summary.checks.some((c) => c.status === "skipped")
      ? "passed_with_omissions"
      : "passed";
  } catch (cause) {
    summary.blocker = String(cause);
  } finally {
    const cleanup = await disposeEnvironment(environment, job).catch(
      (cause) => ({
        status: "failed" as const,
        reason: String(cause),
        evidenceRefs: [],
      }),
    );
    summary.lifecycle = environment.results;
    if (cleanup.status !== "completed") {
      summary.status = "failed";
      summary.blocker = cleanup.reason ?? "Environment cleanup failed";
    }
  }
  try {
    if (
      (
        await gitOutput(job.workspace, ["rev-parse", "HEAD^{commit}"])
      ).trim() !== job.baseCommit ||
      (
        await gitOutput(job.workspace, [
          "status",
          "--porcelain",
          "--untracked-files=no",
        ])
      ).trim()
    )
      throw new Error(
        "Candidate changed during validation; evidence does not match the approved commit",
      );
  } catch (cause) {
    summary.status = "failed";
    summary.blocker = String(cause);
  }
  const latest = await store.getRun(job.runId);
  if (
    latest?.baseline?.operationId !== initial?.baseline?.operationId ||
    (latest?.control?.epoch ?? 0) !== epoch ||
    (latest?.control && latest.control.status !== "active")
  ) {
    summary.status = "failed";
    summary.blocker = "Stale validation completion";
  }
  return summary;
}

