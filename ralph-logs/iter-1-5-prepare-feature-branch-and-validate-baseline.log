test(\"completed baseline failure blocks without spending an issue attempt and removes only its worktree\", async () => {
  const f = await approvedFixture();
  try {
    process.env.RALPH_BASELINE_SCENARIO = \"fail\";
    const configBefore = await readFile(join(f.project.directory, \".ralph/commands.json\"), \"utf8\");
    const run = await preflightRun(f.store, f.adapter, f.runId);
    expect(run?.baseline?.status).toBe(\"failed\");
    expect(run?.baseline?.validation?.checks[0]?.result?.exitCode).toBe(7);
    expect(Object.values(run?.jobs ?? {}).some(j => j.envelope.issueId)).toBe(false);
    expect((await git(\"git\", [\"-C\", f.project.directory, \"worktree\", \"list\", \"--porcelain\"])).stdout).not.toContain(run?.baseline?.workspace as string);
    expect(await readFile(join(f.project.directory, \".ralph/commands.json\"), \"utf8\")).toBe(configBefore);
  } finally { await f.project.cleanup(); }
});

