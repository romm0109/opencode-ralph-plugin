export interface BaselineState {
  status: "preparing" | "passed" | "passed_with_omissions" | "failed";
  operationId: string;
  candidateCommit: string;
  commandHash: string;
  commandRevision: number;
  approvalRequestId?: string;
  branch?: string;
  workspace?: string;
  blocker?: string;
