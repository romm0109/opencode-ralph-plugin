import { commandConfigHash } from \"../config/commands.js\";
import { gitOutput } from \"../git/worktrees.js\";
import { createApprovedEnvironment, prepareEnvironment, disposeEnvironment } from \"../process/environment.js\";
import { type CommandContext, type CommandResult, runCommand } from \"../process/runner.js\";

export interface ValidationSummary {
  status: \"passed\" | \"passed_with_omissions\" | \"failed\";
  candidateCommit: string;
  commandHash: string;
  commandRevision: number;
  checks: { id: string; status: \"passed\" | \"failed\" | \"skipped\"; reason?: string; result?: CommandResult }[];
  lifecycle: CommandResult[];
  skippedCheckIds: string[];
  blocker?: string;
}
export async function validateCandidate(context: CommandContext): Promise<ValidationSummary> {
  const { store, job, config } = context;
  const initial = await store.getRun(job.runId);
  const epoch = initial?.control?.epoch ?? 0;
  const summary: ValidationSummary = {
    status: \"failed\", candidateCommit: job.baseCommit,
    commandHash: commandConfigHash(config), commandRevision: config.revision,
    checks: [], lifecycle: [], skippedCheckIds: [...(initial?.validationSkips ?? [])],
  };
  const environment = createApprovedEnvironment(context, { skipChecks: true });
  try {
    if ("'!/''^(?:[a-f0-9]{40}|[a-f0-9]{64})$/.test(job.baseCommit) ||
      (await gitOutput(job.workspace, ["rev-parse", "HEAD''^{commit}"])).trim() !== job.baseCommit)
      throw new Error("Candidate HEAD differs from the exact approved commit");
    await prepareEnvironment(environment, job);
    for (const command of config.commands.filter(c => c.phase === "check" && c.platforms.some(p => p === process.platform))) {
      if (summary.skippedCheckIds.includes(command.id)) {
        summary.checks.push({ id: command.id, status: "skipped", reason: "Earlier timeout in this feature run" });
        continue;
      }
      const result = await runCommand(command, context);
      if (result.status === "timed_out" && !result.cleanupError && !result.cause) {
        summary.skippedCheckIds.push(command.id);
        summary.checks.push({ id: command.id, status: "skipped", reason: "Timed out; omitted for the rest of this run", result });
        const run = await store.getRun(job.runId);
        if (!run?.baseline || (run.control?.epoch ?? 0) !== epoch || !(await store.recordBaseline(job.runId, run.revision, run.baseline, summary.skippedCheckIds))) throw new Error("Stale timeout completion");
      } else if (result.status !== "completed" || result.exitCode !== 0 || result.cause || result.cleanupError) {
        summary.checks.push({ id: command.id, status: "failed", result });
        throw new Error(`Check ${command.id}: ${result.status}, exit ${result.exitCode}${result.cause ? `: ${result.cause.message}` : ""}`);
      } else summary.checks.push({ id: command.id, status: "passed", result });
    }
    summary.status = summary.checks.some(c => c.status === "skipped") ? "passed_with_omissions" : "passed";
  } catch (cause) { summary.blocker = String(cause); }
  finally {
    const cleanup = await disposeEnvironment(environment, job).catch(cause => ({ status: "failed" as const, reason: String(cause), evidenceRefs: [] }));
    summary.lifecycle = environment.results;
    if (cleanup.status !== "completed") { summary.status = "failed"; summary.blocker = cleanup.reason ?? "Environment cleanup failed"; }
  }
  const latest = await store.getRun(job.runId);
  if ((latest?.control?.epoch ?? 0) !== epoch || (latest?.control && latest.control.status !== "active")) {
    summary.status = "failed"; summary.blocker = "Stale validation completion";
  }
  return summary;
}
