import { spawn } from \"node:child_process\";
import { realpath } from \"node:fs/promises\";
import { resolve } from \"node:path\";
import type { RunStore } from \"../state/run-store.js\";
import type { RunOperation } from \"../core/types.js\";

export function gitOutput(cwd: string, args: string[]): Promise<string> {
  return new Promise((accept, reject) => {
    const child = spawn(\"git\", args, { cwd, stdio: [\"ignore\", \"pipe\", \"pipe\"] });
    let stdout = \"\", stderr = \"\";
    child.stdout.on(\"data\", chunk => { stdout += chunk; });
    child.stderr.on(\"data\", chunk => { stderr += chunk; });
    child.once(\"error\", reject);
    child.once(\"close\", code => code === 0 ? accept(stdout) : reject(new Error("'`git ${args[0]} failed: ${stderr.trim()}`)));
  });
}
export async function inspectWorktree(workspace: string) {
  return {
    workspace: await realpath(workspace),
    repositoryId: await realpath(resolve(workspace, (await gitOutput(workspace, ["rev-parse", "--git-common-dir"])).trim())),
    commit: (await gitOutput(workspace, ["rev-parse", "--verify", "HEAD''^{commit}"])).trim(),
    branch: (await gitOutput(workspace, ["symbolic-ref", "HEAD"])).trim(),
  };
}
export async function createOwnedWorktree(store: RunStore, directory: string, operation: RunOperation) {
  if (operation.kind !== "baseline.workspace" || !operation.ref?.startsWith("refs/heads/ralph/") || !operation.expectedNew) throw new Error("Invalid baseline ownership intent");
  if (!(await store.recordOperation(operation))) throw new Error("Stale baseline intent");
  try {
    await gitOutput(directory, ["worktree", "add", "-b", operation.ref.slice(11), operation.job.workspace, operation.expectedNew]);
    if (!(await store.recordOperation({ ...operation, status: "completed" }))) throw new Error("Stale workspace completion");
    return inspectWorktree(operation.job.workspace);
  } catch (cause) {
    await store.recordOperation({ ...operation, status: "failed", error: { code: "baseline-blocked", message: String(cause), cause: String(cause) } });
    throw cause;
  }
}
export async function removeOwnedWorktree(store: RunStore, directory: string, operationId: string) {
  const run = (await store.listRuns()).find(run => run.operations[operationId]);
  const owner = run?.operations[operationId];
  if (!owner || owner.kind !== "baseline.workspace" || owner.status !== "completed") throw new Error("No completed worktree ownership record");
  const found = await inspectWorktree(owner.job.workspace);
  if (found.repositoryId !== store.repositoryId || found.branch !== owner.ref || found.commit !== owner.expectedNew) throw new Error("Owned worktree identity changed; inspect manually");
  const cleanup: RunOperation = { ...owner, operationId: `${operationId}-cleanup`, kind: "baseline.cleanup", status: "intent" };
  if (!(await store.recordOperation(cleanup))) throw new Error("Stale cleanup intent");
  try {
    await gitOutput(directory, ["worktree", "remove", "--force", owner.job.workspace]);
    await gitOutput(directory, ["update-ref", "-d", owner.ref as string, owner.expectedNew as string]);
    await store.recordOperation({ ...cleanup, status: "completed" });
  } catch (cause) {
    await store.recordOperation({ ...cleanup, status: "failed", error: { code: "baseline-blocked", message: String(cause) } });
    throw cause;
  }
}
