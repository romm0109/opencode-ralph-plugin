cat > src/execution/preflight.ts <<'"'EOF'
import { randomUUID } from \"node:crypto\";
import { mkdir, readFile } from \"node:fs/promises\";
import { dirname, join } from \"node:path\";
import { assertProjectReady } from \"../commands/project-setup.js\";
import { commandConfigHash } from \"../config/commands.js\";
import { loadProjectConfig } from \"../config/project.js\";
import type { JobEnvelope, RunOperation } from \"../core/types.js\";
import { verifyReviewRepository } from \"../git/review-workspace.js\";
import { createOwnedWorktree, gitOutput, removeOwnedWorktree } from \"../git/worktrees.js\";
import type { OpenCodeAdapter } from \"../opencode/adapter.js\";
import { artifactHash, issueBundleHash } from \"../planning/artifacts.js\";
import { validateIssueGraph } from \"../planning/graph.js\";
import type { RunStore } from \"../state/run-store.js\";
import { type ValidationSummary, validateCandidate } from \"./validation.js\";

export interface BaselineState {
  status: \"preparing\" | \"passed\" | \"passed_with_omissions\" | \"failed\";
  operationId: string;
  candidateCommit: string;
  commandHash: string;
  commandRevision: number;
  branch?: string;
  workspace?: string;
  blocker?: string;
  validation?: ValidationSummary;
}
export async function preflightRun(store: RunStore, adapter: OpenCodeAdapter, runId: string) {
  const initial = await store.getRun(runId);
  const state = initial?.planning;
  if ("'!initial || !state) throw new Error("Unknown planning run");
  if (initial.baseline && initial.baseline.status !== "failed") return initial;
  const epoch = initial.control?.epoch ?? 0;
  const baseline: BaselineState = { status: "preparing", operationId: `baseline-${randomUUID()}`, candidateCommit: state.executionApproval?.selectedCommit ?? "", commandHash: state.commandHash, commandRevision: 0 };
  async function save() {
    const run = await store.getRun(runId);
    if (!run || (run.control?.epoch ?? 0) !== epoch || run.planning?.executionApproval?.requestId !== state?.executionApproval?.requestId || !(await store.recordBaseline(runId, run.revision, baseline, baseline.validation?.skippedCheckIds ?? []))) throw new Error("Stale baseline transition");
  }
  let owned: RunOperation | undefined;
  try {
    if (initial.control && initial.control.status !== "active") return initial;
    if (state.phase !== "execution_approved" || !state.prd || !state.graph || !state.executionApproval || state.executionApproval.prdHash !== state.prd.hash || state.executionApproval.graphHash !== state.graph.hash || state.executionApproval.revision !== state.graph.revision || !baseline.candidateCommit || state.selectedCommit !== baseline.candidateCommit) throw new Error("Matching execution approval and selected commit are required");
    await verifyReviewRepository(state.workspace, store.repositoryId);
    const lock = JSON.parse(await readFile(join(store.root, "active-run.lock/owner.json"), "utf8"));
    if (lock.runId !== runId || lock.repositoryId !== store.repositoryId) throw new Error("Repository lock belongs to another run");
    await assertProjectReady(state.workspace);
    const config = await loadProjectConfig(state.workspace);
    baseline.commandRevision = config.commands.revision;
    if (commandConfigHash(config.commands) !== state.commandHash) throw new Error("Approved command configuration changed");
    validateIssueGraph(state.graph.value, state.graph.files, state.prd);
    const graph = JSON.parse(await readFile(join(state.workspace, state.graph.artifactPath), "utf8"));
    const files: Record<string, string> = {};
    for (const path of Object.keys(state.graph.files)) files[path] = await readFile(join(state.workspace, dirname(state.graph.artifactPath), path), "utf8");
    if (artifactHash(await readFile(join(state.workspace, state.prd.artifactPath), "utf8")) !== state.prd.hash || issueBundleHash(graph, files) !== state.graph.hash) throw new Error("Approved planning artifacts changed");
    await gitOutput(state.workspace, ["rev-parse", "--verify", "HEAD''^{commit}"]);
    if (!/''^(?:[a-f0-9]{40}|[a-f0-9]{64})$/.test(baseline.candidateCommit) || (await gitOutput(state.workspace, ["rev-parse", "--verify", `${baseline.candidateCommit}''^{commit}`])).trim() !== baseline.candidateCommit) throw new Error("Selected starting commit is invalid; select and approve a committed starting point");
    if ((await gitOutput(state.workspace, ["status", "--porcelain", "--untracked-files=all"])).trim()) throw new Error("Checkout is dirty; commit or remove tracked and relevant untracked changes before execution");
    baseline.branch = `ralph/${runId}`;
    baseline.workspace = join(store.root, "worktrees", runId);
    if ((await gitOutput(state.workspace, ["for-each-ref", "--format=%(refname)", `refs/heads/${baseline.branch}`])).trim()) throw new Error(`Branch ${baseline.branch} already exists; inspect it and select a new feature ID`);
    await save();
    await mkdir(dirname(baseline.workspace), { recursive: true });
    const job: JobEnvelope = { runId, jobId: baseline.operationId, role: "baseline", attempt: 0, workspace: baseline.workspace, baseCommit: baseline.candidateCommit, inputRevisions: { commands: config.commands.revision, approval: state.executionApproval.revision }, prompt: "Validate approved feature baseline" };
    owned = { operationId: baseline.operationId, kind: "baseline.workspace", status: "intent", job, ref: `refs/heads/${baseline.branch}`, expectedOld: baseline.candidateCommit, expectedNew: baseline.candidateCommit };
    await createOwnedWorktree(store, state.workspace, owned);
    baseline.validation = await validateCandidate({ store, adapter, job, config: config.commands, sourceWorkspace: state.workspace });
    baseline.status = baseline.validation.status;
    if (baseline.validation.blocker) baseline.blocker = baseline.validation.blocker;
    if (baseline.status === "failed") await removeOwnedWorktree(store, state.workspace, owned.operationId);
    await save();
  } catch (cause) {
    baseline.status = "failed";
    baseline.blocker = String(cause);
    if (owned && (await store.getRun(runId))?.operations[owned.operationId]?.status === "completed") {
      try { await removeOwnedWorktree(store, state.workspace, owned.operationId); }
      catch (cleanup) { baseline.blocker += `; cleanup: ${String(cleanup)}`; }
    }
    await save().catch(() => {});
  }
  await adapter.publishStatus(state.sessionId, state.workspace, JSON.stringify(baseline));
  return store.getRun(runId);
}
