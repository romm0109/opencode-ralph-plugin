import { execFile } from "node:child_process";
import { realpath } from "node:fs/promises";
import { resolve } from "node:path";
import { promisify } from "node:util";

const exec = promisify(execFile);
export async function readReviewGit(
  directory: string,
  args: string[],
): Promise<string> {
  return (
    await exec("git", ["-C", directory, ...args], {
      maxBuffer: 16 * 1024 * 1024,
    })
  ).stdout;
}
export async function resolveReviewCommit(
  directory: string,
  commit: string,
): Promise<string> {
  if (!/^[a-f0-9]{40}$|^[a-f0-9]{64}$/.test(commit))
    throw new Error("Review requires an exact commit SHA");
  const resolved = (
    await readReviewGit(directory, [
      "rev-parse",
      "--verify",
      `${commit}^{commit}`,
    ])
  ).trim();
  if (resolved !== commit)
    throw new Error("Review requires a commit object SHA");
  return resolved;
}
export async function pinReviewCommit(
  directory: string,
  ref: string,
  commit: string,
) {
  await readReviewGit(directory, ["update-ref", ref, commit]);
}
export async function createReviewWorkspace(
  directory: string,
  workspace: string,
  commit: string,
) {
  await readReviewGit(directory, [
    "worktree",
    "add",
    "--detach",
    workspace,
    commit,
  ]);
}
export async function verifyReviewWorkspace(workspace: string, commit: string) {
  const head = (await readReviewGit(workspace, ["rev-parse", "HEAD"])).trim();
  const status = await readReviewGit(workspace, [
    "status",
    "--porcelain",
    "--untracked-files=all",
    "--ignored",
  ]);
  if (head !== commit || status.trim())
    throw new Error("Reviewer workspace changed from the frozen commit");
}

export async function verifyReviewRepository(
  directory: string,
  repositoryId: string,
) {
  const common = (
    await readReviewGit(directory, ["rev-parse", "--git-common-dir"])
  ).trim();
  if ((await realpath(resolve(directory, common))) !== repositoryId)
    throw new Error("Review directory belongs to a different repository");
}
export async function verifyFindingEvidence(
  workspace: string,
  commit: string,
  evidence: string[],
  refs: string[],
) {
  for (const ref of evidence) {
    if (refs.some((known) => ref === known || ref.startsWith(`${known}:`)))
      return;
    const location = /^(\S+):(\d+)\b/.exec(ref);
    if (!location) continue;
    const path = location[1];
    const line = Number(location[2]);
    if (
      !path ||
      path.startsWith("/") ||
      path.split("/").includes("..") ||
      !Number.isSafeInteger(line) ||
      line < 1
    )
      continue;
    try {
      const content = await readReviewGit(workspace, [
        "show",
        `${commit}:${path}`,
      ]);
      if (line <= content.trimEnd().split("\n").length) return;
    } catch {
      /* Try the remaining citations; absent files are not evidence. */
    }
  }
  throw new Error(
    "Blocking finding has no valid evidence location at the reviewed commit",
  );
}

/** Review-owned detached worktree at an exact SHA. */
export const createOwnedWorktree = createReviewWorkspace;
export async function verifyFunctionalWorkspace(
  workspace: string,
  commit: string,
) {
  const head = (await readReviewGit(workspace, ["rev-parse", "HEAD"])).trim();
  const changes = await readReviewGit(workspace, ["diff", "HEAD", "--"]);
  if (head !== commit || changes.trim())
    throw new Error("Functional workspace changed from reviewed commit");
}
import { randomUUID } from "node:crypto";
import { readFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { z } from "zod";
import { loadRoleInstructions } from "../agents/skills.js";
import { loadProjectConfig } from "../config/project.js";
import type { UserInputResult } from "../core/types.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { artifactHash, issueBundleHash } from "./artifacts.js";
import {
  dispatchGeneration,
  planningFailure,
  publishRevision,
  savePlanning,
} from "./generation.js";
import { topologicalOrder, validateIssueGraph } from "./graph.js";

export async function generateIssues(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if (!state?.prd) throw new Error("A PRD revision is required");
  try {
    const config = await loadProjectConfig(state.workspace);
    const skill = await loadRoleInstructions(
      state.workspace,
      "issues",
      config.skillPaths,
    );
    const text = await readFile(
      join(state.workspace, state.prd.artifactPath),
      "utf8",
    );
    if (artifactHash(text) !== state.prd.hash)
      throw new Error("PRD artifact changed");
    const generated = await dispatchGeneration(
      store,
      adapter,
      runId,
      "issues",
      `${skill.text}\nRepository: ${state.workspace}\nPRD revision: ${JSON.stringify(state.prd)}\nPRD content:\n${text}\nExplanation: ${JSON.stringify(state.explanation)}\nRevision feedback: ${JSON.stringify(state.transcript)}`,
      { issues: { path: skill.path, hash: skill.hash } },
    );
    if (!generated) return store.getRun(runId);
    const output = z
      .object({ graph: z.unknown(), files: z.record(z.string(), z.string()) })
      .strict()
      .parse(JSON.parse(generated.result.text ?? ""));
    const value = validateIssueGraph(output.graph, output.files, state.prd);
    const order = topologicalOrder(value);
    const files = Object.fromEntries(
      order.map((id) => {
        const issue = value.issues.find((item) => item.id === id);
        if (!issue) throw new Error("Missing issue");
        return [issue.artifactPath, output.files[issue.artifactPath] as string];
      }),
    );
    const publication = await publishRevision(
      store,
      generated.run.revision,
      generated.state,
      runId,
      `graph-${generated.state.generation?.revision}`,
      { ...files, "graph.json": JSON.stringify(value, null, 2) },
    );
    generated.state.graph = {
      revision: (generated.state.graph?.revision ?? 0) + 1,
      hash: issueBundleHash(value, files),
      artifactPath: `${publication.directory}/graph.json`,
      value,
      files,
      order,
    };
    generated.state.phase = "execution_approval";
    delete generated.state.executionApproval;
    await savePlanning(store, runId, publication.revision, generated.state);
  } catch (cause) {
    await planningFailure(store, runId, cause);
  }
  return store.getRun(runId);
}

export async function handlePlanningResponse(
  store: RunStore,
  runId: string,
  response: UserInputResult,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  const pending = state?.pending;
  if (
    !run ||
    state?.phase !== "execution_approval" ||
    !state.prd ||
    !state.graph ||
    !pending ||
    !response.ok ||
    response.source !== "user" ||
    !response.messageId ||
    !response.text.trim() ||
    response.requestId !== pending.requestId ||
    response.sessionId !== pending.sessionId ||
    response.revision !== pending.revision ||
    state.transcript.some((entry) => entry.messageId === response.messageId)
  )
    return false;
  try {
    const text = await readFile(
      join(state.workspace, state.prd.artifactPath),
      "utf8",
    );
    const value = JSON.parse(
      await readFile(join(state.workspace, state.graph.artifactPath), "utf8"),
