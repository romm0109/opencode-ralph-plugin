          entry.status = "terminal";
          entry.result = result;
          run.lastResult = result;
          run.phase = ["code-review", "functional-review"].includes(result.role)
            ? "running"
            : result.outcome === "denied"
              ? "failed"
              : result.outcome;
          if (result.error) run.errors.push(result.error);
          return run;
        },
        result,
      );
    },
  };
