/** Advance only the run-owned integration ref, with an exact validated candidate. */
export async function compareAndAdvanceRef(
  store: RunStore,
  directory: string,
  operation: RunOperation,
): Promise<boolean> {
  const run = await store.getRun(operation.job.runId);
  const baseline = run?.baseline;
  const owner = baseline && run?.operations[baseline.operationId];
  if (operation.kind "'!== "integration.advance" || !operation.expectedOld || !operation.expectedNew ||
      operation.ref !== `refs/heads/${baseline?.branch}` || owner?.kind !== "baseline.workspace" || owner.status !== "completed" || owner.ref !== operation.ref || !baseline?.workspace)
    throw new Error("No owned integration ref");
  const integration = await inspectWorktree(baseline.workspace);
  const candidate = await inspectWorktree(operation.job.workspace);
  const candidateOwner = Object.values(run.operations).find(item => item.kind === "candidate.workspace" && item.status === "completed" && item.job.jobId === operation.job.jobId && item.job.workspace === candidate.workspace);
  if (integration.repositoryId !== store.repositoryId || integration.branch !== operation.ref || candidate.repositoryId !== store.repositoryId || candidate.branch !== candidateOwner?.ref || candidate.commit !== operation.expectedNew ||
      (await gitOutput(candidate.workspace,["status","--porcelain","--untracked-files=all"])).trim()) throw new Error("Validated candidate identity changed");
  if (integration.commit !== operation.expectedOld) return false;
  if ((await gitOutput(integration.workspace,["status","--porcelain","--untracked-files=all"])).trim()) throw new Error("Integration checkout changed");
  await gitOutput(directory,["merge-base","--is-ancestor",operation.expectedOld,operation.expectedNew]);
  if (!(await store.recordOperation(operation))) throw new Error("Stale integration intent");
  try {
    await gitOutput(directory,["update-ref",operation.ref,operation.expectedNew,operation.expectedOld]);
  } catch (cause) {
    await store.recordOperation({...operation,status:"failed",error:{code:"baseline-blocked",message:String(cause),cause:String(cause)}});
    if ((await gitOutput(directory,["rev-parse",operation.ref])).trim() !== operation.expectedOld) return false;
    throw cause;
  }
  // Keep the owned baseline index consistent without another ref mutation.
  await store.recordOperation({...operation,status:"completed"});
  await gitOutput(integration.workspace,["read-tree","--reset","-u",operation.expectedNew]);
  return true;
}
