export function reviewTools(job: JobEnvelope): Set<string> {
  return new Set([
    "read",
    "glob",
    "grep",
    "list",
    ...(job.role === "functional-review"
      ? (job.observationTools ?? []).filter(
          (name) =>
            ![
              "edit",
              "write",
              "patch",
              "apply_patch",
              "bash",
              "shell",
              "subagent",
              "opencode",
              "execute",
              "ralph_control",
            ].includes(name),
        )
      : []),
  ]);
}
export function reviewToolAlias(name: string) {
