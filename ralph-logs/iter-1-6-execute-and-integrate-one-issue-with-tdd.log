        prompt:`${skill.text}'"\\nSkill: "'${JSON.stringify({path:skill.path,hash:skill.hash})}'"\\nApproved PRD: "'${JSON.stringify(planning.prd)}'"\\nApproved issue: "'${JSON.stringify(planning.graph?.value.issues.find(issue=>issue.id===issueId))}'"\\nLatest integration: "'${base.commit}'"\\nSUBMISSION\\n"'${JSON.stringify(submission)}`};
      delete job.sessionId;
      if (!planning.settings.models.merger) delete job.model;
      attempt.candidate={operationId,job,ref:`refs/heads/ralph/${runId}/${operationId}`};
      await saveIssueAttempt(store,initial,attempt);
      await createOwnedWorktree(store,planning.workspace,{operationId,kind:"candidate.workspace",status:"intent",job,ref:attempt.candidate.ref,expectedNew:base.commit});
      const result=await adapter.dispatchJob(job);
      assertCurrentAttempt(initial,await store.getRun(runId),attempt);
      if (result.outcome !== "completed") {attempt.error=result.error ?? {code:"missing-output",message:"Merger did not complete"}; throw new Error(attempt.error.message);}
      const output=mergeResult.parse(correlatedResult(job,result));
      attempt.mergerSessionId=result.sessionId;
      if (result.sessionId === submission.sessionId) throw new Error("Merger must use a separate session");
      if (output.kind === "behavior_conflict") {attempt.feedback=output.feedback; throw new Error("Merge requires behavior repair");}
      const found=await inspectWorktree(job.workspace);
      if (found.repositoryId !== store.repositoryId || found.branch !== attempt.candidate.ref || found.commit !== output.candidateCommit || (await gitOutput(job.workspace,["status","--porcelain","--untracked-files=all"])).trim()) throw new Error("Merger output must be clean and committed on the owned candidate branch");
      await gitOutput(job.workspace,["merge-base","--is-ancestor",base.commit,found.commit]);
      await gitOutput(job.workspace,["merge-base","--is-ancestor",submission.submittedCommit,found.commit]);
      attempt.candidate.commit=found.commit;
      await saveIssueAttempt(store,initial,attempt);
      const validationJob={...job,baseCommit:found.commit};
      attempt.validation=await validateCandidate({store,adapter,job:validationJob,config:config.commands,sourceWorkspace:planning.workspace});
      await saveIssueAttempt(store,initial,attempt);
      if (attempt.validation.status === "failed") throw new Error(attempt.validation.blocker ?? "Candidate validation failed");
      assertCurrentAttempt(initial,await store.getRun(runId),attempt);
      const advanced=await compareAndAdvanceRef(store,planning.workspace,{operationId:`advance-${operationId}`,kind:"integration.advance",status:"intent",job,ref:`refs/heads/${baseline.branch}`,expectedOld:base.commit,expectedNew:found.commit});
      if (!advanced) continue; // New base requires a new merger session and validation.
      attempt.status="integrated";
      attempt.integratedCommit=found.commit;
      await saveIssueAttempt(store,initial,attempt);
      for (const owned of [attempt.operationId,operationId]) {
        try {await removeOwnedWorktree(store,planning.workspace,owned);}
        catch (cause) {(attempt.cleanupErrors ??= []).push(String(cause));}
      }
      await saveIssueAttempt(store,initial,attempt);
      return attempt;
    }
    throw new Error("Integration kept changing; retained candidates require revalidation");
  } catch (cause) {
    if (attempt.status !== "integrated") attempt.status="failed";
    attempt.error ??= {code:"baseline-blocked",message:String(cause),cause:String(cause)};
    await saveIssueAttempt(store,initial,attempt).catch(()=>{});
  }
  return attempt;
}
