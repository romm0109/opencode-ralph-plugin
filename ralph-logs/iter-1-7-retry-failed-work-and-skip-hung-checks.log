export interface AttemptPolicy { maxAttempts: 3; }
export const attemptPolicy: AttemptPolicy = { maxAttempts: 3 };
export function beginAttempt(previous?: IssueAttempt): number {
  const number = (previous?.attempt ?? 0) + 1;
  if (number > attemptPolicy.maxAttempts) throw new Error("Issue attempt budget exhausted");
  return number;
}
export function exhaustIssue(attempt: IssueAttempt) { attempt.status = "exhausted"; }
export function failAttempt(attempt: IssueAttempt) {
  if (["permission-denied", "cancelled"].includes(attempt.error?.code ?? "")) { attempt.status = "waiting"; return; }
  if (attempt.attempt >= attemptPolicy.maxAttempts) exhaustIssue(attempt);
  else attempt.status = "failed";
}
export function repairContext(previous?: IssueAttempt) {
  if (!previous) return undefined;
  const { history: _history, ...evidence } = previous;
  return evidence;
}

