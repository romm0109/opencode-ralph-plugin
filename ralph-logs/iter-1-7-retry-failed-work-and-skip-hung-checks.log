          JSON.stringify({
            kind: "merged",
            candidateCommit: (
              await gitOutput(job.workspace, ["rev-parse", "HEAD"])
            ).trim(),
          }),
        );
      }
    }
    return dispatch(job);
  };
  return {
    project,
    store,
    adapter,
    fake,
    runId,
    issue,
    workspace,
    setMode: (value: string) => {
      mode = value;
    },
  };
}

