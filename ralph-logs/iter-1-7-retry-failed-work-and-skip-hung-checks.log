import { executeIssue } from \"../execution/execute-issue.js\";
import { integrateIssue } from \"../execution/integrate-issue.js\";

/** One issue budget; dependency scheduling is a separate boundary. */
export async function runIssue(store: RunStore, adapter: OpenCodeAdapter, runId: string, issueId: string) {
  for (;;) {
    let attempt = await executeIssue(store, adapter, runId, issueId);
    if (attempt.status === \"submitted\") attempt = await integrateIssue(store, adapter, runId, issueId);
    if (attempt.status "'!== "failed") return attempt;
    const run = await store.getRun(runId);
    if (run?.control && run.control.status !== "active") return attempt;
  }
}
