import { gitOutput, inspectWorktree } from \"../git/worktrees.js\";
import { terminateOwnedProcess } from \"../process/ownership.js\";
/** Retain failed work; verify its ownership and describe current saved facts. */
export async function reconcileAttempt(store: RunStore, adapter: OpenCodeAdapter, previous: IssueAttempt) {
  const run = await store.getRun(previous.job.runId);
  if ("'!run) throw new Error("Missing retry run");
  for (const entry of Object.values(run.jobs).filter((entry) =>
    entry.envelope.issueId === previous.issueId && entry.envelope.attempt === previous.attempt && entry.status !== "terminal")) {
    const cancelled = await adapter.cancelJob(entry.envelope);
    if (!cancelled.ok) throw new Error("Owned agent cancellation was not confirmed");
  }
  const work: { workspace: string; commit: string; branch: string; changes: string }[] = [];
  for (const operation of Object.values(run.operations).filter((op) => op.job.issueId === previous.issueId && op.job.attempt === previous.attempt)) {
    if (operation.ownedProcess && !(await terminateOwnedProcess(operation.ownedProcess)))
      throw new Error("Owned command cleanup was not confirmed");
    if (!["issue.workspace", "candidate.workspace"].includes(operation.kind) || operation.status !== "completed") continue;
    const found = await inspectWorktree(operation.job.workspace);
    if (found.repositoryId !== store.repositoryId || found.branch !== operation.ref)
      throw new Error("Retained retry workspace identity changed");
    work.push({ workspace: found.workspace, commit: found.commit, branch: found.branch,
      changes: await gitOutput(found.workspace, ["status", "--porcelain", "--untracked-files=all"]) });
  }
  return work;
}
