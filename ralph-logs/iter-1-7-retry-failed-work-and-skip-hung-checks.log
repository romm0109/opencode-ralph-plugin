            code: String(value.code),
            message: clean(value.message ?? "Spawn failed"),
          },
        });
    });
    child.once("error", (e: NodeJS.ErrnoException) =>
      end({
        ...base,
        status: "completed",
        exitCode: null,
        cause: {
          ...(e.code ? { code: e.code } : {}),
          message: clean(e.message),
        },
      }),
    );
    child.once("exit", () =>
      end({
        ...base,
        status: "completed",
        exitCode: null,
        cause: { message: "Owned wrapper exited before result collection" },
      }),
    );
  });
  if (child.pid) {
    const identity = await processIdentity(child.pid).catch(() => undefined);
    if (identity)
      owned = {
        pid: child.pid,
        startedAt: identity.startedAt,
        ownerToken,
        workspace: cwd,
        repositoryId: store.repositoryId,
      };
  }
  let result = await completion;
  result = {
    ...result,
    stdout: clean(stdout),
    stderr: clean(stderr),
    ...(owned ? { ownedProcess: owned } : {}),
  };
  if (!owned) {
    if (platform === "win32" && child.pid)
      await new Promise<void>((resolve) =>
        execFile("taskkill.exe", ["/PID", String(child.pid), "/T", "/F"], () =>
          resolve(),
        ),
      );
    else child.kill();
    result = {
      ...result,
      exitCode: null,
      cause: { message: "Process ownership could not be established" },
    };
  }
  if (
    owned &&
    (command.phase !== "start" ||
      result.status !== "completed" ||
      result.exitCode !== 0 ||
      signal?.aborted)
  ) {
    if (!(await terminateOwnedProcess(owned)))
      result.cleanupError = "Owned process cleanup failed";
    if (child.connected) child.disconnect();
  } else {
    child.unref();
    child.channel?.unref?.();
  }
  let recorded: boolean;
  try {
    recorded = await store.recordOperation({
      ...operation,
      status:
        result.status === "completed" &&
        result.exitCode === 0 &&
        !result.cleanupError
          ? "completed"
          : "failed",
      ...(owned ? { ownedProcess: owned } : {}),
    });
  } catch (error) {
    if (owned) await terminateOwnedProcess(owned);
    throw error;
  }
  if (!recorded) {
    if (owned) await terminateOwnedProcess(owned);
    return {
      ...result,
      status: "cancelled",
      cause: { message: "Stale completion" },
    };
  }
  return result;
}

