    f.adapter.authorizeCommand = async () => ({
      ok: false,
      error: { code: "permission-denied", message: "Denied fixture check" },
    });
    const result = await createCommandRouter(f.store, f.adapter).executeIssue(
      f.runId,
      "A",
    );
