import type { ExecutionEvidence, RunRecord } from \"../core/types.js\";
import { runIssue } from \"../core/orchestrator.js\";
import type { OpenCodeAdapter } from \"../opencode/adapter.js\";
import { validateIssueGraph } from \"../planning/graph.js\";
import type { RunStore } from \"../state/run-store.js\";
import { type AttemptOptions, type AttemptPolicy, attemptPolicy } from \"./attempts.js\";
import { integrationQueue } from \"./integration-queue.js\";

/** Pure readiness: a submission is never a dependency completion. */
export function reconcileReadiness(run: RunRecord, queue: string[] = [], policy: AttemptPolicy = attemptPolicy): ExecutionEvidence {
  const planning = run.planning;
  if ("'!planning?.graph || !planning.prd) throw new Error("Missing approved graph");
  const graph = validateIssueGraph(planning.graph.value, planning.graph.files, planning.prd);
  const states = new Map<string, ExecutionEvidence["issues"][number]>();
  function resolve(id: string): ExecutionEvidence["issues"][number] {
    const cached = states.get(id); if (cached) return cached;
    const issue = graph.issues.find((item) => item.id === id);
    if (!issue) throw new Error("Unknown dependency");
    const parents = issue.dependencies.map(resolve);
    const attempt = run.issueAttempts?.[id];
    const blockers = parents.filter((p) => ["blocked", "failed"].includes(p.status)).map((p) => p.id);
    let status: ExecutionEvidence["issues"][number]["status"];
    if (attempt?.status === "integrated") status = "integrated";
    else if (attempt?.status === "exhausted" || (attempt?.status === "failed" && attempt.attempt >= policy.maxAttempts)) status = "failed";
    else if (attempt?.status === "waiting" || blockers.length) status = "blocked";
    else if (attempt && ["submitted", "merging"].includes(attempt.status)) status = "integration_queued";
    else if (attempt?.status === "executing") status = "running";
    else status = parents.every((p) => p.status === "integrated") ? "ready" : "pending";
    const result = { id, title: issue.title, dependencies: issue.dependencies, status, blockers };
    states.set(id, result); return result;
  }
  const issues = graph.issues.map((issue) => resolve(issue.id));
  const checks: ExecutionEvidence["checks"] = Object.values(run.issueAttempts ?? {}).flatMap((attempt) => (attempt.validation?.checks ?? []).map((check) => ({ id: check.id, status: check.status, ...(check.reason ? {reason: check.reason} : {}), attempt: attempt.attempt, candidateCommit: attempt.validation?.candidateCommit ?? "", commandRevision: attempt.validation?.commandRevision ?? 0 })));
  return { issues, integrationQueue: queue, checks, verification: issues.some((i) => i.status === "failed" || i.status === "blocked") ? "failed" : issues.every((i) => i.status === "integrated") && !(run.validationSkips?.length) && !checks.some((c) => c.status === "skipped") ? "passed" : "incomplete" };
}
const active = new Map<string, Promise<RunRecord | undefined>>();
export function scheduleReadyIssues(store: RunStore, adapter: OpenCodeAdapter, runId: string, options: AttemptOptions = {}) {
  const key = `${store.repositoryId}:${runId}`;
  const existing = active.get(key); if (existing) return existing;
  const promise = schedule(store, adapter, runId, options).finally(() => { active.delete(key); });
  active.set(key, promise); return promise;
}
async function schedule(store: RunStore, adapter: OpenCodeAdapter, runId: string, options: AttemptOptions) {
  const initial = await store.getRun(runId);
  const concurrency = initial?.planning?.settings.concurrency ?? 2;
  if (!Number.isInteger(concurrency) || concurrency <= 0) throw new Error("Executor concurrency must be a positive integer");
  if (!initial?.baseline || !["passed", "passed_with_omissions"].includes(initial.baseline.status) || initial.planning?.phase !== "execution_approved") throw new Error("Validated baseline and approved graph required");
  const epoch = initial.control?.epoch ?? 0;
  const queue = integrationQueue(store, runId);
  const workers = new Map<string, Promise<void>>();
  let projection: Promise<unknown> = Promise.resolve();
  const publish = () => {
    const update = projection.then(async () => {
      for (;;) {
        const run = await store.getRun(runId);
        if (!run || (run.control && run.control.status !== "active") || (run.control?.epoch ?? 0) !== epoch || run.planning?.graph?.hash !== initial.planning?.graph?.hash) return;
        const evidence = reconcileReadiness(run, queue.positions);
        if (JSON.stringify(run.execution) === JSON.stringify(evidence)) return;
        if (await store.recordExecution(runId, run.revision, evidence)) return;
      }
    });
    projection = update.catch(() => {}); return update;
  };
  queue.listeners.add(publish);
  try {
    for (;;) {
      await publish();
      const run = await store.getRun(runId);
      if (!run || (run.control && run.control.status !== "active") || (run.control?.epoch ?? 0) !== epoch || run.planning?.graph?.hash !== initial.planning?.graph?.hash) break;
      const ready = reconcileReadiness(run, queue.positions).issues.filter((i) => i.status === "ready" || (i.status === "integration_queued" && !workers.has(i.id)));
      for (const issue of ready) {
        if (workers.size >= concurrency) break;
        if (workers.has(issue.id)) continue;
        const worker = runIssue(store, adapter, runId, issue.id, options).then(() => {}).finally(async () => { workers.delete(issue.id); await publish(); });
        workers.set(issue.id, worker);
      }
      if (!workers.size) break;
      await Promise.race(workers.values());
    }
    await Promise.all(workers.values());
    await publish();
    return store.getRun(runId);
  } finally { queue.listeners.delete(publish); }
}
