      f.runId,
      "A",
      { clock: time.clock },
    );
    for (let attempt = 1; attempt <= 3; attempt++) {
      await eventually(async () => {
        const stored = (await f.store.getRun(f.runId))?.issueAttempts?.A;
        return (
          stored?.attempt === attempt &&
          !!stored.candidate &&
          (await Bun.file(
            join(stored.candidate.job.workspace, "hung-ready"),
