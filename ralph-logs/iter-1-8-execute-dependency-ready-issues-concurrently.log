      await assertDispatchAllowed(store, job.runId);
      return adapter.dispatchJob(job);
    },
    async status(runId?: string): Promise<string> {
      const projectSetup = workspace
        ? await projectStatus(workspace)
        : undefined;
      const run = runId
        ? await store.getRun(runId)
        : (await store.listRuns()).at(-1);
      return run
        ? JSON.stringify(
            {
              ...(dashboardUrl ? { dashboardUrl } : {}),
              ...(projectSetup ? { projectSetup } : {}),
              runId: run.runId,
              revision: run.revision,
              phase: run.phase,
              control: run.control ?? null,
              lastResult: run.lastResult ?? null,
              ...(run.review ? { review: run.review } : {}),
              ...(run.reviewWorkflow
                ? { reviewWorkflow: run.reviewWorkflow }
                : {}),
              ...(run.planning ? { planning: run.planning } : {}),
              ...(run.baseline
                ? {
                    baseline: run.baseline,
                    validationSkips: run.validationSkips ?? [],
                  }
                : {}),
              issueAttempts: run.issueAttempts ?? {},
              errors: run.errors,
            },
            null,
            2,
          )
        : dashboardUrl
          ? JSON.stringify({
              dashboardUrl,
              ...(projectSetup ? { projectSetup } : {}),
              message: "No Ralph run found.",
            })
          : projectSetup
            ? JSON.stringify({ projectSetup, message: "No Ralph run found." })
            : "No Ralph run found.";
    },
    async dispatch(command: string, args = "", context?: ProjectSetupOptions) {
      if (command === "ralph-orchestrator") {
        if (!context)
          throw new Error(
            "Feature planning requires the main session and workspace",
          );
        if (!adapter) throw new Error("No OpenCode adapter supplied");
        return JSON.stringify(
          await orchestrateFeature({
            ...context,
            feature: args,
            store,
            adapter,
          }),
          null,
          2,
        );
      }
      if (command === "ralph-commands") {
        if (!context)
          throw new Error(
            "Project setup requires the main session and workspace",
          );
        return JSON.stringify(await this.setupProject(context), null, 2);
      }
      if (["ralph-pause", "ralph-resume", "ralph-stop"].includes(command)) {
        const runId = args.trim() || (await store.listRuns()).at(-1)?.runId;
        if (!runId) throw new Error("No Ralph run found");
        return handleControlCommand(
          command as "ralph-pause" | "ralph-resume" | "ralph-stop",
          runId,
          store,
          adapter,
        );
      }
      if (command !== "ralph-status")
        throw new Error(`Unknown Ralph command: ${command}`);
      return this.status(args.trim() || undefined);
    },
  };
}
import type { JobEnvelope, JobResult } from "../core/types.js";
import { gitOutput, inspectWorktree } from "../git/worktrees.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { terminateOwnedProcess } from "../process/ownership.js";
import type { RunStore } from "../state/run-store.js";
import type { IssueAttempt } from "./execute-issue.js";

export interface AttemptPolicy {
  maxAttempts: 3;
}
export const attemptPolicy: Readonly<AttemptPolicy> = Object.freeze({
  maxAttempts: 3,
});
export function beginAttempt(previous?: IssueAttempt): number {
  const number = (previous?.attempt ?? 0) + 1;
  if (number > attemptPolicy.maxAttempts)
    throw new Error("Issue attempt budget exhausted");
  return number;
}
export function exhaustIssue(attempt: IssueAttempt) {
  attempt.status = "exhausted";
}
export function failAttempt(attempt: IssueAttempt) {
  if (["permission-denied", "cancelled"].includes(attempt.error?.code ?? "")) {
    attempt.status = "waiting";
    return;
  }
  if (attempt.attempt >= attemptPolicy.maxAttempts) exhaustIssue(attempt);
  else attempt.status = "failed";
}
export function repairContext(previous?: IssueAttempt) {
  if (!previous) return undefined;
  const { history: _history, ...evidence } = previous;
  return evidence;
}

export interface Clock {
  schedule(ms: number, callback: () => void): () => void;
}
export const systemClock: Clock = {
  schedule(ms, callback) {
    const timer = setTimeout(callback, ms);
    return () => clearTimeout(timer);
  },
};
export interface AttemptOptions {
  clock?: Clock;
}
/** Cancellation is acknowledged before the caller can allocate a repair. */
export async function dispatchAttempt(
  store: RunStore,
  adapter: OpenCodeAdapter,
  job: JobEnvelope,
  timeoutMs: number,
  options: AttemptOptions,
): Promise<JobResult> {
  const clock = options.clock ?? systemClock;
  const timeout = Symbol("deadline");
  let dispose = () => {};
  const deadline = new Promise<typeof timeout>((resolve) => {
    dispose = clock.schedule(timeoutMs, () => resolve(timeout));
  });
  try {
    const result = await Promise.race([adapter.dispatchJob(job), deadline]);
    if (result !== timeout) return result;
    const entry = (await store.getRun(job.runId))?.jobs[job.jobId];
    const cancelled = entry
      ? await adapter.cancelJob(entry.envelope)
      : { ok: false };
    return {
      ...(entry?.envelope ?? job),
      outcome: "failed",
      evidence: [`${job.role} deadline ${timeoutMs}ms exceeded`],
      error: {
        code: cancelled.ok ? "agent-timeout" : "cancelled",
        message: cancelled.ok
          ? `${job.role} deadline exceeded (${timeoutMs}ms); owned job cancelled`
          : "Agent deadline exceeded; cancellation was not confirmed. Intervention required",
      },
    };
  } catch (cause) {
    const entry = (await store.getRun(job.runId))?.jobs[job.jobId];
    if (entry && entry.status !== "terminal") {
      const cancelled = await adapter.cancelJob(entry.envelope);
      if (!cancelled.ok)
        return {
          ...entry.envelope,
          outcome: "cancelled",
          evidence: [],
          error: {
            code: "cancelled",
            message:
              "Dispatch failed and owned agent cancellation was not confirmed",
            cause: String(cause),
          },
        };
    }
    throw cause;
  } finally {
    dispose();
  }
}

/** Retain failed work; verify its ownership and describe current saved facts. */
export async function reconcileAttempt(
  store: RunStore,
  adapter: OpenCodeAdapter,
  previous: IssueAttempt,
) {
  const run = await store.getRun(previous.job.runId);
  if (!run) throw new Error("Missing retry run");
  for (const entry of Object.values(run.jobs).filter(
    (entry) =>
      entry.envelope.issueId === previous.issueId &&
      entry.envelope.attempt === previous.attempt &&
      entry.status !== "terminal",
  )) {
    const cancelled = await adapter.cancelJob(entry.envelope);
    if (!cancelled.ok)
      throw new Error("Owned agent cancellation was not confirmed");
  }
  const work: {
    workspace: string;
    commit: string;
    branch: string;
    changes: string;
  }[] = [];
  for (const operation of Object.values(run.operations).filter(
    (op) =>
      op.job.issueId === previous.issueId &&
      op.job.attempt === previous.attempt,
  )) {
    if (
      operation.ownedProcess &&
      !(await terminateOwnedProcess(operation.ownedProcess))
    )
      throw new Error("Owned command cleanup was not confirmed");
    if (
      !["issue.workspace", "candidate.workspace"].includes(operation.kind) ||
      operation.status !== "completed"
    )
      continue;
    const found = await inspectWorktree(operation.job.workspace);
    if (
      found.repositoryId !== store.repositoryId ||
      found.branch !== operation.ref
    )
      throw new Error("Retained retry workspace identity changed");
    work.push({
      workspace: found.workspace,
      commit: found.commit,
      branch: found.branch,
      changes: await gitOutput(found.workspace, [
        "status",
        "--porcelain",
        "--untracked-files=all",
      ]),
    });
  }
  return work;
}
import { z } from "zod";

const strings = z.array(z.string().trim().min(1)).min(1);
export const artifactRevision = z
  .object({
    revision: z.number().int().positive(),
    hash: z.string().regex(/^[a-f0-9]{64}$/),
    artifactPath: z.string().min(1),
  })
  .strict();
const issue = z
  .object({
    id: z.string().regex(/^[A-Za-z0-9_-]+$/),
    title: z.string().trim().min(1),
    artifactPath: z.string().regex(/^issues\/[A-Za-z0-9_-]+\.md$/),
    dependencies: z.array(z.string().min(1)),
    acceptanceCriteria: strings,
    testableBehaviors: strings,
  })
  .strict();
const graph = z
  .object({
    schemaVersion: z.literal(1),
    prdRevision: artifactRevision,
    issues: z.array(issue).min(1),
  })
  .strict();
export type IssueSpec = z.infer<typeof issue>;
export type IssueGraph = z.infer<typeof graph>;
export function topologicalOrder(value: IssueGraph): string[] {
  const issues = new Map(value.issues.map((item) => [item.id, item]));
  if (issues.size !== value.issues.length)
    throw new Error("Duplicate issue IDs");
  const visited = new Set<string>();
  const visiting = new Set<string>();
  const order: string[] = [];
  function visit(id: string) {
    if (visiting.has(id)) throw new Error("Issue graph contains a cycle");
    if (visited.has(id)) return;
    const item = issues.get(id);
    if (!item) throw new Error(`Unknown dependency ${id}`);
    visiting.add(id);
    for (const dependency of item.dependencies) visit(dependency);
    visiting.delete(id);
    visited.add(id);
    order.push(id);
  }
  for (const item of value.issues) visit(item.id);
  return order;
}
export function validateIssueGraph(
  raw: unknown,
  files: Record<string, string>,
  prd: z.infer<typeof artifactRevision>,
): IssueGraph {
  const value = graph.parse(raw);
  if (
    JSON.stringify(value.prdRevision) !==
    JSON.stringify(artifactRevision.parse(prd))
  )
    throw new Error("Issue graph references a different PRD revision");
  const paths = new Set<string>();
  for (const item of value.issues) {
    if (paths.has(item.artifactPath))
      throw new Error("Duplicate issue artifact path");
    paths.add(item.artifactPath);
    const text = files[item.artifactPath];
    if (!text?.trim())
      throw new Error(`Missing issue file ${item.artifactPath}`);
    for (const heading of [
      "Context",
      "Implementation",
      "Tests",
      "Acceptance criteria",
      "Dependencies",
    ])
      if (!text.toLowerCase().includes(`## ${heading.toLowerCase()}`))
        throw new Error(`Issue ${item.id} missing ${heading}`);
  }
  if (Object.keys(files).some((path) => !paths.has(path)))
    throw new Error("Invalid issue file reference");
  topologicalOrder(value);
  return value;
}

