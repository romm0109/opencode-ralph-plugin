export interface ProjectSetupOptions {
  workspace: string;
  sessionId: string;
}
export interface ProjectSetupStatus {
  status: "rejected" | "not-ready" | "verified";
  hash?: string;
  revision?: number;
  platform?: string;
  reason?: string;
  results?: CommandResult[];
  cleanupError?: string;
}
async function performSetup(
  options: ProjectSetupOptions & { store: RunStore; adapter: OpenCodeAdapter },
): Promise<ProjectSetupStatus> {
  const { store, adapter, workspace, sessionId } = options;
  const runId = `setup-${randomUUID()}`;
  await store.createRun(runId);
  const previous = await readFile(
    join(workspace, ".ralph/commands.json"),
    "utf8",
  ).catch((e) => {
    if (e.code === "ENOENT") return undefined;
    throw e;
  });
  const revision = previous
    ? parseCommandConfig(JSON.parse(previous)).revision + 1
    : 1;
  const instructions = await readFile(
    new URL("../../skills/command-discovery/SKILL.md", import.meta.url),
    "utf8",
  );
  const job = {
    runId,
    jobId: "command-discovery",
    attempt: 1,
    role: "command-discovery",
    workspace: await realpath(workspace),
    inputRevisions: { commands: revision },
    baseCommit: "",
    readOnly: true,
    prompt: `${instructions}\nExplore this repository using read-only tools. Return ONLY a complete JSON command configuration: schemaVersion:1, revision:${revision}, rationale, commands with id, phase(setup/check/start/readiness/cleanup), executable, args array, cwd relative to workspace, timeoutMs, platforms(darwin/linux/win32), env mapping target variable names to source variable names; optional explicit shell. Explain absent scripts honestly in rationale, unsupported platforms in unsupportedPlatforms. Require a check per supported platform; order lifecycle phases. Never execute commands, write files, or include secret values. This proposal is not approval.`,
  };
  const result = await adapter.dispatchJob(job);
  if (result.outcome !== "completed" || !result.text)
    return {
      status: "not-ready",
