test("issue agents default to a visible thirty-minute deadline", async () => {
  const f = await singleIssueFixture();
  try {
    const run = required(await f.store.getRun(f.runId));
    const planning = required(run.planning);
    delete planning.settings.agentTimeoutMs;
    await f.store.recordPlanning(f.runId, run.revision, planning);
    const router = createCommandRouter(f.store, f.adapter);
    const result = await router.executeIssue(f.runId, "A");
    expect(result.agentTimeoutMs).toBe(1800000);
    expect(
      JSON.parse(await router.status(f.runId)).issueAttempts.A.agentTimeoutMs,
    ).toBe(1800000);
  } finally {
    await f.project.cleanup();
  }
});

test("duplicate agent failure results do not charge additional attempts", async () => {
  const f = await singleIssueFixture();
  try {
    const dispatch = f.adapter.dispatchJob.bind(f.adapter);
    let calls = 0;
    f.adapter.dispatchJob = async (job) => {
      calls++;
      f.fake.empty();
      const result = await dispatch(job);
      expect(await f.store.recordResult(result)).toBe(false);
      expect(await f.store.recordResult(result)).toBe(false);
      return result;
    };
    const router = createCommandRouter(f.store, f.adapter);
    const result = await router.executeIssue(f.runId, "A");
    expect(result.status).toBe("exhausted");
    expect(calls).toBe(3);
    expect((await f.store.getRun(f.runId))?.phase).toBe("running");
    await router.executeIssue(f.runId, "A");
    expect(calls).toBe(3);
  } finally {
    await f.project.cleanup();
  }
});
import { execFile, spawn } from "node:child_process";
import { randomUUID } from "node:crypto";
import { readFile, realpath } from "node:fs/promises";
import { isAbsolute, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import {
  type ApprovedCommandConfig,
  type CommandSpec,
  commandConfigHash,
  parseCommandConfig,
} from "../config/commands.js";
import type { JobEnvelope } from "../core/types.js";
import { type Clock, systemClock } from "../execution/attempts.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { runtimeSecretValues, sanitizeDisplay } from "../state/sanitize.js";
import {
  type OwnedProcess,
  processIdentity,
  terminateOwnedProcess,
} from "./ownership.js";

export interface CommandResult {
  status:
    | "completed"
    | "timed_out"
    | "cancelled"
    | "permission_denied"
    | "setup_failed"
    | "spawn_error";
  commandId: string;
  exitCode?: number | null;
  stdout: string;
  stderr: string;
  cause?: { code?: string; message: string };
  ownedProcess?: OwnedProcess;
  cleanupError?: string;
}
export interface CommandContext {
  store: RunStore;
  adapter: OpenCodeAdapter;
  job: JobEnvelope;
  config: ApprovedCommandConfig;
  signal?: AbortSignal | undefined;
  clock?: Clock;
  sourceWorkspace?: string;
}
export async function runCommand(
  command: CommandSpec,
  context: CommandContext,
): Promise<CommandResult> {
  const { store, adapter, job, config, signal } = context;
  const hash = commandConfigHash(config);
  const base = { commandId: command.id, stdout: "", stderr: "" };
  if (signal?.aborted) return { ...base, status: "cancelled" };
  const platform = process.platform;
  const secrets = [
    ...runtimeSecretValues(),
    ...Object.values(command.env).map((name) => process.env[name] ?? ""),
  ].filter(Boolean);
  const clean = (s: string) => sanitizeDisplay(s, secrets);
  let permission: Awaited<
    ReturnType<NonNullable<OpenCodeAdapter["authorizeCommand"]>>
  >;
  try {
    permission = (await adapter.authorizeCommand?.({ job, command, hash })) ?? {
      ok: false,
    };
  } catch (error) {
    permission = {
      ok: false,
      error: { code: "permission-denied", message: clean(String(error)) },
    };
  }
  if (!permission.ok)
    return {
      ...base,
      status: "permission_denied",
      cause: {
        message: clean(
          permission.error?.message ??
            "Host command execution permission is unavailable",
        ),
      },
    };
  let cwd: string;
  const env: NodeJS.ProcessEnv = {};
  // Keep only portable system variables and explicitly approved references.
  for (const name of [
    "PATH",
    "Path",
    "PATHEXT",
    "SystemRoot",
    "WINDIR",
    "TEMP",
    "TMP",
    "TMPDIR",
    "HOME",
    "USERPROFILE",
  ])
    if (process.env[name]) env[name] = process.env[name];
  try {
    const saved = parseCommandConfig(
      JSON.parse(
        await readFile(
          join(
            context.sourceWorkspace ?? job.workspace,
            ".ralph/commands.json",
          ),
          "utf8",
        ),
      ),
    );
    if (
      commandConfigHash(saved) !== hash ||
      !config.commands.some(
        (c) => JSON.stringify(c) === JSON.stringify(command),
      )
    )
      throw new Error("Command is not in the saved approved revision");
    if (!command.platforms.some((p) => p === platform))
      throw new Error(`Command unsupported on ${platform}`);
    const root = await realpath(job.workspace);
    cwd = await realpath(resolve(root, command.cwd));
    const location = relative(root, cwd);
    if (
      isAbsolute(location) ||
      location === ".." ||
      location.startsWith(`..${process.platform === "win32" ? "\\" : "/"}`)
    )
      throw new Error("Command cwd escapes workspace");
    for (const [target, source] of Object.entries(command.env)) {
      if (process.env[source] === undefined)
        throw new Error(`Missing environment reference ${source}`);
      env[target] = process.env[source];
    }
  } catch (error) {
    return {
      ...base,
      status: "setup_failed",
      exitCode: null,
      cause: { message: clean(String(error)) },
    };
  }
  const parent = await processIdentity(process.pid).catch(() => undefined);
  if (!parent)
    return {
      ...base,
      status: "cancelled",
      cause: { message: "Parent identity unavailable" },
    };
  const ownerToken = randomUUID();
  const operation = {
    operationId: `command-${ownerToken}`,
    kind: "process.spawn" as const,
    job: { ...job, workspace: cwd },
    status: "intent" as const,
  };
  if (!(await store.recordOperation(operation)))
    return {
      ...base,
      status: "cancelled",
      cause: { message: "Stale operation" },
    };
  const control = (await store.getRun(job.runId))?.control;
  if (control && control.status !== "active")
    return { ...base, status: "cancelled" };
  const child = spawn(
    process.execPath,
    [
      fileURLToPath(
        new URL(
          import.meta.url.endsWith(".ts")
            ? "./command-child.ts"
            : "./command-child.js",
          import.meta.url,
        ),
      ),
      String(process.pid),
      parent.startedAt,
      ownerToken,
