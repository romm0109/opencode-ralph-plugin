import type { RunControl } from "../core/types.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { disposeRunEnvironments } from "../process/environment.js";
import { terminateOwnedProcess } from "../process/ownership.js";
import type { RunStore } from "../state/run-store.js";

export async function assertDispatchAllowed(store: RunStore, runId: string) {
  const run = await store.getRun(runId);
  if (run?.control && run.control.status !== "active")
    throw new Error(
      `Run ${runId} is ${run.control.status}; explicit resume required`,
    );
}
/** In-flight work settles; the next scheduling boundary waits for human resume. */
export async function waitForDispatch(store: RunStore, runId: string) {
  while ((await store.getRun(runId))?.control?.status === "paused")
    await new Promise((resolve) => setTimeout(resolve, 20));
  await assertDispatchAllowed(store, runId);
}
export async function handleControlCommand(
  command: "ralph-pause" | "ralph-resume" | "ralph-stop",
  runId: string,
  store: RunStore,
  adapter?: OpenCodeAdapter,
  options: {
    source?: RunControl["source"];
    cleanup?: () => Promise<void>;
    timeoutMs?: number;
  } = {},
) {
  const run = await store.getRun(runId);
  if (!run) throw new Error("Unknown run");
  if (run.control?.cleanupPending)
    throw new Error("Stop cleanup is pending; wait or reconcile after restart");
  if (
    command === "ralph-pause" &&
    run.control &&
    !["active", "paused"].includes(run.control.status)
  )
    throw new Error(`Run is ${run.control.status}; reconcile or resume first`);
  if (
    command === "ralph-resume" &&
    run.control?.status === "stopped" &&
    run.control.facts?.length
  )
    throw new Error("Stop cleanup uncertain; recovery reconciliation required");
  if (command === "ralph-resume" && run.control?.status === "blocked")
    throw new Error(`Recovery blocked: ${run.control.facts?.join("; ")}`);
  const status =
    command === "ralph-pause"
      ? "paused"
      : command === "ralph-stop"
        ? "stopped"
        : "active";
  // Stopping resources does not resolve an ambiguous recovery or prior cleanup.
  const retainedFacts =
    command === "ralph-stop" &&
    ["blocked", "stopped"].includes(run.control?.status ?? "")
      ? (run.control?.facts ?? [])
      : [];
  if (
    !(await store.recordControl(
      runId,
      {
        status,
        source: options.source ?? "human",
        facts: retainedFacts,
        ...(command === "ralph-stop" ? { cleanupPending: true } : {}),
      },
      run.revision,
    ))
  )
    throw new Error("Control state changed; retry command");
  if (command === "ralph-stop") {
    const current = await store.getRun(runId);
    const cleanup = Promise.allSettled([
      disposeRunEnvironments(runId, [
        ...Object.values(current?.jobs ?? {}).map(
          (job) => job.envelope.workspace,
        ),
        ...Object.values(current?.operations ?? {}).map(
          (op) => op.job.workspace,
        ),
      ]),
      ...Object.values(current?.jobs ?? {})
        .filter((job) => job.status !== "terminal")
        .map(async ({ envelope }) => {
          if (adapter) {
            const result = await adapter.cancelJob(envelope);
            if (!result.ok)
              throw new Error(result.error?.message ?? "Cancellation failed");
          } else {
            await store.recordResult({
              ...envelope,
              outcome: "cancelled",
              evidence: [],
              error: { code: "cancelled", message: "Stop requested" },
            });
          }
        }),
      ...Object.values(current?.operations ?? {})
        .filter((op) => op.ownedProcess)
        .map(async (op) => {
          if (
            op.ownedProcess &&
            !(await terminateOwnedProcess(op.ownedProcess))
          )
            throw new Error(
              `Process ownership/cleanup uncertain: ${op.operationId}`,
            );
        }),
      ...(options.cleanup ? [options.cleanup()] : []),
    ]);
    let timer: ReturnType<typeof setTimeout> | undefined;
    try {
      const settled = await Promise.race([
        cleanup,
        new Promise<undefined>((resolve) => {
          timer = setTimeout(
            () => resolve(undefined),
            options.timeoutMs ?? 2000,
          );
        }),
      ]);
      const facts =
        settled === undefined
          ? [
              "Cleanup deadline reached; retained resources require reconciliation",
            ]
          : settled
              .filter((r) => r.status === "rejected")
              .map((r) => String(r.reason));
      const afterCleanup = await store.getRun(runId);
      if (afterCleanup?.control?.status !== "stopped")
        throw new Error(
          "Control changed during cleanup; reconciliation required",
        );
      await store.recordControl(
        runId,
        {
          status: "stopped",
          source: options.source ?? "human",
          facts: [...new Set([...retainedFacts, ...facts])],
        },
        afterCleanup.revision,
      );
    } finally {
      clearTimeout(timer);
    }
  }
  return JSON.stringify((await store.getRun(runId))?.control);
}
import { randomUUID } from "node:crypto";
import { mkdir, readFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { assertProjectReady } from "../commands/project-setup.js";
import { commandConfigHash } from "../config/commands.js";
import { loadProjectConfig } from "../config/project.js";
import type { Failure, JobEnvelope, RunOperation } from "../core/types.js";
import { verifyReviewRepository } from "../git/review-workspace.js";
import {
  createOwnedWorktree,
  gitOutput,
  removeOwnedWorktree,
} from "../git/worktrees.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { artifactHash, issueBundleHash } from "../planning/artifacts.js";
import { validateIssueGraph } from "../planning/graph.js";
import type { RunStore } from "../state/run-store.js";
import { type ValidationSummary, validateCandidate } from "./validation.js";

export interface BaselineState {
  status: "preparing" | "passed" | "passed_with_omissions" | "failed";
  operationId: string;
  candidateCommit: string;
  commandHash: string;
  commandRevision: number;
  approvalRequestId?: string;
  branch?: string;
  workspace?: string;
  blocker?: string;
  error?: Failure;
  validation?: ValidationSummary;
}
export async function preflightRun(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  const initial = await store.getRun(runId);
  const state = initial?.planning;
  if (!initial || !state) throw new Error("Unknown planning run");
  if (initial.baseline?.status === "preparing") return initial;
  const epoch = initial.control?.epoch ?? 0;
  const baseline: BaselineState = {
    status: "preparing",
    operationId: `baseline-${randomUUID()}`,
    candidateCommit: state.executionApproval?.selectedCommit ?? "",
    commandHash: state.commandHash,
    commandRevision: 0,
    ...(state.executionApproval
      ? { approvalRequestId: state.executionApproval.requestId }
      : {}),
  };
  async function save(expectedRevision?: number) {
    const run = await store.getRun(runId);
    if (
      !run ||
      (run.baseline?.operationId !== initial?.baseline?.operationId &&
        run.baseline?.operationId !== baseline.operationId) ||
      (run.control?.epoch ?? 0) !== epoch ||
      run.planning?.executionApproval?.requestId !==
        state?.executionApproval?.requestId ||
      !(await store.recordBaseline(
        runId,
        expectedRevision ?? run.revision,
        baseline,
        baseline.validation?.skippedCheckIds ?? [],
      ))
    )
      throw new Error("Stale baseline transition");
  }
  let owned: RunOperation | undefined;
  try {
    if (initial.control && initial.control.status !== "active") return initial;
    if (
      state.phase !== "execution_approved" ||
      !state.prd ||
      !state.graph ||
      !state.executionApproval ||
      state.executionApproval.prdHash !== state.prd.hash ||
      state.executionApproval.graphHash !== state.graph.hash ||
      state.executionApproval.revision !== state.graph.revision ||
      !baseline.candidateCommit ||
      state.selectedCommit !== baseline.candidateCommit
    )
      throw new Error(
        "Matching execution approval and selected commit are required",
      );
    await verifyReviewRepository(state.workspace, store.repositoryId);
    const lock = JSON.parse(
      await readFile(join(store.root, "active-run.lock/owner.json"), "utf8"),
    );
    if (lock.runId !== runId || lock.repositoryId !== store.repositoryId)
      throw new Error("Repository lock belongs to another run");
    await assertProjectReady(state.workspace);
    const config = await loadProjectConfig(state.workspace);
    baseline.commandRevision = config.commands.revision;
    if (commandConfigHash(config.commands) !== state.commandHash)
      throw new Error("Approved command configuration changed");
    validateIssueGraph(state.graph.value, state.graph.files, state.prd);
    const graph = JSON.parse(
      await readFile(join(state.workspace, state.graph.artifactPath), "utf8"),
    );
    const files: Record<string, string> = {};
    for (const path of Object.keys(state.graph.files))
      files[path] = await readFile(
        join(state.workspace, dirname(state.graph.artifactPath), path),
        "utf8",
      );
    if (
      artifactHash(
        await readFile(join(state.workspace, state.prd.artifactPath), "utf8"),
      ) !== state.prd.hash ||
      issueBundleHash(graph, files) !== state.graph.hash
    )
      throw new Error("Approved planning artifacts changed");
    try {
      await gitOutput(state.workspace, [
        "rev-parse",
        "--verify",
        "HEAD^{commit}",
      ]);
    } catch (cause) {
      throw new Error(
        "Repository HEAD is unborn or invalid; create a commit before execution",
        { cause },
      );
    }
    if (
      !/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/.test(baseline.candidateCommit) ||
      (
        await gitOutput(state.workspace, [
          "rev-parse",
          "--verify",
          `${baseline.candidateCommit}^{commit}`,
        ])
      ).trim() !== baseline.candidateCommit
    )
      throw new Error(
        "Selected starting commit is invalid; select and approve a committed starting point",
      );
    if (
      (
        await gitOutput(state.workspace, [
          "status",
          "--porcelain",
          "--untracked-files=all",
        ])
      ).trim()
    )
      throw new Error(
        "Checkout is dirty; commit or remove tracked and relevant untracked changes before execution",
      );
    if (
      initial.baseline &&
      ["passed", "passed_with_omissions"].includes(initial.baseline.status) &&
      initial.baseline.candidateCommit === baseline.candidateCommit &&
      initial.baseline.commandHash === baseline.commandHash &&
      initial.baseline.approvalRequestId === state.executionApproval.requestId
    )
      return initial;
    baseline.branch = `ralph/${runId}`;
    baseline.workspace = join(store.root, "worktrees", runId);
    if (
      (
        await gitOutput(state.workspace, [
          "for-each-ref",
          "--format=%(refname)",
          `refs/heads/${baseline.branch}`,
        ])
      ).trim()
    )
      throw new Error(
        `Branch ${baseline.branch} already exists; inspect it and select a new feature ID`,
      );
    await save(initial.revision);
    await mkdir(dirname(baseline.workspace), { recursive: true });
    const job: JobEnvelope = {
      runId,
      jobId: baseline.operationId,
      role: "baseline",
      attempt: 0,
      workspace: baseline.workspace,
      baseCommit: baseline.candidateCommit,
      inputRevisions: {
        commands: config.commands.revision,
        approval: state.executionApproval.revision,
      },
      prompt: "Validate approved feature baseline",
    };
    owned = {
      operationId: baseline.operationId,
      kind: "baseline.workspace",
      status: "intent",
      job,
      ref: `refs/heads/${baseline.branch}`,
      expectedOld: baseline.candidateCommit,
      expectedNew: baseline.candidateCommit,
    };
    await createOwnedWorktree(store, state.workspace, owned);
    baseline.validation = await validateCandidate({
      store,
      adapter,
      job,
      config: config.commands,
      sourceWorkspace: state.workspace,
    });
    baseline.status = baseline.validation.status;
    if (baseline.validation.blocker) {
      baseline.blocker = baseline.validation.blocker;
      baseline.error = {
        code: "baseline-blocked",
        message: baseline.validation.blocker,
        cause: baseline.validation.blocker,
      };
    }
    if (baseline.status === "failed")
      await removeOwnedWorktree(store, state.workspace, owned.operationId);
    await save();
  } catch (cause) {
    baseline.status = "failed";
    baseline.blocker = String(cause);
    baseline.error = {
      code: "baseline-blocked",
      message: String(cause),
      cause: String(cause),
    };
    if (
      owned &&
      (await store.getRun(runId))?.operations[owned.operationId]?.status ===
        "completed"
    ) {
      try {
        await removeOwnedWorktree(store, state.workspace, owned.operationId);
      } catch (cleanup) {
        baseline.blocker += `; cleanup: ${String(cleanup)}`;
      }
    }
    await save().catch(() => {});
  }
  const latest = await store.getRun(runId);
  if (latest?.baseline?.operationId === baseline.operationId)
    await adapter.publishStatus(
      state.sessionId,
      state.workspace,
      JSON.stringify(latest.baseline),
    );
  return latest;
}

