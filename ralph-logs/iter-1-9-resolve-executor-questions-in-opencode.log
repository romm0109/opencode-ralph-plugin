    expect(
      f.jobs
        .filter((j) => j.role === "executor")
        .map((j) => j.issueId)
        .slice(2),
    ).toEqual(["B"]);
    e.release();
    await until(() =>
      f.jobs.some((j) => j.issueId === "C" && j.role === "executor"),
