test("an unrelated journal update cannot turn a timed-out check into an issue repair", async () => {
  const f = await fixture();
  const time = controllableClock();
  await approveCommands(
    f,
    parseCommandConfig({
      ...f.config,
      commands: [
        {
          ...required(f.config.commands[0]),
          id: "hung",
          args: [
            "-e",
            'require("fs").writeFileSync("hung-ready","ready");setInterval(()=>{},1000)',
          ],
        },
        {
          ...required(f.config.commands[0]),
          id: "cleanup",
          phase: "cleanup",
          args: ["-e", 'require("fs").rmSync("hung-ready",{force:true})'],
        },
      ],
    }),
  );
  const e = gate();
  f.holds.set("E", e);
  const record = f.store.recordBaseline.bind(f.store);
  let raced = false;
  f.store.recordBaseline = async (...args) => {
    if (!raced) {
      raced = true;
      await f.store.recordControl(f.runId, {
        status: "active",
        source: "human",
      });
    }
    return record(...args);
  };
  const pending = f.router.scheduleIssues(f.runId, { clock: time.clock });
  try {
    await until(async () => {
      const candidate = (await f.store.getRun(f.runId))?.issueAttempts?.A
        ?.candidate;
      return (
        !!candidate &&
        (await Bun.file(join(candidate.job.workspace, "hung-ready")).exists())
      );
    });
    time.advance(5000);
    await until(async () => {
      const attempt = (await f.store.getRun(f.runId))?.issueAttempts?.A;
      return (
        !!attempt && (attempt.attempt !== 1 || attempt.status === "integrated")
      );
    });
    const attempt = required((await f.store.getRun(f.runId))?.issueAttempts?.A);
    expect(attempt.history?.[0]?.error).toBeUndefined();
    expect(attempt.status).toBe("integrated");
    expect(attempt.attempt).toBe(1);
    e.release();
    const run = required(await pending);
    expect(run.validationSkips).toEqual(["hung"]);
    expect(run.execution?.issues.every((i) => i.status === "integrated")).toBe(
      true,
    );
    expect(run.execution?.verification).toBe("incomplete");
  } finally {
    e.release();
    time.advance(5000);
    await f.router.dispatch("ralph-stop", f.runId);
    await pending;
    await f.project.cleanup();
  }
}, 30000);

test("single-issue calls share the configured executor cap", async () => {
  const f = await fixture();
  const initial = required(await f.store.getRun(f.runId));
  const planning = required(initial.planning);
  planning.settings.concurrency = 1;
  await f.store.recordPlanning(f.runId, initial.revision, planning);
  const a = gate(),
    e = gate();
  f.holds.set("A", a);
  f.holds.set("E", e);
  const dispatch = f.adapter.dispatchJob.bind(f.adapter);
  let active = 0,
    maximum = 0;
  f.adapter.dispatchJob = async (job) => {
    if (job.role !== "executor") return dispatch(job);
    active++;
    maximum = Math.max(maximum, active);
    try {
      return await dispatch(job);
    } finally {
      active--;
    }
  };
  const first = f.router.executeIssue(f.runId, "A");
  await until(() => f.jobs.some((j) => j.issueId === "A"));
  const second = f.router.executeIssue(f.runId, "E");
  try {
    await Bun.sleep(500);
    a.release();
    await until(() => f.jobs.some((j) => j.issueId === "E"));
    e.release();
    await Promise.all([first, second]);
    expect(maximum).toBe(1);
    expect((await f.store.getRun(f.runId))?.issueAttempts?.E?.status).toBe(
      "integrated",
    );
  } finally {
    a.release();
    e.release();
    await Promise.all([first, second]);
    await f.project.cleanup();
  }
}, 30000);
import { expect } from "bun:test";
import { mkdir, writeFile } from "node:fs/promises";
import { join } from "node:path";
import {
  type ApprovedCommandConfig,
  commandConfigHash,
} from "../../src/config/commands.js";
import { createOwnedWorktree, gitOutput } from "../../src/git/worktrees.js";
import { createOpenCodeAdapter } from "../../src/opencode/adapter.js";
import {
  artifactHash,
  explanationHash,
  issueBundleHash,
} from "../../src/planning/artifacts.js";
import { openRunStore } from "../../src/state/run-store.js";
import { createFakeOpenCode } from "./fake-opencode.js";
import { createTestProject } from "./project.js";

export function required<T>(value: T | undefined): T {
  if (value === undefined) throw new Error("Missing fixture evidence");
  return value;
}

export async function singleIssueFixture(
  options: { commands?: ApprovedCommandConfig["commands"] } = {},
) {
  const project = await createTestProject();
  const store = await openRunStore(project.directory);
  const runId = "feature-single";
  await store.createRun(runId);
  const config = {
    schemaVersion: 1 as const,
    revision: 1,
    rationale: "fixture",
    commands: options.commands ?? [
      {
        id: "test",
        phase: "check" as const,
        executable: process.execPath,
        args: ["test", "behavior.test.ts"],
        cwd: ".",
        timeoutMs: 5000,
        platforms: ["darwin", "linux", "win32"] as (
          | "darwin"
          | "linux"
          | "win32"
        )[],
        env: {},
      },
    ],
  };
  await mkdir(join(project.directory, ".ralph"));
  await writeFile(
    join(project.directory, ".ralph/commands.json"),
    JSON.stringify(config),
  );
  await writeFile(join(project.directory, "PRD.md"), "Add one");
  const prd = {
    revision: 1,
    hash: artifactHash("Add one"),
    artifactPath: "PRD.md",
  };
  const issue = {
    id: "A",
    title: "Add one",
    artifactPath: "issues/A.md",
    dependencies: [],
    acceptanceCriteria: ["Adds one"],
    testableBehaviors: ["addOne(2) returns 3"],
  };
  const value = {
    schemaVersion: 1 as const,
    prdRevision: prd,
    issues: [issue],
  };
  const files = {
    "issues/A.md":
      "# A\n## Context\nFixture\n## Implementation\nAdd one\n## Tests\nAdds one\n## Acceptance criteria\nAdds one\n## Dependencies\nNone",
  };
  const graph = {
    revision: 1,
    hash: issueBundleHash(value, files),
    artifactPath: "graph.json",
    value,
    files,
    order: ["A"],
  };
  let run = await store.getRun(runId);
  await store.recordPlanning(runId, required(run).revision, {
    phase: "execution_approved",
    workspace: project.directory,
    sessionId: "main",
    feature: "Add one",
    commandHash: commandConfigHash(config),
    settings: {
      concurrency: 2,
      timeoutMs: 30000,
      agentTimeoutMs: 30000,
      models: {
        executor: { providerID: "fixture", modelID: "executor" },
        merger: { providerID: "fixture", modelID: "merger" },
      },
      skills: {},
    },
    transcript: [],
    turn: 1,
    explanation: {
      revision: 1,
      hash: explanationHash({ text: "Add one", scope: [], criteria: [] }),
      text: "Add one",
      scope: [],
      criteria: [],
    },
    approval: {
      revision: 1,
      hash: explanationHash({ text: "Add one", scope: [], criteria: [] }),
      messageId: "human",
      requestId: "explanation",
    },
    prd,
    graph,
    selectedCommit: project.commit,
    executionApproval: {
      revision: 1,
      selectedCommit: project.commit,
      prdHash: prd.hash,
      graphHash: graph.hash,
      requestId: "approved",
      messageId: "human",
      timestamp: new Date().toISOString(),
    },
  });
  const workspace = join(store.root, "worktrees", runId);
  await mkdir(join(store.root, "worktrees"), { recursive: true });
  const job = {
    runId,
    jobId: "baseline",
    role: "baseline",
    attempt: 0,
    workspace,
    baseCommit: project.commit,
    inputRevisions: {},
    prompt: "baseline",
  };
  await createOwnedWorktree(store, project.directory, {
    operationId: "baseline",
    kind: "baseline.workspace",
    status: "intent",
    job,
    ref: `refs/heads/ralph/${runId}`,
    expectedNew: project.commit,
  });
  run = await store.getRun(runId);
  await store.recordBaseline(
    runId,
    required(run).revision,
    {
      status: "passed",
      approvalRequestId: "approved",
      operationId: "baseline",
      branch: `ralph/${runId}`,
      workspace,
      candidateCommit: project.commit,
      commandHash: commandConfigHash(config),
      commandRevision: 1,
    },
    [],
  );
  const fake = createFakeOpenCode();
  const adapter = createOpenCodeAdapter(fake.client, store);
  adapter.authorizeCommand = async ({ job }) => ({ ok: !!job.sessionId });
  const dispatch = adapter.dispatchJob.bind(adapter);
  let mode = "success";
  adapter.dispatchJob = async (job) => {
    if (job.role === "executor") {
      await writeFile(
        join(job.workspace, "behavior.test.ts"),
        'import {expect,test} from "bun:test"; import {addOne} from "./behavior"; test("adds one",()=>expect(addOne(2)).toBe(3));',
      );
      await writeFile(
        join(job.workspace, "behavior.ts"),
        "export const addOne=(n:number)=>n;",
      );
      const red = Bun.spawnSync(
        [process.execPath, "test", "behavior.test.ts"],
        { cwd: job.workspace },
      );
      expect(red.exitCode).not.toBe(0);
      await writeFile(
        join(job.workspace, "behavior.ts"),
        "export const addOne=(n:number)=>n+1;",
      );
      const green = Bun.spawnSync(
        [process.execPath, "test", "behavior.test.ts"],
        { cwd: job.workspace },
      );
      expect(green.exitCode).toBe(0);
      await gitOutput(job.workspace, ["add", "."]);
      await gitOutput(job.workspace, ["commit", "-m", "Add one"]);
      fake.respond(
        JSON.stringify({
          issueId: mode === "identity" ? "other" : "A",
          attempt: job.attempt,
          baseCommit: job.baseCommit,
          submittedCommit: (
            await gitOutput(job.workspace, ["rev-parse", "HEAD"])
          ).trim(),
          tdd: {
            cycles: [
              {
                behavior: "addOne(2) returns 3",
                red: {
                  exitCode: red.exitCode,
                  log: new TextDecoder().decode(red.stderr),
                },
                green: {
                  exitCode: green.exitCode,
                  log: new TextDecoder().decode(green.stderr),
                },
              },
            ],
          },
        }),
      );
    } else {
      if (mode === "conflict")
        fake.respond(
          JSON.stringify({
            kind: "behavior_conflict",
            feedback: "Choose behavior for addOne",
          }),
        );
      else {
        const submission = JSON.parse(
          required(job.prompt.split("SUBMISSION\n")[1]),
        );
        await gitOutput(job.workspace, [
          "merge",
          "--no-edit",
          submission.submittedCommit,
        ]);
        if (mode === "validation") {
          await writeFile(
            join(job.workspace, "behavior.ts"),
            "export const addOne=(n:number)=>n;",
          );
          await gitOutput(job.workspace, ["commit", "-am", "Bad merge"]);
        }
        fake.respond(
          JSON.stringify({
            kind: "merged",
            candidateCommit: (
              await gitOutput(job.workspace, ["rev-parse", "HEAD"])
            ).trim(),
