/** Explicit user-correlated artifact edits always pass the normal approval gate. */
async function reviseQuestionScope(store: RunStore, run: RunRecord, attempt: IssueAttempt,
  response: Extract<UserInputResult,{ok:true}>, text: string,
  value: import(\"../planning/graph.js\").IssueGraph, files: Record<string,string>) {
  const state = structuredClone(run.planning"'!);
  const oldPrd = state.prd!, oldGraph = state.graph!, oldApproval = state.executionApproval!;
  const revision = oldGraph.revision + 1;
  const directory = `.ralph/features/${run.runId}/graph-${revision}`;
  const prd = {revision: oldPrd.revision + 1, hash:artifactHash(text), artifactPath:`${directory}/PRD.md`};
  value.prdRevision = prd;
  validateIssueGraph(value,files,prd);
  const affected = new Set<string>();
  for (const issue of value.issues) {
    const old = oldGraph.value.issues.find(i=>i.id === issue.id);
    if (text !== await readFile(join(state.workspace,oldPrd.artifactPath),"utf8") ||
        JSON.stringify(old) !== JSON.stringify(issue) ||
        oldGraph.files[issue.artifactPath] !== files[issue.artifactPath]) affected.add(issue.id);
  }
  for (const old of oldGraph.value.issues)
    if (!value.issues.some(i=>i.id === old.id)) affected.add(old.id);
  for (const id of topologicalOrder(value)) {
    if (value.issues.find(i=>i.id === id)!.dependencies.some(d=>affected.has(d))) affected.add(id);
  }
  state.scopeChange = {issueId:attempt.issueId,requestId:attempt.question!.request.requestId,
    affectedIssueIds:[...affected],integratedIssueIds:[...affected].filter(id=>run.issueAttempts?.[id]?.status === "integrated"),
    previousPrd:oldPrd,previousGraph:oldGraph,previousApproval:oldApproval};
  state.phase = "execution_approval";
  delete state.executionApproval;
  delete state.pending;
  state.generation = {role:"issues", revision,jobId:attempt.job.jobId};
  const publication = await publishRevision(store,run.revision,state,run.runId,`graph-${revision}`,
    {...files,"PRD.md":text,"graph.json":JSON.stringify(value,null,2)});
  state.prd = prd;
  state.graph = {revision,hash:issueBundleHash(value,files),artifactPath:`${directory}/graph.json`,value,files,order:topologicalOrder(value)};
  state.transcript.push({source:"user",text:response.text,messageId:response.messageId,requestId:response.requestId,revision:response.revision});
  await savePlanning(store,run.runId,publication.revision,state);
  for (;;) {
    const latest = await store.getRun(run.runId);
    const current = latest?.issueAttempts?.[attempt.issueId];
    if (!latest || current?.question?.request.requestId !== attempt.question?.request.requestId) return;
    current.question.answer = response;
    if (await store.recordIssueAttempt(run.runId,latest.revision,current)) return;
  }
}

/** Keep baseline/code evidence; approval explicitly authorizes the changed artifacts. */
export async function prepareApprovedScope(store: RunStore, adapter: OpenCodeAdapter, runId: string) {
  let run = await store.getRun(runId);
  const state = run?.planning;
  if (!run || !state?.scopeChange || state.scopeChange.prepared || state.phase !== "execution_approved" || !approvalMatchesRevision(state)) return run;
  const change = state.scopeChange;
  // Settle sessions from the superseded artifacts before dispatching continuations.
  for (const job of Object.values(run.jobs).filter(j=>j.status !== "terminal")) {
    const cancelled = await adapter.cancelJob(job.envelope);
    if (!cancelled.ok) throw new Error("Superseded executor cancellation was not confirmed");
  }
  for (;;) {
    run = (await store.getRun(runId))!;
    if (!run.planning || !approvalMatchesRevision(run.planning)) throw new Error("Scope approval changed");
    if (!run.baseline || run.baseline.commandHash !== state.commandHash ||
        run.baseline.candidateCommit !== state.executionApproval?.selectedCommit) throw new Error("Scope baseline changed");
    if (await store.recordBaseline(runId,run.revision,{...run.baseline,approvalRequestId:state.executionApproval!.requestId},run.validationSkips ?? [])) break;
  }
  for (const id of Object.keys(run.issueAttempts ?? {})) {
    for (;;) {
      const latest = (await store.getRun(runId))!;
      const attempt = latest.issueAttempts![id]!;
      if (id === change.issueId && attempt.question?.answer) attempt.status = "resume_ready";
      else if (["executing","submitted","merging"].includes(attempt.status) ||
        (attempt.status === "integrated" && change.affectedIssueIds.includes(id))) {
        attempt.status = "failed";
        attempt.error = {code:"cancelled",message:"Approved scope revision requires execution against current artifacts; previous evidence retained"};
      } else break;
      if (await store.recordIssueAttempt(runId,latest.revision,attempt)) break;
    }
  }
  for (;;) {
    run = (await store.getRun(runId))!;
    const planning = structuredClone(run.planning!);
    if (!planning.scopeChange || !approvalMatchesRevision(planning)) throw new Error("Scope approval changed");
    planning.scopeChange.prepared = true;
    if (await store.recordPlanning(runId,run.revision,planning)) return store.getRun(runId);
  }
}
