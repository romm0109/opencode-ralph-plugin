import type { UserInputResult } from \"../core/types.js\";
import type { PlanningState } from \"./types.js\";

export function approvalMatchesRevision(state: PlanningState) {
  const approval = state.executionApproval;
  return "'!!(approval && state.prd && state.graph &&
    approval.revision === state.graph.revision &&
    approval.prdHash === state.prd.hash && approval.graphHash === state.graph.hash);
}
export function recordApproval(state: PlanningState, response: UserInputResult) {
  if (!response.ok || response.source !== "user" || !response.messageId ||
      !state.pending || response.requestId !== state.pending.requestId ||
      response.sessionId !== state.sessionId || response.revision !== state.graph?.revision ||
      response.text.trim() !== `approve ${state.graph.revision}` || !state.prd) return false;
  state.executionApproval = {
    revision: state.graph.revision,
    ...(state.selectedCommit ? {selectedCommit: state.selectedCommit} : {}),
    prdHash: state.prd.hash, graphHash: state.graph.hash,
    requestId: response.requestId, messageId: response.messageId,
    timestamp: new Date().toISOString(),
  };
  state.phase = "execution_approved";
  return true;
}
