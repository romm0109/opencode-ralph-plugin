/** Approval and control identity remain fixed throughout one attempt. */
export function assertCurrentAttempt(
  initial: RunRecord,
  current: RunRecord | undefined,
  attempt: IssueAttempt,
): asserts current is RunRecord {
  if (
    !current ||
    (current.control && current.control.status !== "active") ||
    (current.control?.epoch ?? 0) !== (initial.control?.epoch ?? 0) ||
    current.planning?.executionApproval?.requestId !==
      initial.planning?.executionApproval?.requestId ||
    current.planning?.prd?.hash !== initial.planning?.prd?.hash ||
    current.planning?.graph?.hash !== initial.planning?.graph?.hash ||
    current.planning?.commandHash !== initial.planning?.commandHash ||
    current.baseline?.operationId !== initial.baseline?.operationId ||
    current.issueAttempts?.[attempt.issueId]?.operationId !==
      attempt.operationId
  )
    throw new Error("Stale issue completion");
}
export async function saveIssueAttempt(
  store: RunStore,
  initial: RunRecord,
  attempt: IssueAttempt,
) {
  for (;;) {
    const current = await store.getRun(initial.runId);
    assertCurrentAttempt(initial, current, attempt);
    if (
      await store.recordIssueAttempt(initial.runId, current.revision, attempt)
    )
      return;
  }
}
async function executeAttempt(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  issueId: string,
  options: AttemptOptions = {},
): Promise<IssueAttempt> {
  const initial = await store.getRun(runId);
  const planning = initial?.planning;
  const baseline = initial?.baseline;
  if (
    !initial ||
    planning?.phase !== "execution_approved" ||
    !planning.executionApproval ||
    !planning.prd ||
    !planning.graph ||
    !baseline?.workspace ||
    !baseline.branch ||
    !["passed", "passed_with_omissions"].includes(baseline.status) ||
    baseline.approvalRequestId !== planning.executionApproval.requestId ||
    baseline.candidateCommit !== planning.executionApproval.selectedCommit
  )
    throw new Error("An approved graph and validated baseline are required");
  if (initial.control && initial.control.status !== "active")
    throw new Error("Run is inactive");
  const previous = initial.issueAttempts?.[issueId];
  if (previous && previous.status !== "failed") return previous;
  const number = beginAttempt(previous);
  const issue: IssueSpec | undefined = planning.graph.value.issues.find(
    (item) => item.id === issueId,
  );
  if (
    !issue ||
    issue.dependencies.some(
      (id) => initial.issueAttempts?.[id]?.status !== "integrated",
    )
  )
    throw new Error("Issue is not dependency ready");
  const operationId = `issue-${randomUUID()}`;
  const job: JobEnvelope = {
    runId,
    issueId,
    jobId: operationId,
    role: "executor",
    attempt: number,
    workspace: join(store.root, "worktrees", operationId),
    baseCommit:
      baseline.candidateCommit ??
      planning.executionApproval.selectedCommit ??
      "",
    inputRevisions: {
      prd: planning.prd.revision,
      graph: planning.graph.revision,
      commands: baseline.commandRevision,
      skill: 1,
    },
    ...(planning.settings.models.executor
      ? { model: planning.settings.models.executor }
      : {}),
    prompt: "Reserved issue attempt",
  };
  const attempt: IssueAttempt = {
    issueId,
    attempt: number,
    agentTimeoutMs: planning.settings.agentTimeoutMs ?? 1800000,
    status: "executing",
    operationId,
    job,
    history: previous
      ? [
          ...(previous.history ?? []),
          (({ history: _history, ...entry }) => entry)(previous),
        ]
      : [],
  };
  if (!(await store.recordIssueAttempt(runId, initial.revision, attempt)))
    return executeAttempt(store, adapter, runId, issueId, options);
  let environment: ReturnType<typeof createApprovedEnvironment> | undefined;
  try {
    if (previous) {
      try {
        attempt.reconciledWork = await reconcileAttempt(
          store,
          adapter,
          previous,
        );
      } catch (cause) {
        attempt.error = { code: "cancelled", message: String(cause) };
        throw cause;
      }
    }
    const config = await loadProjectConfig(planning.workspace);
    if (
      commandConfigHash(config.commands) !== planning.commandHash ||
      baseline.commandHash !== planning.commandHash
    )
      throw new Error("Approved commands changed");
    const prd = await readFile(
      join(planning.workspace, planning.prd.artifactPath),
      "utf8",
    );
    if (
      artifactHash(prd) !== planning.prd.hash ||
      issueBundleHash(planning.graph.value, planning.graph.files) !==
        planning.graph.hash
    )
      throw new Error("Approved artifacts changed");
    const skill = await loadRoleInstructions(
      planning.workspace,
      "executor",
      config.skillPaths,
    );
    const base = await inspectWorktree(baseline.workspace);
    if (
      base.repositoryId !== store.repositoryId ||
      base.branch !== `refs/heads/${baseline.branch}`
    )
      throw new Error("Integration workspace identity changed");
    job.baseCommit = base.commit;
    job.inputRevisions.commands = config.commands.revision;
    job.prompt = `${skill.text}\nSkill: ${JSON.stringify({ path: skill.path, hash: skill.hash })}\nPRD revision: ${JSON.stringify(planning.prd)}\nPRD:\n${prd}\nIssue: ${JSON.stringify(issue)}\n${planning.graph.files[issue.artifactPath]}\nRepair context: ${JSON.stringify({ previous: repairContext(previous), reconciledWork: attempt.reconciledWork })}\nCommands: ${JSON.stringify(config.commands)}\nIdentity: ${JSON.stringify({ issueId, attempt: number, baseCommit: base.commit })}`;
    await saveIssueAttempt(store, initial, attempt);
    await mkdir(dirname(job.workspace), { recursive: true });
    await createOwnedWorktree(store, planning.workspace, {
      operationId,
      kind: "issue.workspace",
      status: "intent",
      job,
      ref: `refs/heads/ralph/issues/${runId}/${operationId}`,
      expectedNew: base.commit,
    });
    environment = createApprovedEnvironment(
      {
        store,
        adapter,
        job,
        config: config.commands,
        sourceWorkspace: planning.workspace,
        permissionSessionId: planning.sessionId,
        ...(options.clock ? { clock: options.clock } : {}),
      },
      { skipChecks: true },
    );
    attempt.environment = { lifecycle: environment.results };
    attempt.environment.lease = await prepareEnvironment(environment, job);
    job.prompt += `\nAllocated environment: ${JSON.stringify(job.environment)}`;
    await saveIssueAttempt(store, initial, attempt);
    const result = await dispatchAttempt(
      store,
      adapter,
      job,
      attempt.agentTimeoutMs ?? 1800000,
      options,
    );
    assertCurrentAttempt(initial, await store.getRun(runId), attempt);
    attempt.executionResult = result;
    if (result.outcome !== "completed") {
      attempt.error = result.error ?? {
        code:
          result.outcome === "denied"
            ? "permission-denied"
            : result.outcome === "cancelled"
              ? "cancelled"
              : "missing-output",
        message: "Executor did not complete",
      };
      throw new Error(attempt.error.message);
    }
    const submission = parseSubmission(result, job);
    const found = await inspectWorktree(job.workspace);
    if (
      found.branch !== `refs/heads/ralph/issues/${runId}/${operationId}` ||
      found.repositoryId !== store.repositoryId ||
      found.commit !== submission.submittedCommit ||
      (
        await gitOutput(job.workspace, [
          "status",
          "--porcelain",
          "--untracked-files=all",
        ])
      ).trim()
    )
      throw new Error(
        "Submission must be committed and clean on the owned issue branch",
      );
    await gitOutput(job.workspace, [
      "merge-base",
      "--is-ancestor",
      base.commit,
      submission.submittedCommit,
    ]);
    const cleanup = await disposeEnvironment(environment, job);
    if (cleanup.status !== "completed")
      throw new Error(cleanup.reason ?? "Executor environment cleanup failed");
    attempt.submission = submission;
    attempt.status = "submitted";
    await saveIssueAttempt(store, initial, attempt);
  } catch (cause) {
    const waiting = environment?.results.find((result) =>
      ["permission_denied", "cancelled"].includes(result.status),
    );
    if (waiting)
      attempt.error ??= {
        code:
          waiting.status === "permission_denied"
            ? "permission-denied"
            : "cancelled",
        message: waiting.cause?.message ?? waiting.status,
        cause: waiting,
      };
    attempt.error ??= {
      code: "setup-failed",
      message: String(cause),
      cause: String(cause),
    };
    if (attempt.status !== "integrated") failAttempt(attempt);
    await saveIssueAttempt(store, initial, attempt).catch(() => {});
  } finally {
    if (environment) {
      const cleanup = await disposeEnvironment(environment, job).catch(
        (cause) => ({ status: "failed" as const, reason: String(cause) }),
      );
      if (cleanup.status !== "completed") {
        attempt.cleanupErrors ??= [];
        attempt.cleanupErrors.push(
          cleanup.reason ?? "Environment cleanup failed",
        );
      }
      await saveIssueAttempt(store, initial, attempt).catch(() => {});
    }
  }
  return attempt;
}

/** Lease only execution/setup/cleanup, never the submission's integration wait. */
export async function executeIssue(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  issueId: string,
  options: AttemptOptions = {},
): Promise<IssueAttempt> {
  const run = await store.getRun(runId);
  const previous = run?.issueAttempts?.[issueId];
  if (previous && previous.status !== "failed")
    return executeAttempt(store, adapter, runId, issueId, options);
  return withExecutorSlot(
    store,
    runId,
    run?.planning?.settings.concurrency ?? 2,
    () => executeAttempt(store, adapter, runId, issueId, options),
  );
}
import type { JobEnvelope, JobResult } from "../core/types.js";
import { gitOutput, inspectWorktree } from "../git/worktrees.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { terminateOwnedProcess } from "../process/ownership.js";
import type { RunStore } from "../state/run-store.js";
import type { IssueAttempt } from "./execute-issue.js";

export interface AttemptPolicy {
  maxAttempts: 3;
}
export const attemptPolicy: Readonly<AttemptPolicy> = Object.freeze({
  maxAttempts: 3,
});
export function beginAttempt(previous?: IssueAttempt): number {
  const number = (previous?.attempt ?? 0) + 1;
  if (number > attemptPolicy.maxAttempts)
    throw new Error("Issue attempt budget exhausted");
  return number;
}
export function exhaustIssue(attempt: IssueAttempt) {
  attempt.status = "exhausted";
}
export function failAttempt(attempt: IssueAttempt) {
  if (["permission-denied", "cancelled"].includes(attempt.error?.code ?? "")) {
    attempt.status = "waiting";
    return;
  }
  if (attempt.attempt >= attemptPolicy.maxAttempts) exhaustIssue(attempt);
  else attempt.status = "failed";
}
export function repairContext(previous?: IssueAttempt) {
  if (!previous) return undefined;
  const { history: _history, ...evidence } = previous;
  return evidence;
}

export interface Clock {
  schedule(ms: number, callback: () => void): () => void;
}
export const systemClock: Clock = {
  schedule(ms, callback) {
    const timer = setTimeout(callback, ms);
    return () => clearTimeout(timer);
  },
};
export interface AttemptOptions {
  clock?: Clock;
}
/** Cancellation is acknowledged before the caller can allocate a repair. */
export async function dispatchAttempt(
  store: RunStore,
  adapter: OpenCodeAdapter,
  job: JobEnvelope,
  timeoutMs: number,
  options: AttemptOptions,
): Promise<JobResult> {
  const clock = options.clock ?? systemClock;
  const timeout = Symbol("deadline");
  let dispose = () => {};
  const deadline = new Promise<typeof timeout>((resolve) => {
    dispose = clock.schedule(timeoutMs, () => resolve(timeout));
  });
  try {
    const result = await Promise.race([adapter.dispatchJob(job), deadline]);
    if (result !== timeout) return result;
    const entry = (await store.getRun(job.runId))?.jobs[job.jobId];
    const cancelled = entry
      ? await adapter.cancelJob(entry.envelope)
      : { ok: false };
    return {
      ...(entry?.envelope ?? job),
      outcome: "failed",
      evidence: [`${job.role} deadline ${timeoutMs}ms exceeded`],
      error: {
        code: cancelled.ok ? "agent-timeout" : "cancelled",
        message: cancelled.ok
          ? `${job.role} deadline exceeded (${timeoutMs}ms); owned job cancelled`
          : "Agent deadline exceeded; cancellation was not confirmed. Intervention required",
      },
    };
  } catch (cause) {
    const entry = (await store.getRun(job.runId))?.jobs[job.jobId];
    if (entry && entry.status !== "terminal") {
      const cancelled = await adapter.cancelJob(entry.envelope);
      if (!cancelled.ok)
        return {
          ...entry.envelope,
          outcome: "cancelled",
          evidence: [],
          error: {
            code: "cancelled",
            message:
              "Dispatch failed and owned agent cancellation was not confirmed",
            cause: String(cause),
          },
        };
    }
    throw cause;
  } finally {
    dispose();
  }
}

/** Retain failed work; verify its ownership and describe current saved facts. */
export async function reconcileAttempt(
  store: RunStore,
  adapter: OpenCodeAdapter,
  previous: IssueAttempt,
) {
  const run = await store.getRun(previous.job.runId);
  if (!run) throw new Error("Missing retry run");
  for (const entry of Object.values(run.jobs).filter(
    (entry) =>
      entry.envelope.issueId === previous.issueId &&
      entry.envelope.attempt === previous.attempt &&
      entry.status !== "terminal",
  )) {
    const cancelled = await adapter.cancelJob(entry.envelope);
    if (!cancelled.ok)
      throw new Error("Owned agent cancellation was not confirmed");
  }
  const work: {
    workspace: string;
    commit: string;
    branch: string;
    changes: string;
  }[] = [];
  for (const operation of Object.values(run.operations).filter(
    (op) =>
      op.job.issueId === previous.issueId &&
      op.job.attempt === previous.attempt,
  )) {
    if (
      operation.ownedProcess &&
      !(await terminateOwnedProcess(operation.ownedProcess))
    )
      throw new Error("Owned command cleanup was not confirmed");
    if (
      !["issue.workspace", "candidate.workspace"].includes(operation.kind) ||
      operation.status !== "completed"
    )
      continue;
    const found = await inspectWorktree(operation.job.workspace);
    if (
      found.repositoryId !== store.repositoryId ||
      found.branch !== operation.ref
    )
      throw new Error("Retained retry workspace identity changed");
    work.push({
      workspace: found.workspace,
      commit: found.commit,
      branch: found.branch,
      changes: await gitOutput(found.workspace, [
        "status",
        "--porcelain",
        "--untracked-files=all",
      ]),
    });
  }
  return work;
}
import type { ExecutionEvidence, RunRecord } from "../core/types.js";
import { validateIssueGraph } from "../planning/graph.js";
import { type AttemptPolicy, attemptPolicy } from "./attempts.js";

/** Pure readiness: a submission is never a dependency completion. */
export function reconcileReadiness(
  run: RunRecord,
  queue: string[] = [],
  policy: AttemptPolicy = attemptPolicy,
): ExecutionEvidence {
  const planning = run.planning;
  if (!planning?.graph || !planning.prd)
    throw new Error("Missing approved graph");
  const graph = validateIssueGraph(
    planning.graph.value,
    planning.graph.files,
    planning.prd,
  );
  const states = new Map<string, ExecutionEvidence["issues"][number]>();
  function resolve(id: string): ExecutionEvidence["issues"][number] {
    const cached = states.get(id);
    if (cached) return cached;
    const issue = graph.issues.find((item) => item.id === id);
    if (!issue) throw new Error("Unknown dependency");
    const parents = issue.dependencies.map(resolve);
    const attempt = run.issueAttempts?.[id];
    const blockers = parents
      .filter((p) => ["blocked", "failed"].includes(p.status))
      .map((p) => p.id);
    let status: ExecutionEvidence["issues"][number]["status"];
    if (attempt?.status === "integrated") status = "integrated";
    else if (
      attempt?.status === "exhausted" ||
      (attempt?.status === "failed" && attempt.attempt >= policy.maxAttempts)
    )
      status = "failed";
    else if (attempt?.status === "waiting" || blockers.length)
      status = "blocked";
    else if (attempt && ["submitted", "merging"].includes(attempt.status))
      status = "integration_queued";
    else if (attempt?.status === "executing") status = "running";
    else
      status = parents.every((p) => p.status === "integrated")
        ? "ready"
        : "pending";
    const result = {
      id,
      title: issue.title,
      dependencies: issue.dependencies,
      status,
      blockers,
    };
    states.set(id, result);
    return result;
  }
  const issues = graph.issues.map((issue) => resolve(issue.id));
  const checks: ExecutionEvidence["checks"] = Object.values(
    run.issueAttempts ?? {},
  ).flatMap((attempt) =>
    (attempt.validation?.checks ?? []).map((check) => ({
      id: check.id,
      status: check.status,
      ...(check.reason ? { reason: check.reason } : {}),
      attempt: attempt.attempt,
      candidateCommit: attempt.validation?.candidateCommit ?? "",
      commandRevision: attempt.validation?.commandRevision ?? 0,
    })),
  );
  return {
    issues,
    integrationQueue: queue,
    checks,
    verification: issues.some(
      (i) => i.status === "failed" || i.status === "blocked",
    )
      ? "failed"
      : issues.every((i) => i.status === "integrated") &&
          !run.validationSkips?.length &&
          !checks.some((c) => c.status === "skipped")
        ? "passed"
        : "incomplete",
  };
}

