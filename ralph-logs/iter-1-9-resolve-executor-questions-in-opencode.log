import { randomUUID } from "node:crypto";
import { readFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { z } from "zod";
import { loadRoleInstructions } from "../agents/skills.js";
import { loadProjectConfig } from "../config/project.js";
import type { UserInputResult } from "../core/types.js";
import { readReviewGit } from "../git/review-workspace.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { artifactHash, issueBundleHash } from "./artifacts.js";
import {
  dispatchGeneration,
  planningFailure,
  publishRevision,
  savePlanning,
} from "./generation.js";
import { topologicalOrder, validateIssueGraph } from "./graph.js";

export async function generateIssues(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if (!state?.prd) throw new Error("A PRD revision is required");
  try {
    const config = await loadProjectConfig(state.workspace);
    const skill = await loadRoleInstructions(
      state.workspace,
      "issues",
      config.skillPaths,
    );
    const text = await readFile(
      join(state.workspace, state.prd.artifactPath),
      "utf8",
    );
    if (artifactHash(text) !== state.prd.hash)
      throw new Error("PRD artifact changed");
    const generated = await dispatchGeneration(
      store,
      adapter,
      runId,
      "issues",
      `${skill.text}\nRepository: ${state.workspace}\nPRD revision: ${JSON.stringify(state.prd)}\nPRD content:\n${text}\nExplanation: ${JSON.stringify(state.explanation)}\nRevision feedback: ${JSON.stringify(state.transcript)}`,
      { issues: { path: skill.path, hash: skill.hash } },
    );
    if (!generated) return store.getRun(runId);
    const output = z
      .object({ graph: z.unknown(), files: z.record(z.string(), z.string()) })
      .strict()
      .parse(JSON.parse(generated.result.text ?? ""));
    const value = validateIssueGraph(output.graph, output.files, state.prd);
    const order = topologicalOrder(value);
    const files = Object.fromEntries(
      order.map((id) => {
        const issue = value.issues.find((item) => item.id === id);
        if (!issue) throw new Error("Missing issue");
        return [issue.artifactPath, output.files[issue.artifactPath] as string];
      }),
    );
    const publication = await publishRevision(
      store,
      generated.run.revision,
      generated.state,
      runId,
      `graph-${generated.state.generation?.revision}`,
      { ...files, "graph.json": JSON.stringify(value, null, 2) },
    );
    generated.state.graph = {
      revision: (generated.state.graph?.revision ?? 0) + 1,
      hash: issueBundleHash(value, files),
      artifactPath: `${publication.directory}/graph.json`,
      value,
      files,
      order,
    };
    generated.state.phase = "execution_approval";
    delete generated.state.executionApproval;
    await savePlanning(store, runId, publication.revision, generated.state);
  } catch (cause) {
    await planningFailure(store, runId, cause);
  }
  return store.getRun(runId);
}

export async function handlePlanningResponse(
  store: RunStore,
  runId: string,
  response: UserInputResult,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  const pending = state?.pending;
  if (
    !run ||
    state?.phase !== "execution_approval" ||
    !state.prd ||
    !state.graph ||
    !pending ||
    !response.ok ||
    response.source !== "user" ||
    !response.messageId ||
    !response.text.trim() ||
    response.requestId !== pending.requestId ||
    response.sessionId !== pending.sessionId ||
    response.revision !== pending.revision ||
    state.transcript.some((entry) => entry.messageId === response.messageId)
  )
    return false;
  try {
    const text = await readFile(
      join(state.workspace, state.prd.artifactPath),
      "utf8",
    );
    const value = JSON.parse(
      await readFile(join(state.workspace, state.graph.artifactPath), "utf8"),
    );
    const files: Record<string, string> = {};
    for (const path of Object.keys(state.graph.files))
      files[path] = await readFile(
        join(state.workspace, dirname(state.graph.artifactPath), path),
        "utf8",
      );
    validateIssueGraph(value, files, state.prd);
    if (
      artifactHash(text) !== state.prd.hash ||
      issueBundleHash(value, files) !== state.graph.hash
    )
      throw new Error(
        "Published artifacts changed; regenerate and approve a new revision",
      );
  } catch (cause) {
    await planningFailure(store, runId, cause);
    return false;
  }
  const next = structuredClone(state);
  delete next.pending;
  delete next.error;
  next.transcript.push({
    source: "user",
    text: response.text,
    messageId: response.messageId,
    requestId: response.requestId,
    revision: response.revision,
  });
  if (response.text.trim() === `approve ${state.graph.revision}`) {
    next.phase = "execution_approved";
    next.executionApproval = {
      revision: state.graph.revision,
      ...(state.selectedCommit ? { selectedCommit: state.selectedCommit } : {}),
      prdHash: state.prd.hash,
      graphHash: state.graph.hash,
      requestId: response.requestId,
      messageId: response.messageId,
      timestamp: new Date().toISOString(),
    };
  } else {
    next.phase = "explanation_approved";
    delete next.executionApproval;
  }
  return store.recordPlanning(runId, run.revision, next);
}
export async function requestPlanningApproval(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  selectedCommit?: string,
) {
  const run = await store.getRun(runId);
  const state = run?.planning;
  if (
    !run ||
    state?.phase !== "execution_approval" ||
    !state.prd ||
    !state.graph
  )
    return false;
  if (!state.pending) {
    try {
      state.selectedCommit = (
        await readReviewGit(state.workspace, [
          "rev-parse",
          "--verify",
          `${selectedCommit ?? state.selectedCommit ?? "HEAD"}^{commit}`,
        ])
      ).trim();
    } catch (cause) {
      await planningFailure(
        store,
        runId,
        new Error(
          "Select a committed starting point; this repository may be unborn",
          { cause },
        ),
      );
      return false;
    }
    const text = await readFile(
      join(state.workspace, state.prd.artifactPath),
      "utf8",
    );
    state.pending = {
      runId,
      workspace: state.workspace,
      sessionId: state.sessionId,
      requestId: randomUUID(),
      revision: state.graph.revision,
      question: `Starting commit: ${state.selectedCommit}\n${text}\nPRD: ${state.prd.artifactPath} (${state.prd.hash})\nGraph: ${state.graph.artifactPath} (${state.graph.hash})\n${state.graph.order
        .map((id, index) => {
          const item = state.graph?.value.issues.find(
            (issue) => issue.id === id,
          );
          return `${index + 1}. ${id}: ${item?.title}; depends on ${item?.dependencies.join(", ") || "none"}`;
        })
        .join(
          "\n",
        )}\nApprove both artifacts for execution by replying approve ${state.graph.revision}, or reply with revisions.`,
    };
    await savePlanning(store, runId, run.revision, state);
  }
  const published = await adapter.publishStatus(
    state.sessionId,
    state.workspace,
    state.pending.question,
  );
  const response = published.ok
    ? await adapter.requestUserInput(state.pending)
    : {
        ok: false as const,
        error: published.error ?? {
          code: "sdk-error" as const,
          message: "Could not publish planning approval",
        },
      };
  if (!response.ok) {
    const latest = await store.getRun(runId);
    if (latest?.planning)
      await store.recordPlanning(runId, latest.revision, {
        ...latest.planning,
        error: response.error,
      });
    return false;
  }
  return handlePlanningResponse(store, runId, response);
}

