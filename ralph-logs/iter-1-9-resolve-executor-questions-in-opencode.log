            "Ralph has no verified human approval/provenance channel yet. No assistant or API-created message is accepted as approval.",
        },
      };
    },
    async publishStatus(_sessionId, workspace, text) {
      try {
        await client.notify(workspace, text);
        return { ok: true };
      } catch (cause) {
