  f.holds.set("B", b);
  f.holds.set("C", c);
  f.holds.set("E", e);
  const pending = f.router.scheduleIssues(f.runId);
  try {
    await until(() =>
      f.jobs.some((j) => j.issueId === "B" && j.role === "executor"),
    ).catch((cause) => diagnostic(f, cause));
    expect(
