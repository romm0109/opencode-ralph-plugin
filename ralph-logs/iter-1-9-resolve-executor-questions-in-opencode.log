export interface IssueAttempt {
  issueId: string;
  attempt: number;
  agentTimeoutMs?: number;
  status:
    | "executing"
    | "submitted"
    | "merging"
    | "failed"
    | "integrated"
    | "exhausted"
    | "waiting";
  history?: Omit<IssueAttempt, "history">[];
  operationId: string;
  job: JobEnvelope;
  submission?: Submission;
  executionResult?: JobResult;
  candidate?: {
