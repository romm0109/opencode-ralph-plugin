  verifyReviewWorkspace,
} from "../git/review-workspace.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import { loadRoleInstructions } from "../roles/instructions.js";
import type { RunStore } from "../state/run-store.js";
import type { ReviewResult, ReviewSnapshot } from "./types.js";
import { validateReviewResult } from "./validate-result.js";

export interface CodeReviewOptions {
  store: RunStore;
  adapter: OpenCodeAdapter;
  directory: string;
  parentSessionId: string;
  model?: JobEnvelope["model"];
}
export async function runCodeReview(
  snapshot: ReviewSnapshot,
  options: CodeReviewOptions,
): Promise<ReviewResult> {
  await waitForDispatch(options.store, snapshot.runId);
  await verifyReviewRepository(options.directory, options.store.repositoryId);
  const run = await options.store.getRun(snapshot.runId);
  if (
    !run?.review ||
    run.review.superseded ||
    !isDeepStrictEqual(run.review.snapshot, snapshot) ||
    run.operations[`review-pin-${snapshot.round}`]?.status !== "completed"
  )
    throw new Error("Unknown or superseded review snapshot");
  if (run.review.result) return run.review.result;
  const workspace = join(options.store.root, "review-workspaces", randomUUID());
  const job: JobEnvelope = {
    runId: snapshot.runId,
    jobId: `code-review-${snapshot.round}`,
    attempt: 1,
    role: "code-review",
    readOnly: true,
    workspace,
    baseCommit: snapshot.commit,
    inputRevisions: { round: snapshot.round },
    prompt: `${await loadRoleInstructions("code-review")}\nReview input:\n${JSON.stringify({ snapshot, ...run.review.inputs })}`,
    ...(options.model ? { model: options.model } : {}),
  };
  const operation = {
    operationId: `review-workspace-${snapshot.round}`,
    kind: "review.workspace" as const,
    status: "intent" as const,
    job,
  };
  if (!(await options.store.recordOperation(operation)))
    throw new Error(
      "Review dispatch already started; resume must reconcile the existing operation",
    );
  try {
    await createReviewWorkspace(options.directory, workspace, snapshot.commit);
    await options.store.recordOperation({ ...operation, status: "completed" });
  } catch (cause) {
    await options.store.recordOperation({
      ...operation,
      status: "failed",
      error: {
        code: "sdk-error",
        message: "Review workspace preparation failed",
        cause: String(cause),
      },
    });
    throw cause;
  }
  await waitForDispatch(options.store, snapshot.runId);
  const response = await options.adapter.dispatchJob(job);
  const result: ReviewResult = {
    role: "code-review",
    reviewedCommit: snapshot.commit,
    round: snapshot.round,
    outcome: "unverified",
    findings: [],
    evidenceRefs: response.evidence,
    ...(response.sessionId ? { sessionId: response.sessionId } : {}),
  };
  try {
    if (
      response.outcome === "completed" &&
      (!response.sessionId ||
        response.sessionId === options.parentSessionId ||
        Object.values(run.jobs).some(
          (entry) => entry.envelope.sessionId === response.sessionId,
        ) ||
        response.baseCommit !== snapshot.commit ||
        response.workspace !== workspace ||
        response.runId !== snapshot.runId ||
        response.jobId !== job.jobId ||
        response.attempt !== job.attempt)
    )
      throw new Error(
        "Reviewer response is not an independent correlated session",
      );
    await verifyReviewWorkspace(workspace, snapshot.commit);
    if (response.outcome === "completed" && response.text) {
      const parsed = validateReviewResult(response.text, snapshot);
      for (const finding of parsed.findings)
        if (finding.blocking)
          await verifyFindingEvidence(
            workspace,
            snapshot.commit,
            finding.evidence,
            snapshot.evidenceRefs,
          );
      result.findings = parsed.findings;
      result.outcome = parsed.outcome;
      result.evidenceRefs = [...parsed.evidenceRefs, ...response.evidence];
    } else {
      result.error = response.error ?? {
        code: "missing-output",
        message: "No completed reviewer output",
      };
    }
  } catch (cause) {
    result.error = {
      code: "invalid-review",
      message: cause instanceof Error ? cause.message : String(cause),
      cause:
        cause instanceof Error
          ? { name: cause.name, message: cause.message }
          : cause,
    };
  }
  const summary = `Code review round ${snapshot.round} at ${snapshot.commit}: ${result.outcome}.${result.error ? ` ${result.error.message}` : ""}\n${result.findings.map((finding) => `${finding.id} [${finding.blocking ? "blocking" : "optional"}] ${finding.category}: ${finding.criterion}\nEvidence: ${finding.evidence.join("; ")}\nSuggested repair: ${finding.suggestedRepair}`).join("\n")}\nFunctional review is still required.`;
  if (
    !(await options.store.recordReviewResult(
      snapshot.runId,
      snapshot,
      result,
      summary,
    ))
  )
    throw new Error("Superseded review result ignored");
  const stored = (await options.store.getRun(snapshot.runId))?.review;
  if (
    !stored?.result ||
    stored.superseded ||
    stored.snapshot.round !== snapshot.round
  )
    throw new Error("Superseded review publication ignored");
  const publish = {
    operationId: `review-publish-${snapshot.round}`,
    kind: "review.publish" as const,
    status: "intent" as const,
    job,
  };
  await waitForDispatch(options.store, snapshot.runId);
  if (!(await options.store.recordOperation(publish))) return result;
  const published = await options.adapter.publishStatus(
    options.parentSessionId,
    options.directory,
    stored.summary ?? summary,
  );
  await options.store.recordOperation({
    ...publish,
    status: published.ok ? "completed" : "failed",
    ...(published.error ? { error: published.error } : {}),
  });
  return stored.result;
}
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { isDeepStrictEqual } from "node:util";
import { waitForDispatch } from "../commands/control.js";
import {
  pinReviewCommit,
  readReviewGit,
  resolveReviewCommit,
  verifyReviewRepository,
} from "../git/review-workspace.js";
import { artifactHash, issueBundleHash } from "../planning/artifacts.js";
import { validateIssueGraph } from "../planning/graph.js";
import type { ReviewSnapshot, SnapshotOptions } from "./types.js";

export async function createReviewSnapshot(
  options: SnapshotOptions,
): Promise<ReviewSnapshot> {
  await waitForDispatch(options.store, options.runId);
  await verifyReviewRepository(options.directory, options.store.repositoryId);
  const run = await options.store.getRun(options.runId);
  const ids = options.graph.issues.map((issue) => issue.id);
  if (
    !run?.execution ||
    !ids.length ||
    new Set(ids).size !== ids.length ||
    ids.some(
      (id) =>
        run.execution?.issues.filter(
          (issue) => issue.id === id && issue.status === "integrated",
        ).length !== 1,
    ) ||
    run.execution.issues.some(
      (issue) => issue.status !== "integrated" || !ids.includes(issue.id),
    ) ||
    run.execution.integrationQueue.length ||
    Object.values(run.jobs).some(
      (job) =>
        job.status !== "terminal" &&
        !["code-review", "functional-review"].includes(job.envelope.role),
    )
  ) {
    throw new Error("All planned issues must be integrated before review");
  }
  if (
    !Number.isInteger(options.round) ||
    options.round < 1 ||
    options.round > 3 ||
    !options.prdRevision.trim() ||
    !options.graph.revision.trim() ||
    !options.evidenceRefs.length ||
    options.evidenceRefs.some((ref) => !ref.trim())
  )
    throw new Error("Invalid review revisions, round or evidence");
  const commit = await resolveReviewCommit(options.directory, options.commit);
  const baseCommit = await resolveReviewCommit(
    options.directory,
    options.baseCommit,
  );
  await readReviewGit(options.directory, [
    "merge-base",
    "--is-ancestor",
    baseCommit,
    commit,
  ]);
  const snapshot: ReviewSnapshot = {
    runId: options.runId,
    round: options.round,
    commit,
    prdRevision: options.prdRevision,
    graphRevision: options.graph.revision,
    evidenceRefs: [...options.evidenceRefs],
  };
  if (run.review) {
    if (
      !run.review.superseded &&
      isDeepStrictEqual(run.review.snapshot, snapshot)
    )
      return run.review.snapshot;
    if (run.review.snapshot.round >= options.round)
      throw new Error("Superseded or conflicting review round");
  }
  let prd: string;
  let graph: string;
  if (options.approvedPlanning) {
    const planning = run.planning;
    const approved = planning?.executionApproval;
    if (
      !planning?.prd ||
      !planning.graph ||
      !approved ||
      planning.phase !== "execution_approved" ||
      approved.prdHash !== planning.prd.hash ||
      approved.graphHash !== planning.graph.hash ||
      options.prdRevision !== planning.prd.hash ||
      !isDeepStrictEqual(options.graph, {
        revision: planning.graph.hash,
        issues: planning.graph.value.issues,
      })
    )
      throw new Error(
        "Review requires the current approved planning revisions",
      );
    validateIssueGraph(
      planning.graph.value,
      planning.graph.files,
      planning.prd,
    );
    prd = await readFile(
      join(planning.workspace, planning.prd.artifactPath),
      "utf8",
    );
    if (
      artifactHash(prd) !== planning.prd.hash ||
      issueBundleHash(planning.graph.value, planning.graph.files) !==
        planning.graph.hash
    )
      throw new Error("Approved review requirements changed");
    graph = JSON.stringify({
      ...planning.graph.value,
      files: planning.graph.files,
    });
  } else {
    prd = await readReviewGit(options.directory, [
      "show",
      `${commit}:${options.prdPath ?? "PRD.md"}`,
    ]);
    graph = await readReviewGit(options.directory, [
      "show",
      `${commit}:${options.graphPath ?? "graph.json"}`,
    ]);
    const committedGraph = JSON.parse(graph);
    if (!isDeepStrictEqual(committedGraph, options.graph) || !prd.trim())
      throw new Error("Committed requirements do not match the approved graph");
  }
  const diff = await readReviewGit(options.directory, [
    "diff",
    "--no-ext-diff",
    "--no-textconv",
    baseCommit,
    commit,
    "--",
  ]);
  if (
    !(await options.store.recordReviewSnapshot(options.runId, run.revision, {
      snapshot,
      inputs: {
        baseCommit,
        prd,
        graph,
        diff,
        tests: run.execution.checks,
        execution: run.execution,
      },
    }))
  )
    throw new Error("Execution changed while creating review snapshot");
  const operation = {
    operationId: `review-pin-${options.round}`,
    kind: "review.pin" as const,
    status: "intent" as const,
    job: {
      runId: options.runId,
      jobId: `review-pin-${options.round}`,
      attempt: 1,
      role: "review-snapshot",
      workspace: options.directory,
      inputRevisions: { round: options.round },
      baseCommit: commit,
      prompt: "Pin review commit",
    },
  };
  if (!(await options.store.recordOperation(operation)))
    throw new Error("Review pin intent rejected");
  try {
    await pinReviewCommit(
      options.directory,
      `refs/ralph/reviews/${options.runId}/${options.round}`,
      commit,
    );
    await options.store.recordOperation({ ...operation, status: "completed" });
  } catch (cause) {
    await options.store.recordOperation({
      ...operation,
      status: "failed",
      error: {
        code: "sdk-error",
        message: "Cannot pin review commit",
        cause: String(cause),
      },
    });
    throw cause;
  }
  return snapshot;
}
import { readReviewGit } from "../git/review-workspace.js";
import type { OpenCodeAdapter } from "../opencode/adapter.js";
import type { RunStore } from "../state/run-store.js";
import { runCodeReview } from "./code-review.js";
import { createReviewSnapshot } from "./snapshot.js";

/** Scheduler handoff only; functional review and repair coordination have separate owners. */
export async function reviewIntegratedExecution(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
) {
  const run = await store.getRun(runId);
  if (
    !run ||
    (run.control && run.control.status !== "active") ||
    !run.execution?.issues.length ||
    run.execution.issues.some((i) => i.status !== "integrated")
  )
    return run;
  if (run.review) return run;
  const planning = run.planning;
  if (!planning?.graph || !planning.prd || !run.baseline?.workspace)
    throw new Error("Missing approved execution review inputs");
  const directory = run.baseline.workspace;
  const commit = (await readReviewGit(directory, ["rev-parse", "HEAD"])).trim();
  const integration = Object.values(run.operations)
    .filter(
      (operation) =>
        operation.kind === "integration.advance" &&
        operation.status === "completed",
    )
    .at(-1);
  if (!integration?.expectedNew || integration.expectedNew !== commit)
    throw new Error(
      "Integration workspace no longer matches the accepted feature commit",
    );
  const snapshot = await createReviewSnapshot({
    store,
    directory,
    runId,
    round: 1,
    commit,
    baseCommit: run.baseline.candidateCommit,
    prdRevision: planning.prd.hash,
    graph: {
      revision: planning.graph.hash,
      issues: planning.graph.value.issues,
    },
    evidenceRefs: Object.values(run.issueAttempts ?? {}).map(
      (attempt) =>
        `integration:${attempt.issueId}:${attempt.attempt}:${attempt.integratedCommit}`,
    ),
    approvedPlanning: true,
  });
  await runCodeReview(snapshot, {
    store,
    adapter,
    directory,
    parentSessionId: planning.sessionId,
    ...(planning.settings.models["code-review"]
      ? { model: planning.settings.models["code-review"] }
      : {}),
  });
  return store.getRun(runId);
}
README.md:3:A locally installable OpenCode plugin with durable session jobs, independent code and functional review, bounded review repairs, a read-only dashboard, and interruption recovery. Exact tested dependencies and platform results are in [compatibility](docs/opencode-compatibility.md).
README.md:5:The complete deterministic setup-to-report demonstration runs through the installed public command/adapter boundary. Production human answers and approvals remain blocked: the OpenCode adapter cannot yet verify their provenance. A host integration must supply correlated human responses. The automatic scheduler starts code review; a host must call `reviewFeature` with functional environment, surface and observation-tool options for the final dual review/report. Native Linux/Windows and credentialed full-workflow evidence remain release blockers. See [package validation](docs/package-validation.md).
README.md:33:Use the **entire** URL printed by the command. It points to the package directory, where OpenCode resolves `server.js` and `tui.js`; do not point it to `dist/plugin.js`. This handles Windows drives and spaces. The example uses single quotes around JavaScript for PowerShell and POSIX shells; native Windows results are pending CI. A relative tarball dependency is recommended; Bun 1.4.3 failed to install the tested percent-encoded absolute `file:` tarball URL with spaces. Each target must be a Git repository. The repository root need not have a commit just to load the plugin; feature/review operations need committed inputs.
README.md:52:The public `adapter`, `store`, `commands`, `types`, `review/*`, `reporting/completion` and `process` exports support typed host integration. `createCommandRouter(...).scheduleIssues(runId)` schedules the approved DAG; `executeIssue(runId, issueId)` executes/integrates one approved issue with at most three attempts and retained failure evidence; `answerExecutorQuestion(runId, issueId, response)` validates a host-provided correlated human response; `continuePlanning(runId)` presents and continues a pending execution approval; `runJob` dispatches a correlated session; `reviewFeature` coordinates the two reviewers and final report. `process` exposes ownership tracking/cleanup for approved command owners, not command approval. Tests and fixture code are excluded from runtime exports and the tarball.
README.md:54:Code and functional reviewers load their bundled `skills/code-review` and `skills/functional-review` resources. Code-review options accept a `{ providerID, modelID }` model; functional review accepts its own model through `functionalOptions`. Executor jobs carry the same optional model field. Model/tool availability and OpenCode permissions remain host-owned; no permission is auto-approved. Command configuration validates lifecycle ordering, platform coverage (or explicit unsupported reasons), paths, timeouts, argument arrays, explicit shells and environment references. Role models and replacement skill paths are read from optional `.ralph/project.json` and captured with hashes on each run.
README.md:76:planning; explanation approval retains it through execution. Terminal coordinated review releases the matching lock. Interrupted locks require reconciliation and explicit resume.
README.md:119:Three **total issue attempts** include the first submission and two retries; an expected failing TDD red test does not consume an attempt. Three **total review rounds** apply to the final dual review; each generated repair task has its own three-attempt limit. Functional infrastructure retries have a separate three-attempt budget. Issue repair limits are enforced through the public single-issue entrypoint; the dependency scheduler preserves independent progress when an issue exhausts its budget.
README.md:123:A completed agent job is not proof of a verified feature. Reports distinguish `verified`, `incomplete-validation` (including skipped checks), `unverified` (missing review evidence) and `unresolved` (blocking issues/findings). Inspect the report's commit, checks, unavailable review and cleanup/resource fields. No workflow script publishes, pushes, creates a PR or merges into a target branch.
README.md:135:The package probe builds a clean distribution, packs it, installs it into two committed temporary repositories with spaces in their paths, and loads the installed plugin. It checks bundled skills/dashboard assets, separate stores and dashboard data, concurrent ports, argv preservation, local readiness, child cleanup and pause/resume. The workflow demo approves discovered commands, interviews, generates and approves a PRD/issue graph, prepares a clean baseline, executes real red/green addition tests, commits through the executor/merger worktrees, and dispatches independent reviewers through the fake SDK HTTP boundary. The second repository really times out its approved validation check; no execution state is seeded. The host explicitly supplies functional review options to the public coordinator after scheduling. Reports are `verified` for the passing-evidence fixture and `incomplete-validation` for the skipped-evidence fixture. These are deterministic fixture verdicts, not live-agent evidence. Temporary repositories are removed; `test:package` prints platform, runtime, outcomes and blockers. Set `PACKAGE_EVIDENCE_PATH` to retain JSON evidence.
README.md:137:For the real installed OpenCode server probe, enable `OPENCODE_SMOKE=1` (PowerShell: `$env:OPENCODE_SMOKE='1'`) before `bun run test:smoke`. It uses a local deterministic model. The separate credentialed session probe requires `OPENCODE_LIVE_SMOKE=1`, `OPENCODE_SMOKE_URL` and `OPENCODE_SMOKE_MODEL=provider/model`; without them it reports SKIPPED. The credentialed probe covers a model session, not the complete workflow; production human provenance and automatic functional-review wiring remain blockers. A v2 server also requires authentication: set `OPENCODE_SMOKE_PASSWORD` for the live probe. Credentials remain in the configured server; do not copy them into fixtures or package assets.
