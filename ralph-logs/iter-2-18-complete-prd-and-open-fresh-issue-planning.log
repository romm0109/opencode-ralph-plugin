    title: z.string().trim().min(1),
    artifactPath: z.string().regex(/^issues\/[A-Za-z0-9_-]+\.md$/),
    dependencies: z.array(z.string().min(1)),
    acceptanceCriteria: strings,
    testableBehaviors: strings,
  })
  .strict();
const graph = z
  .object({
    schemaVersion: z.literal(1),
    prdRevision: artifactRevision,
    issues: z.array(issue).min(1),
  })
  .strict();
export type IssueSpec = z.infer<typeof issue>;
export type IssueGraph = z.infer<typeof graph>;
export function topologicalOrder(value: IssueGraph): string[] {
  const issues = new Map(value.issues.map((item) => [item.id, item]));
  if (issues.size !== value.issues.length)
    throw new Error("Duplicate issue IDs");
  const visited = new Set<string>();
  const visiting = new Set<string>();
  const order: string[] = [];
  function visit(id: string) {
    if (visiting.has(id)) throw new Error("Issue graph contains a cycle");
    if (visited.has(id)) return;
    const item = issues.get(id);
    if (!item) throw new Error(`Unknown dependency ${id}`);
    visiting.add(id);
    for (const dependency of item.dependencies) visit(dependency);
    visiting.delete(id);
    visited.add(id);
    order.push(id);
  }
  for (const item of value.issues) visit(item.id);
  return order;
}
export function validateIssueGraph(
  raw: unknown,
  files: Record<string, string>,
  prd: z.infer<typeof artifactRevision>,
): IssueGraph {
  const value = graph.parse(raw);
  if (
    JSON.stringify(value.prdRevision) !==
    JSON.stringify(artifactRevision.parse(prd))
  )
    throw new Error("Issue graph references a different PRD revision");
  const paths = new Set<string>();
  for (const item of value.issues) {
    if (paths.has(item.artifactPath))
      throw new Error("Duplicate issue artifact path");
    paths.add(item.artifactPath);
    const text = files[item.artifactPath];
    if (!text?.trim())
      throw new Error(`Missing issue file ${item.artifactPath}`);
    const sections = new Map<string, string>();
    const headings = [...text.matchAll(/^##\s+(.+)$/gm)];
    for (const [index, match] of headings.entries()) {
      const name = (match[1] ?? "").trim().toLowerCase();
      if (sections.has(name))
        throw new Error(`Issue ${item.id} repeats ${name}`);
      sections.set(
        name,
        text
          .slice(
            (match.index ?? 0) + match[0].length,
            headings[index + 1]?.index ?? text.length,
          )
          .trim(),
      );
    }
    for (const heading of [
      "What to build",
      "Context: files to read before implementing",
      "Patterns to follow",
      "Step-by-step tasks",
      "Acceptance criteria",
      "Validation commands",
      "Blocked by",
    ])
      if (
        !sections
          .get(heading.toLowerCase())
          ?.replace(/^#+.*$/gm, "")
          .trim()
      )
        throw new Error(`Issue ${item.id} missing or empty ${heading}`);
  }
  if (Object.keys(files).some((path) => !paths.has(path)))
    throw new Error("Invalid issue file reference");
  topologicalOrder(value);
  return value;
}
import { createHash } from "node:crypto";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
export async function loadRoleInstructions(
  workspace: string,
  role: "interview" | "prd" | "issues" | "executor" | "merger",
  overrides: Record<string, string> = {},
) {
  const bundled = new URL(
    `../../skills/${{ interview: "grill-me", prd: "create-prd", issues: "to-issues", executor: "tdd", merger: "merge" }[role]}/SKILL.md`,
    import.meta.url,
  );
  const path = overrides[role] ? resolve(workspace, overrides[role]) : bundled;
  let text: string;
  try {
    text = await readFile(path, "utf8");
    if (!text.trim()) throw new Error("Empty instructions");
    if (overrides[role])
      text = `${await readFile(bundled, "utf8")}\nProject instructions:\n${text}`;
  } catch (cause) {
    throw new Error(
      `Cannot load ${role} instructions at ${path}. Fix .ralph/project.json skillPaths.${role}.`,
      { cause },
    );
  }
  if (role === "interview")
    text += `
Ralph interview stage contract:
Explore repository facts with observation tools. Resolve scope, acceptance criteria,
constraints, and failure behavior. Ask one substantive question at a time and include
its recommended answer. Ralph displays your structured questions through the native
question tool and records the human answer. Return a question as JSON:
{"kind":"question","question":"...","recommendation":"..."}
When decisions are resolved, explain the feature using ASD-STE100 writing instructions:
use short sentences, active voice, consistent terms, and simple vocabulary. This is
writing guidance, not a separately certified result. Finish by calling
ralph_complete_interview with runId, attempt, text, scope[], and criteria[].
The host supplies session identity and obtains native human approval.
Stay in this interview. Do not write project files or advance to another stage.
Assistant prose cannot complete the stage or authorize work.
`;
  return {
    path: String(path),
    hash: createHash("sha256").update(text).digest("hex"),
    text,
  };
}

