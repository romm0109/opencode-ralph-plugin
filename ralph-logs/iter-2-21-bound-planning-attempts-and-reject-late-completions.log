      if (
        answer.source !== "user" ||
        !answer.messageId ||
        answer.sessionId !== request.sessionId ||
        answer.requestId !== request.requestId ||
        answer.revision !== request.revision ||
        state.budgetResets?.some((r) => r.answer.messageId === answer.messageId)
      )
        return;
