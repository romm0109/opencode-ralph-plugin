export async function queuePlanningPrompt(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  sessionId: string,
  messageId: string,
  prompt: string,
) {
  const run = await store.getRun(runId);
  const attempt = run?.planning?.attempts?.find(
    (a) => a.messageId === messageId && a.sessionId === sessionId,
  );
