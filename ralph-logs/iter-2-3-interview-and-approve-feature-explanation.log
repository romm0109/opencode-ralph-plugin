import { expect, test } from "bun:test";
import { createCommandRouter } from "../../src/commands/router.js";
import { createOpenCodeAdapter } from "../../src/opencode/adapter.js";
import { openRunStore } from "../../src/state/run-store.js";
import { createFakeOpenCode } from "../helpers/fake-opencode.js";
import { createTestProject } from "../helpers/project.js";

test("orchestrator rejects a feature before verified setup", async () => {
  const project = await createTestProject();
  try {
    const fake = createFakeOpenCode();
    const store = await openRunStore(project.directory);
    const router = createCommandRouter(
      store,
      createOpenCodeAdapter(fake.client, store),
    );
    await expect(
      router.dispatch("ralph-orchestrator", "Add reset", {
        workspace: project.directory,
        sessionId: "main",
      }),
    ).rejects.toThrow("verification");
    expect(await store.listRuns()).toHaveLength(0);
  } finally {
    await project.cleanup();
  }
});

test("recommended interview question, rejected revision and human approval hand off to PRD generation", async () => {
  const project = await createTestProject();
  try {
    const fake = createFakeOpenCode();
    const store = await openRunStore(project.directory);
    const adapter = createOpenCodeAdapter(fake.client, store);
    adapter.getSessionModel = async () => ({
      providerID: "fixture",
      modelID: "default",
    });
    const router = createCommandRouter(
      store,
      adapter,
      undefined,
      project.directory,
    );
    fake.respond(
      JSON.stringify({
        schemaVersion: 1,
        revision: 1,
        rationale: "Fixture",
        commands: [
          {
            id: "check",
            phase: "check",
            executable: process.execPath,
            args: ["-e", "process.exit(0)"],
            cwd: ".",
            timeoutMs: 2000,
            platforms: ["darwin", "linux", "win32"],
            env: {},
          },
        ],
      }),
    );
    adapter.authorizeCommand = async () => ({ ok: true });
    adapter.requestUserInput = async (request) => ({
      ok: true,
      ...request,
      source: "user",
      messageId: "setup-human",
      text: `approve ${request.question.match(/hash ([a-f0-9]+)/)?.[1]}`,
    });
    await router.setupProject({
      workspace: project.directory,
      sessionId: "main",
    });
    fake.respond(
      JSON.stringify({
        kind: "question",
        question: "How long should tokens last?",
        recommendation: "15 minutes",
      }),
    );
    let count = 0;
    adapter.requestUserInput = async (request) => {
      expect(request.sessionId).toBe("main");
      count++;
      if (count === 1) {
        fake.respond(
          JSON.stringify({
            kind: "explanation",
            text: "Expire reset tokens after 15 minutes.",
            scope: ["Reset tokens"],
            criteria: ["Expired tokens fail"],
          }),
        );
        return {
          ok: true,
          ...request,
          source: "user",
          messageId: "answer",
          text: "15 minutes",
        };
      }
      if (count === 2) {
        fake.respond(
          JSON.stringify({
            kind: "explanation",
            text: "Expire reset tokens after 10 minutes.",
            scope: ["Reset tokens"],
            criteria: ["Tokens fail after 10 minutes"],
          }),
        );
        return {
          ok: true,
          ...request,
          source: "user",
          messageId: "reject",
          text: "revise: use 10 minutes",
        };
      }
      return {
        ok: true,
        ...request,
        source: "user",
        messageId: "approve",
        text: `approve ${request.revision}`,
      };
    };
    const result = JSON.parse(
      await router.dispatch("ralph-orchestrator", "Add password reset", {
        workspace: project.directory,
        sessionId: "main",
      }),
    );
    const run = await store.getRun(result.runId);
    expect(run?.planning?.phase).toBe("prd_generation");
    expect(run?.planning?.error?.code).toBe("missing-output");
    expect(run?.planning?.explanation?.revision).toBe(2);
    expect(run?.planning?.approval?.revision).toBe(2);
    expect(
      run?.planning?.transcript.filter((entry) => entry.source === "user"),
    ).toHaveLength(4);
    expect(
      Object.values(run?.jobs ?? {}).every((job) =>
        ["interview", "prd"].includes(job.envelope.role),
      ),
    ).toBe(true);
    expect(JSON.parse(await router.status(result.runId)).planning.phase).toBe(
      "prd_generation",
    );

