    [state.prd.artifactPath]: state.prd.hash,
    [state.graph.artifactPath]: artifactHash(
      JSON.stringify(state.graph.value, null, 2),
    ),
    ...Object.fromEntries(
      Object.entries(state.graph.files).map(([path, text]) => [
        `${graphDirectory}/${path}`,
        artifactHash(text),
      ]),
    ),
