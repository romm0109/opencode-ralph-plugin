export const MAX_PROGRESS_CHARS = 16000;

function visibleOwner(run: RunRecord) {
  return run.planning?.protocol === "native-interview-v1"
    ? run.planning.owner?.sessionId
    : undefined;
}
async function progressView(run: RunRecord) {
  let commands:
    | {
        revision?: number;
        selected?: {
          id: string;
          phase: string;
          executable: string;
          args: string[];
        }[];
        unavailable?: string;
      }
    | undefined;
  if (run.baseline && run.planning) {
    try {
      const config = (await loadProjectConfig(run.planning.workspace)).commands;
      commands =
        commandConfigHash(config) === run.planning.commandHash
          ? {
              revision: config.revision,
              selected: config.commands.map((c) => ({
                id: c.id,
                phase: c.phase,
                executable: c.executable,
                args: c.args,
              })),
            }
          : {
              unavailable:
                "Command configuration changed; inspect baseline blocker",
            };
    } catch {
      commands = {
        unavailable:
          "Approved command configuration unavailable; inspect baseline status",
      };
    }
  }
  const snapshot = projectRunSnapshot(run, 0, runtimeSecretValues());
  return sanitizeValue(
    {
      commands,
      completion: snapshot.completion && {
        ...snapshot.completion,
        retainedResources: run.reviewWorkflow?.report?.retainedResources,
        findings: run.reviewWorkflow?.report?.findings,
      },
      planning: snapshot.planning,
      control: snapshot.control,
      baseline: run.baseline && {
        status: run.baseline.status,
        blocker: run.baseline.blocker,
        error: run.baseline.error?.message,
        commandRevision: run.baseline.commandRevision,
      },
      agents: snapshot.agents.map((a) => ({
        ...a,
        result:
          run.jobs[a.jobId]?.result?.text === undefined
            ? undefined
            : sanitizeValue(
                run.jobs[a.jobId]?.result?.text ?? "",
                runtimeSecretValues(),
              ).slice(0, 2000),
      })),
      issues: snapshot.issues,
      checks: snapshot.checks,
      review: snapshot.reviewRounds,
      errors: snapshot.errors,
    },
    runtimeSecretValues(),
  );
}
type Cursor = {
  sequence: number;
  sessionId: string;
  view: Awaited<ReturnType<typeof progressView>>;
};

/** Observes committed state only. It never calls a stage, prompt, or scheduler. */
export function createProgressObserver(options: {
  store: RunStore;
  directory: string;
  deliver: (message: {
    runId: string;
    sessionId: string;
    id: string;
    text: string;
  }) => Promise<void>;
}) {
  const { store, directory, deliver } = options;
  const root = join(store.root, "chat-progress");
  let stopped = false;
  let running: Promise<void> | undefined;
  async function observe() {
    const location = await realpath(directory);
    await mkdir(root, { recursive: true });
    for (const run of await store.listRuns()) {
      if (stopped || !visibleOwner(run) || !run.planning) continue;
      // Linked worktrees share a journal, but never share visible chat ownership.
      try {
        if ((await realpath(run.planning.workspace)) !== location) continue;
      } catch (cause) {
        if ((cause as NodeJS.ErrnoException).code === "ENOENT") continue;
        throw cause;
      }
      const path = join(root, `${run.runId}.json`);
      let cursor: Cursor | undefined;
      try {
        cursor = JSON.parse(await readFile(path, "utf8"));
      } catch (cause) {
        if ((cause as NodeJS.ErrnoException).code !== "ENOENT") throw cause;
      }
      for (const event of (
        await store.events(run.runId, { afterSequence: cursor?.sequence ?? 0 })
      )
        .filter((event) => visibleOwner(event.snapshot) === visibleOwner(run))
        .slice(0, 100)) {
        if (stopped) return;
        const sessionId = visibleOwner(event.snapshot);
        if (!sessionId) continue;
        // Re-read before delivery: retired owners cannot receive queued progress.
        const current = await store.getRun(run.runId);
        if (
          !current ||
          visibleOwner(current) !== sessionId ||
          current.planning?.workspace !== run.planning.workspace
        )
          continue;
        const view = await progressView(event.snapshot);
        const changed = Object.fromEntries(
          Object.entries(view).filter(
            ([key, value]) =>
              cursor?.sessionId !== sessionId ||
              JSON.stringify(value) !==
                JSON.stringify(cursor.view[key as keyof typeof view]),
          ),
        );
        if (Object.keys(changed).length) {
          const text = sanitizeValue(
            `Ralph progress · ${run.runId} · event ${event.sequence}\n${JSON.stringify(changed, null, 2)}`,
            runtimeSecretValues(),
          );
          await deliver({
            runId: run.runId,
            sessionId,
            id: `msg_ralph-progress-${run.runId}-${event.sequence}`,
            text:
              text.length > MAX_PROGRESS_CHARS
                ? `${text.slice(0, MAX_PROGRESS_CHARS - 60)}\n[Progress truncated; full evidence in Ralph status/logs.]`
                : text,
          });
        }
        cursor = { sequence: event.sequence, sessionId, view };
        // Separate observation checkpoint: never invalidate execution revisions.
        const temp = `${path}.${randomUUID()}.tmp`;
        await writeFile(
          temp,
          JSON.stringify(sanitizeValue(cursor, runtimeSecretValues())),
        );
        await rename(temp, path);
      }
    }
  }
  return {
    flush() {
      if (stopped) return Promise.resolve();
      running ??= observe().finally(() => {
        running = undefined;
      });
      return running;
    },
    async stop() {
      stopped = true;
      await running?.catch(() => {});
    },
  };
}
import { Rpc } from "@opencode/schema/rpc";
import { z } from "zod";

// OpenCode v2 exposes the tool catalog to plugins, but not as a client endpoint.
// This read-only RPC keeps external typed integrations on the same host boundary.
export const ralphBridge = Rpc.define({
  id: "ralph",
  methods: {
    tools: { input: z.object({}), output: z.array(z.string()) },
    prepareReview: {
      input: z.object({ tools: z.array(z.string()) }),
      output: z.object({ ok: z.literal(true) }),
    },
    publishStatus: {
      input: z.object({ text: z.string() }),
      output: z.object({ ok: z.literal(true) }),
    },
  },
  events: {
    stageSession: {
      schema: z.object({
        runId: z.string(),
        revision: z.number().int().positive(),
        stage: z.enum(["interview", "issues"]),
        sessionId: z.string(),
        attempt: z.number().int().positive(),
      }),
    },
    status: { schema: z.object({ text: z.string() }) },
  },
});
import { define } from "@opencode/plugin/tui/plugin";

export default define({
  id: "ralph",
  setup(ctx) {
    const followed = new Set<string>();
    const revisions = new Map<string, number>();
    const unsubscribe = ctx.data.listen(({ details }) => {
      if (
        !["rpc.ralph.status", "rpc.ralph.stageSession"].includes(details.type)
      )
        return;
      if (
        !ctx.location ||
        details.location?.directory !== ctx.location.directory
      )
        return;
      const data = details.data as Record<string, unknown> | undefined;
      if (details.type === "rpc.ralph.stageSession") {
        if (
          !ctx.location ||
          details.location?.directory !== ctx.location.directory ||
          !data ||
          typeof data !== "object" ||
          Array.isArray(data) ||
          typeof data.sessionId !== "string" ||
          typeof data.runId !== "string" ||
          !["interview", "issues"].includes(String(data.stage)) ||
          !Number.isSafeInteger(data.attempt) ||
          Number(data.attempt) < 1 ||
          !Number.isSafeInteger(data.revision) ||
          Number(data.revision) < 1
        )
          return;
        const revision = Number(data.revision);
        if (revision <= (revisions.get(data.runId) ?? 0)) return;
        revisions.set(data.runId, revision);
        const key = `${data.runId}:${data.stage}:${data.attempt}:${data.sessionId}`;
        if (followed.has(key)) return;
        followed.add(key);
        if (!ctx.ui.tabs.focus(data.sessionId))
          ctx.ui.router.navigate({
            type: "session",
            sessionID: data.sessionId,
          });
        return;
      }
      if (
        !data ||
        typeof data !== "object" ||
        Array.isArray(data) ||
        typeof data.text !== "string"
      )
        return;
      ctx.ui.toast.show({
        title: "Ralph status",
        message: data.text,
        variant: "info",
      });
    });
    return () => {
      unsubscribe();
    };
  },
});
      };
    },
    async publishProgress(runId, sessionId, workspace, id, text) {
      const run = await store.getRun(runId);
      if (
        run?.planning?.protocol !== "native-interview-v1" ||
        run.planning.owner?.sessionId !== sessionId
      )
        return {
          ok: false,
          error: {
            code: "permission-denied",
            message: "Visible workflow session ownership changed",
          },
        };
      if (!client.session.synthetic)
        return {
          ok: false,
          error: {
            code: "unsupported",
            message: "Host synthetic progress unavailable",
          },
        };
      try {
        if (
          (await realpath(run.planning.workspace)) !==
          (await realpath(workspace))
        )
          return {
            ok: false,
            error: {
              code: "permission-denied",
              message: "Progress belongs to another project location",
            },
          };
        await client.session.synthetic({
          sessionID: sessionId,
          id,
          text: sanitizeValue(text, runtimeSecretValues()).slice(0, 16000),
          description: "Ralph workflow progress",
          resume: false,
        });
        return { ok: true };
      } catch (cause) {
        return { ok: false, error: failure(cause) };
      }
    },
    async publishStatus(_sessionId, workspace, text) {
      try {
        await client.notify(
          workspace,
          sanitizeValue(text, runtimeSecretValues()).slice(0, 16000),
        );
        return { ok: true };
      } catch (cause) {
        return { ok: false, error: failure(cause) };
