      notification = setImmediate(async () => {
        if (disposed) return;
        const flush = () =>
          void progress.flush().catch((cause) => {
            if (!disposed)
              console.error(
                "Ralph progress delivery failed",
                sanitizeValue(
                  cause instanceof Error ? cause.message : String(cause),
                  runtimeSecretValues(),
                ).slice(0, 1000),
