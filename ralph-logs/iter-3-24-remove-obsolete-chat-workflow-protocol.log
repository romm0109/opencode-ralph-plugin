});

function hungCheck(id = "hung") {
  return {
    id,
    phase: "check" as const,
    executable: process.execPath,
    args: [
      "-e",
      'require("fs").writeFileSync("hung-ready", "ready"); setInterval(()=>{},1000)',
    ],
    cwd: ".",
    timeoutMs: 5000,
    platforms: ["darwin", "linux", "win32"] as ("darwin" | "linux" | "win32")[],
    env: {},
  };
}
