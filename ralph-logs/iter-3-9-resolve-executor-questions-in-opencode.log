export interface ExecutorQuestion
  extends z.infer<typeof executorQuestionSchema> {
  request: UserInputRequest;
  jobId: string;
  attempt: number;
  operationId: string;
  epoch: number;
  prdHash: string;
  graphHash: string;
  inputRevisions: Record<string, number>;
  answer?: Extract<UserInputResult, { ok: true }>;
  error?: Failure;
}
export function createExecutorQuestion(
  run: RunRecord,
  attempt: IssueAttempt,
  value: z.infer<typeof executorQuestionSchema>,
): ExecutorQuestion {
  const state = run.planning;
  if (!state?.prd || !state.graph)
    throw new Error("Missing approved question artifacts");
  return {
    kind: value.kind,
    question: value.question,
    recommendedAnswer: value.recommendedAnswer,
    affectedRequirement: value.affectedRequirement,
    jobId: attempt.job.jobId,
    attempt: attempt.attempt,
    operationId: attempt.operationId,
    epoch: run.control?.epoch ?? 0,
    prdHash: state.prd.hash,
    graphHash: state.graph.hash,
    inputRevisions: {
      ...attempt.job.inputRevisions,
      prd: state.prd.revision,
      graph: state.graph.revision,
    },
    request: {
      runId: run.runId,
      workspace: state.workspace,
      sessionId: state.sessionId,
      requestId: randomUUID(),
      revision: state.graph.revision,
      question: `Issue ${attempt.issueId}, attempt ${attempt.attempt}\nRequirement: ${value.affectedRequirement}\n${value.question}\nRecommended answer: ${value.recommendedAnswer}`,
    },
  };
}

/** Durable pending identity is the publication intent; waiting has no agent timer. */
const pending = new Map<string, Promise<void>>();
export function handleExecutorQuestion(
  store: RunStore,
  adapter: OpenCodeAdapter,
  runId: string,
  issueId: string,
  requestId?: string,
  options: AttemptOptions = {},
) {
  const key = `${store.repositoryId}:${runId}:${issueId}:${requestId ?? "current"}`;
  if (pending.has(key)) return;
  const work = (async () => {
    const attempt = (await store.getRun(runId))?.issueAttempts?.[issueId];
    const question = attempt?.question;
    if (
      attempt?.status !== "waiting" ||
      !question ||
      question.answer ||
      (requestId && question.request.requestId !== requestId)
    )
      return;
    const published = await adapter.publishStatus(
      question.request.sessionId,
      question.request.workspace,
      question.request.question,
    );
    const response: UserInputResult = published.ok
      ? await adapter.requestUserInput(question.request)
      : {
          ok: false,
          error: published.error ?? {
            code: "sdk-error",
            message: "Could not publish executor question",
          },
        };
    if (!response.ok) {
      for (;;) {
        const latest = await store.getRun(runId);
        const current = latest?.issueAttempts?.[issueId];
        if (
          !latest ||
          (latest.control && latest.control.status !== "active") ||
          !current?.question ||
          current.question.request.requestId !== question.request.requestId ||
          current.question.answer
        )
          return;
        current.question.error = response.error;
        if (await store.recordIssueAttempt(runId, latest.revision, current))
          return;
      }
    }
    if (await answerExecutorQuestion(store, runId, issueId, response)) {
      if (
        (await store.getRun(runId))?.planning?.phase === "execution_approval"
      ) {
        await continuePlanning(store, adapter, runId);
      } else {
        // A scheduler may still be settling independent workers. Join it, then re-read.
        await scheduleReadyIssues(store, adapter, runId, options);
        await scheduleReadyIssues(store, adapter, runId, options);
      }
    }
  })()
    .catch(async (cause) => {
      const run = await store.getRun(runId);
      const attempt = run?.issueAttempts?.[issueId];
      if (
        run &&
        attempt?.question &&
        attempt.status === "waiting" &&
        (!requestId || attempt.question.request.requestId === requestId)
      ) {
        attempt.question.error = { code: "sdk-error", message: String(cause) };
        await store.recordIssueAttempt(runId, run.revision, attempt);
      }
    })
    .finally(() => {
      pending.delete(key);
    });
  pending.set(key, work);
}

export async function answerExecutorQuestion(
  store: RunStore,
  runId: string,
  issueId: string,
  response: UserInputResult,
) {
  for (;;) {
    const run = await store.getRun(runId);
    const attempt = run?.issueAttempts?.[issueId];
    const q = attempt?.question;
    const state = run?.planning;
    if (
      !run ||
      !state ||
      !attempt ||
      attempt.status !== "waiting" ||
      !q ||
      q.answer ||
      (run.control && run.control.status !== "active") ||
      (run.control?.epoch ?? 0) !== q.epoch ||
      attempt.operationId !== q.operationId ||
      attempt.job.jobId !== q.jobId ||
      attempt.attempt !== q.attempt ||
      state.phase !== "execution_approved" ||
      !approvalMatchesRevision(state) ||
      state.prd?.hash !== q.prdHash ||
      state.graph?.hash !== q.graphHash ||
      state.graph?.revision !== q.request.revision ||
      state.prd?.revision !== q.inputRevisions.prd ||
      !response.ok ||
      response.source !== "user" ||
      !response.messageId ||
      !response.text.trim() ||
      response.requestId !== q.request.requestId ||
      response.sessionId !== q.request.sessionId ||
      response.revision !== q.request.revision ||
      state.transcript.some(
        (entry) => entry.messageId === response.messageId,
      ) ||
      Object.values(run.issueAttempts ?? {}).some((a) =>
        [...(a.questions ?? []), ...(a.question ? [a.question] : [])].some(
          (q) => q.answer?.messageId === response.messageId,
        ),
      )
    )
      return false;
# Executor questions

## Summary
Executor `needs_input` output persists a specific question, recommendation and affected requirement on the current issue attempt. The main OpenCode adapter publishes it and requests a correlated human response outside the executor slot and deadline. Independent issues continue integrating.

## Key behavior
- Waiting issues and descendants are blocked. Clarification resumes the same attempt, owned worktree and base commit with a fresh dispatch identity and current approved context. Question history is retained.
- Only active executor time reduces the remaining agent deadline. Human waiting has no timer or attempt charge.
- Answers require adapter-supplied human provenance, the main session, current request/job/attempt/operation/epoch and artifact revisions. Superseded, duplicate and unrelated-session responses cannot advance work.
- An explicit user-correlated `revise_scope` answer carries complete PRD text, graph and issue files. Actual content comparison determines whether approval is needed; graph validation precedes publication. Draft publication records intent and retains old artifacts, approval and integrated-work evidence.
- The normal combined approval gate presents affected and already-integrated issue IDs. Only renewed approval rebinds the unchanged validated baseline. Affected integrated work retains its evidence and is scheduled for execution again; the questioning issue continues the same attempt. Other pending questions receive new revision-bound request identities.
- Public host methods `answerExecutorQuestion` and `continuePlanning` support later responses and approval continuation. Adapter-delivered answers continue automatically. There is no browser write endpoint.

## Code references
- `src/execution/questions.ts` — question persistence, delivery, correlation, scope drafts and approval continuation.
- `src/execution/execute-issue.ts`, `src/execution/attempts.ts` — same-attempt dispatch and remaining active-time budget.
- `src/agents/results.ts`, `src/opencode/adapter.ts`, `skills/tdd/SKILL.md` — structured question output contract.
- `src/planning/approvals.ts`, `src/planning/issues.ts` — revision-bound approval and affected-work presentation.
- `src/execution/scheduler.ts`, `src/core/orchestrator.ts`, `src/commands/router.ts` — independent scheduling and public host boundary.
- `tests/integration/09-questions.test.ts`, `tests/helpers/diamond.ts` — concurrent question demonstration, rejection and renewed approval coverage.

## Related
- [Concurrent execution](concurrent-execution.md)
- [Planning approval](feature-planning.md)

## Notes
The production adapter still reports unsupported human provenance. Tests supply authenticated/correlated user responses through the controllable adapter and real temporary Git repositories; live human-chat and native Linux/Windows runs are not claimed. A prose clarification does not authorize artifact edits; scope revisions use the explicit artifact proposal and normal human approval gate.

